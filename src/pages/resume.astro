---
import ActionBar from "../components/ActionBar.astro";
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "Michael Bickford / Résumé",
  description:
    "Software developer focused on developer tooling, diagnostic systems, and interactive applications.",
  image: "/images/og-default.png",
  noindex: true,
};
---

<Layout seo={seo}>
  <ActionBar label="Resume actions" class="resume-actions">
    <a class="resume-action" href="/resume.pdf" download="Michael-Bickford-Resume.pdf">Download PDF</a>
    <a class="resume-action" href="/contact">Contact</a>
  </ActionBar>

  <section class="resume-shell" aria-labelledby="resume-name">
    <article class="resume-sheet">
      <div class="eyebrow"><span>Michael Bickford / Résumé</span><span>Software Developer</span></div>
      <div class="hairline"></div>
      <header>
        <h1 id="resume-name">MICHAEL BICKFORD</h1>
        <div class="role"><strong>Software Developer · tools, systems &amp; interactive software</strong><span>Ontario, Canada</span></div>
        <div class="contact" aria-label="Public professional links">
          <span><b>web</b> <a href="https://woflo.dev">woflo.dev</a></span>
          <span><b>github</b> <a href="https://github.com/worflor">github.com/worflor</a></span>
          <span><b>contact</b> <a href="/contact">woflo.dev/contact</a></span>
          <span><b>linkedin</b> <a href="https://linkedin.com/in/michael-bickford-0aa209211">linkedin.com/in/michael-bickford-0aa209211</a></span>
        </div>
      </header>
      <p class="intro">Software developer and independent researcher focused on developer tooling, diagnostic systems, and interactive applications. I move between implementation and theory, using code, mathematical models, and structured investigation to make complex systems easier to understand, test, and use. I have worked this way since I was a kid taking the family computer apart and rebuilding it, piece by piece, just to know what was inside.</p>
      <div class="layout">
        <main>
          <section class="section">
            <h2 class="section-label">Selected Work</h2>
            <article class="work-item">
              <div class="head"><h3>What Do You Mean?</h3><span class="tag">Capstone · 2026</span></div>
              <div class="sub">Live diagnostic environment for a Java 21 game client · Fabric 1.21</div>
              <p>Capstone for diagnosing a live modded Minecraft client from inside the session: inspection, health monitoring, source access, and controlled debugging with explicit approval and rollback. Playable alpha at <a href="https://woflo.itch.io/what-do-you-mean">woflo.itch.io/what-do-you-mean</a>; source private.</p>
              <ul class="points">
                <li data-n="01">Designed a staged diagnostic workflow: read-only inspection first, explicit approval for state changes, and rollback on failure.</li>
                <li data-n="02">Implemented live JVM bytecode patching with multi-patch plans that roll back as a unit, compiled read-only runtime triggers, and on-the-fly decompilation of loaded classes.</li>
                <li data-n="03">Built the privacy layer to redact with explicit markers, so the model knows what was withheld instead of guessing around the gap.</li>
              </ul>
            </article>
            <article class="work-item">
              <div class="head"><h3>Manifold</h3><span class="tag">Live &middot; Community Source</span></div>
              <div class="sub">Git client for Windows &amp; Linux · Flutter / Dart</div>
              <p>Desktop Git client for exploring file relationships around a change and navigating unfamiliar codebases.</p>
              <ul class="points"><li data-n="01">Started as a Tauri/Rust app; rebuilt in Flutter/Dart when the original proved too slow. Currently working on graph exploration, structured diffs, and Git-native review flows.</li></ul>
            </article>
            <article class="work-item">
              <div class="head"><h3>Minecraft Server Maintainer</h3><span class="tag">Open source</span></div>
              <div class="sub">Java 21 utility · 19 GitHub stars · 8 server platforms</div>
              <p>Headless utility for Minecraft servers, mods, plugins, and datapacks across 8 platforms. Provides pre-update checks, automated rollback on failure, and repeatable maintenance workflows.</p>
            </article>
          </section>
          <section class="section">
            <h2 class="section-label">Research &amp; Writing</h2>
            <div class="pub">
              <h3>The Self-Referential Fixed Point of the Complex Exponential</h3>
              <div class="venue">arXiv:2606.01668 · June 2026 · solo author</div>
              <p>Independent work on a fixed point of the complex exponential. Also writes technical documentation on live systems and high-dimensional mathematics.</p>
            </div>
          </section>
        </main>
        <aside class="rail">
          <section><h2 class="section-label">Capabilities</h2><p><strong>Software development</strong><br />Architecture, debugging, testing, review, docs</p><p><strong>Interactive systems</strong><br />Gameplay, tools, UX, live iteration</p><p><strong>Investigation</strong><br />Source reading, blame tracing, failure analysis</p><p><strong>Automation</strong><br />Tooling, workflows, integrations</p></section>
          <section><h2 class="section-label">Tools I Reach For</h2><div class="tools"><span class="grp"><b>Languages</b>C++ · Java · Python · Dart · Rust · TypeScript</span><span class="grp"><b>Application &amp; web</b>Flutter · HTML/CSS · Astro · WebAssembly integration</span><span class="grp"><b>Platforms</b>Fabric/Minecraft · Unreal Engine (C++) · Windows · Linux</span><span class="grp"><b>Practice</b>Git · testing · technical documentation</span></div></section>
          <section><h2 class="section-label">Currently</h2><p>Advanced Diploma in Game Programming, Humber College. Looking for software work in Ontario or remote.</p></section>
          <p class="portfolio-note"><strong>Portfolio</strong>Projects and writing: woflo.dev. Capstone docs and demo available on request.</p>
        </aside>
      </div>
      <div class="footer"><span>Michael Bickford / Résumé</span><span>01 / 02</span></div>
    </article>

    <article class="resume-sheet">
      <div class="runhead"><span><b>Michael Bickford</b> / Résumé</span><span>Project &amp; technical detail</span></div>
      <section class="section"><h2 class="section-label">Capstone: Diagnostic Tooling for Modded Minecraft</h2><p class="summary">A capstone built as a controlled diagnostic environment for a live modded client. The work combines inspection, health monitoring, source access, and user-approved state changes with rollback. Underneath it is an agent harness: a model acting inside a live world needs chosen context, memory, privacy boundaries, and a way back when something fails, and building those turned out to be the real work.</p><div class="two-col"><div><ul class="tight"><li><strong>Live diagnosis.</strong> Read-only inspection first, state changes only with explicit approval, rollback on failure.</li><li><strong>Reactive conditions.</strong> Compiled read-only triggers with safety checks, notifications, and background monitoring.</li><li><strong>Source access.</strong> File, jar, and registry scanning plus Vineflower decompilation, keeping code investigation close to the running environment.</li></ul></div><div><ul class="tight"><li><strong>Guarded execution.</strong> Action-depth limits with visible confirmation before every state change.</li><li><strong>Fidelity controls.</strong> Privacy redaction that tells you exactly what was removed, with no silent gaps.</li><li><strong>Evaluation.</strong> Post-mortem separating measured results, observed behaviour, and open limitations.</li></ul></div></div></section>
      <section class="section"><h2 class="section-label">Game &amp; Interactive Work</h2><article class="work-item"><div class="head"><h3>Morithon</h3><span class="tag">Team project · 2024</span></div><div class="sub">Unreal Engine 5 death-run · 45-person student production</div><p>Built the main menu and settings UI, including anchored layouts, team-colour theming, and audio and graphics controls. Coordinated UI delivery with another core contributor when project ownership shifted.</p></article><article class="work-item"><div class="head"><h3>C++ Team Game</h3><span class="tag">Midstone · three-person team</span></div><div class="sub">Custom engine work in C++ · audio, UI, scenes</div><p>Built with two teammates. I owned the engine core: the component framework, a full C++ audio engine, the UI and menu screens, and scene setup, with cleanup passes across the shared code.</p></article><article class="work-item"><div class="head"><h3>Neuron</h3><span class="tag">In development</span></div><div class="sub">All-Rust Windows peripheral utility · raw HID, local configuration, automation</div><p>Rust utility for Razer peripherals, including direct HID interaction, Chroma SDK mock support, lighting controls, gesture input, and local TOML configuration.</p></article></section>
      <section class="section"><h2 class="section-label">Experience &amp; Education</h2><div class="two-col"><div><h3 class="detail-heading">Open-Source &amp; Independent Development <span>ONGOING</span></h3><p class="detail-copy">Building and documenting tools, prototypes, and studies across developer tooling, game modding, systems work, and math. Currently: WDYM, Manifold, Neuron, Minecraft Server Maintainer, and a solo arXiv paper.</p><h3 class="detail-heading">Grounds Maintenance Worker, Humber College <span>SUMMER 2023 TO DECEMBER 2025</span></h3><p class="detail-copy">Performed routine outdoor grounds maintenance and cleanup across campus as part of Humber’s student work-study program, working reliably in a team through physical labour and changing weather conditions.</p><h3 class="detail-heading">Customer Service, Tim Hortons <span>2017 TO 2019 / 2021 TO 2022</span></h3><p class="detail-copy">Drive-thru, beverage preparation, cash, and front-counter service in a fast-paced, high-volume environment.</p></div><div><h3 class="detail-heading">Advanced Diploma, Game Programming <span>CURRENTLY ENROLLED</span></h3><p class="detail-copy">Humber College. Game math and game physics through all three years, C++ throughout, and a graphics sequence where the standout was a Vulkan renderer in C++, with OpenGL and SDL alongside. Electives in astrobiology and psychology. Capstone: <em>What Do You Mean?</em></p><h3 class="detail-heading">Concurrent Education, Dramatic Arts <span>2019 TO 2022</span></h3><p class="detail-copy">University of Windsor. Dramatic arts as the teachable; started toward biology and switched to psychology in second year when biology was ruled out for teachables. Psychology through developmental and abnormal, with sociology, university biology, improvisation, and community drama alongside. Volunteered at the John McGivney Children's Centre. Three years completed; left during the pandemic.</p></div></div></section>
      <div class="footer"><span>Michael Bickford / Résumé</span><span>02 / 02</span></div>
    </article>
  </section>
</Layout>

<style is:global>
  @font-face { font-family: "InterResume"; src: url("/fonts/InterVariable.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
  .resume-shell { --resume-bg:#0a0a0a; --resume-ink:#f5f5f5; --resume-body:rgb(245 245 245/.74); --resume-muted:rgb(245 245 245/.58); --resume-quiet:rgb(245 245 245/.42); --resume-border:#242424; --resume-cyan:#3fd8d8; max-width:10.5in; margin:2rem auto 7rem; padding:0 1rem; color:var(--resume-ink); font:9.2pt/1.47 "InterResume",Inter,"Segoe UI",sans-serif; }
  /* min() so the 761-848px band cannot scroll sideways; print pins 8.5in */
  .resume-sheet { width:min(8.5in,100%); min-height:11in; overflow:hidden; margin:0 auto 1.5rem; padding:.46in .54in .42in; position:relative; background:radial-gradient(ellipse 78% 34% at 48% 0%,rgb(255 255 255/.022),transparent 62%),var(--resume-bg); box-shadow:0 1rem 3rem rgb(0 0 0/.28); }
  .resume-shell .eyebrow,.resume-shell .section-label,.resume-shell .tag,.resume-shell .footer,.resume-shell .runhead { font-family:"Cascadia Code",Consolas,monospace; }
  .resume-shell .eyebrow,.resume-shell .runhead { display:flex; justify-content:space-between; color:var(--resume-quiet); font-size:6.9pt; letter-spacing:.1em; text-transform:uppercase; }
  .resume-shell .hairline { height:1px; margin:11px 0 15px; background:linear-gradient(90deg,rgb(63 216 216/.5),rgb(118 80 220/.22) 42%,var(--resume-border) 78%); }
  .resume-shell h1 { margin:0; font-size:31pt; font-weight:760; letter-spacing:-.072em; line-height:.95; }
  .resume-shell .role,.resume-shell .head { display:flex; justify-content:space-between; gap:10px; align-items:baseline; }
  .resume-shell .role { margin-top:8px; gap:20px; }.resume-shell .role strong { font-size:11pt; font-weight:580; letter-spacing:-.02em; }.resume-shell .role span,.resume-shell .sub,.resume-shell .venue { color:var(--resume-muted); font-size:8.2pt; text-align:right; }
  .resume-shell .contact { display:flex; flex-wrap:wrap; gap:4px 15px; margin-top:11px; color:var(--resume-muted); font-size:8.1pt; }.resume-shell .contact b { color:var(--resume-ink); font-weight:540; }.resume-shell .contact a { color:inherit; text-decoration:none; }.resume-shell .contact a:hover { color:var(--resume-cyan); }.resume-shell .work-item a { color:inherit; text-decoration:underline; text-decoration-color:rgb(63 216 216/.45); text-underline-offset:2px; }.resume-shell .work-item a:hover { color:var(--resume-cyan); }
  .resume-shell .intro { margin:15px 0 0; max-width:6.9in; color:var(--resume-body); font-size:10pt; line-height:1.48; letter-spacing:-.01em; }.resume-shell .layout { display:grid; grid-template-columns:minmax(0,1fr) 1.82in; gap:26px; margin-top:15px; }.resume-shell .rail { padding-left:16px; position:relative; }.resume-shell .rail::before { content:""; position:absolute; left:0; top:2px; bottom:2px; width:1px; background:linear-gradient(rgb(63 216 216/.35),var(--resume-border) 30%); }
  .resume-shell .section-label { display:flex; align-items:center; gap:8px; margin:0 0 9px; color:var(--resume-quiet); font-size:6.9pt; letter-spacing:.1em; text-transform:uppercase; }.resume-shell .section-label::before { content:"›"; color:rgb(63 216 216/.75); }.resume-shell .section-label::after { content:""; height:1px; flex:1; background:var(--resume-border); }.resume-shell .section { margin-bottom:18px; }.resume-shell .work-item { padding-bottom:11px; margin-bottom:11px; border-bottom:1px solid var(--resume-border); }.resume-shell .work-item:last-child { margin-bottom:0; }.resume-shell .head h3 { margin:0; font-size:11.2pt; font-weight:630; letter-spacing:-.024em; }.resume-shell .tag { color:var(--resume-quiet); font-size:6.6pt; letter-spacing:.06em; text-transform:uppercase; white-space:nowrap; }.resume-shell .work-item p,.resume-shell .pub p,.resume-shell .detail-copy,.resume-shell .summary { margin:5px 0 0; color:var(--resume-body); }.resume-shell .points,.resume-shell .tight { margin:6px 0 0; padding:0; list-style:none; color:var(--resume-body); font-size:8.6pt; }.resume-shell .points li,.resume-shell .tight li { margin:3px 0; padding-left:15px; position:relative; }.resume-shell .points li::before { content:attr(data-n); position:absolute; left:0; color:rgb(63 216 216/.62); font:6.6pt "Cascadia Code",Consolas,monospace; padding-top:2.5px; }.resume-shell .tight li::before { content:"·"; position:absolute; left:0; color:rgb(63 216 216/.55); }.resume-shell .rail p { margin:0 0 8px; color:var(--resume-body); font-size:8.3pt; line-height:1.55; }.resume-shell .rail strong,.resume-shell .tight strong { color:var(--resume-ink); font-weight:560; }.resume-shell .rail section + section { margin-top:16px; }.resume-shell .tools { color:var(--resume-body); font-size:8.2pt; line-height:1.62; }.resume-shell .tools .grp { display:block; margin-bottom:6px; }.resume-shell .tools b,.resume-shell .portfolio-note strong { display:block; color:var(--resume-quiet); font:600 6.5pt "Cascadia Code",Consolas,monospace; letter-spacing:.09em; text-transform:uppercase; margin-bottom:2px; }.resume-shell .portfolio-note { margin-top:18px !important; padding-top:10px; border-top:1px solid var(--resume-border); }.resume-shell .pub h3,.resume-shell .detail-heading { margin:0; font-size:9.5pt; font-weight:620; }.resume-shell .detail-heading { margin-top:10px; }.resume-shell .detail-heading span { font-weight:420; color:var(--resume-muted); }.resume-shell .runhead { align-items:baseline; padding-bottom:9px; border-bottom:1px solid var(--resume-border); margin-bottom:15px; }.resume-shell .runhead b { color:var(--resume-muted); font-weight:600; }.resume-shell .two-col { display:grid; grid-template-columns:1fr 1fr; gap:20px; }.resume-shell .footer { position:absolute; left:.54in; right:.54in; bottom:.18in; display:flex; justify-content:space-between; border-top:1px solid var(--resume-border); padding-top:8px; color:var(--resume-quiet); font-size:6.4pt; letter-spacing:.06em; text-transform:uppercase; }
  .resume-actions { position:sticky; top:5rem; left:auto; right:auto; bottom:auto; transform:none; width:max-content; margin:.85rem auto 0; z-index:45; }
  .resume-actions .action-bar-content { gap:.5rem; }.resume-action { appearance:none; border:0; background:transparent; color:var(--color-text); font:600 var(--text-sm)/1 var(--font-body); letter-spacing:.02em; padding:.7rem .9rem; border-radius:.55rem; text-decoration:none; cursor:pointer; }.resume-action:hover,.resume-action:focus-visible { background:rgb(var(--color-text-rgb)/.1); outline:none; }
  @media (max-width: 760px) { .resume-shell { margin-top:1rem; padding:0 .35rem 6rem; }.resume-sheet { width:100%; min-height:0; padding:1.25rem 1rem 2.75rem; overflow:visible; }.resume-shell .layout,.resume-shell .two-col { grid-template-columns:1fr; }.resume-shell .rail { padding:1.25rem 0 0; }.resume-shell .rail::before { top:0; right:0; bottom:auto; width:auto; height:1px; background:var(--resume-border); }.resume-shell .footer { left:1rem; right:1rem; bottom:.75rem; }.resume-shell h1 { font-size:clamp(2rem,10vw,3.4rem); }.resume-shell .role,.resume-shell .head { align-items:flex-start; flex-direction:column; gap:.25rem; }.resume-shell .role span { text-align:left; }.resume-shell .contact { display:grid; gap:.35rem; }.resume-shell .tag { white-space:normal; }.resume-shell .section-label { font-size:6.4pt; } }
  @page { size:Letter; margin:0; }
  /* the downloadable /resume.pdf is this same page printed by a headless
     chromium in ci (scripts/render-resume-pdf.mjs), so the pdf can never drift
     from the page. the boring look lives here: white paper, near-black ink,
     one muted accent, and every piece of content the screen version carries,
     including the rail the old print styles used to drop. */
  @media print {
    html,body { background:#fff !important; }
    .site-header,.skip-link,.resume-actions,footer { display:none !important; }
    main#main { padding:0 !important; }
    .resume-shell { margin:0; padding:0; max-width:none; -webkit-print-color-adjust:exact; print-color-adjust:exact; --resume-bg:#fff; --resume-ink:#111; --resume-body:#2d2d2d; --resume-muted:#565656; --resume-quiet:#666; --resume-border:#c9c9c9; --resume-cyan:#176d6d; }
    /* fractionally under the letter page: two exact 11in boxes on 11in pages
       leave zero slack, and engine rounding then fragments a hairline of the
       second sheet onto a third pdf page. 10.95in cannot fragment. */
    .resume-sheet { width:8.5in; height:10.95in; min-height:10.95in; margin:0; box-shadow:none; background:#fff; break-after:page; page-break-after:always; }
    .resume-sheet:last-child { break-after:auto; page-break-after:auto; }
    /* print rhythm runs a little tighter than screen so both sheets keep real
       breathing room instead of fitting by four pixels */
    .resume-shell .section { margin-bottom:14px; }
    .resume-shell .work-item { padding-bottom:9px; margin-bottom:9px; }
    .resume-shell .intro { margin-top:10px; }
    .resume-shell .layout { margin-top:12px; }
    /* the screen accents are cyan at low alpha, which dissolves on paper */
    .resume-shell .section-label::before,.resume-shell .points li::before,.resume-shell .tight li::before { color:var(--resume-cyan); }
    .resume-shell .rail::before { background:var(--resume-border); }
    .resume-shell .hairline { background:var(--resume-border); }
    .resume-shell .contact a { color:inherit; }
    .resume-shell .work-item a { color:inherit; text-decoration-color:var(--resume-border); }
    /* the site-wide print rule expands every external href in parentheses,
       which is right for prose and wrong here: the visible text already is
       the url, and the expansion breaks urls mid-word */
    .resume-shell a[href^="http"]::after { content:none; }
    /* navigation copy, and the one rail block that runs into the footer */
    .resume-shell .portfolio-note { display:none; }
  }
</style>
