---
import Layout from "../layouts/Layout.astro";
import { contactPageContent, projectsPageContent } from "../config";
import { inquiryLabels } from "../utils/projects";

// every id ?project= will answer to, built from the same record the endeavours
// page renders. this used to be a hand-written object down in the inline script,
// which meant a new card produced a link that matched nothing and showed no
// banner, with no error anywhere to say so.
const labels = inquiryLabels(projectsPageContent.projects, projectsPageContent.artifacts ?? []);

// json in a non-executable script tag. the escape keeps a title containing
// "</script>" from ending the element early.
const labelsJson = JSON.stringify(labels).replace(/</g, "\\u003c");
---

<Layout seo={contactPageContent.seo}>
  <section class="mt-8 content-section">
    <h1 class="page-title">Contact</h1>
    <p class="opacity-60 mb-10">
      {contactPageContent.subtitle}
    </p>

    {/* one banner, whatever the visitor arrived carrying. the kind word and the
        subject both come from whichever branch below claims it, so a second
        arrival route can never render a second, differently-styled chip. */}
    <div class="project-context" hidden aria-live="polite">
      <span class="project-context-label" id="context-kind"></span>
      <span id="project-context-name"></span>
    </div>

    <div class="sent-message">
      <p>{contactPageContent.sentMessage}</p>
    </div>

    <form
      method="POST"
      class="flex flex-col gap-[var(--space-md)]"
      data-astro-reload
    >
      <!-- Honeypot fields -->
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        class="form-field-helper"
        aria-hidden="true"
      />
      <input
        type="text"
        name="phone"
        autocomplete="off"
        tabindex="-1"
        class="form-field-helper"
        aria-hidden="true"
      />

      <!-- Disable captcha for minimal friction -->
      <input type="hidden" name="_captcha" value="false" />

      <!-- Email subject for filtering -->
      <input type="hidden" name="_subject" value="New message from portfolio" />

      <!-- Redirect after submission -->
      <input
        type="hidden"
        name="_next"
        value={`${Astro.url.origin}/contact?sent`}
      />

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="name" class="form-label">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          placeholder={contactPageContent.placeholders.name}
          data-hey-placeholder={contactPageContent.heyPlaceholders.name}
          class="form-input"
        />
      </div>

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="email" class="form-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder={contactPageContent.placeholders.email}
          data-hey-placeholder={contactPageContent.heyPlaceholders.email}
          class="form-input"
        />
      </div>

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="message" class="form-label"
          >Message<span class="text-red-400">*</span></label
        >
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder={contactPageContent.placeholders.message}
          data-hey-placeholder={contactPageContent.heyPlaceholders.message}
          required
          class="form-input resize-y min-h-[8rem]"></textarea>
      </div>

      <button type="submit" class="form-submit mt-[var(--space-sm)]">
        Send Message
      </button>

      <noscript>
        <p class="text-[var(--text-sm)] opacity-50 mt-[var(--space-sm)]">
          JavaScript is required to send messages.
        </p>
      </noscript>
    </form>
  </section>
</Layout>

<script type="application/json" id="project-labels" set:html={labelsJson} is:inline />

<script is:inline data-astro-rerun>
  // Set data attrs before render
  (function () {
    var p = new URLSearchParams(location.search);
    if (p.has("hey")) {
      document.documentElement.dataset.hey = "";
      document
        .querySelectorAll("[data-hey-placeholder]")
        .forEach(function (el) {
          el.placeholder = el.dataset.heyPlaceholder || "";
        });
    }
    if (p.has("sent")) {
      document.documentElement.dataset.sent = "";
      history.replaceState({}, "", location.pathname);
    }
    var project = p.get("project");
    var labels = {};
    try {
      var labelsEl = document.getElementById("project-labels");
      if (labelsEl) labels = JSON.parse(labelsEl.textContent || "{}");
    } catch (e) {}
    // the single place any arrival route announces itself. kind + name light
    // the banner, and the subject line is derived from the same two strings,
    // so what the visitor is told and what lands in the inbox cannot drift.
    function announce(kind, name) {
      var banner = document.querySelector(".project-context");
      var kindEl = document.getElementById("context-kind");
      var nameEl = document.getElementById("project-context-name");
      if (banner && kindEl && nameEl) {
        kindEl.textContent = kind;
        nameEl.textContent = name;
        banner.removeAttribute("hidden");
      }
      var subjectEl = document.querySelector('input[name="_subject"]');
      if (subjectEl) subjectEl.value = kind.charAt(0).toUpperCase() + kind.slice(1) + ": " + name;
    }

    var label = project ? labels[project] : null;
    if (label) {
      announce("inquiry", label);
      var messageEl = document.getElementById("message");
      if (messageEl) messageEl.placeholder = "what brings you to " + label + "?";
    }
    if (p.has("brief")) {
      var brief = "";
      var briefSource = "the portfolio";
      try {
        brief = sessionStorage.getItem("freelance-brief") || "";
        briefSource = sessionStorage.getItem("freelance-brief-source") || briefSource;
        sessionStorage.removeItem("freelance-brief");
        sessionStorage.removeItem("freelance-brief-source");
      } catch (e) {}
      var briefMessageEl = document.getElementById("message");
      if (brief && briefMessageEl instanceof HTMLTextAreaElement) {
        briefMessageEl.value = brief;
        announce("brief", briefSource);
        // the message is already written. what is still missing is a way to
        // reply, so the cursor goes to the gap rather than back to the answer.
        var emailEl = document.getElementById("email");
        if (emailEl instanceof HTMLInputElement) emailEl.focus();
        // this visitor demonstrably typed a sentence on the previous page. the
        // spam gate below counts interaction from page load, and without this
        // it would silently swallow their first send.
        document.documentElement.dataset.briefCarried = "";
      }
      history.replaceState({}, "", location.pathname);
    }
    document.documentElement.dataset.ready = "";
  })();
</script>

<script>
  // Anti-spam
  const MIN_TIME_MS = 5000;
  const loadTime = Date.now();
  // arriving with a brief already means a sentence was typed and a button was
  // pressed on the page before this one. the gate is meant to catch a bot that
  // posts on load, not to make a human retype their own words.
  const carriedBrief = "briefCarried" in document.documentElement.dataset;
  let interacted = carriedBrief;
  const ctrl = new AbortController();

  const onInteract = () => {
    interacted = true;
    ctrl.abort();
  };
  ["mousemove", "keydown", "touchstart", "click"].forEach((e) =>
    document.addEventListener(e, onInteract, { signal: ctrl.signal }),
  );

  const form = document.querySelector("form");
  if (form instanceof HTMLFormElement) {
    form.action = "https://formsubmit.co/841f620dfbfbfdae899508762dca523e";

    form.addEventListener("submit", (e) => {
      const hp1 = document.querySelector('input[name="website"]');
      const hp2 = document.querySelector('input[name="phone"]');
      const hp1Value = hp1 instanceof HTMLInputElement ? hp1.value : "";
      const hp2Value = hp2 instanceof HTMLInputElement ? hp2.value : "";
      const elapsed = Date.now() - loadTime;

      // Block spam
      if (
        hp1Value ||
        hp2Value ||
        (elapsed < MIN_TIME_MS && !carriedBrief) ||
        !interacted ||
        navigator.webdriver
      ) {
        e.preventDefault();
        return;
      }

      // Remove honeypots before submit
      document
        .querySelectorAll('input[name="website"], input[name="phone"]')
        .forEach((el) => el.remove());
    });
  }
</script>

<style>
  /* Hidden: offscreen (bots detect display:none) */
  .form-field-helper {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  /* Arrival banner: shown when /contact is reached carrying context, either a
     project inquiry (?project=) or a freelance brief (?brief). */
  .project-context {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: var(--space-lg);
    padding: 0.45rem 0.85rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-left: 2px solid rgb(var(--chromatic-cyan) / 0.55);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.7);
  }

  /* Honor the `hidden` attribute despite the display override above. */
  .project-context[hidden] {
    display: none;
  }

  .project-context-label {
    font-size: calc(var(--text-sm) * 0.78);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* Sent confirmation - hidden until ?sent */
  .sent-message {
    display: none;
    margin-bottom: var(--space-xl);
    padding-left: var(--space-md);
    position: relative;
  }

  :global(html[data-sent]) .sent-message {
    display: block;
  }

  /* Chromatic line - single element with box-shadow for both colors */
  .sent-message::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--ring-accent-strong);
    box-shadow: -1px 0 0 rgb(var(--chromatic-red) / 0.7);
    transform-origin: top;
    will-change: transform;
    /* Soft deliberate drop instead of a spring */
    animation: lineDown 0.8s var(--ease-out) both !important;
  }

  .sent-message p {
    will-change: transform, opacity;
    /* Gentle dissolve instead of an aggressive slide */
    animation: textReveal 0.8s var(--ease-out) 0.3s both !important;
  }

  @keyframes lineDown {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes textReveal {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
    to {
      opacity: 0.7;
      transform: translateX(0);
    }
  }

  /* field labels speak in the same register as the freelance brief kicker, so
     the two ends of the brief flow read as one instrument. */
  .form-label {
    font-family: var(--font-mono);
    font-size: calc(var(--text-sm) * 0.82);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-text-rgb) / 0.55);
  }

  /* the field surface. a quiet hairline box carrying the site's chromatic seam,
     the red hairline beside a cyan rule that already marks the sent confirmation
     and the brief section. it rests as a short tick at the top left and extends
     to the full field height on focus, which keeps focus unmistakable without
     spending any shadow at all. the seam is drawn as two background gradients
     because an input cannot host a pseudo-element. */
  .form-input {
    background: transparent;
    border: 0;
    border-top: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-bottom: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: 0;
    padding: var(--space-sm) 0;
    font-size: var(--text-base);
    color: var(--color-text);
    min-height: var(--touch-target);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .form-input:hover {
    border-bottom-color: rgb(var(--color-text-rgb) / 0.28);
  }

  .form-input:focus {
    outline: none;
    /* the layout-level focus ring composites a soft bloom onto anything
       focused. the rule under the text carries focus here instead. */
    box-shadow: none;
    border-bottom-color: rgb(var(--color-text-rgb) / 0.55);
  }

  /* Input-specific */
  .form-input::placeholder {
    color: var(--color-text);
    opacity: 0.5;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .form-input:hover::placeholder {
    opacity: 0.6;
  }
  :global(html[data-hey]:not([data-ready])) .form-input::placeholder {
    opacity: 0;
  }

  /* the submit borrows the label register rather than the field surface. it is
     an action, so it wears no seam of its own until it is pointed at. */
  .form-submit {
    cursor: pointer;
    min-height: var(--touch-target);
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: 1px solid rgb(var(--color-text-rgb) / 0.18);
    border-radius: var(--radius-sm);
    color: rgb(var(--color-text-rgb) / 0.85);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background-color var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
  }
  .form-submit:hover {
    background: rgb(var(--color-text-rgb) / 0.045);
    border-color: rgb(var(--color-text-rgb) / 0.35);
    color: var(--color-text);
    /* the layout-level hover fringe on buttons reads as bleed on this much
       uppercase mono, so the border and fill carry the hover instead. */
    text-shadow: none;
  }
  .form-submit:focus-visible {
    outline: 2px solid rgb(var(--chromatic-cyan) / 0.6);
    outline-offset: 2px;
    /* keep the layout-level bloom off the action too */
    box-shadow: none;
    color: var(--color-text);
  }
  .form-submit:active {
    /* minimal physical push so it feels heavy */
    transform: scale(0.99);
    opacity: var(--opacity-muted);
  }
</style>
