---
import Layout from "../layouts/Layout.astro";
import { contactPageContent } from "../config";
---

<Layout seo={contactPageContent.seo}>
  <section class="mt-8 content-section">
    <h1 class="page-title">Contact</h1>
    <p class="opacity-60 mb-10">
      {contactPageContent.subtitle}
    </p>

    <div class="sent-message">
      <p>{contactPageContent.sentMessage}</p>
    </div>

    <form
      method="POST"
      class="flex flex-col gap-[var(--space-md)]"
      data-astro-reload
    >
      <!-- Honeypot fields -->
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        class="form-field-helper"
        aria-hidden="true"
      />
      <input
        type="text"
        name="phone"
        autocomplete="off"
        tabindex="-1"
        class="form-field-helper"
        aria-hidden="true"
      />

      <!-- Disable captcha for minimal friction -->
      <input type="hidden" name="_captcha" value="false" />

      <!-- Email subject for filtering -->
      <input type="hidden" name="_subject" value="New message from portfolio" />

      <!-- Redirect after submission -->
      <input type="hidden" name="_next" value={`${Astro.url.origin}/contact?sent`} />

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="name" class="text-[var(--text-sm)] opacity-70">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          placeholder={contactPageContent.placeholders.name}
          data-hey-placeholder={contactPageContent.heyPlaceholders.name}
          class="form-input"
        />
      </div>

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="email" class="text-[var(--text-sm)] opacity-70">Email</label
        >
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder={contactPageContent.placeholders.email}
          data-hey-placeholder={contactPageContent.heyPlaceholders.email}
          class="form-input"
        />
      </div>

      <div class="flex flex-col gap-[var(--space-xs)]">
        <label for="message" class="text-[var(--text-sm)] opacity-70"
          >Message<span class="text-red-400">*</span></label
        >
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder={contactPageContent.placeholders.message}
          data-hey-placeholder={contactPageContent.heyPlaceholders.message}
          required
          class="form-input resize-y min-h-[8rem]"></textarea>
      </div>

      <button type="submit" class="form-submit mt-[var(--space-sm)]">
        Send Message
      </button>

      <noscript>
        <p class="text-[var(--text-sm)] opacity-50 mt-[var(--space-sm)]">
          JavaScript is required to send messages.
        </p>
      </noscript>
    </form>
  </section>
</Layout>

<script is:inline data-astro-rerun>
  // Set data attrs before render
  (function() {
    var p = new URLSearchParams(location.search);
    if (p.has('hey')) {
      document.documentElement.dataset.hey = '';
      document.querySelectorAll('[data-hey-placeholder]').forEach(function(el) {
        el.placeholder = el.dataset.heyPlaceholder || '';
      });
    }
    if (p.has('sent')) {
      document.documentElement.dataset.sent = '';
      history.replaceState({}, '', location.pathname);
    }
    document.documentElement.dataset.ready = '';
  })();
</script>

<script>

  // Anti-spam
  const MIN_TIME_MS = 5000;
  const loadTime = Date.now();
  let interacted = false;
  const ctrl = new AbortController();

  const onInteract = () => { interacted = true; ctrl.abort(); };
  ['mousemove', 'keydown', 'touchstart', 'click'].forEach(e =>
    document.addEventListener(e, onInteract, { signal: ctrl.signal })
  );

  const form = document.querySelector('form');
  if (form instanceof HTMLFormElement) {
    form.action = 'https://formsubmit.co/841f620dfbfbfdae899508762dca523e';

    form.addEventListener('submit', (e) => {
      const hp1 = document.querySelector('input[name="website"]');
      const hp2 = document.querySelector('input[name="phone"]');
      const hp1Value = hp1 instanceof HTMLInputElement ? hp1.value : '';
      const hp2Value = hp2 instanceof HTMLInputElement ? hp2.value : '';
      const elapsed = Date.now() - loadTime;

      // Block spam
      if (hp1Value || hp2Value || elapsed < MIN_TIME_MS || !interacted || navigator.webdriver) {
        e.preventDefault();
        return;
      }

      // Remove honeypots before submit
      document.querySelectorAll('input[name="website"], input[name="phone"]').forEach(el => el.remove());
    });
  }
</script>

<style>
  /* Hidden: offscreen (bots detect display:none) */
  .form-field-helper {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  /* Sent confirmation - hidden until ?sent */
  .sent-message {
    display: none;
    margin-bottom: var(--space-xl);
    padding-left: var(--space-md);
    position: relative;
  }

  :global(html[data-sent]) .sent-message {
    display: block;
  }

  /* Chromatic line - single element with box-shadow for both colors */
  .sent-message::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--ring-accent-strong);
    box-shadow: -1px 0 0 rgb(var(--chromatic-red) / 0.7);
    transform-origin: top;
    will-change: transform;
    animation: lineDown 0.6s var(--ease-spring) both !important;
  }

  .sent-message p {
    will-change: transform, opacity;
    animation: textReveal 0.5s var(--ease-spring) 0.5s both !important;
  }

  @keyframes lineDown {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes textReveal {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 0.7;
      transform: translateX(0);
    }
  }

  /* Shared form control base */
  .form-input, .form-submit {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-base);
    color: var(--color-text);
    min-height: var(--touch-target);
    box-shadow: var(--depth-inset);
    transition: box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  .form-input:hover, .form-submit:hover {
    border-color: rgb(var(--color-text-rgb) / 0.2);
    box-shadow: var(--depth-inset), var(--chromatic-shadow);
  }

  .form-input:focus, .form-submit:focus-visible {
    outline: none;
    border-color: rgb(var(--color-text-rgb) / 0.3);
    box-shadow: var(--depth-inset), var(--glow-soft), var(--chromatic-shadow-lg);
  }

  /* Input-specific */
  .form-input::placeholder {
    color: var(--color-text);
    opacity: 0.5;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .form-input:hover::placeholder { opacity: 0.6; }
  :global(html[data-hey]:not([data-ready])) .form-input::placeholder { opacity: 0; }

  /* Button-specific */
  .form-submit {
    cursor: pointer;
    transition: box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                background var(--duration-normal) var(--ease-out),
                text-shadow var(--duration-normal) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .form-submit:hover {
    background: rgb(var(--color-text-rgb) / 0.03);
    text-shadow: var(--chromatic-text-shadow);
  }
  .form-submit:active {
    transform: scale(var(--scale-active));
    opacity: var(--opacity-muted);
  }
</style>
