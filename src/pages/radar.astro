---
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "Radar | woflo",
  description:
    "Local signal detection. Distance estimated by signal strength and smoothed with a Kalman filter. Contacts inferred from network routing. All client-side, nothing leaves your device.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div class="radar-page">
    <!-- ── Header ─────────────────────────────────────────────── -->
    <section
      class="mt-8 content-section radar-intro radar-reveal"
      style="--reveal-delay: 0ms"
    >
      <h1 class="page-title radar-title" id="radar-title">Radar</h1>
      <p class="radar-tagline">local signal detection</p>
    </section>

    <!-- ── Merged Telemetry Bar (status + sensors combined) ────── -->
    <section
      class="mt-[var(--space-sm)] content-section radar-reveal"
      style="--reveal-delay: 60ms"
    >
      <div class="radar-telemetry surface-raised">
        <div class="telemetry-group telemetry-group--status">
          <div class="status-item">
            <span class="status-label">mode</span>
            <span class="status-value" id="radar-mode">idle</span>
          </div>
          <div class="status-item">
            <span class="status-label">bluetooth</span>
            <span class="status-value" id="radar-bluetooth">unknown</span>
          </div>
          <div class="status-item">
            <span class="status-label">model</span>
            <span class="status-value" id="radar-model">--</span>
          </div>
        </div>
        <div class="telemetry-divider" aria-hidden="true"></div>
        <div class="telemetry-group telemetry-group--sensors">
          <div class="status-item">
            <span class="status-label">position</span>
            <span class="status-value tabular-nums" id="radar-self-loc"
              >no fix</span
            >
          </div>
          <div class="status-item">
            <span class="status-label">heading</span>
            <span class="status-value tabular-nums" id="radar-compass">--</span>
          </div>
          <div class="status-item">
            <span class="status-label">ambient</span>
            <span class="status-value tabular-nums" id="radar-ambient">--</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Hero Canvas ────────────────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] radar-canvas-section radar-reveal"
      style="--reveal-delay: 120ms"
    >
      <div class="radar-scope-wrap surface-raised">
        <canvas
          id="radar-canvas"
          class="radar-canvas"
          aria-label="Signal map"
          role="img"></canvas>
      </div>
    </section>

    <!-- ── Stat Readout Strip ─────────────────────────────────── -->
    <section
      class="mt-[var(--space-xs)] content-section radar-reveal"
      style="--reveal-delay: 180ms"
    >
      <div class="radar-readout-strip">
        <!-- Signal counts -->
        <div class="readout-group readout-group--signals">
          <div class="stat-chip stat-chip--primary">
            <span class="stat-number tabular-nums" id="radar-total">0</span>
            <span class="stat-label">total</span>
          </div>
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-bt-count">0</span>
            <span class="stat-label">bt</span>
          </div>
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-wifi-count">0</span
            >
            <span class="stat-label">wifi</span>
          </div>
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-radio-count"
              >0</span
            >
            <span class="stat-label">radio</span>
          </div>
        </div>

        <!-- Evidence breakdown -->
        <div class="readout-group readout-group--evidence">
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-active">0</span>
            <span class="stat-label">active</span>
          </div>
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-measured">0</span>
            <span class="stat-label">measured</span>
          </div>
          <div class="stat-chip">
            <span class="stat-number tabular-nums" id="radar-inferred">0</span>
            <span class="stat-label">inferred</span>
          </div>
        </div>

        <!-- Proximity -->
        <div class="readout-group readout-group--proximity">
          <div class="stat-chip stat-chip--accent">
            <span class="stat-number tabular-nums" id="radar-nearest">--</span>
            <span class="stat-label">nearest</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Triage ─────────────────────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] content-section radar-reveal"
      style="--reveal-delay: 240ms"
    >
      <div class="radar-triage surface-raised">
        <h2 class="feed-title">triage</h2>
        <p class="feed-hint">filter and rank local contacts</p>
        <div class="triage-grid">
          <label class="triage-field" for="radar-triage-protocol">
            <span class="triage-field-label">protocol</span>
            <select id="radar-triage-protocol" class="triage-select">
              <option value="all">all</option>
              <option value="bluetooth">bluetooth</option>
              <option value="wifi">wifi/net</option>
              <option value="radio">radio</option>
            </select>
          </label>

          <label class="triage-field" for="radar-triage-evidence">
            <span class="triage-field-label">evidence</span>
            <select id="radar-triage-evidence" class="triage-select">
              <option value="all">all</option>
              <option value="measured">measured</option>
              <option value="inferred">inferred</option>
            </select>
          </label>

          <label class="triage-field" for="radar-triage-state">
            <span class="triage-field-label">state</span>
            <select id="radar-triage-state" class="triage-select">
              <option value="all">all</option>
              <option value="new">new</option>
              <option value="acquiring">acquiring</option>
              <option value="stable">stable</option>
              <option value="degrading">degrading</option>
              <option value="lost">lost</option>
            </select>
          </label>

          <label class="triage-field" for="radar-triage-sort">
            <span class="triage-field-label">sort</span>
            <select id="radar-triage-sort" class="triage-select">
              <option value="priority">priority</option>
              <option value="nearest">nearest</option>
              <option value="confidence">confidence</option>
              <option value="recent">recent</option>
            </select>
          </label>

          <label
            class="triage-field triage-field-wide"
            for="radar-triage-min-confidence"
          >
            <span class="triage-field-label"
              >min confidence <span
                id="radar-triage-min-confidence-value"
                class="triage-output">0%</span
              ></span
            >
            <input
              id="radar-triage-min-confidence"
              class="triage-range"
              type="range"
              min="0"
              max="95"
              step="5"
              value="0"
            />
          </label>

          <label class="triage-toggle" for="radar-triage-active-only">
            <input id="radar-triage-active-only" type="checkbox" />
            <span>active only</span>
          </label>
        </div>
      </div>
    </section>

    <!-- ── All Feeds (fluid grid) ─────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] radar-feeds-section radar-reveal"
      style="--reveal-delay: 300ms"
    >
      <div class="radar-feeds-fluid">
        <div class="radar-feed radar-feed--contacts surface-raised">
          <h2 class="feed-title">contacts</h2>
          <p class="feed-hint">local inspectable actors</p>
          <ul
            id="radar-contacts"
            class="feed-list feed-list-contacts"
            aria-live="polite"
          >
          </ul>
        </div>
        <div class="radar-feed surface-raised">
          <h2 class="feed-title">lock</h2>
          <p class="feed-hint">
            target lock with derived range, bearing, and trend
          </p>
          <ul
            id="radar-lock"
            class="feed-list feed-list-lock"
            aria-live="polite"
          >
          </ul>
        </div>
        <div class="radar-feed surface-raised">
          <h2 class="feed-title">events</h2>
          <ul
            id="radar-events"
            class="feed-list feed-list-events"
            aria-live="polite"
          >
          </ul>
        </div>
        <div class="radar-feed surface-raised">
          <h2 class="feed-title">capabilities</h2>
          <ul
            id="radar-capabilities"
            class="feed-list feed-list-capabilities"
            aria-live="polite"
          >
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Model Note ─────────────────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] mb-[var(--space-xl)] content-section radar-reveal"
      style="--reveal-delay: 420ms"
    >
      <p class="model-note">
        fully client-side. measured range comes from log-distance path loss with
        Kalman-filtered RSSI and online variance tracking. lock telemetry uses
        derived rate from the same local signals. inferred contacts are network
        and route hints, not literal nearby people.
      </p>
    </section>

    <!-- ── Action Bar ─────────────────────────────────────────── -->
    <div class="radar-actions" role="group" aria-label="Radar controls">
      <button class="action-btn" id="radar-start" type="button">Load</button>
      <button class="action-btn" id="radar-stop" type="button">Stop</button>
      <button class="action-btn" id="radar-bt-scan" type="button"
        >BT LE Scan</button
      >
      <button class="action-btn" id="radar-bt-pick" type="button"
        >BT Pair</button
      >
      <button class="action-btn" id="radar-clear" type="button">Clear</button>
    </div>
  </div>

  <script>
    import { initRadar, resolveRadarUIOptions } from "../scripts/radar-ui";

    const RADAR_LIFECYCLE_KEY = "__radarLifecycle";
    type RadarLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };
    let cleanupRadar: (() => void) | null = null;
    const radarWindow = window as unknown as Record<
      string,
      RadarLifecycle | undefined
    >;

    function boot() {
      teardown();
      const radarOptions = resolveRadarUIOptions(document);
      if (radarOptions) cleanupRadar = initRadar(radarOptions);
    }

    function teardown() {
      cleanupRadar?.();
      cleanupRadar = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
      detachLifecycle();
      const current = radarWindow[RADAR_LIFECYCLE_KEY];
      if (current?.boot === boot) delete radarWindow[RADAR_LIFECYCLE_KEY];
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = radarWindow[RADAR_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) prev.detach();
      else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", prev.teardown);
      }
      prev.teardown?.();
    }

    radarWindow[RADAR_LIFECYCLE_KEY] = {
      boot,
      teardown,
      detach: detachLifecycle,
    };

    boot();
    attachLifecycle();
  </script>
</Layout>

<style>
  /* ── Page Shell ─────────────────────────────────────────────── */

  .radar-page {
    --radar-radius: var(--radius-lg);
    --radar-muted: rgb(var(--color-text-rgb) / 0.58);
    --radar-faint: rgb(var(--color-text-rgb) / 0.3);
    --radar-edge: rgb(var(--color-text-rgb) / 0.14);
    --radar-action-offset: calc(var(--touch-target) + (var(--space-sm) * 2));
    padding-bottom: calc(var(--radar-action-offset) + var(--space-lg));
  }

  /* ── Staggered reveal animation ──────────────────────────────── */

  @keyframes radar-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .radar-reveal {
    animation: radar-fade-up 0.4s var(--ease-out) both;
    animation-delay: var(--reveal-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-reveal {
      animation: none;
    }
  }

  /* ── Header ─────────────────────────────────────────────────── */

  .radar-intro {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

  .radar-title {
    margin: 0;
    line-height: 1.03;
    letter-spacing: -0.018em;
  }

  .radar-tagline {
    margin: 0;
    color: var(--radar-muted);
  }

  /* ── Merged Telemetry Bar ────────────────────────────────────── */

  .radar-telemetry {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border: 1px solid var(--radar-edge);
    border-left: 2px solid rgb(var(--chromatic-cyan) / 0.25);
    border-radius: var(--radar-radius);
    padding: var(--space-sm);
    overflow: hidden;
  }

  .telemetry-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(var(--space-xs) * 0.8);
    flex: 1;
  }

  .telemetry-divider {
    width: 100%;
    height: 1px;
    background: var(--radar-edge);
    flex-shrink: 0;
  }

  .status-item,
  .stat-chip {
    display: grid;
    gap: 0.15rem;
    justify-items: center;
    text-align: center;
  }

  .status-label,
  .stat-label,
  .model-note {
    font-size: var(--text-sm);
    color: var(--radar-muted);
  }

  .status-value {
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: var(--text-sm);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .stat-number {
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: var(--text-sm);
  }

  .status-value[data-bt="no-api"],
  .status-value[data-bt="unavailable"] {
    color: var(--radar-muted);
    font-weight: 400;
  }

  .status-value[data-bt="scanning"] {
    color: rgb(var(--chromatic-cyan));
  }

  .status-value[data-bt="blocked"] {
    color: rgb(var(--chromatic-red));
  }

  /* ── Hero Canvas ─────────────────────────────────────────────── */

  /* Canvas section breaks out slightly wider than content-width */
  .radar-canvas-section {
    width: 100%;
    max-width: calc(var(--content-width) + 4rem);
    margin-inline: auto;
    padding-inline: max(
      clamp(1rem, 4vw, 1.5rem),
      env(safe-area-inset-left),
      env(safe-area-inset-right)
    );
  }

  .radar-scope-wrap {
    border: 1px solid var(--radar-edge);
    border-radius: var(--radar-radius);
    padding: var(--space-sm);
    box-shadow:
      var(--edge-highlight),
      0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .radar-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: calc(var(--radar-radius) - var(--radius-xs));
    background: rgb(var(--color-text-rgb) / 0.015);
    cursor: default;
    touch-action: manipulation;
  }

  /* ── Borderless Stat Readout Strip ───────────────────────────── */

  .radar-readout-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: calc(var(--space-xs) * 0.5);
    padding: calc(var(--space-xs) * 0.6) 0;
  }

  .readout-group {
    display: flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.15);
    background: rgb(var(--color-text-rgb) / 0.03);
    border: 1px solid rgb(var(--color-text-rgb) / 0.06);
    border-radius: var(--radius-lg);
    padding: calc(var(--space-xs) * 0.15);
  }

  .radar-readout-strip .stat-chip {
    display: flex;
    flex-direction: row;
    gap: 0.3em;
    align-items: baseline;
    text-align: left;
    padding: calc(var(--space-xs) * 0.3) calc(var(--space-xs) * 0.65);
    border-radius: calc(var(--radius-lg) - 2px);
    transition: background var(--duration-normal) var(--ease-out);
    white-space: nowrap;
  }

  /* stat-chip hover only on pointer devices */
  @media (hover: hover) {
    .radar-readout-strip .stat-chip:hover {
      background: rgb(var(--color-text-rgb) / 0.05);
    }
  }

  .radar-readout-strip .stat-number {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .radar-readout-strip .stat-label {
    font-size: calc(var(--text-sm) * 0.85);
    color: var(--radar-faint);
    letter-spacing: 0.03em;
  }

  /* Primary stat: total count gets accent color */
  .stat-chip--primary .stat-number {
    color: rgb(var(--chromatic-cyan));
  }

  /* Accent stat: nearest gets a stronger pill */
  .readout-group--proximity {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border-color: rgb(var(--chromatic-cyan) / 0.14);
  }

  .stat-chip--accent .stat-number {
    color: rgb(var(--chromatic-cyan));
  }

  .stat-chip--accent .stat-label {
    color: rgb(var(--chromatic-cyan) / 0.6);
  }

  /* ── Fluid Feed Grid ─────────────────────────────────────────── */

  .radar-feeds-section {
    width: 100%;
    max-width: calc(var(--content-width) + 4rem);
    margin-inline: auto;
    padding-inline: max(
      clamp(1rem, 4vw, 1.5rem),
      env(safe-area-inset-left),
      env(safe-area-inset-right)
    );
  }

  .radar-feeds-fluid {
    columns: 2 18rem;
    column-gap: var(--space-sm);
  }

  .radar-feeds-fluid > * {
    break-inside: avoid;
    margin-bottom: var(--space-sm);
  }

  /* prevent trailing margin on the last item in each column */
  .radar-feeds-fluid > :last-child {
    margin-bottom: 0;
  }

  .radar-feed {
    border: 1px solid var(--radar-edge);
    border-radius: var(--radar-radius);
    padding: var(--space-sm);
    min-width: 0;
  }

  /* ── Triage ──────────────────────────────────────────────────── */

  .radar-triage {
    border: 1px solid var(--radar-edge);
    border-radius: var(--radar-radius);
    padding: var(--space-sm);
    display: grid;
    gap: calc(var(--space-xs) * 0.75);
  }

  .triage-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(var(--space-xs) * 0.7);
    align-items: end;
  }

  .triage-field {
    display: grid;
    gap: 0.3rem;
  }

  .triage-field-wide {
    grid-column: span 2;
  }

  .triage-field-label {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--radar-muted);
    text-transform: lowercase;
  }

  .triage-output {
    font-family: monospace;
    font-size: calc(var(--text-sm) * 0.95);
    color: rgb(var(--chromatic-cyan) / 0.9);
  }

  .triage-select,
  .triage-range {
    width: 100%;
  }

  .triage-select {
    background: rgb(var(--color-text-rgb) / 0.025);
    border: 1px solid rgb(var(--color-text-rgb) / 0.16);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    min-height: calc(var(--touch-target) * 0.8);
    padding: calc(var(--space-xs) * 0.55) calc(var(--space-xs) * 0.72);
    font: inherit;
    line-height: 1.2;
    appearance: none;
    -webkit-appearance: none;
  }

  .triage-select:focus-visible,
  .triage-range:focus-visible,
  .triage-toggle:focus-within {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.42);
    outline-offset: 1px;
  }

  .triage-range {
    accent-color: rgb(var(--chromatic-cyan));
    min-height: calc(var(--touch-target) * 0.6);
  }

  .triage-toggle {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.45);
    min-height: calc(var(--touch-target) * 0.8);
    border: 1px solid rgb(var(--color-text-rgb) / 0.16);
    border-radius: var(--radius-sm);
    padding: calc(var(--space-xs) * 0.55) calc(var(--space-xs) * 0.7);
    background: rgb(var(--color-text-rgb) / 0.025);
    color: var(--radar-muted);
    cursor: pointer;
    user-select: none;
  }

  .triage-toggle input[type="checkbox"] {
    accent-color: rgb(var(--chromatic-cyan));
    width: 0.95rem;
    height: 0.95rem;
  }

  /* ── Feed Titles & Lists ─────────────────────────────────────── */

  .feed-title {
    margin: 0 0 calc(var(--space-xs) * 0.5);
    font-size: var(--text-base);
    letter-spacing: 0.02em;
  }

  .feed-hint {
    margin: 0 0 calc(var(--space-xs) * 0.5);
    font-size: var(--text-sm);
    color: var(--radar-faint);
  }

  .feed-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
    max-height: 20rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .feed-list-events {
    max-height: 12rem;
  }

  .feed-list-capabilities {
    max-height: none;
  }

  .feed-list-contacts {
    max-height: 32rem;
  }

  .feed-list-lock {
    max-height: none;
  }

  .feed-list-lock :global(li) {
    font-family: monospace;
    line-height: 1.45;
  }

  .feed-list-lock :global(li strong) {
    font-family: var(--font-body);
  }

  .feed-list :global(li) {
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-sm);
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-xs) * 0.8);
    background: rgb(var(--color-text-rgb) / 0.02);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .feed-list-contacts :global(li) {
    cursor: pointer;
    touch-action: manipulation;
  }

  .feed-list-contacts :global(li.contact-selected) {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
