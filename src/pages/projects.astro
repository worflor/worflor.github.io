---
import Layout from "../layouts/Layout.astro";
import { projectsPageContent } from "../config";
import ProjectCard from "../components/ProjectCard.astro";
import { getLoadingPriority } from "../utils/helpers";
---

<Layout seo={projectsPageContent.seo}>
  <section class="mt-8 content-section">
    <h1 class="page-title">Projects</h1>
    <p class="opacity-60 mb-10">{projectsPageContent.subtitle}</p>
    <div class="grid grid-cols-1 group">
      {
        projectsPageContent.projects.map((project, index) => (
          <ProjectCard {...project} loading={getLoadingPriority(index)} />
        ))
      }
    </div>
  </section>
</Layout>
