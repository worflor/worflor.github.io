---
import Layout from "../layouts/Layout.astro";
import { projectsPageContent } from "../config";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { getLoadingPriority } from "../utils/helpers";
import { groupOf, resolveGates } from "../utils/projects";

const publications = projectsPageContent.publications ?? [];

const allProjects = await resolveGates(projectsPageContent.projects);

const shippedProjects = allProjects.filter((p) => groupOf(p) === "shipped" && p.status !== "coming-soon");
const developmentProjects = allProjects.filter((p) =>
  (groupOf(p) === "private" || p.status === "coming-soon") && p.status !== "active-research"
);
const researchProjects = allProjects.filter((p) => p.status === "active-research");
---

<Layout seo={projectsPageContent.seo}>
  <section class="mt-8 projects-page">
    <h1 class="page-title">Endeavours</h1>
    <p class="opacity-60 mb-10">{projectsPageContent.subtitle}</p>

    <div class="projects-main">
      <section aria-labelledby="shipped-heading">
        <div class="section-header">
          <h2 id="shipped-heading" class="section-title">Public work</h2>
        </div>
        <div class="grid grid-cols-1 group">
          {shippedProjects.map((project, index) => (
            <ProjectCard
              {...project}
              description={project.slug === "neuron"
                ? project.description + " The colour picker previews palette suggestions from Luma-T, a small model I trained."
                : project.description}
              loading={getLoadingPriority(index)}
              index={index}
            />
          ))}
        </div>
      </section>

      {developmentProjects.length > 0 && (
        <section aria-labelledby="development-heading">
          <div class="section-header">
            <h2 id="development-heading" class="section-title">In development</h2>
          </div>
          <div class="grid grid-cols-1 group">
            {developmentProjects.map((project, index) => (
              <ProjectCard {...project} index={index} />
            ))}
          </div>
        </section>
      )}

      {(researchProjects.length > 0 || publications.length > 0) && (
        <section aria-labelledby="research-heading">
          <div class="section-header">
            <h2 id="research-heading" class="section-title">Research</h2>
            <p class="section-subtitle">A few things I made to see what would happen.</p>
          </div>
          <div class="grid grid-cols-1 gap-[var(--space-sm)]">
            {publications.map((pub, index) => <PublicationCard {...pub} index={index} />)}
            {researchProjects.map((project, index) => (
              <div>
                <ProjectCard {...project} variant="compact" index={publications.length + index} />
                {project.slug === "engram" && (
                  <a class="research-link" href="https://woflo.itch.io/all-you-mean-to-me">Play <em>all you mean to me</em> on itch.io</a>
                )}
                {project.slug === "scryer" && (
                  <a id="scryer-access" class="research-link" href="/scryer/#use">Scryer MCP setup and access tokens</a>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>

<style>
  .projects-page {
    width: 100%;
    max-width: 58rem;
    margin-inline: auto;
    padding-inline: max(clamp(1rem, 4vw, 1.5rem), env(safe-area-inset-left), env(safe-area-inset-right));
    container-type: inline-size;
  }

  .projects-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .section-header {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgb(var(--color-text-rgb) / 0.08);
  }

  .section-title {
    font-size: calc(var(--text-sm) * 0.85);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 0;
  }

  .research-link {
    display: inline-block;
    margin: 0.35rem 0.9rem;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    scroll-margin-top: 8rem;
  }

  .section-subtitle {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    opacity: 0.4;
    line-height: 1.45;
  }
</style>
