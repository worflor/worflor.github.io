---
import Layout from "../layouts/Layout.astro";
import { featureFlags } from "../config/features";

if (!featureFlags.cageEnabled) {
  return Astro.redirect("/");
}

const seo = {
  title: "Cage | woflo",
  description:
    "Behavioral interrogation sandbox for intent discovery. Local-only triage with live threat logging and verdict scoring.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div class="cage-page" id="cage-page">
    <section class="mt-8 content-section cage-intro">
      <div class="cage-title-row">
        <h1 class="page-title cage-title" id="cage-title">Cage</h1>
        <span
          class="cage-alpha-badge"
          id="cage-alpha-badge">ALPHA</span
        >
      </div>
      <p class="cage-tagline">the interrogation room</p>
      <p class="cage-privacy-badge">
        <span class="privacy-dot"></span>
        local to this browser
      </p>
      <p class="cage-subtag">local mirror-strike triage for behavioral intent discovery</p>
    </section>

    <section class="mt-[var(--space-md)] content-section">
      <div
        class="cage-upload-zone"
        id="cage-upload-zone"
        role="button"
        tabindex="0"
        aria-label="Upload a file for interrogation"
      >
        <div class="upload-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <path d="M7 6v12"></path>
            <path d="M17 6v12"></path>
            <path d="M9.5 13.5l1.6-2.2 1.8 1.9 1.6-2.7"></path>
            <circle cx="12" cy="8.5" r="1"></circle>
          </svg>
        </div>
        <p class="upload-text">drop a file here</p>
        <p class="upload-subtext">or click / paste to browse</p>
        <p class="upload-formats">EXE &middot; DLL &middot; JS &middot; PDF &middot; DOC &middot; any file</p>
        <input type="file" id="cage-file-input" class="sr-only" aria-hidden="true" />
      </div>
    </section>

    <section class="mt-[var(--space-sm)] content-section">
      <div class="cage-source">
        <p class="cage-source-name" id="cage-source-name">no file loaded</p>
        <p class="cage-source-meta" id="cage-source-meta">drop a file to begin</p>
      </div>
    </section>

    <section class="mt-[var(--space-sm)] content-section">
      <div class="cage-grid">
        <article class="cage-panel">
          <h2 class="cage-panel-title">Viewport</h2>
          <pre class="cage-viewport" id="cage-viewport">v86 viewport is idle. load a file and run interrogation.</pre>
        </article>

        <article class="cage-panel">
          <h2 class="cage-panel-title">Verdict Dashboard</h2>
          <div class="cage-verdict">
            <p class="cage-verdict-score"><span id="cage-verdict-score">0</span> / 100</p>
            <p class="cage-verdict-label" id="cage-verdict-label">idle</p>
            <p class="cage-verdict-reason" id="cage-verdict-reason">awaiting interrogation run</p>
          </div>
        </article>
      </div>
    </section>

    <section class="mt-[var(--space-sm)] content-section">
      <div class="cage-grid">
        <article class="cage-panel">
          <h2 class="cage-panel-title">Threat Log</h2>
          <p class="cage-threat-empty" id="cage-threat-empty">No events yet.</p>
          <ul class="cage-threat-list" id="cage-threat-log"></ul>
        </article>
        <article class="cage-panel">
          <div class="cage-manifest-head">
            <h2 class="cage-panel-title">Requested Strip Manifest</h2>
            <button class="cage-copy-btn" id="cage-manifest-copy" type="button">Copy</button>
          </div>
          <pre class="cage-manifest" id="cage-manifest-output">&#123;
  "requestedStrip": []
&#125;</pre>
        </article>
      </div>
    </section>

    <div
      class="cage-actions"
      id="cage-actions"
      role="group"
      aria-label="Cage controls"
      style="display:none;opacity:0"
    >
      <button class="action-btn action-btn--primary" id="cage-action-run" type="button" disabled>Interrogate</button>
      <button
        class="action-btn action-btn--icon"
        id="cage-action-lens"
        type="button"
        disabled
        aria-label="View with Lens"
        title="View with Lens"
      >
        <svg
          class="lens-handoff-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
        </svg>
      </button>
      <button class="action-btn" id="cage-action-upload" type="button">Upload</button>
      <button class="action-btn" id="cage-action-clear" type="button" disabled>Clear</button>
    </div>
  </div>

  <script>
    import { initCage, resolveCageUIOptions } from "../scripts/cage-ui";

    const CAGE_LIFECYCLE_KEY = "__cageLifecycle";
    type CageLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };
    let cleanupCage: (() => void) | null = null;
    const cageWindow = window as unknown as Record<string, CageLifecycle | undefined>;

    function boot() {
      teardown();
      const cageOptions = resolveCageUIOptions(document);
      if (cageOptions) cleanupCage = initCage(cageOptions);
    }

    function teardown() {
      cleanupCage?.();
      cleanupCage = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
      detachLifecycle();
      const current = cageWindow[CAGE_LIFECYCLE_KEY];
      if (current?.boot === boot) delete cageWindow[CAGE_LIFECYCLE_KEY];
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = cageWindow[CAGE_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) prev.detach();
      else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", prev.teardown);
      }
      prev.teardown?.();
    }

    cageWindow[CAGE_LIFECYCLE_KEY] = { boot, teardown, detach: detachLifecycle };
    boot();
    attachLifecycle();
  </script>
</Layout>

<style>
  .cage-page {
    --cage-action-offset: calc(var(--touch-target) + (var(--space-sm) * 2));
    padding-bottom: calc(var(--cage-action-offset) + var(--space-lg));
  }

  .cage-intro {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

  .cage-title-row {
    display: flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.7);
  }

  .cage-title {
    margin: 0;
    line-height: 1.03;
    letter-spacing: -0.018em;
  }

  .cage-alpha-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: calc(var(--touch-target) * 0.5);
    padding: calc(var(--space-xs) * 0.2) calc(var(--space-xs) * 0.6);
    border-radius: calc(var(--radius-lg) * 0.55);
    border: 1px solid rgb(var(--chromatic-red) / 0.35);
    background: rgb(var(--chromatic-red) / 0.1);
    color: rgb(var(--chromatic-red));
    font-size: calc(var(--text-sm) * 0.66);
    font-weight: 700;
    letter-spacing: 0.08em;
    user-select: none;
  }

  .cage-tagline {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.58);
  }

  .cage-privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.28);
    margin-top: calc(var(--space-xs) * 0.3);
  }

  .privacy-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: rgb(var(--tool-status-success));
    box-shadow: 0 0 6px rgb(var(--tool-status-success) / 0.35);
    flex-shrink: 0;
    animation: privacy-pulse 4s ease-in-out infinite;
  }

  @keyframes privacy-pulse {
    0%,
    100% {
      box-shadow: 0 0 5px rgb(var(--tool-status-success) / 0.3);
    }
    50% {
      box-shadow: 0 0 10px rgb(var(--tool-status-success) / 0.5);
    }
  }

  .cage-subtag {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.35);
    font-size: var(--text-sm);
  }

  .cage-upload-zone {
    position: relative;
    border: 2px dashed rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    cursor: pointer;
    background: linear-gradient(
      180deg,
      rgb(var(--color-text-rgb) / 0.012) 0%,
      transparent 60%
    );
    box-shadow: var(--edge-highlight);
    transition:
      border-color var(--duration-slow) var(--ease-spring),
      background var(--duration-slow) var(--ease-spring),
      box-shadow var(--duration-slow) var(--ease-spring);
  }

  .cage-upload-zone:hover,
  .cage-upload-zone:global(.cage-drop-active) {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.03) 0%,
      rgb(var(--chromatic-cyan) / 0.008) 50%,
      transparent 100%
    );
    box-shadow: var(--edge-highlight);
  }

  .cage-upload-zone:active {
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.05) 0%,
      rgb(var(--chromatic-cyan) / 0.015) 50%,
      transparent 100%
    );
  }

  .cage-upload-zone:focus-visible {
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    box-shadow:
      var(--edge-highlight),
      0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
    outline: none;
  }

  .upload-icon {
    position: absolute;
    top: calc(var(--space-sm) * 1.2);
    left: calc(var(--space-sm) * 1.2);
    width: var(--space-xl);
    height: var(--space-xl);
    color: rgb(var(--color-text-rgb) / 0.14);
    line-height: 0;
    transition:
      color var(--duration-slow) var(--ease-spring),
      transform var(--duration-slow) var(--ease-spring);
  }

  .cage-upload-zone:hover .upload-icon {
    color: rgb(var(--chromatic-cyan) / 0.4);
    transform: scale(1.06);
  }

  .cage-upload-zone:active .upload-icon {
    transform: scale(0.94);
  }

  .upload-text {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 calc(var(--space-xs) * 0.3);
    color: rgb(var(--color-text-rgb) / 0.6);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .cage-upload-zone:hover .upload-text {
    color: rgb(var(--color-text-rgb) / 0.8);
  }

  .upload-subtext {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-sm);
    color: rgb(var(--color-text-rgb) / 0.28);
  }

  .upload-formats {
    font-size: calc(var(--text-sm) * 0.85);
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.15);
    letter-spacing: 0.06em;
  }

  .cage-source {
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-lg);
    padding: calc(var(--space-xs) * 1) var(--space-sm);
    background: rgb(var(--color-text-rgb) / 0.015);
  }

  .cage-source-name {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.86);
    font-weight: 600;
    word-break: break-word;
  }

  .cage-source-meta {
    margin: calc(var(--space-xs) * 0.35) 0 0;
    color: rgb(var(--color-text-rgb) / 0.38);
    font-size: var(--text-sm);
  }

  .cage-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .cage-panel {
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-sm);
    background: rgb(var(--color-text-rgb) / 0.015);
  }

  .cage-panel-title {
    margin: 0 0 calc(var(--space-xs) * 0.6);
    font-size: var(--text-base);
  }

  .cage-viewport {
    margin: 0;
    padding: calc(var(--space-xs) * 0.9);
    border: 1px solid rgb(var(--color-text-rgb) / 0.08);
    border-radius: var(--radius-sm);
    background: rgb(8 10 12 / 90%);
    color: rgb(var(--chromatic-cyan) / 0.88);
    min-height: 8rem;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.9);
    line-height: 1.6;
  }

  .cage-verdict-score {
    margin: 0;
    font-size: var(--text-xl);
    color: rgb(var(--chromatic-cyan));
    font-weight: 700;
  }

  .cage-verdict-label {
    margin: calc(var(--space-xs) * 0.3) 0 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: calc(var(--text-sm) * 0.82);
    color: rgb(var(--color-text-rgb) / 0.46);
  }

  .cage-verdict-reason {
    margin: calc(var(--space-xs) * 0.55) 0 0;
    color: rgb(var(--color-text-rgb) / 0.55);
    line-height: 1.55;
    font-size: var(--text-sm);
  }

  .cage-threat-empty {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.4);
    font-size: var(--text-sm);
  }

  .cage-threat-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: calc(var(--space-xs) * 0.45);
  }

  .cage-threat-row {
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-sm);
    padding: calc(var(--space-xs) * 0.7);
  }

  .cage-threat-row--high {
    border-color: rgb(var(--chromatic-red) / 0.45);
    background: rgb(var(--chromatic-red) / 0.08);
  }

  .cage-threat-row--medium {
    border-color: rgb(var(--tool-status-warning) / 0.35);
    background: rgb(var(--tool-status-warning) / 0.08);
  }

  .cage-threat-row--low {
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .cage-threat-heading,
  .cage-threat-code,
  .cage-threat-detail {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .cage-threat-heading {
    font-weight: 600;
    color: rgb(var(--color-text-rgb) / 0.82);
  }

  .cage-threat-code {
    color: rgb(var(--color-text-rgb) / 0.44);
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.85);
  }

  .cage-threat-detail {
    margin-top: calc(var(--space-xs) * 0.28);
    color: rgb(var(--color-text-rgb) / 0.6);
  }

  .cage-manifest-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .cage-copy-btn {
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--radius-sm);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.55);
    padding: calc(var(--space-xs) * 0.35) calc(var(--space-xs) * 0.7);
    font-family: var(--font-body);
    font-size: calc(var(--text-sm) * 0.88);
    cursor: pointer;
  }

  .cage-manifest {
    margin: 0;
    border: 1px solid rgb(var(--color-text-rgb) / 0.08);
    border-radius: var(--radius-sm);
    padding: calc(var(--space-xs) * 0.85);
    background: rgb(var(--color-text-rgb) / 0.01);
    min-height: 12rem;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.63);
    overflow: auto;
  }

  .cage-actions {
    position: fixed;
    bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    gap: calc(var(--space-xs) * 0.25);
    padding: calc(var(--space-xs) * 0.7);
    background: var(--tool-actionbar-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-lg);
    box-shadow: var(--edge-highlight), 0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 40;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    max-width: min(
      var(--content-width),
      calc(100vw - 2 * clamp(0.75rem, 4vw, 1.5rem))
    );
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .cage-actions::-webkit-scrollbar {
    display: none;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: calc(var(--space-xs) * 0.8) calc(var(--space-xs) * 1.5);
    background: transparent;
    border: none;
    border-radius: calc(var(--radius-lg) * 0.625);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
  }

  .action-btn--primary {
    background: rgb(var(--tool-action-run) / 0.1);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:hover:not(:disabled) {
    background: rgb(var(--tool-action-run) / 0.18);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--icon {
    min-width: var(--touch-target);
    padding-inline: calc(var(--space-xs) * 0.8);
  }

  .lens-handoff-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .action-btn:hover:not(:disabled) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .action-btn:disabled {
    cursor: not-allowed;
    color: rgb(var(--color-text-rgb) / 0.38);
    background: transparent;
    opacity: 1;
  }

  @supports not (
    (-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))
  ) {
    .cage-actions {
      background: var(--tool-actionbar-bg-fallback);
    }
  }

  @media (hover: none) {
    .cage-upload-zone:hover {
      border-color: rgb(var(--color-text-rgb) / 0.12);
      background: linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.012) 0%,
        transparent 60%
      );
      box-shadow: var(--edge-highlight);
    }

    .cage-upload-zone:hover .upload-icon {
      color: rgb(var(--color-text-rgb) / 0.14);
      transform: none;
    }

    .cage-upload-zone:hover .upload-text {
      color: rgb(var(--color-text-rgb) / 0.6);
    }

    .cage-upload-zone:active {
      border-color: rgb(var(--chromatic-cyan) / 0.35);
      background: linear-gradient(
        180deg,
        rgb(var(--chromatic-cyan) / 0.03) 0%,
        rgb(var(--chromatic-cyan) / 0.008) 50%,
        transparent 100%
      );
    }

    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }

    .action-btn--primary:hover {
      background: rgb(var(--tool-action-run) / 0.1);
      color: rgb(var(--tool-action-run));
    }

    .action-btn--primary:active {
      background: rgb(var(--tool-action-run) / 0.2);
    }
  }

  @media (max-width: 800px) {
    .cage-grid {
      grid-template-columns: 1fr;
    }

    .cage-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }
</style>
