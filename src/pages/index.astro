---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getCollection } from "astro:content";
import { preparePosts } from "../utils/posts";
import { getLoadingPriority } from "../utils/helpers";

const posts = await getCollection("posts");
const recentPosts = await preparePosts(posts, 2);
---

<Layout seo={homePageContent.seo}>
  <section class="mt-8 content-section">
    <h1 class="page-title">{identity.name}</h1>
    <p class="opacity-60 mb-10">{homePageContent.role}</p>
    <div class="flex flex-col @xs:flex-row gap-[var(--space-md)] mb-8">
      <Image
        src={identity.logo}
        alt={identity.name}
        width={100}
        height={100}
        loading="eager"
        decoding="async"
        class="size-(--size-avatar-lg) rounded-full shrink-0"
        transition:name="profile-image"
      />
      <div class="group flex flex-col justify-center gap-[var(--space-xs)] w-fit">
        {
          homePageContent.socialLinks.map((link) => (
            <SocialLink
              title={link.title}
              url={link.url}
              icon={link.icon}
              external={link.external}
            />
          ))
        }
      </div>
    </div>
    <p class="max-w-md mb-8">
      {homePageContent.description}
    </p>
    <div class="flex items-center gap-[var(--space-md)] group w-fit flex-wrap">
      {
        homePageContent.links.map((link) => (
          <Link text={link.title} href={link.url} external={link.external} />
        ))
      }
    </div>
  </section>
  <section class="mt-[var(--space-xl)] content-section">
    <h2 class="mb-8">Latest Posts</h2>
    <div class="grid grid-cols-1 gap-[var(--space-lg)] @xs:gap-[var(--space-md)] mb-10">
      {
        recentPosts.map((post, index) => (
          <BlogPostCard post={post} loading={getLoadingPriority(index)} showReadingTime />
        ))
      }
    </div>
    <div class="text-center">
      <a
        href="/blog"
        class="link-underline opacity-60 hover:opacity-100 py-2 inline-block min-h-[var(--touch-target)]"
        >View all</a
      >
    </div>
  </section>
</Layout>
