---
// woflo - digital browser mirror
// A transparent, educational display of all browser-detectable client information.
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "Digital Mirror | woflo",
  description:
    "A reflection of your browser's face. A transparent, educational display of all browser-detectable client information. All client-side.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div class="mirror-page">
    <section class="mt-8 content-section mirror-intro">
      <h1 class="page-title mirror-title" id="mirror-title">Digital Mirror</h1>
      <p class="mirror-tagline">a reflection of your browser's face</p>
      <p class="mirror-time tabular-nums">
        <span id="mirror-timestamp"></span>
      </p>
    </section>

    <!-- Score -->
    <section class="mt-[var(--space-md)] content-section">
      <div class="mirror-score">
        <div class="score-numbers tabular-nums">
          <span class="score-exposed"
            ><span id="score-exposed-count">0</span><span class="score-unit">
              exposed</span
            ></span
          ><span class="score-separator"> &middot; </span><span
            class="score-blocked"
            id="score-blocked-group"
            ><span id="score-blocked-count">0</span><span class="score-unit">
              blocked</span
            ></span
          >
        </div>
        <div class="score-bar-wrap">
          <div class="score-bar-exposed" id="score-bar-exposed"></div>
          <div class="score-bar-blocked" id="score-bar-blocked"></div>
        </div>
        <div class="score-verdict" id="score-verdict"></div>
        <div class="score-fingerprint">
          your fingerprint: <code id="fingerprint">--------</code>
        </div>
        <div class="score-subtitle">
          built from your most identifying signals. different browser, different
          hash.
        </div>
      </div>
    </section>

    <!-- Categories (populated by JS) -->
    <section class="mt-[var(--space-sm)] content-section">
      <div id="mirror-categories" data-breadcrumb-controller></div>
    </section>

    <!-- Insights -->
    <section class="mt-[var(--space-lg)] mb-[var(--space-xl)] content-section">
      <div class="mirror-insights">
        <h2 class="insights-title">are you stalking me..? D:</h2>
        <p class="insights-text">
          not particicularly, but none of this asked for your permission. no
          popups, no prompts... just browsers doing browser things. did you know
          any website can call these the moment you land on their page?
          silently...
        </p>
        <p class="insights-text">
          the canvas and audio fingerprints aren't just demos. they're real
          tracking techniques. your browser renders things <em>slightly</em>
          differently than everyone else's, and that difference alone can build a
          unique ID without cookies. combine that with your IP, timezone, GPU, and
          screen size... and you're as unique as they come!
          <br />the ones <span class="sensitive-indicator">&bull;</span>marked
          are the worst offenders.
        </p>
        <p class="insights-text">
          privacy browsers help (Firefox, Brave). tracking protection helps.
          VPNs help. when something shows a &ldquo;-&rdquo; up there, that's
          your browser doing its job :]
        </p>
      </div>
    </section>

    <!-- Actions -->
    <div class="mirror-actions" role="group" aria-label="Mirror actions">
      <button class="action-btn" id="action-copy">Copy</button>
      <button class="action-btn" id="action-expand">Expand</button>
      <button class="action-btn" id="action-collapse">Collapse</button>
      <button class="action-btn" id="action-refresh">Rescan</button>
    </div>
  </div>

  <script>
    import { initMirror, resolveMirrorUIOptions } from "../scripts/mirror/ui";

    const MIRROR_LIFECYCLE_KEY = "__digitalMirrorLifecycle";
    type MirrorLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };
    let cleanupMirror: (() => void) | null = null;
    const mirrorWindow = window as unknown as Record<
      string,
      MirrorLifecycle | undefined
    >;

    function boot() {
      teardown();
      const mirrorOptions = resolveMirrorUIOptions(document);
      if (mirrorOptions) cleanupMirror = initMirror(mirrorOptions);
    }

    function teardown() {
      cleanupMirror?.();
      cleanupMirror = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
      detachLifecycle();
      const current = mirrorWindow[MIRROR_LIFECYCLE_KEY];
      if (current?.boot === boot) {
        delete mirrorWindow[MIRROR_LIFECYCLE_KEY];
      }
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = mirrorWindow[MIRROR_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) {
        prev.detach();
      } else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", prev.teardown);
      }
      prev.teardown?.();
    }

    mirrorWindow[MIRROR_LIFECYCLE_KEY] = {
      boot,
      teardown,
      detach: detachLifecycle,
    };

    boot();
    attachLifecycle();
  </script>
</Layout>

<style>
  /* ── Score Hero ──────────────────────────────────────────── */

  .mirror-page {
    --mirror-duration-fill: calc(var(--duration-slow) * 4);
    --mirror-duration-counter: calc(var(--duration-slow) * 2);
    --mirror-duration-point-highlight: calc(var(--duration-slow) * 5);
    --mirror-duration-toast-visible: calc(
      (var(--duration-slow) * 7) + var(--duration-fast)
    );
    --mirror-duration-toast-exit: var(--duration-slow);
    --mirror-duration-breadcrumb-lock: calc(
      (var(--duration-slow) * 2) + (var(--duration-fast) * 2)
    );
    --mirror-duration-breadcrumb-type: 35ms;
    --mirror-duration-breadcrumb-clear: 20ms;
    --mirror-layout-offset: var(--space-xs);
    --mirror-toast-offset: var(--mirror-layout-offset);
    --mirror-breadcrumb-scroll-offset: var(--mirror-layout-offset);
    --mirror-breadcrumb-detection-offset: calc(var(--mirror-layout-offset) * 3);
    --mirror-breadcrumb-observer-bottom-margin-pct: 60;
    --mirror-space-tight: calc(var(--space-xs) * 0.7);
    --mirror-space-2xs: calc(var(--space-xs) * 0.2);
    --mirror-stack-gap: calc(var(--space-xs) * 0.25);
    --mirror-radius-xs: var(--radius-xs);
    --mirror-radius-sm: var(--radius-sm);
    --mirror-action-radius: calc(var(--radius-lg) - var(--mirror-radius-sm));
    --mirror-inline-gap-tight: 0.15em;
    --mirror-inline-code-pad-y: 0.15em;
    --mirror-inline-code-pad-x: 0.5em;
    --mirror-inline-code-size: 0.9em;
    --mirror-text-track-title: -0.018em;
    --mirror-text-track-wide: 0.04em;
    --mirror-text-track-chip: 0.02em;
    --mirror-line-tight: 1.1;
    --mirror-line-chip: 1.25;
    --mirror-chip-font-size: clamp(
      calc(var(--text-sm) * 0.72),
      calc((var(--text-sm) * 0.69) + 0.08vw),
      calc(var(--text-sm) * 0.8)
    );
    --mirror-chip-pad-y: calc(var(--space-xs) * 0.12);
    --mirror-chip-pad-x: calc(var(--space-xs) * 0.76);
    --mirror-micro-text-size: calc(var(--text-sm) * 0.6875);
    --mirror-sensitive-text-size: calc(var(--text-sm) * 0.625);
    --mirror-supporting-text-size: clamp(
      calc(var(--text-sm) * 0.875),
      calc((var(--text-sm) * 0.8125) + 0.2vw),
      var(--text-sm)
    );
    --mirror-tier-core-rgb: 123 92 214;
    --mirror-tier-context-rgb: 232 96 166;
    --mirror-tier-deep-rgb: 153 151 172;
    --mirror-actions-offset: calc(var(--touch-target) + (var(--space-sm) * 2));
    --mirror-actions-inline-gap: calc(var(--space-xs) * 0.25);

    padding-bottom: calc(var(--mirror-actions-offset) + var(--space-lg));
  }

  .mirror-intro {
    display: grid;
    gap: var(--mirror-space-tight);
  }

  .mirror-title {
    margin: 0;
    line-height: 1.03;
    letter-spacing: var(--mirror-text-track-title);
  }

  .mirror-tagline {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.58);
  }

  .mirror-time {
    margin: calc(var(--space-xs) * 0.1) 0 0;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.3);
  }

  .mirror-score {
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-md)
      calc(var(--space-sm) + var(--mirror-space-2xs));
    text-align: center;
    background: linear-gradient(
      180deg,
      rgb(var(--color-text-rgb) / 0.018) 0%,
      rgb(var(--color-text-rgb) / 0.006) 62%,
      transparent 100%
    );
    box-shadow: var(--edge-highlight);
  }

  .score-numbers {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--mirror-inline-gap-tight);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--mirror-line-tight);
  }

  .score-exposed {
    color: rgb(var(--chromatic-cyan));
  }

  .score-unit {
    font-size: var(--text-sm);
    opacity: 0.25;
    font-weight: 400;
  }

  .score-separator {
    opacity: 0.15;
    font-weight: 400;
    font-size: var(--text-sm);
  }

  .score-blocked {
    opacity: 0;
    transition: opacity var(--mirror-duration-fade) var(--ease-out);
  }

  .score-blocked .score-unit {
    opacity: 0.35;
  }

  .score-blocked.visible {
    opacity: 0.5;
  }

  .score-bar-wrap {
    position: relative;
    height: 4px;
    background: rgb(var(--color-text-rgb) / 0.06);
    border-radius: var(--mirror-radius-xs);
    margin-top: calc(var(--space-xs) + (var(--space-xs) * 0.2));
    overflow: visible;
  }

  .score-bar-wrap::before {
    content: "";
    position: absolute;
    inset: -14px 0;
  }

  .score-bar-exposed {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-cyan) / 0.8);
    box-shadow: 0 0 6px rgb(var(--chromatic-cyan) / 0.3);
    border-radius: var(--mirror-radius-xs);
    transition: width var(--mirror-duration-fill) var(--ease-spring);
  }

  .score-bar-blocked {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-red) / 0.1);
    border-radius: var(--mirror-radius-xs);
    transition: width var(--mirror-duration-fill) var(--ease-spring);
  }

  .score-verdict {
    font-size: var(--text-sm);
    opacity: 0;
    margin-top: var(--space-xs);
    transition: opacity var(--mirror-duration-fade) var(--ease-out);
  }

  .score-verdict.visible {
    opacity: 0.4;
  }

  .score-fingerprint {
    font-size: var(--text-sm);
    opacity: 0.38;
    margin-top: var(--space-sm);
  }

  .score-fingerprint code {
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.06);
    padding: var(--mirror-inline-code-pad-y) var(--mirror-inline-code-pad-x);
    border-radius: var(--mirror-radius-sm);
    font-size: var(--mirror-inline-code-size);
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.06);
  }

  .score-subtitle {
    font-size: var(--text-sm);
    opacity: 0.24;
    margin-top: var(--mirror-space-tight);
  }

  /* ── Insights ──────────────────────────────────────────── */

  .mirror-insights {
    border: 1px solid var(--color-border);
    border-left: 2px solid rgb(var(--chromatic-cyan) / 0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    background: linear-gradient(
      135deg,
      rgb(var(--chromatic-cyan) / 0.012) 0%,
      transparent 40%
    );
    box-shadow: var(--edge-highlight);
  }

  .insights-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .insights-text {
    font-size: var(--text-sm);
    opacity: 0.45;
    line-height: 1.8;
    margin-bottom: calc(var(--space-sm) * 0.85);
  }

  .insights-text:last-of-type {
    margin-bottom: 0;
  }

  .insights-text strong {
    opacity: 1;
    font-weight: 600;
    color: var(--color-text);
  }

  .insights-text em {
    font-style: italic;
    opacity: 0.85;
  }

  .sensitive-indicator {
    color: rgb(var(--tool-status-warning));
    text-shadow: 0 0 6px rgb(var(--tool-status-warning) / 0.3);
  }

  /* ── Action Bar ──────────────────────────────────────────── */

  .mirror-actions {
    position: fixed;
    bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: var(--mirror-actions-inline-gap);
    width: min(max-content, calc(100vw - (2 * clamp(0.75rem, 4vw, 1.5rem))));
    max-width: min(var(--content-width), 30rem);
    padding: var(--mirror-space-tight);
    background: var(--tool-actionbar-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--radius-lg);
    box-shadow:
      var(--edge-highlight),
      0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 40;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .mirror-actions::-webkit-scrollbar {
    display: none;
  }

  @supports not (
    (-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))
  ) {
    .mirror-actions {
      background: var(--tool-actionbar-bg-fallback);
    }
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    min-width: 0;
    padding: calc(var(--space-xs) * 0.8) calc(var(--space-xs) * 1.5);
    background: transparent;
    border: none;
    border-radius: var(--mirror-action-radius);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
  }

  .action-btn:hover {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  /* ── Reduced Motion ──────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .score-bar-exposed,
    .score-bar-blocked {
      transition: none;
    }
    .score-blocked,
    .score-verdict {
      transition: none;
    }
  }

  @media (max-width: 520px) {
    .mirror-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }

  /* ── Hover: touch devices ──────────────────────────────────── */

  @media (hover: none) {
    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }
  }
</style>

<style is:global>
  /* ── Bar Tooltip ──────────────────────────────────────────── */

  .score-bar-wrap {
    cursor: default;
  }

  .bar-tooltip {
    --_tip-gap: var(--space-xs);
    --_tip-arrow: 6px;
    --_tip-slide: 4px;
    --_tip-chip: var(--mirror-chip-font-size);

    position: absolute;
    bottom: calc(100% + var(--_tip-gap) + var(--_tip-arrow));
    left: 50%;
    transform: translateX(-50%) translateY(var(--_tip-slide));
    width: max-content;
    max-width: min(320px, 88vw);
    padding: var(--space-xs);
    background: var(--color-bg);
    background-image: var(--surface-sheen);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow:
      var(--edge-highlight),
      0 8px 32px rgb(0 0 0 / 0.5);
    font-family: var(--font-body);
    font-size: calc(var(--text-sm) * 0.9);
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    z-index: 10;
  }

  .bar-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    border: var(--_tip-arrow) solid transparent;
    border-top-color: var(--color-border);
  }

  .score-bar-wrap:hover .bar-tooltip,
  .bar-tooltip.bar-tooltip--open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* Flipped: tooltip below the bar when there's no room above */
  .bar-tooltip.bar-tooltip--below {
    bottom: auto;
    top: calc(100% + var(--_tip-gap) + var(--_tip-arrow));
    transform: translateX(-50%) translateY(calc(-1 * var(--_tip-slide)));
  }

  .bar-tooltip.bar-tooltip--below::after {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom-color: var(--color-border);
  }

  .score-bar-wrap:hover .bar-tooltip.bar-tooltip--below,
  .bar-tooltip.bar-tooltip--open.bar-tooltip--below {
    transform: translateX(-50%) translateY(0);
  }

  .bar-tooltip-heading {
    font-size: var(--_tip-chip);
    letter-spacing: var(--mirror-text-track-wide);
    text-transform: uppercase;
    color: rgb(var(--color-text-rgb) / var(--opacity-subtle));
    padding: calc(var(--space-xs) * 0.4) calc(var(--space-xs) * 0.9)
      calc(var(--space-xs) * 0.7);
  }

  .bar-tooltip-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-xs) * 0.9);
    border-radius: var(--mirror-radius-sm);
    cursor: pointer;
    transition: background var(--duration-normal) var(--ease-out);
  }

  .bar-tooltip-row:hover {
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .bar-tooltip-label {
    flex-shrink: 0;
    color: rgb(var(--color-text-rgb) / var(--opacity-dim));
    white-space: nowrap;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .bar-tooltip-row:hover .bar-tooltip-label {
    color: rgb(var(--color-text-rgb) / var(--opacity-high));
  }

  .bar-tooltip-val {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
    font-size: var(--_tip-chip);
    color: rgb(var(--color-text-rgb) / var(--opacity-faint));
  }

  .bar-tooltip-weight {
    flex-shrink: 0;
    font-size: var(--_tip-chip);
    letter-spacing: var(--mirror-text-track-chip);
    padding: var(--mirror-chip-pad-y) var(--mirror-chip-pad-x);
    border-radius: 999px;
    background: rgb(var(--chromatic-cyan) / 0.04);
    border: 1px solid rgb(var(--chromatic-cyan) / var(--opacity-faint));
    color: rgb(var(--chromatic-cyan) / var(--opacity-hover-dim));
    line-height: var(--mirror-line-chip);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-tooltip {
      transition: none;
    }
  }

  @media (max-width: 520px) {
    .bar-tooltip {
      max-width: min(94vw, 24rem);
    }

    .bar-tooltip-row {
      gap: calc(var(--space-xs) * 0.75);
    }
  }

  /* ── Categories ──────────────────────────────────────────── */

  .cat-section {
    margin-bottom: var(--mirror-stack-gap);
  }

  .cat-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: calc(var(--space-xs) * 1.2) calc(var(--space-xs) * 1.5);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      text-shadow var(--duration-normal) var(--ease-out);
    min-height: var(--touch-target);
  }

  .cat-toggle:hover {
    background: rgb(var(--color-text-rgb) / 0.03);
    border-color: rgb(var(--color-text-rgb) / 0.2);
    box-shadow: var(--chromatic-shadow);
  }

  .cat-toggle:active {
    transform: scale(var(--scale-active));
    opacity: var(--opacity-muted);
  }

  .cat-arrow {
    font-size: calc(var(--text-sm) * 0.8125);
    width: 1em;
    flex-shrink: 0;
    opacity: 0.3;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .cat-toggle:hover .cat-arrow {
    opacity: 0.55;
  }

  .cat-title {
    flex: 1;
  }

  .cat-count {
