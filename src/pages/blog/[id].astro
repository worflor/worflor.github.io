---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import ImageGallery from "../../components/ImageGallery.astro";
import { identity } from "../../config";
import { formatPostDate, getRelatedPosts, buildResonanceIndex } from "../../utils/posts";
import BlogPostCard from "../../components/BlogPostCard.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const resonanceIndex = await buildResonanceIndex(posts);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { resonanceIndex, allPosts: posts },
  }));
}

const { id } = Astro.params;
const { resonanceIndex, allPosts } = Astro.props;
const entry = await getEntry("posts", id as string);

if (!entry) {
  return Astro.redirect("/blog");
}

const { Content, remarkPluginFrontmatter } = await render(entry);

const relatedPosts = getRelatedPosts(id as string, allPosts, resonanceIndex);
---

<Layout
  seo={{
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.images[0].url,
  }}
>
  <section class="mt-8 content-section">
    <h1 class="font-bold text-[length:var(--text-3xl)] mb-4">{entry.data.title}</h1>
    <p class="opacity-60 mb-[var(--space-md)]">
      {entry.data.description}
    </p>
    <div class="flex gap-3 @xs:gap-4 mb-[var(--space-md)]">
      <Image
        src={identity.logo}
        alt={identity.name}
        width={40}
        height={40}
        loading="eager"
        decoding="async"
        class="size-(--size-avatar-sm) object-cover rounded-full shrink-0"
        transition:name="profile-image"
      />
      <div class="min-w-0">
        <p class="font-medium">{entry.data.author || identity.name}</p>
        <p class="opacity-60 tabular-nums text-[length:var(--text-sm)]">
          {formatPostDate(entry.data.pubDate)}{remarkPluginFrontmatter?.minutesRead && <> · {remarkPluginFrontmatter.minutesRead}</>}
        </p>
      </div>
    </div>
    {entry.data.images.length === 1 ? (
      <Image
        src={entry.data.images[0].url}
        alt={entry.data.images[0].alt}
        width={1200}
        height={800}
        loading="eager"
        decoding="async"
        class="w-full max-h-80 object-cover rounded-xl mb-[var(--space-lg)]"
        transition:name={`blog-image-${id}`}
      />
    ) : (
      <ImageGallery
        images={entry.data.images.map(img => ({ src: img.url, alt: img.alt }))}
        variant="scroll"
        showIndicators={false}
        class="mb-[var(--space-lg)]"
      />
    )}
    <article
      class="prose prose-invert prose-a:text-blue-300 prose-a:underline-offset-4 prose-headings:mb-2 prose-p:opacity-70"
    >
      <Content />
    </article>

    {relatedPosts.length > 0 && (
      <aside class="mt-[var(--space-xl)] pt-[var(--space-lg)] border-t border-[var(--color-border)]">
        <p class="opacity-60 mb-[var(--space-md)]">See also</p>
        <div class="grid gap-[var(--space-md)]">
          {relatedPosts.map((post) => <BlogPostCard post={post} />)}
        </div>
      </aside>
    )}
  </section>
</Layout>
