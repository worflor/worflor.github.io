---
import Layout from "../layouts/Layout.astro";
import { aboutPageContent } from "../config";
import ResumeItem from "../components/ResumeItem.astro";
import SocialLink from "../components/SocialLink.astro";
import ImageGallery from "../components/ImageGallery.astro";
import FreelanceBrief from "../components/FreelanceBrief.astro";
import { parseMarkdown } from "../utils/helpers";

const pageDescription = parseMarkdown(aboutPageContent.about.description);
const workDescription = parseMarkdown(aboutPageContent.work.description);
const connectDescription = parseMarkdown(aboutPageContent.connect.description);
const featuredConnectLinks = aboutPageContent.connect.links.slice(0, 3);
const remainingConnectLinks = aboutPageContent.connect.links.slice(3);
---

<Layout seo={aboutPageContent.seo}>
  <section class="mt-8 content-section">
    <h1 class="page-title">About</h1>
    <p class="opacity-60 mb-10"><Fragment set:html={aboutPageContent.subtitle.replace('hey', '<a href="/contact?hey" class="underline hover:opacity-100">hey</a>')} /></p>
    <div class="mb-[var(--space-xl)]">
      <Fragment set:html={pageDescription} />
    </div>
    <ImageGallery
      images={aboutPageContent.about.images}
      variant="overlap"
      showIndicators={true}
    />
  </section>
  <section
    class="my-[var(--space-xl)] mt-[calc(var(--space-xl)*1.5)] content-section @xs:flex @xs:gap-[var(--space-lg)]"
  >
    <h2 class="mb-8 @xs:mb-0 opacity-60 shrink-0 min-w-[5rem]">Work</h2>
    <div class="flex-1 min-w-0">
      <div class="mb-[var(--space-md)]">
        <Fragment set:html={workDescription} />
      </div>
      <div class="relative @xs:pl-4">
        <div class="pointer-events-none absolute left-[2.7rem] top-0 bottom-0 hidden w-px @xs:block bg-[linear-gradient(180deg,transparent,rgb(var(--color-text-rgb)/0.08)_10%,rgb(var(--color-text-rgb)/0.08)_90%,transparent)]" aria-hidden="true"></div>
        <div class="group border-y border-[rgb(var(--color-text-rgb)/0.08)] divide-y divide-[rgb(var(--color-text-rgb)/0.08)]">
        {aboutPageContent.work.items.map((item) => <ResumeItem {...item} />)}
        </div>
      </div>
    </div>
  </section>
  {/* a section in its own right, not a block inside one. it carries its own
      rule, kicker and heading, so nesting it under another section's label gave
      the page two headings for one thing, two vertical rules a few pixels
      apart, and a column of text indented past everything around it.

      it follows Work on purpose: that section ends on "Tool Maker / Freelance /
      2025 - Present", and this is that line made actionable. */}
  <section class="content-section">
    <FreelanceBrief source="the about page" />
  </section>
  <section
    class="mt-[calc(var(--space-xl)*1.5)] content-section @xs:flex @xs:gap-[var(--space-lg)]"
  >
    <h2 class="casual mb-8 @xs:mb-0 opacity-60 shrink-0 min-w-[5rem]">Mandatory Self Promotion</h2>
    <div class="flex-1 min-w-0">
      <div class="mb-[var(--space-md)]">
        <Fragment set:html={connectDescription} />
      </div>
      {/* the column count is asked for rather than declared. a fixed
          three-across fired at a 20rem container, which at phone width gave
          each box about 108px when "Endeavours" needs roughly 157 to stay on
          one line, so the labels wrapped one letter per row. stating the
          minimum a box can live at lets the grid fit however many actually
          fit, and it cannot break again when a link is renamed. */}
      <div class="grid grid-cols-[repeat(auto-fit,minmax(12rem,1fr))] gap-[var(--space-xs)] group">
        {
          featuredConnectLinks.map((item) => (
            <SocialLink {...item} variant="box" />
          ))
        }
      </div>
      {remainingConnectLinks.length > 0 && (
        <div class="grid grid-cols-1 @xs:grid-cols-2 gap-[var(--space-xs)] group mt-[var(--space-xs)]">
          {
            remainingConnectLinks.map((item) => (
              <SocialLink {...item} variant="box" />
            ))
          }
        </div>
      )}
    </div>
  </section>
</Layout>
