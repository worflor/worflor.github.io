---
// 404.astro - THE VOID: Little Guys in the Void
// A creature simulation with a simple loop: feed, grow, multiply, reveal
// Feed them. Watch them grow. They reveal the world.
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content="noindex" />
    <title>404 - Lost with you</title>
    <style>
      /*
     * Standalone 404 page - values synced with global.css @theme
     * This page is intentionally self-contained for isolation
     */
      :root {
        --color-bg: #0a0a0a;
        --color-text: #f5f5f5;
        --color-border: #262626;
        --font-body:
          "Trebuchet MS", "Lucida Grande", "Lucida Sans Unicode", "Lucida Sans",
          Tahoma, sans-serif;
        --font-casual: "Comic Neue", "Comic Sans MS", cursive;
        --chromatic-cyan: 0 255 255;
        --chromatic-red: 255 0 0;
        --chromatic-offset: 1px;
        --chromatic-opacity: 0.5;
      }

      @font-face {
        font-family: "Comic Neue";
        src: url("/fonts/ComicNeue-Regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: "Comic Neue";
        src: url("/fonts/ComicNeue-Bold.woff2") format("woff2");
        font-weight: 700;
        font-display: swap;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--color-bg);
        overflow: hidden;
        font-family: var(--font-body);
        /* Use native cursor - custom cursor was laggy */
        cursor: auto;
        /* unprefixed user-select is Safari 17.4+, and long-press is the pickup
           gesture here, so without these iOS 17 and earlier pop the selection
           magnifier in the middle of picking a creature up */
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
        overscroll-behavior: none;
      }

      #game {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        /* the canvas owns its gestures: no pinch zoom, no double-tap zoom, no
           rubber-band while dragging a creature */
        touch-action: none;
        overscroll-behavior: none;
      }

      #title {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
        z-index: 5; /* Behind creatures, part of the world */
        width: 90vw;
        max-width: 800px;
      }
      #title h1 {
        /* Fluid font-size: 100px on mobile → 280px on desktop */
        font-size: clamp(80px, 15vw + 20px, 280px);
        font-weight: 100;
        /* Fluid letter-spacing: 20px on mobile → 60px on desktop */
        letter-spacing: clamp(15px, 4vw + 5px, 60px);
        color: rgba(245, 245, 245, 0.058);
        margin-bottom: clamp(6px, 1vw, 10px);
      }
      #title p {
        /* Fluid font-size: 9px → 11px */
        font-size: clamp(9px, 0.5vw + 7px, 11px);
        letter-spacing: clamp(6px, 1vw + 2px, 10px);
        text-transform: uppercase;
        /* was 0.14, about 1.7:1. --opacity-text-floor is the 4.5:1 mark. */
        color: rgba(245, 245, 245, 0.47);
        font-family: var(--font-casual);
      }
      #lost-path {
        position: fixed;
        bottom: clamp(60px, 10vw, 70px);
        left: 50%;
        transform: translateX(-50%);
        font-size: clamp(9px, 0.4vw + 7px, 11px);
        letter-spacing: clamp(1px, 0.3vw + 0.5px, 2px);
        /* this is the line that says which page failed. it was 1.6:1. */
        color: rgba(245, 245, 245, 0.55);
        pointer-events: none;
        z-index: 40;
        max-width: min(300px, 80vw);
        text-align: center;
        /* the requested path can be one long unbroken token, so it has to be
           breakable. break-all did that by breaking anywhere in anything, which
           split the ordinary words too: the line read "pag / e not found".
           anywhere breaks a token only when it cannot fit on a line by itself,
           which is what was wanted. */
        overflow-wrap: anywhere;
        padding: 0 1rem;
      }

      #creature-tooltip {
        position: fixed;
        z-index: 200;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s ease;
        background: rgba(10, 10, 10, 0.9);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        padding: 8px 12px;
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
        min-width: 100px;
      }
      #creature-tooltip.visible {
        opacity: 1;
      }
      #creature-tooltip .name {
        font-size: 13px;
        color: rgba(245, 245, 245, 0.85);
        letter-spacing: 1px;
        margin-bottom: 4px;
      }
      #creature-tooltip .details {
        font-size: 9px;
        color: rgba(245, 245, 245, 0.45);
        letter-spacing: 0.5px;
      }
      #creature-tooltip .personality {
        font-size: 8px;
        color: rgba(245, 245, 245, 0.3);
        margin-top: 3px;
        font-style: italic;
        font-family: var(--font-casual);
      }
      #creature-tooltip .stats {
        font-size: 8px;
        color: rgba(245, 245, 245, 0.35);
        margin-top: 4px;
        display: flex;
        gap: 8px;
      }

      /* Pickup progress indicator */
      #pickup-ring {
        position: fixed;
        pointer-events: none;
        z-index: 150;
        opacity: 0;
      }

      #toast {
        position: fixed;
        bottom: clamp(70px, 12vw, 80px);
        left: 50%;
        transform: translateX(-50%);
        color: rgba(245, 245, 245, 0.5);
        font-size: clamp(9px, 0.5vw + 7px, 11px);
        letter-spacing: clamp(2px, 0.4vw + 1px, 3px);
        text-transform: uppercase;
        z-index: 200;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
        text-align: center;
        max-width: 90vw;
        padding: 0 1rem;
        font-family: var(--font-casual);
      }
      #toast.show {
        opacity: 1;
      }

      #home {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        position: fixed;
        /* viewport-fit=cover is set, so without env() this lands under the
           gesture bar on every modern iPhone. #controls already does this. */
        bottom: max(clamp(16px, 3vw, 24px), env(safe-area-inset-bottom));
        left: 50%;
        transform: translateX(-50%);
        background: transparent;
        /* the only way out of the page: it was 2.6:1 */
        color: rgba(245, 245, 245, 0.62);
        font-family: inherit;
        font-size: clamp(8px, 0.5vw + 6px, 9px);
        letter-spacing: clamp(2px, 0.5vw + 1px, 4px);
        text-transform: uppercase;
        /* Touch-friendly minimum size */
        padding: clamp(10px, 1.5vw, 12px) clamp(16px, 2vw, 20px);
        min-height: 44px;
        min-width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-border);
        transition:
          all 0.3s ease,
          text-shadow 0.15s ease;
        z-index: 100;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      @media (any-hover: hover) {
        #home:hover {
          color: rgba(245, 245, 245, 0.6);
          border-color: rgba(245, 245, 245, 0.2);
          background: rgba(255, 255, 255, 0.02);
          text-shadow:
            calc(-1 * var(--chromatic-offset)) 0 0
              rgb(var(--chromatic-cyan) / var(--chromatic-opacity)),
            var(--chromatic-offset) 0 0
              rgb(var(--chromatic-red) / var(--chromatic-opacity));
        }
      }
      /* :focus-visible, not :focus, so it does not fire on a click; and a real
         ring rather than an alpha nudge nobody can perceive on near-black */
      #home:focus-visible,
      #controls button:focus-visible {
        outline: 2px solid rgb(var(--chromatic-cyan) / 0.5);
        outline-offset: 2px;
        color: rgba(245, 245, 245, 0.85);
        background: rgba(255, 255, 255, 0.03);
      }

      #controls {
        position: fixed;
        bottom: max(clamp(16px, 3vw, 24px), env(safe-area-inset-bottom));
        right: max(clamp(16px, 3vw, 24px), env(safe-area-inset-right));
        z-index: 100;
      }
      #controls button {
        background: transparent;
        border: 1px solid var(--color-border);
        color: rgba(245, 245, 245, 0.47);
        /* Touch-friendly minimum size */
        padding: clamp(6px, 1vw, 10px) clamp(10px, 1.5vw, 14px);
        min-height: 44px;
        min-width: 44px;
        font-size: clamp(7px, 0.4vw + 5px, 8px);
        cursor: pointer;
        font-family: inherit;
        transition:
          all 0.3s ease,
          text-shadow 0.15s ease;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      #controls button:hover {
        border-color: rgba(245, 245, 245, 0.2);
        color: rgba(245, 245, 245, 0.5);
        text-shadow:
          calc(-1 * var(--chromatic-offset)) 0 0
            rgb(var(--chromatic-cyan) / var(--chromatic-opacity)),
          var(--chromatic-offset) 0 0
            rgb(var(--chromatic-red) / var(--chromatic-opacity));
      }
    </style>
  </head>
  <body>
    <canvas
      id="game"
      role="img"
      aria-label="An animated field of small creatures drifting in darkness."
    ></canvas>

    <div id="title">
      <h1>404</h1>
      <p id="title-sub"></p>
    </div>

    <!-- Population count shown in browser title for cleaner UX -->

    <div id="creature-tooltip">
      <div class="name"></div>
      <div class="details"></div>
      <div class="stats"></div>
      <div class="personality"></div>
    </div>
    <canvas id="pickup-ring" width="60" height="60"></canvas>

    <div id="lost-path"></div>
    <div id="toast" role="status" aria-live="polite"></div>
    <a id="home" href="/">go back home</a>

    <div id="controls">
      <button id="btn-reset">reset</button>
    </div>

    <script>
      import { initVoidGame } from "../scripts/void/game";

      function getRequiredElement<T extends Element>(
        id: string,
        ctor: { new (...args: any[]): T }
      ): T | null {
        const el = document.getElementById(id);
        if (!(el instanceof ctor)) {
          console.error(
            `[void404] Initialization aborted: required element #${id} missing or invalid.`
          );
          return null;
        }
        return el;
      }

      const canvas = getRequiredElement("game", HTMLCanvasElement);
      const lostPath = getRequiredElement("lost-path", HTMLElement);
      const titleSub = getRequiredElement("title-sub", HTMLElement);
      const title = getRequiredElement("title", HTMLElement);
      const toast = getRequiredElement("toast", HTMLElement);
      const tooltip = getRequiredElement("creature-tooltip", HTMLElement);
      const pickupRing = getRequiredElement("pickup-ring", HTMLCanvasElement);
      const homeBtn = getRequiredElement("home", HTMLAnchorElement);
      const resetBtn = getRequiredElement("btn-reset", HTMLButtonElement);

      if (
        !canvas ||
        !lostPath ||
        !titleSub ||
        !title ||
        !toast ||
        !tooltip ||
        !pickupRing ||
        !homeBtn ||
        !resetBtn
      ) {
        // Required DOM not available; do not attempt startup.
      } else {
        const cleanup = initVoidGame({
          canvas,
          lostPath,
          titleSub,
          title,
          toast,
          tooltip,
          pickupRing,
          homeBtn,
          resetBtn,
        });

        // Bfcache-aware, and deliberately not `once`.
        //
        // The game installs its own pagehide handler that declines to tear down
        // when `persisted` is true, because a bfcached document is intact and
        // only the loop needs restarting. This listener was registered after it
        // with no such check, so the first Back destroyed the world anyway and
        // `pageshow` rebuilt it from the save, re-rolling every stalker, fissure,
        // hole, nest and monolith. `once` then removed this listener, so only
        // the first Back behaved that way and no later one did, which is the
        // signature of a bug nobody can reproduce.
        //
        // `once` also has to go: with the check in place it would otherwise be
        // spent on a bfcache hide that cleaned nothing, leaving a genuine unload
        // afterwards with no teardown at all.
        window.addEventListener("pagehide", (event) => {
          if (!event.persisted) cleanup();
        });
        document.addEventListener("astro:before-swap", cleanup, { once: true });
      }
    </script>
  </body>
</html>
