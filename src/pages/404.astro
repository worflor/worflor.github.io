---
// 404.astro - THE VOID: Little Guys in the Void
// A creature simulation with a simple loop: feed, grow, multiply, reveal
// Feed them. Watch them grow. They reveal the world.
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content="noindex" />
    <title>404 - Lost with you</title>
    <style>
      /*
     * Standalone 404 page - values synced with global.css @theme
     * This page is intentionally self-contained for isolation
     */
      :root {
        --color-bg: #0a0a0a;
        --color-text: #f5f5f5;
        --color-border: #262626;
        --font-body:
          "Trebuchet MS", "Lucida Grande", "Lucida Sans Unicode", "Lucida Sans",
          Tahoma, sans-serif;
        --font-casual: "Comic Neue", "Comic Sans MS", cursive;
        --chromatic-cyan: 0 255 255;
        --chromatic-red: 255 0 0;
        --chromatic-offset: 1px;
        --chromatic-opacity: 0.5;
      }

      @font-face {
        font-family: "Comic Neue";
        src: url("/fonts/ComicNeue-Regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: "Comic Neue";
        src: url("/fonts/ComicNeue-Bold.woff2") format("woff2");
        font-weight: 700;
        font-display: swap;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--color-bg);
        overflow: hidden;
        font-family: var(--font-body);
        /* Use native cursor - custom cursor was laggy */
        cursor: auto;
        user-select: none;
      }

      #game {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
      }

      #title {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
        z-index: 5; /* Behind creatures, part of the world */
        width: 90vw;
        max-width: 800px;
      }
      #title h1 {
        /* Fluid font-size: 100px on mobile → 280px on desktop */
        font-size: clamp(80px, 15vw + 20px, 280px);
        font-weight: 100;
        /* Fluid letter-spacing: 20px on mobile → 60px on desktop */
        letter-spacing: clamp(15px, 4vw + 5px, 60px);
        color: rgba(245, 245, 245, 0.058);
        margin-bottom: clamp(6px, 1vw, 10px);
      }
      #title p {
        /* Fluid font-size: 9px → 11px */
        font-size: clamp(9px, 0.5vw + 7px, 11px);
        letter-spacing: clamp(6px, 1vw + 2px, 10px);
        text-transform: uppercase;
        color: rgba(245, 245, 245, 0.14);
        font-family: var(--font-casual);
      }
      #lost-path {
        position: fixed;
        bottom: clamp(60px, 10vw, 70px);
        left: 50%;
        transform: translateX(-50%);
        font-size: clamp(8px, 0.4vw + 6px, 9px);
        letter-spacing: clamp(1px, 0.3vw + 0.5px, 2px);
        color: rgba(245, 245, 245, 0.12);
        pointer-events: none;
        z-index: 40;
        max-width: min(300px, 80vw);
        text-align: center;
        word-break: break-all;
        padding: 0 1rem;
      }

      #creature-tooltip {
        position: fixed;
        z-index: 200;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s ease;
        background: rgba(10, 10, 10, 0.9);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        padding: 8px 12px;
        backdrop-filter: blur(4px);
        min-width: 100px;
      }
      #creature-tooltip.visible {
        opacity: 1;
      }
      #creature-tooltip .name {
        font-size: 13px;
        color: rgba(245, 245, 245, 0.85);
        letter-spacing: 1px;
        margin-bottom: 4px;
      }
      #creature-tooltip .details {
        font-size: 9px;
        color: rgba(245, 245, 245, 0.45);
        letter-spacing: 0.5px;
      }
      #creature-tooltip .personality {
        font-size: 8px;
        color: rgba(245, 245, 245, 0.3);
        margin-top: 3px;
        font-style: italic;
        font-family: var(--font-casual);
      }
      #creature-tooltip .stats {
        font-size: 8px;
        color: rgba(245, 245, 245, 0.35);
        margin-top: 4px;
        display: flex;
        gap: 8px;
      }

      /* Pickup progress indicator */
      #pickup-ring {
        position: fixed;
        pointer-events: none;
        z-index: 150;
        opacity: 0;
      }

      #toast {
        position: fixed;
        bottom: clamp(70px, 12vw, 80px);
        left: 50%;
        transform: translateX(-50%);
        color: rgba(245, 245, 245, 0.5);
        font-size: clamp(9px, 0.5vw + 7px, 11px);
        letter-spacing: clamp(2px, 0.4vw + 1px, 3px);
        text-transform: uppercase;
        z-index: 200;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
        text-align: center;
        max-width: 90vw;
        padding: 0 1rem;
        font-family: var(--font-casual);
      }
      #toast.show {
        opacity: 1;
      }

      #home {
        position: fixed;
        bottom: clamp(16px, 3vw, 24px);
        left: 50%;
        transform: translateX(-50%);
        background: transparent;
        color: rgba(245, 245, 245, 0.25);
        font-family: inherit;
        font-size: clamp(8px, 0.5vw + 6px, 9px);
        letter-spacing: clamp(2px, 0.5vw + 1px, 4px);
        text-transform: uppercase;
        /* Touch-friendly minimum size */
        padding: clamp(10px, 1.5vw, 12px) clamp(16px, 2vw, 20px);
        min-height: 44px;
        min-width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-border);
        transition:
          all 0.3s ease,
          text-shadow 0.15s ease;
        z-index: 100;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      @media (any-hover: hover) {
        #home:hover {
          color: rgba(245, 245, 245, 0.6);
          border-color: rgba(245, 245, 245, 0.2);
          background: rgba(255, 255, 255, 0.02);
          text-shadow:
            calc(-1 * var(--chromatic-offset)) 0 0
              rgb(var(--chromatic-cyan) / var(--chromatic-opacity)),
            var(--chromatic-offset) 0 0
              rgb(var(--chromatic-red) / var(--chromatic-opacity));
        }
      }
      #home:focus {
        outline: none;
        color: rgba(245, 245, 245, 0.6);
        border-color: rgba(245, 245, 245, 0.3);
        background: rgba(255, 255, 255, 0.02);
      }

      #controls {
        position: fixed;
        bottom: max(clamp(16px, 3vw, 24px), env(safe-area-inset-bottom));
        right: max(clamp(16px, 3vw, 24px), env(safe-area-inset-right));
        z-index: 100;
      }
      #controls button {
        background: transparent;
        border: 1px solid var(--color-border);
        color: rgba(245, 245, 245, 0.2);
        /* Touch-friendly minimum size */
        padding: clamp(6px, 1vw, 10px) clamp(10px, 1.5vw, 14px);
        min-height: 44px;
        min-width: 44px;
        font-size: clamp(7px, 0.4vw + 5px, 8px);
        cursor: pointer;
        font-family: inherit;
        transition:
          all 0.3s ease,
          text-shadow 0.15s ease;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      #controls button:hover {
        border-color: rgba(245, 245, 245, 0.2);
        color: rgba(245, 245, 245, 0.5);
        text-shadow:
          calc(-1 * var(--chromatic-offset)) 0 0
            rgb(var(--chromatic-cyan) / var(--chromatic-opacity)),
          var(--chromatic-offset) 0 0
            rgb(var(--chromatic-red) / var(--chromatic-opacity));
      }
    </style>
  </head>
  <body>
    <canvas id="game"></canvas>

    <div id="title">
      <h1>404</h1>
      <p id="title-sub"></p>
    </div>

    <!-- Population count shown in browser title for cleaner UX -->

    <div id="creature-tooltip">
      <div class="name"></div>
      <div class="details"></div>
      <div class="stats"></div>
      <div class="personality"></div>
    </div>
    <canvas id="pickup-ring" width="60" height="60"></canvas>

    <div id="lost-path"></div>
    <div id="toast"></div>
    <button id="home">go back home</button>

    <div id="controls">
      <button id="btn-reset">reset</button>
    </div>

    <script>
      import { initVoidGame } from "../scripts/void-game";

      const _cleanup = initVoidGame({
        canvas: document.getElementById("game") as HTMLCanvasElement,
        lostPath: document.getElementById("lost-path")!,
        titleSub: document.getElementById("title-sub")!,
        title: document.getElementById("title")!,
        toast: document.getElementById("toast")!,
        tooltip: document.getElementById("creature-tooltip")!,
        pickupRing: document.getElementById("pickup-ring") as HTMLCanvasElement,
        homeBtn: document.getElementById("home") as HTMLButtonElement,
        resetBtn: document.getElementById("btn-reset") as HTMLButtonElement,
      });
    </script>
  </body>
</html>
