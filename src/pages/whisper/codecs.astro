    width: calc(var(--wave) * min(65vw, 460px));
    height: calc(var(--wave) * min(65vw, 460px));
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1.5px solid rgb(0 255 255 / calc(var(--intensity) * 0.55));
    box-shadow:
      0 0 12px rgb(0 255 255 / calc(var(--intensity) * 0.2)),
      inset 0 0 12px rgb(0 255 255 / calc(var(--intensity) * 0.1));
    background: none;
  }

  /* second ring — expands faster, thinner, ghostly echo */
  .bond-flash::after {
    content: "";
    position: absolute;
    inset: -25%;
    border-radius: 50%;
    border: 0.5px solid rgb(0 255 255 / calc(var(--intensity) * 0.25));
    box-shadow: 0 0 8px rgb(0 255 255 / calc(var(--intensity) * 0.08));
  }

  .mobius-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: ring-orbit 10s linear infinite;
