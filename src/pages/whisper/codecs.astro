  }

  /* ── act 6 — the loop ─────────────────────────────────── */

  .act--loop {
    height: 260vh;
  }

  .loop-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* slow ratchet rotation as icons collapse */
    transform: rotate(calc(var(--p) * 60deg));
