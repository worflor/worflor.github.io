    will-change: transform;
  }

  .ring-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgb(0 255 255 / 0.55);
    left: calc(50% - 2px);
    top: calc(50% - 2px);
    transform-style: preserve-3d;
    transform:
      rotateY(calc(var(--i) * 15deg))
      translateZ(min(80px, 11vw));
    /* fade lives on each dot, not the parent, to preserve 3d context */
    opacity: calc(clamp(0, (var(--p) - 0.48) * 5, 1));
  }

  @keyframes ring-orbit {
    from { transform: rotateY(0deg) rotateX(25deg); }
    to { transform: rotateY(360deg) rotateX(25deg); }
  }

  .act--kizuna .copy {
    --reveal: clamp(0, (var(--p) - 0.04) * 4, 1);
  }

  /* ── act 5 — crystallization ──────────────────────────── */

  .act--crystal {
    height: 280vh;
  }

  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .temp-gauge {
