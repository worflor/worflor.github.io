  .loop-icon {
    position: absolute;
    width: 28px;
    height: 28px;
    color: rgb(0 255 255 / 0.55);
    transform:
      rotate(calc(var(--i) * 60deg))
      translateY(calc((1 - var(--p)) * min(-18vw, -100px)))
      rotate(calc(var(--i) * -60deg))
      /* counter-rotate the ratchet so icons stay upright */
      rotate(calc(var(--p) * -60deg));
    opacity: calc(1 - var(--p) * 0.9);
  }

  .loop-icon svg {
    width: 100%;
    height: 100%;
  }

  .loop-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(0 255 255);
