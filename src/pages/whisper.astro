  <script>
    const WHISPER_LIFECYCLE_KEY = "__whisperLifecycle";
    type WhisperLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };

    type WhisperRuntimeMode =
      | "embed"
      | "extract"
      | "hunt"
      | "live"
      | "seal"
      | "campfire";
    type WhisperModuleKey = "whisper" | "live" | "seal" | "campfire";
    type WhisperModuleLoader = {
      resolveOptions: (root: ParentNode) => unknown | null;
      init: (options: unknown) => (() => void) | void;
    };

    const MODE_LABELS: Record<WhisperRuntimeMode, string> = {
      embed: "embed",
      extract: "extract",
      hunt: "hunt",
      live: "live",
      seal: "seal",
      campfire: "campfire",
    };

    const modulePromiseCache = new Map<WhisperModuleKey, Promise<WhisperModuleLoader>>();

    function loadWhisperModule(key: WhisperModuleKey): Promise<WhisperModuleLoader> {
      if (!modulePromiseCache.has(key)) {
        const cacheWithRetry = (promise: Promise<WhisperModuleLoader>): void => {
          modulePromiseCache.set(
            key,
            promise.catch((error) => {
              modulePromiseCache.delete(key);
              throw error;
            }),
          );
        };
        if (key === "whisper") {
          cacheWithRetry(
            import("../scripts/whisper/ui").then((mod) => ({
              resolveOptions: (root: ParentNode) => mod.resolveWhisperUIOptions(root),
              init: (options: unknown) => mod.initWhisper(options as Parameters<typeof mod.initWhisper>[0]),
            })),
          );
        } else if (key === "live") {
          cacheWithRetry(
            import("../scripts/whisper/live-ui").then((mod) => ({
              resolveOptions: (root: ParentNode) => mod.resolveWhisperLiveUIOptions(root),
              init: (options: unknown) => mod.initWhisperLive(options as Parameters<typeof mod.initWhisperLive>[0]),
            })),
          );
        } else if (key === "seal") {
          cacheWithRetry(
            import("../scripts/whisper/seal-ui").then((mod) => ({
              resolveOptions: (root: ParentNode) => mod.resolveWhisperSealUIOptions(root),
              init: (options: unknown) => mod.initWhisperSeal(options as Parameters<typeof mod.initWhisperSeal>[0]),
            })),
          );
        } else {
          cacheWithRetry(
            import("../scripts/whisper/campfire/ui").then((mod) => ({
              resolveOptions: (root: ParentNode) => mod.resolveCampfireUIOptions(root),
              init: (options: unknown) => mod.initCampfire(options as Parameters<typeof mod.initCampfire>[0]),
            })),
          );
        }
      }
      return modulePromiseCache.get(key)!;
    }

    let baseWhisperCleanup: (() => void) | null = null;
    let activeEnhancementCleanup: (() => void) | null = null;
    let activeEnhancementKey: Exclude<WhisperModuleKey, "whisper"> | null = null;
    let moduleLoadToken = 0;
    let sealHashHintActive = window.location.hash.startsWith("#ws2:");
    let modeObserver: MutationObserver | null = null;
    let submodeAbort: AbortController | null = null;
    const whisperWindow = window as unknown as Record<
      string,
      WhisperLifecycle | undefined
    >;

    const MESSAGE_PLACEHOLDERS = [
      "your secret message...",
      "confess your true feelings...",
      "whats on your mind - but more importantly... how do you communicate it?",
    ];

    function setModuleLoading(isLoading: boolean, mode?: WhisperRuntimeMode): void {
      const page = document.getElementById("whisper-page") as HTMLElement | null;
      const statusLine = document.getElementById("whisper-status-line") as HTMLElement | null;
      if (!page) return;

      page.dataset.moduleLoading = isLoading ? "1" : "0";
      if (!statusLine) return;

      if (isLoading) {
        if (!statusLine.dataset.prevStatusLine) {
          statusLine.dataset.prevStatusLine = statusLine.textContent ?? "";
        }
        statusLine.textContent = `loading ${MODE_LABELS[mode ?? "embed"]} module...`;
        return;
      }

      if (statusLine.dataset.prevStatusLine !== undefined) {
        statusLine.textContent = statusLine.dataset.prevStatusLine;
        delete statusLine.dataset.prevStatusLine;
      }
    }

    function resolveRuntimeMode(page: HTMLElement): WhisperRuntimeMode {
      const mode = page.dataset.mode;
      if (sealHashHintActive && window.location.hash.startsWith("#ws2:")) return "seal";
      if (mode === "seal" || mode === "campfire") return mode;
      if (mode === "live") {
        const selected = document.querySelector<HTMLInputElement>(
          'input[name="wl-live-submode"]:checked',
        )?.value;
        return selected === "campfire" ? "campfire" : "live";
      }
      if (mode === "embed" && page.dataset.carrier === "url") return "seal";
      if (mode === "extract" || mode === "hunt") return mode;
      return "embed";
    }

    function moduleForMode(mode: WhisperRuntimeMode): WhisperModuleKey {
      if (mode === "live") return "live";
      if (mode === "seal") return "seal";
      if (mode === "campfire") return "campfire";
      return "whisper";
    }

    function teardownEnhancementModule(): void {
      activeEnhancementCleanup?.();
      activeEnhancementCleanup = null;
      activeEnhancementKey = null;
    }

    function teardownBaseWhisperModule(): void {
      baseWhisperCleanup?.();
      baseWhisperCleanup = null;
    }

    async function ensureBaseWhisperModule(mode: WhisperRuntimeMode, token: number): Promise<void> {
      if (baseWhisperCleanup) return;
      const firstLoad = !modulePromiseCache.has("whisper");
      if (firstLoad) setModuleLoading(true, mode);
      try {
        const loader = await loadWhisperModule("whisper");
        if (token !== moduleLoadToken) return;
        const options = loader.resolveOptions(document);
        if (!options) return;
        const cleanup = loader.init(options);
        baseWhisperCleanup = typeof cleanup === "function" ? cleanup : null;
      } finally {
        if (firstLoad && token === moduleLoadToken) {
          setModuleLoading(false);
        }
      }
    }

    async function ensureRuntimeModule(mode: WhisperRuntimeMode): Promise<void> {
      const token = ++moduleLoadToken;
      await ensureBaseWhisperModule(mode, token);
      if (token !== moduleLoadToken) return;

      const key = moduleForMode(mode);
      if (key === "whisper") {
        teardownEnhancementModule();
        return;
      }
      if (activeEnhancementKey === key && activeEnhancementCleanup) return;

      teardownEnhancementModule();
      const firstLoad = !modulePromiseCache.has(key);
      if (firstLoad) setModuleLoading(true, mode);

      try {
        const loader = await loadWhisperModule(key);
        if (token !== moduleLoadToken) return;
        const options = loader.resolveOptions(document);
        if (!options) return;
        const cleanup = loader.init(options);
        activeEnhancementCleanup = typeof cleanup === "function" ? cleanup : null;
        activeEnhancementKey = key;
      } finally {
        if (firstLoad && token === moduleLoadToken) {
          setModuleLoading(false);
        }
      }
    }

    function syncRuntimeMode(): void {
      const page = document.getElementById("whisper-page") as HTMLElement | null;
      if (!page) return;
      const mode = resolveRuntimeMode(page);
      if (mode === "seal" && sealHashHintActive) {
        sealHashHintActive = false;
      }
      void ensureRuntimeModule(mode);
    }

    function boot() {
      teardown();
      const msgArea =
        document.querySelector<HTMLTextAreaElement>("#ws-message");
      if (msgArea)
        msgArea.placeholder =
          MESSAGE_PLACEHOLDERS[
            Math.floor(Math.random() * MESSAGE_PLACEHOLDERS.length)
          ];

      // Wire up collapsible runtime log
      const logWrap = document.getElementById("whisper-log-wrap");
      const logHeader = logWrap?.querySelector<HTMLElement>(
        ".whisper-log-header",
      );
      if (logWrap && logHeader) {
        const STORAGE_KEY = "whisper-log-collapsed";
        if (localStorage.getItem(STORAGE_KEY) === "1") {
          logWrap.classList.add("whisper-log-collapsed");
          logHeader.setAttribute("aria-expanded", "false");
        }
        logHeader.addEventListener("click", () => {
          const collapsed = logWrap.classList.toggle("whisper-log-collapsed");
          logHeader.setAttribute("aria-expanded", String(!collapsed));
          localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
        });
        logHeader.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            logHeader.click();
          }
        });
      }

      // Wire up Live sub-mode toggle (1:1 vs Campfire)
      const submodeRadios = document.querySelectorAll<HTMLInputElement>(
        'input[name="wl-live-submode"]',
      );
      const livePhaseIds = [
        "wl-idle-phase",
        "wl-offer-section",
        "wl-answer-section",
        "wl-connecting-section",
        "wl-verify-section",
        "wl-chat-section",
        "wl-silent-section",
        "wl-disconnected-section",
        "wl-error-section",
      ];
      const campfirePhaseIds = [
        "cf-idle-phase",
        "cf-waiting-section",
        "cf-connecting-section",
        "cf-active-section",
        "cf-ended-section",
      ];

      submodeAbort?.abort();
      submodeAbort = new AbortController();
      const submodeSignal = submodeAbort.signal;

      const phaseElements = (ids: string[]): HTMLElement[] =>
        ids
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el instanceof HTMLElement);

      const hasVisiblePhase = (elements: HTMLElement[]): boolean =>
        elements.some((el) => el.style.display !== "none");

      function syncLiveSubmode(mode: "1:1" | "campfire"): void {
        const livePhases = phaseElements(livePhaseIds);
        const campfirePhases = phaseElements(campfirePhaseIds);

        if (mode === "campfire") {
          for (const phase of livePhases) phase.style.display = "none";
          document
            .getElementById("wl-section")
            ?.classList.remove("wl-connected", "wl-recovering");
          if (!hasVisiblePhase(campfirePhases)) {
            const cfIdle = document.getElementById("cf-idle-phase");
            if (cfIdle instanceof HTMLElement) cfIdle.style.display = "";
          }
          return;
        }

        for (const phase of campfirePhases) phase.style.display = "none";
        if (!hasVisiblePhase(livePhases)) {
          const wlIdle = document.getElementById("wl-idle-phase");
          if (wlIdle instanceof HTMLElement) wlIdle.style.display = "";
        }
      }

      submodeRadios.forEach((radio) => {
        radio.addEventListener(
          "change",
          () => {
            if (!radio.checked) return;
            const mode = radio.value === "campfire" ? "campfire" : "1:1";
            sessionStorage.setItem("whisper-live-submode", mode);
            syncLiveSubmode(mode);
            syncRuntimeMode();
          },
          { signal: submodeSignal },
        );
      });

      window.addEventListener(
        "whisper-live-funnel",
        async (event: Event) => {
          const custom = event as CustomEvent<{
            mode?: "1:1" | "campfire";
            bootstrap?: boolean;
          }>;
          const mode = custom.detail?.mode === "campfire" ? "campfire" : "1:1";
          sessionStorage.setItem("whisper-live-submode", mode);
          syncLiveSubmode(mode);
          const page = document.getElementById("whisper-page");
          if (page instanceof HTMLElement) {
            const funnelRuntimeMode =
              mode === "campfire" ? "campfire" : resolveRuntimeMode(page);
            await ensureRuntimeModule(funnelRuntimeMode);
          }

          if (mode === "campfire" && custom.detail?.bootstrap) {
            window.dispatchEvent(
              new CustomEvent("whisper-campfire-bootstrap", {
                detail: {
                  source: "live-vote",
                  phrase:
                    (
                      document.getElementById(
                        "wl-phrase",
                      ) as HTMLInputElement | null
                    )?.value?.trim() ?? "",
                },
              }),
            );
          }
        },
        { signal: submodeSignal },
      );

      window.addEventListener(
        "hashchange",
        () => {
          sealHashHintActive = window.location.hash.startsWith("#ws2:");
          syncRuntimeMode();
        },
        { signal: submodeSignal },
      );

      const savedSubmode = sessionStorage.getItem("whisper-live-submode");
      if (savedSubmode === "campfire" || savedSubmode === "1:1") {
        const target = Array.from(submodeRadios).find(
          (r) => r.value === savedSubmode,
        );
        if (target) target.checked = true;
      }
      const checkedMode = Array.from(submodeRadios).find(
        (r) => r.checked,
      )?.value;
      syncLiveSubmode(checkedMode === "campfire" ? "campfire" : "1:1");

      const page = document.getElementById("whisper-page") as HTMLElement | null;
      if (page) {
        modeObserver = new MutationObserver(() => {
          syncRuntimeMode();
        });
        modeObserver.observe(page, {
          attributes: true,
          attributeFilter: ["data-mode", "data-carrier"],
        });
      }

      syncRuntimeMode();
    }

    function teardown() {
      moduleLoadToken += 1;
      setModuleLoading(false);
      teardownEnhancementModule();
      teardownBaseWhisperModule();
      submodeAbort?.abort();
      submodeAbort = null;
      modeObserver?.disconnect();
      modeObserver = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = whisperWindow[WHISPER_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) {
        prev.detach();
      } else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", handleBeforeSwap);
      }
      prev.teardown?.();
    }

    whisperWindow[WHISPER_LIFECYCLE_KEY] = {
      boot,
      teardown,
      detach: detachLifecycle,
    };

    boot();
    attachLifecycle();
  </script>
</Layout>

