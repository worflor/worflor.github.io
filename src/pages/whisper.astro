<script is:inline>
  (function () {
    var p = document.getElementById("whisper-page");
    if (!p) return;

    // P2P/E2E Tooltip mobile interaction
    var badge = p.querySelector(".wl-e2e-badge");
    if (badge) {
      badge.addEventListener("pointerdown", function (e) {
        e.stopPropagation();
        var el = e.currentTarget;
        var live = el.closest(".whisper-op-live");
        if (!live) return;

        var isConnected =
          live.classList.contains("wl-connected") ||
          live.classList.contains("wl-recovering") ||
          live.classList.contains("wl-preview");

        if (isConnected) {
          el.classList.toggle("wl-e2e-tip--open");
        }
      });
    }

    document.addEventListener("pointerdown", function (e) {
      if (badge && !badge.contains(e.target)) {
        badge.classList.remove("wl-e2e-tip--open");
      }
    });
  })();
</script>

