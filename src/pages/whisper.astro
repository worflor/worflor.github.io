    cursor: pointer;
    list-style: none;
    font-size: calc(var(--text-sm) * 0.85);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.5;
    user-select: none;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .whisper-extract-advanced-summary::-webkit-details-marker { display: none; }
  .whisper-extract-advanced-summary::before {
    content: "+ ";
    display: inline-block;
    width: 1em;
  }
  .whisper-extract-advanced[open] .whisper-extract-advanced-summary::before {
    content: "− ";
