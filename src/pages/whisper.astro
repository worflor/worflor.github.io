  }

  :global(.wl-tool-sep) {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--color-text-rgb) / 0.18);
    user-select: none;
  }

  :global(.wl-join-row) {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
    flex-wrap: nowrap;
    min-width: 0;
  }

  :global(.wl-join-row .whisper-input) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.wl-join-row .whisper-mini-btn) {
    flex: 0 0 auto;
    min-width: 5.25rem;
  }

  :global(.wl-code-input) {
    flex: 1;
    min-width: 0;
    font-family: var(--whisper-font-mono);
    font-size: calc(var(--text-sm) * 0.9);
  }

  :global(.whisper-mini-btn.wl-primary) {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border-color: rgb(var(--chromatic-cyan) / 0.28);
    color: rgb(var(--chromatic-cyan));
  }

  :global(.whisper-mini-btn.wl-primary):hover {
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    color: rgb(var(--chromatic-cyan));
  }

  :global(.whisper-mini-btn.wl-primary):focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
  }

  /* Card-local spacing without inflating the panel itself */
  :global(.wl-card .wl-join-row),
  :global(.wl-card .wl-code-display-wrap) {
    margin-top: calc(var(--space-xs) * 0.6);
  }

  :global(.wl-card .whisper-mini-btn) {
    justify-content: center;
  }

  :global(.wl-card .wl-primary) {
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.06);
  }

  :global(.wl-join-tools) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--space-xs) * 0.35);
    margin-top: calc(var(--space-xs) * 0.3);
  }

  :global(.wl-join-qr-panel) {
    border: 1px solid rgb(var(--chromatic-cyan) / 0.18);
    border-radius: var(--whisper-radius-tight);
    background: rgb(var(--chromatic-cyan) / 0.04);
    padding: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.5);
  }

  :global(.wl-join-qr-video) {
    width: 100%;
    max-height: 16rem;
    border-radius: var(--whisper-radius-inner);
    background: rgb(var(--color-bg-rgb));
    object-fit: cover;
  }

  :global(.wl-join-qr-status) {
    display: block;
    margin-top: calc(var(--space-xs) * 0.5);
  }

  :global(.wl-join-qr-status):empty {
    display: none;
  }

  :global(.wl-live-qr-wrap) {
    display: grid;
    justify-items: center;
    gap: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.55);
    padding-top: calc(var(--space-xs) * 0.25);
    border-top: 1px dashed rgb(var(--color-text-rgb) / 0.08);
  }

  :global(.wl-live-qr-toggle-row) {
    margin-top: calc(var(--space-xs) * 0.6);
    display: flex;
    justify-content: center;
  }

  :global(.wl-offer-actions) {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(var(--space-xs) * 0.75);
  }

  :global(.wl-live-qr-status) {
    text-align: center;
    min-height: 1.2em;
  }

  /* ── Live mode responsive ────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto auto;
    }

    .wl-head-title-row {
      grid-column: 1 / -1;
    }

    .wl-head-subtitle {
      grid-column: 1 / -1;
    }

    .wl-status-row {
      grid-row: 3;
      grid-column: 1;
      flex-wrap: wrap;
      gap: calc(var(--space-xs) * 0.5);
    }

    .wl-head-right {
      grid-column: 2;
      grid-row: 3;
      justify-self: end;
      align-self: center;
    }

    .whisper-op-live.wl-connected .wl-head-right {
      grid-row: 1;
    }

    .whisper-op-live.wl-connected .wl-head-title-row {
      grid-column: 1;
    }

    :global(.cf-live-mode-toggle) {
      margin-top: 0;
      width: auto;
    }

    :global(.cf-live-mode-toggle .cf-btn-verbose) {
      display: none;
    }

    :global(.cf-live-mode-toggle #wl-funnel-campfire) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(.wl-phase-lede) {
      font-size: calc(var(--text-sm) * 0.84);
    }

    :global(.wl-inline-hint) {
      font-size: calc(var(--text-sm) * 0.8);
    }

    :global(.wl-join-row .whisper-mini-btn) {
      min-width: 4.8rem;
      padding-inline: 0.65rem;
    }

    :global(.wl-offer-actions) {
      justify-content: stretch;
    }

    :global(.wl-offer-actions .whisper-mini-btn) {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    /* title and identity chip share one line always: the chip's name
       ellipsizes rather than the row breaking (the old drop-below-title
       layout read as a bug once the bond iris joined the chip). */
    .wl-head-title-row {
      flex-wrap: nowrap;
    }

    .wl-head-title {
      font-size: var(--text-ui-sm);
      white-space: nowrap;
    }

    .wl-e2e-badge {
      padding: 0.1em 0.35em;
    }
  }

  @media (max-height: 760px) {
    .wl-head-subtitle,
    :global(.wl-phase-lede) {
      line-height: 1.35;
    }
  }

  /* ── Live mode touch ─────────────────────────────────────── */
  @media (hover: none) {
    :global(.wl-create-btn):hover {
      background: rgb(var(--chromatic-cyan) / 0.08);
      border-color: rgb(var(--chromatic-cyan) / 0.3);
    }

    :global(.wl-create-btn):active {
      background: rgb(var(--chromatic-cyan) / 0.16);
      border-color: rgb(var(--chromatic-cyan) / 0.5);
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Live — Stage Mode
     wl-stage is toggled on <html> exactly while the chat phase
     (#wl-chat-section) is the visible phase. every rule below is
     scoped :root.wl-stage .whisper-page[data-mode="live"] (or, for
     the site header which lives outside .whisper-page, a :has()
     guard on :root) so nothing leaks into carrier/signature modes
     or other pages. selectors are wrapped in :global() throughout —
     :root is never rendered by this component, so a scoped selector
     starting there would never match. .wl-stage-fade / .wl-stage-
     log-wrap / .wl-stage-column are style-only hooks added to the
     hero, mode tabs, insights and runtime-log sections, and to the
     op-panel column. */

  @keyframes wl-stage-panel-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* site header slides away in stage mode. it lives outside
     .whisper-page (sibling in <body>), so it can only be reached
     from :root — :has() checks the live chat is actually active. */
  /* important beats the scroll auto-hide script, which writes an inline
     transform on the header every scroll tick. */
  :global(:root.wl-stage:has(.whisper-page[data-mode="live"]) .site-header) {
    transform: translateY(-100%) !important;
    transition: transform var(--duration-slow) var(--ease-out);
    pointer-events: none;
  }

  /* mode tabs must always stay clickable — dimmed chrome or not,
     the user needs a way out of stage mode. */
  :global(:root.wl-stage .whisper-page[data-mode="live"] .whisper-mode-bar) {
    pointer-events: auto;
  }

  @media (max-width: 700px) {
    /* mobile: the live section becomes the viewport. hero, tabs,
       insights and the runtime log are chrome — collapse them. */
    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-stage-fade),
    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-stage-log-wrap) {
      display: none;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] #wl-section) {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      height: 100dvh;
      margin: 0;
      padding: env(safe-area-inset-top) env(safe-area-inset-right)
        env(safe-area-inset-bottom) env(safe-area-inset-left);
      background: var(--color-bg);
      gap: 0;
      animation: wl-stage-panel-in var(--duration-slow) var(--ease-spring) both;
    }

    /* wl-head becomes the chat's own compact header, pinned at the
       top of the stage. */
    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-head) {
      flex: 0 0 auto;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-phase--chat) {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-panel) {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      border-radius: 0;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-messages) {
      flex: 1 1 auto;
      min-height: 0;
      max-height: none;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-compose) {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 701px) {
    /* tablet + desktop share this: normal document flow, but the
       chat panel gets real height instead of the clamp()-based one. */
    :global(:root.wl-stage .whisper-page[data-mode="live"] #wl-section) {
      animation: wl-stage-panel-in var(--duration-slow) var(--ease-spring) both;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-panel) {
      display: flex;
      flex-direction: column;
      /* half-set floor, max ceiling: a young conversation opens the panel at
         half the stage and it grows with the messages until it fills it,
         then scrolls. */
      min-height: min(39vh, 27rem);
      max-height: min(78vh, 54rem);
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-messages) {
      flex: 1 1 auto;
      min-height: 0;
      max-height: none;
    }

    :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-chat-compose) {
      flex: 0 0 auto;
    }
  }

  /* breathing room when the stage entrance scrolls the section into view */
  :global(:root.wl-stage .whisper-page[data-mode="live"] #wl-section) {
    scroll-margin-top: var(--space-lg);
  }

  /* stage header compacts to a single intentional row: title and badge,
     peer chip, then controls pushed right. the subtitle is chrome the
     e2e badge already covers, so it goes. */
  :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-head) {
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto;
    align-items: center;
  }

  :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-head-title-row) {
    display: contents;
  }

  :global(:root.wl-stage .whisper-page[data-mode="live"] .wl-head-subtitle) {
    display: none;
