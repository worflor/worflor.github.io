  .whisper-page[data-mode="seal"] .whisper-field--filter,
  .whisper-page[data-mode="extract"] .whisper-field--embed,
  .whisper-page[data-mode="seal"] .whisper-field--embed {
    display: none;
  }

  /* Operation panels — only the active mode shows. Seal and Live each
     have their own top-level panel; the others share .whisper-op-solo. */
  .whisper-page[data-mode="embed"] .whisper-op-live,
  .whisper-page[data-mode="extract"] .whisper-op-live,
  .whisper-page[data-mode="seal"] .whisper-op-live {
    display: none;
