    background: var(--whisper-surface);
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-icon {
    display: none;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-text {
    font-weight: 600;
    color: rgb(var(--color-text-rgb) / 0.86);
    margin: 0;
    word-break: break-word;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-subtext,
  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-formats {
    display: none;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-file-meta {
    display: block;
    margin-top: calc(var(--space-xs) * 0.35);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact):hover
    .upload-file-meta {
    color: rgb(var(--chromatic-cyan) / 0.55);
  }

  /* ── Operation Panel ───────────────────────────────────── */
  :global(.whisper-panel) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    padding: var(--space-sm);
    background: var(--whisper-surface);
    box-shadow: var(--edge-highlight);
    min-width: 0;
    overflow: hidden;
  }

  :global(.whisper-panel-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  :global(.whisper-panel-title) {
    margin: 0;
    font-size: var(--text-base);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  .whisper-op {
    display: none;
  }

  .whisper-page[data-busy="0"][data-mode="embed"] .whisper-op--embed,
  .whisper-page[data-busy="0"][data-mode="extract"] .whisper-op--extract,
  .whisper-page[data-busy="0"][data-mode="hunt"] .whisper-op--hunt {
    display: inline;
  }

  .whisper-page[data-busy="1"][data-mode="embed"] .whisper-op--embedding,
  .whisper-page[data-busy="1"][data-mode="extract"] .whisper-op--extracting,
  .whisper-page[data-busy="1"][data-mode="hunt"] .whisper-op--hunting {
    display: inline;
  }

  :global(.whisper-panel-mode) {
    font-size: var(--whisper-text-meta);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
    transition: color var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-panel-mode.whisper-status--ready) {
    color: rgb(var(--chromatic-cyan));
  }

  :global(.whisper-field) {
    display: grid;
    gap: calc(var(--space-xs) * 0.35);
    min-width: 0;
  }

  :global(.whisper-field-label) {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.62);
  }

  :global(.whisper-field-hint) {
    color: rgb(var(--color-text-rgb) / 0.32);
    font-size: var(--whisper-text-meta);
  }

  :global(#whisper-page input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="range"]):not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="hidden"])),
  :global(#whisper-page textarea),
  :global(#whisper-page select) {
    font-size: var(--whisper-text-input) !important;
  }

  :global(#whisper-page input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="range"]):not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="hidden"])::placeholder),
  :global(#whisper-page textarea::placeholder) {
    font-size: inherit !important;
  }

  :global(.whisper-input) {
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    border-radius: var(--whisper-radius-soft);
    background: rgb(10 10 10 / 0.9);
    color: var(--color-text);
    min-height: var(--touch-target);
    padding: var(--whisper-control-padding);
    font-family: var(--font-body);
    font-size: var(--whisper-text-input);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-input)::placeholder {
    color: rgb(var(--color-text-rgb) / 0.22);
    font-size: inherit;
  }

  :global(.whisper-input):focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.42);
    outline-offset: 0;
    border-color: rgb(var(--chromatic-cyan) / 0.34);
    box-shadow: none;
  }

  .whisper-password-row {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
    min-width: 0;
  }

  .whisper-password-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.whisper-mini-btn) {
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: var(--whisper-control-padding);
    border-radius: var(--whisper-radius-soft);
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(10 10 10 / 0.88);
    color: rgb(var(--color-text-rgb) / 0.6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .whisper-password-tools {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: stretch;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--whisper-radius-soft);
    background: rgb(var(--color-text-rgb) / 0.02);
    overflow: hidden;
  }

  .whisper-password-tools .whisper-mini-btn {
    border: 0;
    border-radius: 0;
    background: transparent;
    min-height: var(--touch-target);
  }

  .whisper-password-tools .whisper-mini-btn + .whisper-mini-btn {
    border-left: 1px solid rgb(var(--color-text-rgb) / 0.14);
  }

  :global(.whisper-mini-btn):hover {
    border-color: rgb(var(--color-text-rgb) / 0.22);
    background: rgb(var(--color-text-rgb) / 0.05);
    color: rgb(var(--color-text-rgb) / 0.75);
  }

  .whisper-password-tools .whisper-mini-btn:hover {
    border-color: transparent;
  }

  :global(.whisper-mini-btn):disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .whisper-password-meta {
    margin: 0;
  }

  .whisper-password-meta:empty {
    display: none;
  }

  :global(.whisper-mini-btn):focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  :global(.whisper-file-btn) {
    display: flex;
    align-items: center;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--whisper-radius-soft);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-file-btn):hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  :global(.whisper-file-btn-text) {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  :global(.whisper-toggle) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--whisper-radius-soft);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: var(--whisper-toggle-padding);
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-toggle):hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  :global(.whisper-toggle):focus-within {
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  :global(.whisper-toggle-input) {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: rgb(var(--chromatic-cyan));
    flex-shrink: 0;
  }

  :global(.whisper-toggle-text) {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.66);
  }

  /* ── Mode-conditional visibility ───────────────────────── */

  /* Field-level: hide hunt fields in embed/extract, embed fields in extract/hunt */
  .whisper-page[data-mode="embed"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--embed,
  .whisper-page[data-mode="hunt"] .whisper-field--embed {
    display: none;
  }

  /* Solo vs live: operation panels — only the active mode shows */
  .whisper-page[data-mode="embed"] .whisper-op-live,
  .whisper-page[data-mode="extract"] .whisper-op-live,
  .whisper-page[data-mode="hunt"] .whisper-op-live {
    display: none;
  }

  .whisper-page[data-mode="live"] .whisper-op-solo {
    display: none;
  }

  /* Solo-only sections: upload zone, progress, results, action bar.
     Keep insights visible across modes for continuity. */
  .whisper-page[data-mode="live"] #whisper-upload-zone,
  .whisper-page[data-mode="live"] #whisper-progress-section,
  .whisper-page[data-mode="live"] #whisper-results,
  .whisper-page[data-mode="live"] #whisper-download-area,
  .whisper-page[data-mode="live"] #whisper-actions {
    display: none;
  }

  /* Carrier toggle: only visible in embed mode */
  .whisper-page:not([data-mode="embed"]) .ws-carrier-toggle-wrap {
    display: none;
  }

  /* When carrier=url: hide file-specific embed fields, upload zone, and file password */
  .whisper-page[data-mode="embed"][data-carrier="url"]
    .whisper-field--embed:not(.ws-carrier-toggle-wrap):not([for="ws-message"]) {
    display: none;
  }
  .whisper-page[data-mode="embed"][data-carrier="url"] #whisper-upload-zone {
    display: none;
  }
  .whisper-page[data-mode="embed"][data-carrier="url"]
    .whisper-field--file-password {
    display: none;
  }

  /* When carrier=file (default): hide URL-only seal fields */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-url-only {
    display: none;
  }

  /* Seal fields hidden in non-embed modes */
  .whisper-page:not([data-mode="embed"]) .ws-seal-fields {
    display: none;
  }

  /* Seal mode chip + inline code only when carrier=url */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-btn,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-inline,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"])
    .ws-my-seal-inline-panel {
    display: none;
  }

  /* Password tools (generate/copy) only in embed mode; paste link only in extract/hunt */
  .whisper-page:not([data-mode="embed"]) .whisper-password-tools {
    display: none;
  }

  /* Overlay hides solo panel when active (JS-managed via style) */
  :global(.ws-overlay) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  /* Hide overlay in live mode */
  :global(.whisper-page[data-mode="live"] .ws-overlay) {
    display: none;
  }

  /* ── Progress ──────────────────────────────────────────── */
  .whisper-progress {
    height: 4px;
    border-radius: 2px;
    background: rgb(var(--color-text-rgb) / 0.06);
    overflow: hidden;
  }

  .whisper-progress-fill {
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-cyan));
    border-radius: 2px;
    transition: width 0.3s linear;
  }

  .whisper-progress-fill:global(.whisper-progress--indeterminate) {
    width: 100%;
    animation: whisper-progress-pulse 1.5s ease-in-out infinite;
  }

  @keyframes whisper-progress-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* ── Results ───────────────────────────────────────────── */
  .whisper-results {
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
  }

  :global(.whisper-result) {
    margin: 0;
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius-soft);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  :global(.whisper-result--ok) {
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--color-text-rgb) / 0.86);
    background: rgb(var(--chromatic-cyan) / 0.03);
  }

  :global(.whisper-result--warn) {
    border-color: rgb(var(--tool-status-warning) / 0.35);
    color: rgb(var(--tool-status-warning));
    background: rgb(var(--tool-status-warning) / 0.04);
  }

  :global(.whisper-result--error) {
    border-color: rgb(var(--chromatic-red) / 0.35);
    color: rgb(var(--chromatic-red));
    background: rgb(var(--chromatic-red) / 0.04);
  }

  /* ── Downloads ─────────────────────────────────────────── */
  .whisper-downloads {
    margin-top: var(--space-sm);
    display: grid;
    gap: calc(var(--space-xs) * 0.45);
  }

  :global(.whisper-download-card) {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius-soft);
    padding: 0.7rem 0.8rem;
    background: var(--whisper-surface);
    display: grid;
    gap: calc(var(--space-xs) * 0.25);
    box-shadow: var(--edge-highlight);
  }

  :global(.whisper-download-title),
  :global(.whisper-download-meta) {
    margin: 0;
  }

  :global(.whisper-download-title) {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  :global(.whisper-download-meta) {
    font-size: calc(var(--text-sm) * 0.9);
    color: rgb(var(--color-text-rgb) / 0.42);
  }

  :global(.whisper-download-link) {
    width: fit-content;
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.35);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-download-link):hover,
  :global(.whisper-download-link):focus-visible {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
    outline: none;
  }

  /* ── Log ────────────────────────────────────────────────── */
  .whisper-log-wrap {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    background: rgb(var(--color-text-rgb) / 0.01);
    overflow: hidden;
    box-shadow: var(--edge-highlight);
  }

  .whisper-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--whisper-edge);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .whisper-log-header:hover .whisper-log-title {
    color: rgb(var(--color-text-rgb) / 0.58);
  }

  .whisper-log-header-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .whisper-log-chevron {
    width: 0.75rem;
    height: 0.75rem;
    color: rgb(var(--color-text-rgb) / 0.3);
    transition: transform var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-chevron {
    transform: rotate(-90deg);
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-header {
    border-bottom-color: transparent;
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-output {
    max-height: 0;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
  }

  .whisper-log-output {
    transition:
      max-height var(--duration-normal) var(--ease-out),
      min-height var(--duration-normal) var(--ease-out),
      padding var(--duration-normal) var(--ease-out);
  }

  .whisper-log-title {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
  }

  :global(.whisper-log-hint) {
    margin: 0;
    padding: 0.45rem 0.8rem 0;
    font-size: var(--whisper-text-micro);
    color: rgb(var(--color-text-rgb) / 0.38);
    line-height: 1.35;
  }

  .whisper-log-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.12);
    flex-shrink: 0;
    transition: background var(--duration-slow) var(--ease-out);
  }

  .whisper-log-dot:global(.whisper-log-active) {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.4);
    animation: whisper-log-blink 1s ease-in-out infinite;
  }

  @keyframes whisper-log-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .whisper-log-output {
    margin: 0;
    min-height: 7rem;
    max-height: clamp(14rem, 12rem + 8vw, 24rem);
    overflow: auto;
    font-family: var(--whisper-font-mono);
    font-size: calc(var(--text-sm) * 0.9);
    line-height: 1.6;
    padding: 0.65rem 0.8rem;
    color: rgb(var(--color-text-rgb) / 0.6);
    background: transparent;
  }

  /* ── Insights ──────────────────────────────────────────── */
  .whisper-insights {
    display: grid;
    gap: calc(var(--space-xs) * 0.9);
  }

  .insights-title {
    margin: 0;
    font-size: var(--text-lg);
    color: rgb(var(--color-text-rgb) / 0.8);
    letter-spacing: -0.01em;
  }

  .insights-text {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.44);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .insights-text strong {
    color: rgb(var(--color-text-rgb) / 0.55);
    font-weight: 500;
  }

  .insights-text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    text-decoration-color: rgb(var(--color-text-rgb) / 0.3);
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .insights-text a:visited {
    color: inherit;
  }

  .insights-text a:hover {
    color: rgb(var(--color-text-rgb) / 0.68);
    text-decoration-color: rgb(var(--color-text-rgb) / 0.5);
  }

  .insights-text a:focus-visible {
    outline: 1px solid rgb(var(--color-text-rgb) / 0.45);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .insights-text em {
    color: rgb(var(--color-text-rgb) / 0.65);
    font-style: italic;
  }

  /* ── Fixed Action Bar ──────────────────────────────────── */
  .whisper-actions {
    border-radius: var(--whisper-radius);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    max-width: min(
      var(--content-width),
      calc(100vw - 2 * clamp(0.75rem, 4vw, 1.5rem))
    );
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .whisper-actions::-webkit-scrollbar {
    display: none;
  }

  .action-btn {
    border-radius: calc(var(--whisper-radius) * 0.625);
  }

  .action-btn--primary {
    background: rgb(var(--tool-action-run) / 0.1);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:hover:not(:disabled) {
    background: rgb(var(--tool-action-run) / 0.18);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:global(.action-btn--loading) {
    background: rgb(var(--tool-action-load) / 0.16);
    color: rgb(var(--tool-action-load));
    pointer-events: none;
  }

  .action-btn--primary:global(.action-btn--ran) {
    animation: whisper-run-ack 900ms var(--ease-spring);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.22) 0%,
      rgb(var(--chromatic-cyan) / 0.1) 100%
    );
    color: rgb(var(--chromatic-cyan));
    border: 1px solid rgb(var(--chromatic-cyan) / 0.35);
  }

  @keyframes whisper-run-ack {
    0% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
    35% {
      transform: translateY(-1px) scale(1.03);
      box-shadow: 0 0 14px rgb(var(--chromatic-cyan) / 0.24);
    }
    100% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
  }

  .action-btn--icon {
    min-width: var(--touch-target);
    padding-inline: calc(var(--space-xs) * 0.8);
  }

  .lens-handoff-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .action-btn:hover:not(:disabled) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .action-btn:disabled {
    cursor: not-allowed;
    color: rgb(var(--color-text-rgb) / 0.38);
    background: transparent;
    opacity: 1;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .whisper-upload-zone {
      padding: var(--space-lg) var(--space-sm);
    }

    .upload-icon {
      display: none;
    }

    .whisper-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }

  /* ── Touch devices ─────────────────────────────────────── */
  @media (hover: none) {
    .whisper-upload-zone:hover {
      border-color: rgb(var(--color-text-rgb) / 0.14);
      background: linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.012) 0%,
        transparent 60%
      );
      box-shadow: var(--edge-highlight);
    }

    .whisper-upload-zone:hover .upload-icon {
      color: rgb(var(--color-text-rgb) / 0.14);
      transform: none;
    }

    .whisper-upload-zone:hover .upload-text {
      color: rgb(var(--color-text-rgb) / 0.6);
    }

    .whisper-upload-zone:active {
      border-color: rgb(var(--chromatic-cyan) / 0.35);
      background: linear-gradient(
        180deg,
        rgb(var(--chromatic-cyan) / 0.03) 0%,
        rgb(var(--chromatic-cyan) / 0.008) 50%,
        transparent 100%
      );
    }

    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }

    .action-btn--primary:hover {
      background: rgb(var(--tool-action-run) / 0.1);
      color: rgb(var(--tool-action-run));
    }

    .action-btn--primary:active {
      background: rgb(var(--tool-action-run) / 0.2);
    }

    .whisper-mode-btn:not(.whisper-mode-btn--active):hover {
      color: rgb(var(--color-text-rgb) / 0.55);
      border-color: transparent;
    }

    .whisper-mode-btn:not(.whisper-mode-btn--active):active {
      color: rgb(var(--color-text-rgb));
      border-color: rgb(var(--color-text-rgb) / 0.18);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .privacy-dot {
      animation: none;
    }

    :global(.wl-spinner) {
      animation: none;
    }

    .whisper-log-dot:global(.whisper-log-active) {
      animation: none;
    }

    .whisper-log-chevron {
      transition: none;
    }

    .whisper-log-output {
      transition: none;
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Live — Mode Styles
     ═══════════════════════════════════════════════════════ */

  .whisper-op-live {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  :global(.wl-phase) {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

  :global(.wl-phase--chat) {
    margin-top: 0;
  }

  :global(.whisper-op-live.wl-connected .wl-phase--chat) {
    margin-top: calc(var(--space-sm) * -1);
  }

  .wl-head {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: calc(var(--space-xs) * 0.6) var(--space-sm);
    background: var(--whisper-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      border-radius var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);

    /* Surgical fix: allow tooltip to overflow the panel */
    overflow: visible;
  }

  .wl-head-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    grid-column: 1;
    grid-row: 1;

    /* Ensure tooltip isn't clipped by the title row flexbox */
    overflow: visible;
  }

  .wl-head-title {
    margin: 0;
    font-size: var(--text-ui-base);
    line-height: 1.15;
    letter-spacing: 0.015em;
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  .wl-e2e-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-size: var(--whisper-text-hairline);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(var(--color-text-rgb) / 0.18);
    background: rgb(var(--color-text-rgb) / 0.04);
    border: 1px solid rgb(var(--color-text-rgb) / 0.06);
    border-radius: var(--whisper-radius-tight);
    padding: calc(var(--space-xs) * 0.15) calc(var(--space-xs) * 0.45);
    vertical-align: middle;
    user-select: none;
    position: relative;
    cursor: default;
    /* Strictly inert when not connected */
    pointer-events: none;
  }

  .whisper-op-live.wl-connected .wl-e2e-badge,
  .whisper-op-live.wl-recovering .wl-e2e-badge,
  .whisper-op-live.wl-preview .wl-e2e-badge {
    cursor: help;
    pointer-events: auto;
  }

  .wl-e2e-tip {
    --_tip-gap: calc(var(--space-xs) * 0.8);
    --_tip-arrow: 5px;
    --_tip-slide: 4px;

    position: absolute;
    bottom: calc(100% + var(--_tip-gap) + var(--_tip-arrow));
    left: 50%;
    transform: translateX(-50%) translateY(var(--_tip-slide));
    width: max-content;
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-xs) * 0.9);
    background: var(--color-bg);
    background-image: var(--surface-sheen);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow:
      var(--edge-highlight),
      0 8px 32px rgba(0, 0, 0, 0.5);
    color: var(--color-text-muted);
    font-size: var(--whisper-text-soft);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    z-index: 1000;
    white-space: nowrap;
    display: none;
  }

  .wl-e2e-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: var(--_tip-arrow) solid transparent;
    border-top-color: var(--color-border);
  }

  /* Hover/Focus states (only when active/preview) */
  .whisper-op-live.wl-connected .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-connected .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-connected .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip {
    display: block;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-e2e-tip {
      transition: none;
    }
  }

  .wl-e2e-dot {
    width: 0.3em;
    height: 0.3em;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.24);
    flex: 0 0 auto;
  }

  .whisper-op-live.wl-connected .wl-e2e-badge {
    color: rgb(var(--chromatic-cyan));
    border-color: rgb(var(--chromatic-cyan) / 0.35);
    background: rgb(var(--chromatic-cyan) / 0.06);
  }

  .whisper-op-live.wl-connected .wl-e2e-dot {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 6px rgb(var(--chromatic-cyan) / 0.45);
  }

  .whisper-op-live.wl-connected .wl-status-chip,
  .whisper-op-live.wl-recovering .wl-status-chip {
    display: none;
  }

  .whisper-op-live.wl-preview .wl-e2e-badge {
    color: rgb(var(--color-text-rgb) / 0.18);
    border-color: rgb(var(--color-text-rgb) / 0.06);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .whisper-op-live.wl-preview .wl-e2e-dot {
    background: rgb(var(--color-text-rgb) / 0.24);
    box-shadow: none;
  }

  .whisper-op-live.wl-recovering .wl-e2e-badge {
    animation: wl-badge-amber-flash 1.1s ease-in-out infinite;
  }

  .whisper-op-live.wl-recovering .wl-e2e-dot {
    background: rgb(var(--tool-status-warning));
    box-shadow: 0 0 6px rgb(var(--tool-status-warning) / 0.45);
  }

  @keyframes wl-badge-amber-flash {
    0%,
    100% {
      color: rgb(var(--tool-status-warning) / 0.5);
      border-color: rgb(var(--tool-status-warning) / 0.18);
      background: rgb(var(--tool-status-warning) / 0.04);
    }
    50% {
      color: rgb(var(--tool-status-warning));
      border-color: rgb(var(--tool-status-warning) / 0.4);
      background: rgb(var(--tool-status-warning) / 0.1);
    }
  }

  .wl-head-right {
    display: none;
    justify-self: end;
    grid-column: 2;
    grid-row: 3;
    align-self: center;
  }

  .whisper-op-live.wl-connected .wl-head {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow: none;
    padding-top: calc(var(--space-sm) * 0.6);
    padding-bottom: calc(var(--space-sm) * 0.6);
  }

  .whisper-op-live.wl-connected .wl-head-right {
    display: flex;
    grid-row: 1;
    min-width: 0;
    overflow: hidden;
    justify-self: stretch;
    justify-content: flex-end;
  }

  .whisper-op-live.wl-connected #wl-funnel-campfire {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .whisper-op-live.wl-connected .wl-disconnect-btn {
    flex-shrink: 0;
  }

  .whisper-op-live.wl-connected .cf-live-mode-toggle {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
  }

  .whisper-op-live.wl-connected .cf-live-mode-toggle .cf-head-btn {
    border-radius: 0;
    margin: 0;
  }

  .whisper-op-live.wl-connected .cf-live-mode-toggle .cf-head-btn + .cf-head-btn {
    margin-left: -1px;
  }

  .whisper-op-live.wl-connected .cf-live-mode-toggle .cf-head-btn:first-child {
    border-top-left-radius: calc(var(--whisper-radius) * 0.5);
    border-bottom-left-radius: calc(var(--whisper-radius) * 0.5);
  }

  .whisper-op-live.wl-connected .cf-live-mode-toggle .cf-head-btn:last-child {
    border-top-right-radius: calc(var(--whisper-radius) * 0.5);
    border-bottom-right-radius: calc(var(--whisper-radius) * 0.5);
  }

  .whisper-op-live.wl-connected .wl-head-subtitle {
    display: none;
  }

  .wl-head-subtitle {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.46);
    letter-spacing: 0.01em;
    grid-column: 1;
    grid-row: 2;
    max-width: 48ch;
  }

  .wl-head-meta {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.35);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .wl-status-row {
    display: none;
  }

  .wl-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0;
    overflow: hidden;
    padding: calc(var(--space-xs) * 0.5) calc(var(--space-xs) * 0.75);
    border-radius: var(--whisper-radius-soft);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(10 10 10 / 0.9);
    color: rgb(var(--color-text-rgb) / 0.62);
  }

  .wl-status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.24);
    box-shadow: 0 0 0 2px rgb(var(--color-text-rgb) / 0.06);
    flex: 0 0 auto;
  }

  .wl-status-text {
    font-size: calc(var(--text-sm) * 0.9);
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wl-status-text.whisper-status--ready {
    color: rgb(var(--chromatic-cyan));
  }

  .wl-status-chip:has(.wl-status-text.whisper-status--ready) .wl-status-dot {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.25);
  }

  :global(.wl-grid) {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  :global(.wl-phase-lede) {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.44);
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  :global(.wl-inline-hint) {
    margin: calc(var(--space-xs) * -0.15) 0 0;
    font-size: calc(var(--text-sm) * 0.84);
    color: rgb(var(--color-text-rgb) / 0.4);
    line-height: 1.35;
  }

  @media (min-width: 680px) {
    :global(.wl-grid) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    :global(.wl-grid.wl-grid--offer) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  :global(.wl-card) {
    /* Keep card content compact even when sibling cards are taller. */
    align-content: start;
  }

  :global(.wl-actions-panel) {
    gap: var(--space-xs);
    padding: var(--space-sm);
  }

  :global(.wl-actions-row) {
    display: flex;
    align-items: start;
    gap: var(--space-xs);
  }

  :global(.wl-action-label) {
    display: block;
    font-size: var(--whisper-text-fine);
    color: rgb(var(--color-text-rgb) / 0.38);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: calc(var(--space-xs) * 0.15);
  }

  :global(.wl-action-create) {
    flex: 0 0 auto;
  }

  :global(.wl-action-create .wl-primary) {
    white-space: nowrap;
  }

  :global(.wl-action-join) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.wl-actions-divider) {
    width: 1px;
    align-self: stretch;
    background: var(--whisper-edge);
    flex: 0 0 1px;
  }

  /* Shared spinner (used by connecting, seal overlay, campfire) */
  :global(.wl-spinner) {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(var(--color-text-rgb) / 0.1);
    border-top-color: rgb(var(--chromatic-cyan));
    border-radius: var(--radius-full);
    animation: wl-spin 0.8s linear infinite;
  }

  @keyframes wl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Inline text-link tools under join input */
  :global(.wl-tool-link) {
    all: unset;
    font-size: calc(var(--text-sm) * 0.78);
    color: rgb(var(--color-text-rgb) / 0.34);
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: color var(--duration-normal) var(--ease-out);
  }

  :global(.wl-tool-link):hover {
    color: rgb(var(--chromatic-cyan) / 0.85);
  }

  :global(.wl-tool-link):focus-visible {
    outline: none;
    color: rgb(var(--chromatic-cyan));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.wl-tool-link--stop) {
    color: rgb(var(--chromatic-red) / 0.55);
  }

  :global(.wl-tool-link--stop):hover {
    color: rgb(var(--chromatic-red) / 0.85);
  }

  :global(.wl-tool-sep) {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--color-text-rgb) / 0.18);
    user-select: none;
  }

  :global(.wl-join-row) {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
    flex-wrap: nowrap;
    min-width: 0;
  }

  :global(.wl-join-row .whisper-input) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.wl-join-row .whisper-mini-btn) {
    flex: 0 0 auto;
    min-width: 5.25rem;
  }

  :global(.wl-code-input) {
    flex: 1;
    min-width: 0;
    font-family: var(--whisper-font-mono);
    font-size: calc(var(--text-sm) * 0.9);
  }

  :global(.whisper-mini-btn.wl-primary) {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border-color: rgb(var(--chromatic-cyan) / 0.28);
    color: rgb(var(--chromatic-cyan));
  }

  :global(.whisper-mini-btn.wl-primary):hover {
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    color: rgb(var(--chromatic-cyan));
  }

  :global(.whisper-mini-btn.wl-primary):focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
  }

  /* Card-local spacing without inflating the panel itself */
  :global(.wl-card .wl-join-row),
  :global(.wl-card .wl-code-display-wrap) {
    margin-top: calc(var(--space-xs) * 0.6);
  }

  :global(.wl-card .whisper-mini-btn) {
    justify-content: center;
  }

  :global(.wl-card .wl-primary) {
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.06);
  }

  :global(.wl-join-tools) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--space-xs) * 0.35);
    margin-top: calc(var(--space-xs) * 0.3);
  }

  :global(.wl-join-qr-panel) {
    border: 1px solid rgb(var(--chromatic-cyan) / 0.18);
    border-radius: var(--whisper-radius-tight);
    background: rgb(var(--chromatic-cyan) / 0.04);
    padding: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.5);
  }

  :global(.wl-join-qr-video) {
    width: 100%;
    max-height: 16rem;
    border-radius: var(--whisper-radius-inner);
    background: rgb(var(--color-bg-rgb));
    object-fit: cover;
  }

  :global(.wl-join-qr-status) {
    display: block;
    margin-top: calc(var(--space-xs) * 0.5);
  }

  :global(.wl-join-qr-status):empty {
    display: none;
  }

  :global(.wl-live-qr-wrap) {
    display: grid;
    justify-items: center;
    gap: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.55);
    padding-top: calc(var(--space-xs) * 0.25);
    border-top: 1px dashed rgb(var(--color-text-rgb) / 0.08);
  }

  :global(.wl-live-qr-toggle-row) {
    margin-top: calc(var(--space-xs) * 0.6);
    display: flex;
    justify-content: center;
  }

  :global(.wl-offer-actions) {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(var(--space-xs) * 0.75);
  }

  :global(.wl-live-qr-status) {
    text-align: center;
    min-height: 1.2em;
  }

  /* ── Live mode responsive ────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto auto;
    }

    .wl-head-title-row {
      grid-column: 1 / -1;
    }

    .wl-head-subtitle {
      grid-column: 1 / -1;
    }

    .wl-status-row {
      grid-row: 3;
      grid-column: 1;
      flex-wrap: wrap;
      gap: calc(var(--space-xs) * 0.5);
    }

