---
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "Whisper | woflo",
  description:
    "Hide data inside files, send private sealed messages, and talk peer-to-peer. Everything encrypted, everything local. Nothing leaves your browser.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div class="whisper-page" id="whisper-page" data-mode="embed" data-busy="0" data-breadcrumb-controller>
    <script is:inline>
      (function(){var p=document.getElementById("whisper-page");if(!p)return;
        var m=sessionStorage.getItem("whisper-mode");
        if(m==="embed"||m==="extract"||m==="hunt"||m==="live")p.dataset.mode=m;
        if(m==="embed"&&sessionStorage.getItem("whisper-carrier")==="url")p.dataset.carrier="url";
      })();
    </script>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section
      class="mt-8 content-section whisper-intro"
    >
      <div class="whisper-title-row">
        <h1 class="page-title whisper-title" id="whisper-title">Whisper</h1>
        <span class="whisper-alpha-badge" id="whisper-alpha-badge">ALPHA</span>
      </div>
      <p class="whisper-tagline">carrier-bound encryption and sealed messaging</p>
      <p class="whisper-privacy-badge">
        <span class="privacy-dot"></span>
       local to this browser
      </p>
    </section>

    <!-- ── Mode Selector ────────────────────────────────────── -->
    <section
      class="mt-[var(--space-md)] content-section"
    >
      <div class="whisper-mode-bar" role="group" aria-label="Whisper mode">
        <button
          class="whisper-mode-btn whisper-mode-btn--active"
          data-whisper-mode="embed"
          aria-pressed="true"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M4 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2"></path>
            <path d="M2 4h12"></path>
            <path d="M5.5 9.5h5M8 7v5"></path>
          </svg>
          Embed
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="extract"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M4 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2"></path>
            <path d="M2 11h12"></path>
            <path d="M5.5 6.5h5"></path>
          </svg>
          Extract
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="hunt"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="7" cy="7" r="4"></circle>
            <path d="M10 10l3.5 3.5"></path>
          </svg>
          Hunt
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="live"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
            <path d="M9.5 2L6.5 8h3L6.5 14"></path>
          </svg>
          Live
        </button>
      </div>
    </section>

    <!-- ── Upload Zone (carrier) ────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] content-section whisper-section--solo"
    >
      <div
        class="whisper-upload-zone"
        id="whisper-upload-zone"
        role="button"
        tabindex="0"
        aria-label="Upload a carrier file"
      >
        <div class="upload-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v12"></path>
            <path d="M8 11l4 4 4-4"></path>
            <rect x="3" y="17" width="18" height="4" rx="2"></rect>
            <circle cx="7" cy="19" r="0.5" fill="currentColor"></circle>
          </svg>
        </div>
        <p class="upload-text" id="whisper-upload-text">drop a carrier file here</p>
        <p class="upload-subtext">or click / paste to browse</p>
        <p class="upload-formats">PNG &middot; JPEG &middot; TIFF &middot; BMP &middot; any file</p>
        <p class="upload-file-meta" id="whisper-upload-meta"></p>
        <input
          type="file"
          id="whisper-carrier-input"
          class="sr-only"
          aria-hidden="true"
        />
      </div>
    </section>

    <!-- ── Operation Panel ──────────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] content-section"
    >
      <!-- Solo mode content (embed / extract / hunt) -->
      <div class="whisper-op-solo">
        <div class="whisper-panel">
          <div class="whisper-panel-header">
            <h2 class="whisper-panel-title" id="whisper-op-title">
              <span class="whisper-op whisper-op--idle whisper-op--embed">Embed</span>
              <span class="whisper-op whisper-op--idle whisper-op--extract">Extract</span>
              <span class="whisper-op whisper-op--idle whisper-op--hunt">Hunt</span>

              <span class="whisper-op whisper-op--busy whisper-op--embedding">Embedding</span>
              <span class="whisper-op whisper-op--busy whisper-op--extracting">Extracting</span>
              <span class="whisper-op whisper-op--busy whisper-op--hunting">Hunting</span>
            </h2>
            <span class="whisper-panel-mode" id="whisper-status-line">drop a carrier file to begin</span>
          </div>

          <!-- Carrier type toggle (embed mode only) -->
          <div class="whisper-field whisper-field--embed ws-carrier-toggle-wrap">
            <span class="whisper-field-label">carrier</span>
            <div class="ws-carrier-toggle" role="radiogroup" aria-label="Carrier type">
              <label class="ws-carrier-opt">
                <input type="radio" name="ws-carrier-type" value="file" checked class="ws-carrier-radio" />
                <span class="ws-carrier-label">File</span>
              </label>
              <label class="ws-carrier-opt">
                <input type="radio" name="ws-carrier-type" value="url" class="ws-carrier-radio" />
                <span class="ws-carrier-label">URL (Seal)</span>
              </label>
              <button id="ws-my-seal-btn" type="button" class="whisper-mini-btn ws-my-seal-btn" aria-expanded="false" aria-pressed="false" title="Show your WS2 QR">My Seal</button>
              <span id="ws-my-seal-inline" class="ws-my-seal-inline" style="display:none" role="button" tabindex="0" title="Click to copy"></span>
            </div>
            <div id="ws-my-seal-inline-panel" class="ws-my-seal-inline-panel" style="display:none">
              <div class="ws-seal-qr-wrap">
                <canvas id="ws-seal-qr-canvas" class="ws-seal-qr-canvas" data-qr-size="180" aria-label="QR code for your full WS2 public key"></canvas>
                <p id="ws-seal-qr-status" class="ws-seal-hint">QR encodes the full WS2 public key exactly.</p>
              </div>
            </div>
          </div>

          <!-- Seal compose fields (visibility driven by CSS) -->
          <div class="ws-seal-fields" id="ws-seal-fields">
            <label class="whisper-field" for="ws-recipient-seal">
              <span class="whisper-field-label">recipient's seal</span>
              <div class="whisper-password-row">
                <input id="ws-recipient-seal" type="text" class="whisper-input whisper-password-input" placeholder="paste recipient code (WS2:...)" autocomplete="off" spellcheck="false" />
                <div class="whisper-password-tools" role="group" aria-label="Seal paste tools">
                  <button
                    id="ws-recipient-paste"
                    class="whisper-mini-btn"
                    type="button"
                    aria-label="Paste a valid seal code from clipboard"
                  >Paste</button>
                </div>
              </div>
            </label>
            <div class="ws-recipient-tools" role="group" aria-label="Recipient seal QR tools">
              <button id="ws-recipient-qr-scan" type="button" class="whisper-mini-btn">Scan QR</button>
              <button id="ws-recipient-qr-image" type="button" class="whisper-mini-btn">Image</button>
              <button id="ws-recipient-qr-stop" type="button" class="whisper-mini-btn" style="display:none">Stop</button>
              <input id="ws-recipient-qr-file" type="file" class="sr-only" accept="image/*" aria-hidden="true" />
            </div>
            <div id="ws-recipient-qr-panel" class="ws-recipient-qr-panel" style="display:none">
              <video id="ws-recipient-qr-video" class="ws-recipient-qr-video" playsinline muted></video>
            </div>
            <span id="ws-recipient-qr-status" class="whisper-field-hint ws-recipient-qr-status"></span>
            <span id="ws-seal-validation" class="ws-seal-validation"></span>

            <label class="whisper-field" for="ws-message">
              <span class="whisper-field-label">your message</span>
              <textarea id="ws-message" class="whisper-input ws-textarea" rows="6" placeholder="type your secret message..." maxlength="48000"></textarea>
            </label>
            <span id="ws-char-count" class="ws-char-count">0 / 48,000</span>

            <label class="whisper-field" for="ws-extra-password">
              <span class="whisper-field-label">shared phrase <span class="whisper-field-hint">(only if you've agreed on one)</span></span>
              <div class="whisper-password-row">
                <input id="ws-extra-password" type="password" class="whisper-input whisper-password-input" placeholder="leave blank if none" autocomplete="off" />
                <div class="whisper-password-tools ws-extra-pw-tools" role="group" aria-label="Password tools">
                  <button
                    id="ws-extra-pw-gen"
                    class="whisper-mini-btn"
                    type="button"
                    aria-label="Generate a strong random password"
                    title="Generate"
                  >Generate</button>
                  <button
                    id="ws-extra-pw-copy"
                    class="whisper-mini-btn"
                    type="button"
                    aria-label="Copy password to clipboard"
                    title="Copy"
                  >Copy</button>
                </div>
              </div>
            </label>

            <div class="whisper-field">
              <span class="whisper-field-label">expires after</span>
              <div class="ws-expiry-pills" id="ws-expiry" role="radiogroup" aria-label="Expiry duration">
                <label class="ws-expiry-pill">
                  <input type="radio" name="ws-expiry" value="3600000" class="ws-expiry-radio" />
                  <span class="ws-expiry-pill-label">1h</span>
                </label>
                <label class="ws-expiry-pill">
                  <input type="radio" name="ws-expiry" value="86400000" class="ws-expiry-radio" checked />
                  <span class="ws-expiry-pill-label">24h</span>
                </label>
                <label class="ws-expiry-pill">
                  <input type="radio" name="ws-expiry" value="604800000" class="ws-expiry-radio" />
                  <span class="ws-expiry-pill-label">7d</span>
                </label>
                <label class="ws-expiry-pill">
                  <input type="radio" name="ws-expiry" value="0" class="ws-expiry-radio" />
                  <span class="ws-expiry-pill-label">never</span>
                </label>
                <label class="ws-expiry-pill">
                  <input type="radio" name="ws-expiry" value="custom" class="ws-expiry-radio" />
                  <span class="ws-expiry-pill-label">custom</span>
                </label>
                <div id="ws-expiry-custom" class="ws-expiry-custom">
                  <input id="ws-expiry-custom-val" type="number" class="whisper-input ws-expiry-custom-input" min="1" value="12" tabindex="-1" />
                  <select id="ws-expiry-custom-unit" class="whisper-input ws-select ws-expiry-custom-unit" tabindex="-1">
                    <option value="60000">min</option>
                    <option value="3600000" selected>hr</option>
                    <option value="86400000">days</option>
                  </select>
                </div>
              </div>
            </div>

            <button id="ws-seal-it" type="button" class="whisper-mini-btn wl-primary" disabled>Seal it</button>

            <div id="ws-sealed-result" class="ws-sealed-result" style="display:none">
              <span class="ws-sealed-result-label">sealed url</span>
              <pre id="ws-sealed-url-inline" class="ws-sealed-url-inline" role="button" tabindex="0" title="Click to copy"></pre>
              <div class="ws-sealed-result-meta">
                <span id="ws-sealed-result-info"></span>
                <span id="ws-sealed-result-warning" class="ws-sealed-result-warning" style="display:none"></span>
              </div>
            </div>
          </div>

          <!-- Hunt multi-file input -->
          <label class="whisper-field whisper-field--hunt" for="whisper-hunt-carrier-input">
            <span class="whisper-field-label">carrier files <span class="whisper-field-hint">(hunt mode)</span></span>
            <div class="whisper-file-btn" tabindex="-1">
              <span class="whisper-file-btn-text" id="whisper-hunt-label">choose files&hellip;</span>
              <input id="whisper-hunt-carrier-input" type="file" multiple class="sr-only" aria-hidden="true" />
            </div>
          </label>

          <!-- Payload input -->
          <label class="whisper-field whisper-field--embed" for="whisper-payload-input">
            <span class="whisper-field-label">payload file <span class="whisper-field-hint">(embed mode)</span></span>
            <div class="whisper-file-btn" tabindex="-1">
              <span class="whisper-file-btn-text" id="whisper-payload-label">choose file&hellip;</span>
              <input id="whisper-payload-input" type="file" class="sr-only" aria-hidden="true" />
            </div>
          </label>

          <!-- Password (file-based modes) -->
          <label class="whisper-field whisper-field--file-password" for="whisper-password-input">
            <span class="whisper-field-label">password</span>
            <div class="whisper-password-row">
              <input
                id="whisper-password-input"
                type="password"
                class="whisper-input whisper-password-input"
                autocomplete="off"
                placeholder="password to encrypt"
              />
              <div class="whisper-password-tools" role="group" aria-label="Password tools">
                <button
                  id="whisper-password-gen"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Generate a strong random password"
                  title="Generate"
                >Generate</button>
                <button
                  id="whisper-password-copy"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Copy password to clipboard"
                  title="Copy"
                >Copy</button>
              </div>
            </div>
            <p id="whisper-password-meta" class="whisper-password-meta whisper-field-hint" aria-live="polite"></p>
          </label>

          <!-- Privacy toggle (embed only) -->
          <div class="whisper-field whisper-field--embed">
            <span class="whisper-field-label">privacy</span>
            <label class="whisper-toggle" for="whisper-only-decode-here">
              <input id="whisper-only-decode-here" type="checkbox" class="whisper-toggle-input" />
              <span class="whisper-toggle-text">
                only decode here
                <span class="whisper-field-hint">(locks decryption to this browser profile)</span>
              </span>
            </label>
          </div>

          <!-- Embed behavior (embed only) -->
          <div class="whisper-field whisper-field--embed">
            <span class="whisper-field-label">embed</span>
            <label class="whisper-toggle" for="whisper-allow-tail-fallback">
              <input id="whisper-allow-tail-fallback" type="checkbox" class="whisper-toggle-input" checked />
              <span class="whisper-toggle-text">
                allow tail attaching
                <span class="whisper-field-hint">(fallback if no inert slot fits)</span>
              </span>
            </label>
          </div>

          <!-- Clue -->
          <label class="whisper-field whisper-field--hunt" for="whisper-clue-input">
            <span class="whisper-field-label">payload clue <span class="whisper-field-hint">(optional)</span></span>
            <input
              id="whisper-clue-input"
              type="text"
              class="whisper-input"
              placeholder="name fragment or hash prefix"
            />
          </label>
        </div>
      </div>

      <!-- Live mode content (all phases live inside the same section) -->
      <div class="whisper-op-live" id="wl-section">
        <div class="wl-head whisper-panel" aria-label="Whisper Live status">
          <h2 class="wl-head-title">Whisper Live</h2>
          <p class="wl-head-subtitle">fast encrypted sessions, no accounts, no relay inbox</p>
          <div class="wl-head-right">
            <div class="cf-live-mode-toggle" role="radiogroup" aria-label="Live sub-mode">
              <label class="cf-mode-opt">
                <input type="radio" name="wl-live-submode" value="1:1" checked class="cf-mode-radio" />
                <span class="cf-mode-label">1:1</span>
              </label>
              <label class="cf-mode-opt">
                <input type="radio" name="wl-live-submode" value="campfire" class="cf-mode-radio" />
                <span class="cf-mode-label">Campfire</span>
              </label>
            </div>
          </div>

          <div class="wl-status-chip" role="status" aria-live="polite">
            <span class="wl-status-dot" aria-hidden="true"></span>
            <span id="wl-status-line" class="wl-status-text">ready to connect</span>
          </div>
        </div>

        <!-- Phase: idle — create or join -->
        <div class="wl-phase" id="wl-idle-phase">
          <p class="wl-phase-lede">create to start a channel, or join with someone else's offer code. shared phrase is optional, only set one if you both already agreed on it.</p>
          <div class="wl-grid">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Create</h3>
                <span class="whisper-panel-mode">start a new channel</span>
              </div>
              <p class="wl-inline-hint">you make the offer, then wait for one reply code.</p>
              <button id="wl-create" type="button" class="whisper-mini-btn wl-primary">Create channel</button>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Join</h3>
                <span class="whisper-panel-mode">paste an offer code</span>
              </div>
              <p class="wl-inline-hint">paste, scan, or import an offer code to generate your answer.</p>
              <div class="wl-join-row">
                <input
                  id="wl-join-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="offer code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="wl-join" type="button" class="whisper-mini-btn">Join</button>
              </div>
              <div class="wl-join-tools" role="group" aria-label="Join code helpers">
                <button id="wl-join-paste" type="button" class="whisper-mini-btn">Paste</button>
                <button id="wl-join-qr-scan" type="button" class="whisper-mini-btn">Scan QR</button>
                <button id="wl-join-qr-image" type="button" class="whisper-mini-btn">Image</button>
                <button id="wl-join-qr-stop" type="button" class="whisper-mini-btn" style="display:none">Stop</button>
                <input id="wl-join-qr-file" type="file" class="sr-only" accept="image/*" aria-hidden="true" />
              </div>
              <div id="wl-join-qr-panel" class="wl-join-qr-panel" style="display:none">
                <video id="wl-join-qr-video" class="wl-join-qr-video" playsinline muted></video>
              </div>
              <span id="wl-join-qr-status" class="whisper-field-hint wl-join-qr-status"></span>
            </div>
          </div>

          <div class="whisper-panel wl-phrase-panel">
            <label class="whisper-field" for="wl-phrase">
              <span class="whisper-field-label">shared phrase <span class="whisper-field-hint">(optional, match on both sides)</span></span>
              <input
                id="wl-phrase"
                type="password"
                class="whisper-input"
                placeholder="a short phrase you both know"
                autocomplete="off"
              />
            </label>

            <div class="whisper-field">
              <span class="whisper-field-label">network</span>
              <label class="whisper-toggle" for="wl-external-assist">
                <input id="wl-external-assist" type="checkbox" class="whisper-toggle-input" />
                <span class="whisper-toggle-text">
                  external assist (stun)
                  <span class="whisper-field-hint">(helps connect across networks. may expose network metadata during setup. it turns off after connect)</span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- Phase: offering — show offer code, wait for answer -->
        <div class="wl-phase" id="wl-offer-section" style="display:none">
          <p class="wl-phase-lede">send your offer to the other peer, then paste their reply to complete the handshake.</p>
          <div class="wl-grid wl-grid--offer">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Send</h3>
                <span class="whisper-panel-mode">offer code</span>
              </div>
              <p class="wl-inline-hint">share this with your peer through any channel.</p>
              <div class="wl-code-display-wrap">
                <pre id="wl-offer-code" class="wl-code-display"></pre>
                <button id="wl-offer-copy" type="button" class="whisper-mini-btn">Copy</button>
              </div>
              <div class="wl-live-qr-toggle-row">
                <button id="wl-offer-qr-toggle" type="button" class="whisper-mini-btn" aria-expanded="false">Show QR</button>
              </div>
              <div id="wl-offer-qr-panel" class="wl-live-qr-wrap" style="display:none">
                <canvas id="wl-offer-qr-canvas" class="ws-seal-qr-canvas" data-qr-size="132" aria-label="QR code for this Whisper Live offer"></canvas>
                <p id="wl-offer-qr-status" class="ws-seal-hint wl-live-qr-status"></p>
              </div>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Receive</h3>
                <span class="whisper-panel-mode">paste reply</span>
              </div>
              <p class="wl-inline-hint">paste their answer code here, then connect.</p>
              <div class="wl-join-row">
                <input
                  id="wl-answer-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="answer code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="wl-answer-apply" type="button" class="whisper-mini-btn wl-primary">Connect</button>
              </div>
            </div>
          </div>
          <div class="wl-offer-actions">
            <button id="wl-offer-back" type="button" class="whisper-mini-btn">Back</button>
          </div>
        </div>

        <!-- Phase: answering — show answer code to copy back -->
        <div class="wl-phase" id="wl-answer-section" style="display:none">
          <p class="wl-phase-lede">send this answer code back to the creator to finish connecting.</p>
          <div class="whisper-panel wl-answer-only">
            <div class="whisper-panel-header">
              <h3 class="whisper-panel-title">Send back</h3>
              <span class="whisper-panel-mode">answer code</span>
            </div>
            <p class="wl-inline-hint">keep this tab open until the creator confirms connection.</p>
            <div class="wl-code-display-wrap">
              <pre id="wl-answer-code" class="wl-code-display"></pre>
              <button id="wl-answer-copy" type="button" class="whisper-mini-btn">Copy</button>
            </div>
            <div class="wl-live-qr-toggle-row">
              <button id="wl-answer-qr-toggle" type="button" class="whisper-mini-btn" aria-expanded="false">Show QR</button>
            </div>
            <div id="wl-answer-qr-panel" class="wl-live-qr-wrap" style="display:none">
              <canvas id="wl-answer-qr-canvas" class="ws-seal-qr-canvas" data-qr-size="132" aria-label="QR code for this Whisper Live answer"></canvas>
              <p id="wl-answer-qr-status" class="ws-seal-hint wl-live-qr-status"></p>
            </div>
          </div>
        </div>

        <!-- Phase: connecting/handshaking -->
        <div class="wl-phase" id="wl-connecting-section" style="display:none">
          <div class="whisper-panel wl-connecting-panel">
            <div class="wl-spinner" aria-hidden="true"></div>
            <p id="wl-connecting-status" class="wl-connecting-text">establishing connection...</p>
          </div>
        </div>

        <!-- Phase: verify fingerprint -->
        <div class="wl-phase" id="wl-verify-section" style="display:none">
          <div class="whisper-panel wl-verify-panel">
            <h2 class="whisper-panel-title">Verify fingerprint</h2>
            <p class="whisper-field-hint">does your peer see the same emoji?</p>
            <p id="wl-fingerprint" class="wl-fingerprint" aria-live="polite"></p>
            <div class="wl-verify-actions">
              <button id="wl-confirm" type="button" class="whisper-mini-btn wl-confirm-btn">They match</button>
              <button id="wl-reject" type="button" class="whisper-mini-btn wl-reject-btn">They don't match</button>
            </div>
          </div>
        </div>

        <!-- Phase: live chat -->
        <div class="wl-phase" id="wl-chat-section" style="display:none">
          <div class="whisper-panel wl-chat-panel">
            <div class="wl-chat-header">
              <div class="wl-transport" role="radiogroup" aria-label="Transport mode">
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="naked" checked class="wl-transport-radio" /> naked</label>
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="dressed" class="wl-transport-radio" /> dressed</label>
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="silent" class="wl-transport-radio" /> silent</label>
              </div>
              <button id="wl-disconnect" type="button" class="whisper-mini-btn wl-disconnect-btn">Disconnect</button>
            </div>

            <div id="wl-chat-messages" class="wl-chat-messages" aria-live="polite" aria-relevant="additions"></div>

            <div class="wl-chat-compose">
              <input
                id="wl-chat-input"
                type="text"
                class="whisper-input wl-chat-text-input"
                placeholder="type a message"
                autocomplete="off"
                spellcheck="false"
              />
              <button id="wl-chat-file-btn" type="button" class="whisper-mini-btn wl-chat-file-btn" aria-label="Send a file" title="Send file">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" class="wl-file-icon" aria-hidden="true">
                  <path d="M8 2v8M4 6l4-4 4 4"></path>
                  <path d="M2 10v3a1 1 0 001 1h10a1 1 0 001-1v-3"></path>
                </svg>
              </button>
              <input id="wl-chat-file-input" type="file" class="sr-only" aria-hidden="true" />
              <button id="wl-chat-send" type="button" class="whisper-mini-btn wl-chat-send-btn">Send</button>
            </div>
          </div>
        </div>

        <!-- Phase: silent mode — show shared secret -->
        <div class="wl-phase" id="wl-silent-section" style="display:none">
          <div class="whisper-panel wl-silent-panel">
            <h2 class="whisper-panel-title">Shared secret</h2>
            <p class="whisper-field-hint">use this as your Whisper password for solo-mode dead drops through any channel</p>
            <div class="wl-code-display-wrap">
              <pre id="wl-silent-secret" class="wl-code-display wl-secret-display"></pre>
              <button id="wl-silent-copy" type="button" class="whisper-mini-btn">Copy</button>
            </div>
            <button id="wl-silent-disconnect" type="button" class="whisper-mini-btn wl-disconnect-btn">End session</button>
          </div>
        </div>

        <!-- Phase: disconnected -->
        <div class="wl-phase" id="wl-disconnected-section" style="display:none">
          <div class="whisper-panel wl-end-panel">
            <p class="wl-end-text">session ended. no trace remains</p>
            <button id="wl-new-session" type="button" class="whisper-mini-btn">New session</button>
          </div>
        </div>

        <!-- Phase: error -->
        <div class="wl-phase" id="wl-error-section" style="display:none">
          <div class="whisper-panel wl-error-panel">
            <p id="wl-error-message" class="wl-error-text"></p>
            <button id="wl-error-retry" type="button" class="whisper-mini-btn">Try again</button>
          </div>
        </div>

        <!-- ═══ Campfire phases (group chat within Live) ═══ -->

        <!-- Campfire: idle -->
        <div class="wl-phase" id="cf-idle-phase" style="display:none">
          <p class="wl-phase-lede">encrypted group chat, peer-to-peer. one person creates the room and shares the code. everyone connects directly, no server in the middle.</p>
          <div class="wl-grid">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Create</h3>
                <span class="whisper-panel-mode">start a new room</span>
              </div>
              <p class="wl-inline-hint">you host the room. others join using your code.</p>
              <button id="cf-create" type="button" class="whisper-mini-btn wl-primary">Create room</button>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Join</h3>
                <span class="whisper-panel-mode">paste a room code</span>
              </div>
              <p class="wl-inline-hint">got a code? paste it here to join the room.</p>
              <div class="wl-join-row">
                <input
                  id="cf-join-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="room code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="cf-join" type="button" class="whisper-mini-btn">Join</button>
              </div>
            </div>
          </div>

          <div class="whisper-panel wl-phrase-panel">
            <label class="whisper-field" for="cf-name">
              <span class="whisper-field-label">display name <span class="whisper-field-hint">(visible to the group)</span></span>
              <input
                id="cf-name"
                type="text"
                class="whisper-input"
                placeholder="your name (optional)"
                autocomplete="off"
                maxlength="32"
              />
            </label>

            <div class="whisper-field">
              <span class="whisper-field-label">network</span>
              <label class="whisper-toggle" for="cf-external-assist">
                <input id="cf-external-assist" type="checkbox" class="whisper-toggle-input" />
                <span class="whisper-toggle-text">
                  external assist (stun)
                  <span class="whisper-field-hint">(helps connect across networks. may expose network metadata during setup. turns off after connect)</span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- Campfire: waiting -->
        <div class="wl-phase" id="cf-waiting-section" style="display:none">
          <p class="wl-phase-lede">share the room code. when someone sends back their reply, paste it here to let them in.</p>
          <div class="wl-grid wl-grid--offer">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Room code</h3>
                <span class="whisper-panel-mode">send this to peers</span>
              </div>
              <p class="wl-inline-hint">anyone with this code can request to join.</p>
              <div class="wl-code-display-wrap">
                <pre id="cf-room-code" class="wl-code-display"></pre>
                <button id="cf-room-copy" type="button" class="whisper-mini-btn">Copy</button>
              </div>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Accept</h3>
                <span class="whisper-panel-mode">paste peer reply</span>
              </div>
              <p class="wl-inline-hint">paste a peer's reply code to finish connecting them.</p>
              <div class="wl-join-row">
                <input
                  id="cf-answer-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="answer code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="cf-answer-apply" type="button" class="whisper-mini-btn wl-primary">Connect</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Campfire: connecting -->
        <div class="wl-phase" id="cf-connecting-section" style="display:none">
          <div class="whisper-panel wl-connecting-panel">
            <div class="wl-spinner" aria-hidden="true"></div>
            <p id="cf-connecting-status" class="wl-connecting-text">joining the room...</p>
          </div>
          <div class="whisper-panel wl-card" id="cf-joiner-answer" style="display:none">
            <div class="whisper-panel-header">
              <h3 class="whisper-panel-title">Reply code</h3>
              <span class="whisper-panel-mode">send back to the host</span>
            </div>
            <p class="wl-inline-hint">copy this and send it to whoever created the room. keep this tab open.</p>
            <div class="wl-code-display-wrap">
              <pre id="cf-joiner-code" class="wl-code-display"></pre>
              <button id="cf-joiner-copy" type="button" class="whisper-mini-btn">Copy</button>
            </div>
          </div>
        </div>

        <!-- Campfire: active -->
        <div class="wl-phase" id="cf-active-section" style="display:none">
          <div class="whisper-panel wl-chat-panel cf-chat-panel">
            <div class="wl-chat-header cf-chat-header">
              <div class="cf-peer-list-wrap">
                <span class="cf-peer-label">in room:</span>
                <div id="cf-peer-list" class="cf-peer-list" role="list"></div>
              </div>
              <div class="cf-header-actions">
                <button id="cf-sub-create" type="button" class="whisper-mini-btn" title="split off with selected peers">Split</button>
                <button id="cf-disconnect" type="button" class="whisper-mini-btn wl-disconnect-btn">Leave</button>
              </div>
            </div>

            <div id="cf-chat-messages" class="wl-chat-messages" aria-live="polite" aria-relevant="additions"></div>

            <div class="wl-chat-compose">
              <input
                id="cf-chat-input"
                type="text"
                class="whisper-input wl-chat-text-input"
                placeholder="type a message"
                autocomplete="off"
                spellcheck="false"
              />
              <button id="cf-chat-send" type="button" class="whisper-mini-btn wl-chat-send-btn">Send</button>
            </div>
          </div>
        </div>

        <!-- Campfire: DM overlay -->
        <div id="cf-dm-overlay" class="cf-dm-overlay" style="display:none">
          <div class="whisper-panel cf-dm-panel">
            <div class="cf-dm-header">
              <span class="cf-dm-label"><strong id="cf-dm-target-name"></strong></span>
              <button id="cf-dm-close" type="button" class="whisper-mini-btn">Close</button>
            </div>
            <div id="cf-dm-messages" class="wl-chat-messages cf-dm-messages"></div>
            <div class="wl-chat-compose">
              <input
                id="cf-dm-input"
                type="text"
                class="whisper-input wl-chat-text-input"
                placeholder="just between you two"
                autocomplete="off"
                spellcheck="false"
              />
              <button id="cf-dm-send" type="button" class="whisper-mini-btn wl-chat-send-btn">Send</button>
            </div>
          </div>
        </div>

        <!-- Campfire: ended -->
        <div class="wl-phase" id="cf-ended-section" style="display:none">
          <div class="whisper-panel wl-end-panel">
            <p id="cf-ended-message" class="wl-end-text">the campfire is out. nothing remains.</p>
            <button id="cf-new-campfire" type="button" class="whisper-mini-btn">New session</button>
          </div>
        </div>
      </div>

      <!-- Seal overlay panels (computing, my-seal, result, unseal) -->
      <div class="ws-overlay" id="ws-overlay" style="display:none">
        <!-- Computing fingerprint -->
        <div class="ws-overlay-panel" id="ws-computing-phase" style="display:none">
          <div class="whisper-panel ws-computing-panel">
            <div class="wl-spinner" aria-hidden="true"></div>
            <p class="ws-computing-text">computing your browser seal...</p>
          </div>
        </div>

        <!-- My seal — display seal code -->
        <div class="ws-overlay-panel" id="ws-my-seal-phase" style="display:none">
          <div class="whisper-panel ws-seal-display-panel">
            <h3 class="whisper-panel-title">Your WS2 Public Seal</h3>
            <div class="ws-seal-code-wrap">
              <span id="ws-seal-code" class="ws-seal-code"></span>
            </div>
            <div class="ws-seal-qr-wrap">
              <canvas id="ws-seal-qr-canvas-overlay" class="ws-seal-qr-canvas" data-qr-size="220" aria-label="QR code for your full WS2 public key"></canvas>
              <p id="ws-seal-qr-status-overlay" class="ws-seal-hint">QR encodes the full WS2 public key exactly.</p>
            </div>
            <p class="ws-seal-hint">Share this full WS2 code to receive messages.</p>
            <p class="ws-seal-hint">Only the browser profile with the matching private key can open messages sealed to this key.</p>
            <div class="ws-seal-actions">
              <button id="ws-seal-copy" type="button" class="whisper-mini-btn wl-primary">Copy seal</button>
              <button id="ws-seal-back" type="button" class="whisper-mini-btn">Done</button>
            </div>
          </div>
        </div>

        <!-- Sealed URL ready -->
        <div class="ws-overlay-panel" id="ws-result-phase" style="display:none">
          <div class="whisper-panel ws-result-panel">
            <h3 class="whisper-panel-title">Message Sealed</h3>

            <div class="ws-url-display-wrap">
              <pre id="ws-sealed-url" class="wl-code-display ws-url-display"></pre>
              <button id="ws-url-copy" type="button" class="whisper-mini-btn">Copy URL</button>
            </div>

            <div class="ws-result-checks">
              <p class="ws-check"><span class="ws-check-icon" aria-hidden="true">&#x2713;</span> Only <strong id="ws-result-seal-target"></strong> can open this</p>
              <p class="ws-check"><span class="ws-check-icon" aria-hidden="true">&#x2713;</span> <span id="ws-result-expiry-text">Expires in 24 hours</span></p>
              <p class="ws-check"><span class="ws-check-icon" aria-hidden="true">&#x2713;</span> No data stored anywhere</p>
            </div>

            <p id="ws-result-url-warning" class="ws-result-url-length-warning" style="display:none"></p>
            <p class="ws-result-warning">Once you leave this page, this URL cannot be recovered.</p>

            <button id="ws-result-done" type="button" class="whisper-mini-btn">Done</button>
          </div>
        </div>

        <!-- Unsealing (auto-triggered by URL fragment) -->
        <div class="ws-overlay-panel" id="ws-unseal-phase" style="display:none">
          <div class="whisper-panel ws-unseal-panel">
            <div id="ws-unseal-progress" class="ws-unseal-progress">
              <div class="wl-spinner" aria-hidden="true"></div>
              <p class="ws-computing-text">checking your seal...</p>
            </div>

            <div id="ws-unseal-success" class="ws-status-screen" style="display:none">
              <div class="ws-status-icon ws-status-icon--success" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <h3 class="whisper-panel-title ws-status-title">Sealed Message</h3>
              <div class="ws-message-display">
                <pre id="ws-decrypted-message" class="ws-decrypted-text"></pre>
              </div>
              <p class="ws-unseal-meta"><span class="ws-check-icon" aria-hidden="true">&#x2713;</span> decrypted locally with your seal. this message won't be here when you leave.</p>
              <div class="ws-status-meta" data-meta="success"></div>
              <div class="ws-unseal-actions">
                <button id="ws-msg-copy" type="button" class="whisper-mini-btn wl-primary">Copy content</button>
                <button id="ws-unseal-done" type="button" class="whisper-mini-btn">Close</button>
              </div>
            </div>

            <div id="ws-unseal-fail" class="ws-status-screen" style="display:none">
              <div class="ws-status-icon ws-status-icon--locked" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>
              <h3 class="whisper-panel-title ws-status-title">Cannot Open</h3>
              <p class="ws-fail-text">this one's not for you. or at least, not this browser.</p>
              <p class="ws-fail-detail">try opening it in the browser where your seal was created.</p>
              <div class="ws-status-meta" data-meta="fail"></div>
              <button id="ws-fail-back" type="button" class="whisper-mini-btn">Back</button>
            </div>

            <div id="ws-unseal-expired" class="ws-status-screen" style="display:none">
              <div class="ws-status-icon ws-status-icon--expired" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <h3 class="whisper-panel-title ws-status-title">Expired</h3>
              <p class="ws-fail-text">this sealed message has expired and can no longer be opened.</p>
              <p class="ws-fail-detail">this one had a time limit... and it passed.</p>
              <div class="ws-status-meta" data-meta="expired"></div>
              <button id="ws-expired-back" type="button" class="whisper-mini-btn">Back</button>
            </div>

            <div id="ws-unseal-password" class="ws-status-screen" style="display:none">
              <div class="ws-status-icon ws-status-icon--phrase" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
              </div>
              <h3 class="whisper-panel-title ws-status-title">Shared Phrase Required</h3>
              <p class="ws-fail-detail">this sealed message was locked with a shared phrase. enter it below to decrypt.</p>
              <div class="ws-status-meta" data-meta="password"></div>
              <label class="whisper-field" for="ws-unseal-pw-input">
                <input id="ws-unseal-pw-input" type="password" class="whisper-input" placeholder="enter shared phrase" autocomplete="off" />
              </label>
              <button id="ws-unseal-pw-submit" type="button" class="whisper-mini-btn wl-primary">Decrypt</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Progress Bar ─────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--solo" id="whisper-progress-section" style="display:none">
      <div class="whisper-progress">
        <div class="whisper-progress-fill" id="whisper-progress-fill"></div>
      </div>
    </section>

    <!-- ── Results ──────────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--solo">
      <div id="whisper-results" class="whisper-results" aria-live="polite"></div>
      <div id="whisper-download-area" class="whisper-downloads"></div>
    </section>

    <!-- ── Runtime Log ──────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--shared">
      <div class="whisper-log-wrap">
        <div class="whisper-log-header">
          <p class="whisper-log-title">runtime log</p>
          <span class="whisper-log-dot" id="whisper-log-dot"></span>
        </div>
        <pre id="whisper-log-output" class="whisper-log-output"></pre>
      </div>
    </section>

    <!-- ── Insights ─────────────────────────────────────────── -->
    <section class="mt-[var(--space-lg)] mb-[var(--space-xl)] content-section whisper-section--solo">
      <div class="whisper-insights">
        <h2 class="insights-title">what does this do?</h2>
        <p class="insights-text">
          whisper takes a normal file (a "carrier"), and hides something secret inside it. the secret payload is injected into padding, gaps, and dead space most formats already have. the carrier file retiains full functionality. if there's
          not enough room, it can attach as a tail.
        </p>
        <p class="insights-text">
          it’s intentionally fragile. edit the carrier, re-save it, recompress
          it, or move the bytes around even a little and it won’t decrypt anymore. the payload
          is bound to that exact file.
        </p>
        <p class="insights-text">
          everything runs locally. nothing gets uploaded. embed hides a payload, 
          extract pulls it back out, hunt checks whether one is
          present, and live combines these so you can do it peer to peer between browsers.
        </p>
      </div>
    </section>

    <!-- ── Fixed Action Bar (hidden until carrier loaded) ──── -->
    <div
      class="whisper-actions whisper-section--solo"
      id="whisper-actions"
      role="group"
      aria-label="Whisper controls"
      style="display:none;opacity:0"
    >
      <button
        class="action-btn action-btn--primary"
        id="whisper-action-run"
        type="button"
        disabled
      >Embed</button>
      <button
        class="action-btn"
        id="whisper-action-upload"
        type="button"
      >New File</button>
      <button
        class="action-btn action-btn--icon"
        id="whisper-action-lens"
        type="button"
        aria-label="View with Lens"
        title="View with Lens"
        style="display:none"
      >
        <svg
          class="lens-handoff-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
        </svg>
      </button>
      <button
        class="action-btn"
        id="whisper-action-clear"
        type="button"
        disabled
      >Clear</button>
    </div>
  </div>

  <script>
    import { initWhisper, resolveWhisperUIOptions } from "../scripts/whisper/ui";
    import { initWhisperLive, resolveWhisperLiveUIOptions } from "../scripts/whisper/live-ui";
    import { initWhisperSeal, resolveWhisperSealUIOptions } from "../scripts/whisper/seal-ui";
    import { initCampfire, resolveCampfireUIOptions } from "../scripts/whisper/campfire/ui";

    const WHISPER_LIFECYCLE_KEY = "__whisperLifecycle";
    type WhisperLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };

    let cleanupWhisper: (() => void) | null = null;
    let cleanupLive: (() => void) | null = null;
    let cleanupSeal: (() => void) | null = null;
    let cleanupCampfire: (() => void) | null = null;
    let submodeAbort: AbortController | null = null;
    const whisperWindow = window as unknown as Record<string, WhisperLifecycle | undefined>;

    function boot() {
      teardown();
      const whisperOptions = resolveWhisperUIOptions(document);
      if (whisperOptions) cleanupWhisper = initWhisper(whisperOptions);
      const liveOptions = resolveWhisperLiveUIOptions(document);
      if (liveOptions) cleanupLive = initWhisperLive(liveOptions);
      const sealOptions = resolveWhisperSealUIOptions(document);
      if (sealOptions) cleanupSeal = initWhisperSeal(sealOptions);
      const campfireOptions = resolveCampfireUIOptions(document);
      if (campfireOptions) cleanupCampfire = initCampfire(campfireOptions);

      // Wire up Live sub-mode toggle (1:1 vs Campfire)
      const submodeRadios = document.querySelectorAll<HTMLInputElement>('input[name="wl-live-submode"]');
      const livePhaseIds = [
        "wl-idle-phase",
        "wl-offer-section",
        "wl-answer-section",
        "wl-connecting-section",
        "wl-verify-section",
        "wl-chat-section",
        "wl-silent-section",
        "wl-disconnected-section",
        "wl-error-section",
      ];
      const campfirePhaseIds = [
        "cf-idle-phase",
        "cf-waiting-section",
        "cf-connecting-section",
        "cf-active-section",
        "cf-ended-section",
      ];

      submodeAbort?.abort();
      submodeAbort = new AbortController();
      const submodeSignal = submodeAbort.signal;

      const phaseElements = (ids: string[]): HTMLElement[] =>
        ids
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el instanceof HTMLElement);

      const hasVisiblePhase = (elements: HTMLElement[]): boolean =>
        elements.some((el) => el.style.display !== "none");

      function syncLiveSubmode(mode: "1:1" | "campfire"): void {
        const livePhases = phaseElements(livePhaseIds);
        const campfirePhases = phaseElements(campfirePhaseIds);

        if (mode === "campfire") {
          for (const phase of livePhases) phase.style.display = "none";
          if (!hasVisiblePhase(campfirePhases)) {
            const cfIdle = document.getElementById("cf-idle-phase");
            if (cfIdle instanceof HTMLElement) cfIdle.style.display = "";
          }
          return;
        }

        for (const phase of campfirePhases) phase.style.display = "none";
        if (!hasVisiblePhase(livePhases)) {
          const wlIdle = document.getElementById("wl-idle-phase");
          if (wlIdle instanceof HTMLElement) wlIdle.style.display = "";
        }
      }

      submodeRadios.forEach((radio) => {
        radio.addEventListener("change", () => {
          if (!radio.checked) return;
          syncLiveSubmode(radio.value === "campfire" ? "campfire" : "1:1");
        }, { signal: submodeSignal });
      });

      const checkedMode = Array.from(submodeRadios).find((r) => r.checked)?.value;
      syncLiveSubmode(checkedMode === "campfire" ? "campfire" : "1:1");
    }

    function teardown() {
      cleanupWhisper?.();
      cleanupWhisper = null;
      cleanupLive?.();
      cleanupLive = null;
      cleanupSeal?.();
      cleanupSeal = null;
      cleanupCampfire?.();
      cleanupCampfire = null;
      submodeAbort?.abort();
      submodeAbort = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = whisperWindow[WHISPER_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) {
        prev.detach();
      } else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", handleBeforeSwap);
      }
      prev.teardown?.();
    }

    whisperWindow[WHISPER_LIFECYCLE_KEY] = {
      boot,
      teardown,
      detach: detachLifecycle,
    };

    boot();
    attachLifecycle();
  </script>
</Layout>

