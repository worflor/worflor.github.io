---
import Layout from "../layouts/Layout.astro";
import WhisperLiveIdle from "../components/whisper/WhisperLiveIdle.astro";
import WhisperLiveChat from "../components/whisper/WhisperLiveChat.astro";
import WhisperCampfire from "../components/whisper/WhisperCampfire.astro";
import WhisperSealOverlay from "../components/whisper/WhisperSealOverlay.astro";
import WhisperSealPanel from "../components/whisper/WhisperSealPanel.astro";
import ActionBar from "../components/ActionBar.astro";

const seo = {
  title: "Whisper | woflo",
  description:
    "Hide data inside files, send private sealed messages, and talk peer-to-peer. Everything encrypted, everything local. Nothing leaves your browser.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div
    class="whisper-page"
    id="whisper-page"
    data-mode="embed"
    data-busy="0"
    data-breadcrumb-controller
  >
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="mt-8 content-section whisper-intro wl-stage-fade">
      <div class="whisper-title-row">
        <h1 class="page-title whisper-title" id="whisper-title">Whisper</h1>
        <span class="whisper-alpha-badge" id="whisper-alpha-badge">ALPHA</span>
      </div>
      <p class="whisper-tagline">
        carrier-bound encryption and sealed messaging
      </p>
    </section>

    <!-- ── Mode Selector ────────────────────────────────────── -->
    <section class="mt-[var(--space-md)] content-section wl-stage-fade">
      <div class="whisper-mode-bar" role="group" aria-label="Whisper mode">
        <button
          class="whisper-mode-btn whisper-mode-btn--active"
          data-whisper-mode="carrier"
          aria-pressed="true"
          type="button"
        >
          <svg
            class="whisper-mode-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            aria-hidden="true"
          >
            <path
              d="M4 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2"
            ></path>
            <path d="M2 4h12"></path>
            <path d="M6 9l2 2 2-2M8 6v5"></path>
          </svg>
          <span class="btn-label">Carrier</span>
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="seal"
          aria-pressed="false"
          type="button"
        >
          <svg
            class="whisper-mode-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9.5 3l2 2-5.5 5.5H4V8.5L9.5 3z"></path>
            <path d="M3 14h10"></path>
          </svg>
          <span class="btn-label">Digital Signature</span>
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="live"
          aria-pressed="false"
          type="button"
        >
          <svg
            class="whisper-mode-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M9.5 2L6.5 8h3L6.5 14"></path>
          </svg>
          <span class="btn-label">Live</span>
        </button>
        <span class="whisper-mode-indicator" aria-hidden="true"></span>
      </div>
      <script is:inline>
        (function () {
          var bar = document.querySelector(".whisper-mode-bar");
          var ind = bar && bar.querySelector(".whisper-mode-indicator");
          if (!bar || !ind) return;

          var cyan = "rgb(var(--chromatic-cyan))";
          var red = "rgb(var(--chromatic-red))";
          var btns = bar.querySelectorAll(".whisper-mode-btn");

          function measure(btn) {
            var s = getComputedStyle(btn);
            var pl = parseFloat(s.paddingLeft) || 0;
            var pr = parseFloat(s.paddingRight) || 0;
            return {
              left: btn.offsetLeft + pl,
              width: btn.offsetWidth - pl - pr,
              live: btn.getAttribute("data-whisper-mode") === "live"
            };
          }

          function moveTo(btn) {
            var m = measure(btn);
            ind.style.left = m.left + "px";
            ind.style.right = (bar.offsetWidth - m.left - m.width) + "px";
            ind.style.background = m.live ? red : cyan;
          }

          function moveToActive() {
            var active = bar.querySelector(".whisper-mode-btn--active");
            if (active) moveTo(active);
          }

          moveToActive();

          for (var i = 0; i < btns.length; i++) {
            btns[i].addEventListener("mouseenter", (function (btn) {
              return function () { moveTo(btn); };
            })(btns[i]));
          }

          bar.addEventListener("mouseleave", moveToActive);

          new MutationObserver(moveToActive).observe(bar, {
            subtree: true,
            attributes: true,
            attributeFilter: ["class"]
          });

          new ResizeObserver(moveToActive).observe(bar);
        })();
      </script>
    </section>

    <!-- ── Upload Zone (carrier) ────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--solo">
      <div
        class="whisper-upload-zone"
        id="whisper-upload-zone"
        role="button"
        tabindex="0"
        aria-label="Upload a carrier file"
      >
        <div class="upload-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v12"></path>
            <path d="M8 11l4 4 4-4"></path>
            <rect x="3" y="17" width="18" height="4" rx="2"></rect>
            <circle cx="7" cy="19" r="0.5" fill="currentColor"></circle>
          </svg>
        </div>
        <p class="upload-text" id="whisper-upload-text">
          drop a carrier file here
        </p>
        <p class="upload-subtext">or click / paste to browse</p>
        <p class="upload-formats">
          PNG &middot; JPEG &middot; TIFF &middot; BMP &middot; any file
        </p>
        <p class="upload-file-meta" id="whisper-upload-meta"></p>
        <input
          type="file"
          id="whisper-carrier-input"
          class="sr-only"
          aria-hidden="true"
        />
      </div>
    </section>

    <!-- ── Operation Panel ──────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section wl-stage-column">
      <!-- Solo mode content (embed / extract / hunt) -->
      <div class="whisper-op-solo">
        <div class="whisper-panel">
          <div class="whisper-panel-header">
            <h2 class="whisper-panel-title" id="whisper-op-title">
              <span class="whisper-op whisper-op--idle whisper-op--embed"
                >Embed</span
              >
              <span class="whisper-op whisper-op--idle whisper-op--extract"
                >Extract</span
              >
              <span class="whisper-op whisper-op--idle whisper-op--hunt"
                >Hunt</span
              >

              <span class="whisper-op whisper-op--busy whisper-op--embedding"
                >Embedding</span
              >
              <span class="whisper-op whisper-op--busy whisper-op--extracting"
                >Extracting</span
              >
              <span class="whisper-op whisper-op--busy whisper-op--hunting"
                >Hunting</span
              >
            </h2>
            <span class="whisper-panel-mode" id="whisper-status-line"
              >drop a carrier file to begin</span
            >
          </div>

          <!-- Direction + carrier type (single row) -->
          <div class="whisper-field ws-controls-row-wrap">
            <div class="ws-controls-row">
              <div
                class="ws-direction-toggle"
                role="radiogroup"
                aria-label="Operation direction"
              >
                <label class="ws-direction-opt">
                  <input
                    type="radio"
                    name="ws-direction"
                    value="embed"
                    checked
                    class="ws-direction-radio"
                  />
                  <span class="ws-direction-label">Embed</span>
                </label>
                <label class="ws-direction-opt">
                  <input
                    type="radio"
                    name="ws-direction"
                    value="extract"
                    class="ws-direction-radio"
                  />
                  <span class="ws-direction-label">Extract</span>
                </label>
              </div>
              <div
                class="ws-carrier-toggle whisper-field--embed"
                role="radiogroup"
                aria-label="Carrier type"
              >
                <label class="ws-carrier-opt">
                  <input
                    type="radio"
                    name="ws-carrier-type"
                    value="file"
                    checked
                    class="ws-carrier-radio"
                  />
                  <span class="ws-carrier-label">File</span>
                </label>
                <label class="ws-carrier-opt">
                  <input
                    type="radio"
                    name="ws-carrier-type"
                    value="url"
                    class="ws-carrier-radio"
                  />
                  <span class="ws-carrier-label">URL</span>
                </label>
                <button
                  id="ws-my-seal-btn"
                  type="button"
                  class="whisper-mini-btn ws-my-seal-btn ws-seal-mode-chip ws-seal-mode-chip--stable"
                  aria-pressed="false"
                  title="switch seal mode">Stable seal</button
                >
              </div>
              <span
                id="ws-my-seal-inline"
                class="ws-my-seal-inline"
                style="display:none"
                role="button"
                tabindex="0"
                title="copy full seal"></span>
            </div>
            <script is:inline>
              (function () {
                var p = document.getElementById("whisper-page");
                if (!p) return;

                // URL params override session state; share-friendly deep links.
                var urlParams = new URLSearchParams(location.search);
                var paramMode = urlParams.has("live") ? "live" :
                                urlParams.has("embed") ? "embed" :
                                urlParams.has("extract") ? "extract" :
                                urlParams.has("seal") ? "seal" : null;

                // phrase handoff fragments force live mode, same mechanism as
                // ?live above: #wl64:<base64url(phrase)> is the flare qr's
                // machine shape, #wl:<phrase> is plain text for human fingers
                // ("/whisper#wl:tacos" in the address bar connects on load).
                // the phrase can't ride in location.search (there isn't one)
                // or survive past the replaceState below (which strips the
                // fragment too), so it hands off through sessionStorage —
                // read once, as a one-shot, near the end of live-ui.ts's init.
                var wlHash = location.hash;
                if (wlHash.indexOf("#wl64:") === 0) {
                  paramMode = "live";
                  try {
                    var wlB64 = wlHash.slice(6).replace(/-/g, "+").replace(/_/g, "/");
                    var wlBin = atob(wlB64);
                    var wlBytes = new Uint8Array(wlBin.length);
                    for (var wi = 0; wi < wlBin.length; wi++) wlBytes[wi] = wlBin.charCodeAt(wi);
                    var wlPhrase = new TextDecoder().decode(wlBytes).trim();
                    if (wlPhrase) sessionStorage.setItem("wl-qr-phrase", wlPhrase);
                  } catch (e) {
                    // undecodable fragment: still fall back to opening live mode
                  }
                } else if (wlHash.indexOf("#wl:") === 0) {
                  paramMode = "live";
                  try {
                    var wlPlain = decodeURIComponent(wlHash.slice(4)).trim();
                    if (wlPlain) sessionStorage.setItem("wl-qr-phrase", wlPlain);
                  } catch (e) {
                    // malformed percent-encoding: still open live mode
                  }
                } else if (wlHash.indexOf("#wl-local:") === 0) {
                  // in-person handoff on a cold load: stash the packed payload
                  // (already url-safe) for live-ui.ts to pick up and route by
                  // its own role byte. same one-shot mechanism as the flare.
                  paramMode = "live";
                  var wlLocal = wlHash.slice("#wl-local:".length);
                  if (wlLocal) sessionStorage.setItem("wl-local-payload", wlLocal);
                }

                if (paramMode) {
                  sessionStorage.setItem("whisper-mode", paramMode);
                  history.replaceState({}, "", location.pathname);
                }

                var savedMode = sessionStorage.getItem("whisper-mode");
                // migrate any legacy "hunt" sessionStorage value to embed
                if (savedMode === "hunt") {
                  savedMode = "embed";
                  sessionStorage.setItem("whisper-mode", "embed");
                }
                var m = paramMode || savedMode || "embed";
                var c = sessionStorage.getItem("whisper-carrier") || "file";

                if (
                  m === "embed" ||
                  m === "extract" ||
                  m === "seal" ||
                  m === "live"
                ) {
                  p.dataset.mode = m;
                  // "carrier" tab covers both embed and extract
                  var tabMode = (m === "embed" || m === "extract") ? "carrier" : m;
                  var btns = p.querySelectorAll(".whisper-mode-btn");
                  for (var i = 0; i < btns.length; i++) {
                    var active =
                      btns[i].getAttribute("data-whisper-mode") === tabMode;
                    active
                      ? btns[i].classList.add("whisper-mode-btn--active")
                      : btns[i].classList.remove("whisper-mode-btn--active");
                    btns[i].setAttribute(
                      "aria-pressed",
                      active ? "true" : "false",
                    );
                  }
                  // sync direction toggle
                  var dirRadios = p.querySelectorAll('input[name="ws-direction"]');
                  for (var j = 0; j < dirRadios.length; j++) {
                    dirRadios[j].checked = dirRadios[j].value === m;
                  }
                }

                if (m === "embed") {
                  p.dataset.carrier = c === "file" || c === "url" ? c : "file";
                  var radios = p.querySelectorAll(
                    'input[name="ws-carrier-type"]',
                  );
                  for (var j = 0; j < radios.length; j++) {
                    radios[j].checked = radios[j].value === p.dataset.carrier;
                  }
                }
              })();

              /* autoCompact: observe a container and set data-compact when
                 content overflows. Observes a stable ancestor so toggling
                 compact doesn't cause an infinite ResizeObserver loop.
                 - el: element to toggle data-compact on
                 - observeEl: element whose resize triggers checks (default: el.parentElement)
                 - overflowEl: element whose scrollWidth vs clientWidth is tested (default: el) */
              (function () {
                function autoCompact(el, observeEl, overflowEl) {
                  if (!el || typeof ResizeObserver === "undefined") return;
                  var target = observeEl || el.parentElement || el;
                  var check_el = overflowEl || el;
                  var lastW = -1;
                  function check(entries) {
                    var w = entries && entries[0] && entries[0].contentBoxSize
                      ? entries[0].contentBoxSize[0].inlineSize
                      : target.clientWidth;
                    if (w === lastW) return;
                    lastW = w;
                    el.removeAttribute("data-compact");
                    var overOwnBox = check_el.scrollWidth > check_el.clientWidth + 1;
                    var overTarget = check_el.getBoundingClientRect().width > target.clientWidth + 1;
                    if (overOwnBox || overTarget) {
                      el.setAttribute("data-compact", "");
                    }
                  }
                  new ResizeObserver(check).observe(target);
                  check();
                }
                autoCompact(document.querySelector(".whisper-mode-bar"));
                document.addEventListener("DOMContentLoaded", function () {
                  autoCompact(
                    document.querySelector(".cf-live-mode-toggle"),
                    document.querySelector(".wl-head-right"),
                    document.querySelector(".cf-live-mode-toggle")
                  );
                });
              })();
            </script>
            <div
              id="ws-my-seal-inline-panel"
              class="ws-my-seal-inline-panel"
              style="display:none"
            >
              <div class="ws-seal-qr-wrap">
                <canvas
                  id="ws-seal-qr-canvas"
                  class="ws-seal-qr-canvas"
                  data-qr-size="180"
                  aria-label="QR code for your full WS2 public key"></canvas>
                <p id="ws-seal-qr-status" class="ws-seal-hint">
                  share this to let someone message you.
                </p>
              </div>
            </div>
          </div>

          <!-- Seal compose fields (visibility driven by CSS) -->
          <div class="ws-seal-fields" id="ws-seal-fields">
            <label class="whisper-field ws-url-only" for="ws-recipient-seal">
              <span class="whisper-field-label">recipient's seal</span>
              <input
                id="ws-recipient-seal"
                type="text"
                class="whisper-input"
                placeholder="recipient code (WS2:...)"
                autocomplete="off"
                spellcheck="false"
              />
            </label>
            <div
              class="wl-join-tools ws-recipient-tools ws-url-only"
              role="group"
              aria-label="Seal tools"
            >
              <button
                id="ws-recipient-paste"
                type="button"
                class="wl-tool-link"
                aria-label="Paste a valid seal code from clipboard"
                >paste</button
              >
              <span class="wl-tool-sep" aria-hidden="true">/</span>
              <button
                id="ws-recipient-qr-scan"
                type="button"
                class="wl-tool-link">scan</button
              >
              <span class="wl-tool-sep" aria-hidden="true">/</span>
              <button
                id="ws-recipient-qr-image"
                type="button"
                class="wl-tool-link">image</button
              >
              <button
                id="ws-recipient-qr-stop"
                type="button"
                class="wl-tool-link wl-tool-link--stop"
                style="display:none">stop</button
              >
              <input
                id="ws-recipient-qr-file"
                type="file"
                class="sr-only"
                accept="image/*"
                aria-hidden="true"
              />
            </div>
            <div
              id="ws-recipient-qr-panel"
              class="ws-recipient-qr-panel ws-url-only"
              style="display:none"
            >
              <video
                id="ws-recipient-qr-video"
                class="ws-recipient-qr-video"
                playsinline
                muted></video>
            </div>
            <span
              id="ws-recipient-qr-status"
              class="whisper-field-hint ws-recipient-qr-status ws-url-only"
            ></span>
            <span id="ws-seal-validation" class="ws-seal-validation ws-url-only"
            ></span>

            <label class="whisper-field" for="ws-message">
              <span class="whisper-field-label">your message</span>
              <textarea
                id="ws-message"
                class="whisper-input ws-textarea"
                rows="6"
                placeholder="your secret message..."
                maxlength="48000"></textarea>
            </label>
            <span id="ws-char-count" class="ws-char-count">0 / 48,000</span>

            <label class="whisper-field ws-url-only" for="ws-extra-password">
              <span class="whisper-field-label"
                >shared phrase <span class="whisper-field-hint">(optional)</span
                ></span
              >
              <input
                id="ws-extra-password"
                type="password"
                class="whisper-input"
                placeholder="a short phrase between friends"
                autocomplete="new-password"
                autocapitalize="off"
                spellcheck="false"
                data-lpignore="true"
                data-1p-ignore="true"
                data-form-type="other"
              />
            </label>

            <div class="whisper-field ws-url-only">
              <span class="whisper-field-label">expires after</span>
              <div
                class="ws-expiry-pills"
                id="ws-expiry"
                role="radiogroup"
                aria-label="Expiry duration"
              >
                <label class="ws-expiry-pill">
                  <input
                    type="radio"
                    name="ws-expiry"
                    value="3600000"
                    class="ws-expiry-radio"
                  />
                  <span class="ws-expiry-pill-label">1h</span>
                </label>
                <label class="ws-expiry-pill">
                  <input
                    type="radio"
                    name="ws-expiry"
                    value="86400000"
                    class="ws-expiry-radio"
                    checked
                  />
                  <span class="ws-expiry-pill-label">24h</span>
                </label>
                <label class="ws-expiry-pill">
                  <input
                    type="radio"
                    name="ws-expiry"
                    value="604800000"
                    class="ws-expiry-radio"
                  />
                  <span class="ws-expiry-pill-label">7d</span>
                </label>
                <label class="ws-expiry-pill">
                  <input
                    type="radio"
                    name="ws-expiry"
                    value="0"
                    class="ws-expiry-radio"
                  />
                  <span class="ws-expiry-pill-label">never</span>
                </label>
                <label class="ws-expiry-pill">
                  <input
                    type="radio"
                    name="ws-expiry"
                    value="custom"
                    class="ws-expiry-radio"
                  />
                  <span class="ws-expiry-pill-label">custom</span>
                </label>
                <div id="ws-expiry-custom" class="ws-expiry-custom">
                  <input
                    id="ws-expiry-custom-val"
                    type="number"
                    class="whisper-input ws-expiry-custom-input"
                    min="1"
                    value="12"
                    tabindex="-1"
                  />
                  <select
                    id="ws-expiry-custom-unit"
                    class="whisper-input ws-select ws-expiry-custom-unit"
                    tabindex="-1"
                  >
                    <option value="60000">min</option>
                    <option value="3600000" selected>hr</option>
                    <option value="86400000">days</option>
                  </select>
                </div>
              </div>
            </div>

            <button
              id="ws-seal-it"
              type="button"
              class="whisper-mini-btn wl-primary ws-url-only"
              disabled>Seal it</button
            >

            <div
              id="ws-sealed-result"
              class="ws-sealed-result ws-url-only"
              style="display:none"
            >
              <span class="ws-sealed-result-label">sealed url</span>
              <pre
                id="ws-sealed-url-inline"
                class="ws-sealed-url-inline"
                role="button"
                tabindex="0"
                title="copy sealed url">
              </pre>
              <div class="ws-sealed-result-meta">
                <span id="ws-sealed-result-info"></span>
                <span
                  id="ws-sealed-result-warning"
                  class="ws-sealed-result-warning"
                  style="display:none"></span>
              </div>
            </div>
          </div>

          <!-- Hunt multi-file input hook (driven by the main upload zone) -->
          <input
            id="whisper-hunt-carrier-input"
            type="file"
            multiple
            class="sr-only"
            aria-hidden="true"
          />
          <span id="whisper-hunt-label" class="sr-only" aria-hidden="true"
            >choose files&hellip;</span
          >

          <!-- Hidden legacy payload hook (intentionally not shown in UI) -->
          <input
            id="whisper-payload-input"
            type="file"
            class="sr-only"
            aria-hidden="true"
            tabindex="-1"
          />
          <span id="whisper-payload-label" class="sr-only" aria-hidden="true"
            >choose file&hellip;</span
          >

          <textarea
            id="whisper-embed-message"
            class="sr-only"
            aria-hidden="true"
            tabindex="-1"
            maxlength="48000"></textarea>
          <span
            id="whisper-embed-message-count"
            class="sr-only"
            aria-hidden="true">0 / 48,000</span
          >

          <!-- Password (file-based modes) -->
          <label
            class="whisper-field whisper-field--file-password"
            for="whisper-password-input"
          >
            <span class="whisper-field-label">password</span>
            <div class="whisper-password-row">
              <input
                id="whisper-password-input"
                type="password"
                class="whisper-input whisper-password-input"
                autocomplete="new-password"
                autocapitalize="off"
                spellcheck="false"
                data-lpignore="true"
                data-1p-ignore="true"
                data-form-type="other"
                placeholder="password to encrypt"
              />
              <div
                class="whisper-password-tools"
                role="group"
                aria-label="Password tools"
              >
                <button
                  id="whisper-password-gen"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Generate a strong random password"
                  title="Generate">Generate</button
                >
                <button
                  id="whisper-password-copy"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Copy password to clipboard"
                  title="Copy">Copy</button
                >
              </div>
            </div>
            <div
              class="wl-join-tools whisper-password-paste-tools"
              role="group"
