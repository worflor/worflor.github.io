  /* When carrier=url: hide file-specific embed fields, upload zone, and file password */
  .whisper-page[data-mode="embed"][data-carrier="url"]
    .whisper-field--embed:not(.ws-carrier-toggle):not([for="ws-message"]) {
    display: none;
  }
  .whisper-page[data-mode="embed"][data-carrier="url"] #whisper-upload-zone {
    display: none;
  }
  .whisper-page[data-mode="embed"][data-carrier="url"]
    .whisper-field--file-password {
    display: none;
  }

  /* When carrier=file (default): hide URL-only seal fields */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-url-only {
    display: none;
  }

  /* Seal fields hidden in non-embed modes */
  .whisper-page:not([data-mode="embed"]) .ws-seal-fields {
    display: none;
  }

  /* Seal mode chip + inline code only when carrier=url */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-btn,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-inline,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"])
    .ws-my-seal-inline-panel {
    display: none;
  }

  /* Password tools (generate/copy) only in embed mode; paste link only in extract/hunt */
  .whisper-page:not([data-mode="embed"]) .whisper-password-tools {
    display: none;
  }

  /* Overlay hides solo panel when active (JS-managed via style) */
  :global(.ws-overlay) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  /* Hide overlay in live mode */
  :global(.whisper-page[data-mode="live"] .ws-overlay) {
    display: none;
  }

  /* ── Progress ──────────────────────────────────────────── */
  .whisper-progress {
    height: 4px;
    border-radius: 2px;
    background: rgb(var(--color-text-rgb) / 0.06);
    overflow: hidden;
  }

  .whisper-progress-fill {
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-cyan));
    border-radius: 2px;
    transition: width 0.3s linear;
  }

  .whisper-progress-fill:global(.whisper-progress--indeterminate) {
    width: 100%;
    animation: whisper-progress-pulse 1.5s ease-in-out infinite;
  }

  @keyframes whisper-progress-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* ── Results ───────────────────────────────────────────── */
  .whisper-results {
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
  }

  :global(.whisper-result) {
    margin: 0;
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius-soft);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  :global(.whisper-result--ok) {
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--color-text-rgb) / 0.86);
    background: rgb(var(--chromatic-cyan) / 0.03);
  }

  :global(.whisper-result--warn) {
    border-color: rgb(var(--tool-status-warning) / 0.35);
    color: rgb(var(--tool-status-warning));
    background: rgb(var(--tool-status-warning) / 0.04);
  }

  :global(.whisper-result--error) {
    border-color: rgb(var(--chromatic-red) / 0.35);
    color: rgb(var(--chromatic-red));
    background: rgb(var(--chromatic-red) / 0.04);
  }

  /* ── Downloads ─────────────────────────────────────────── */
  .whisper-downloads {
    margin-top: var(--space-sm);
    display: grid;
    gap: calc(var(--space-xs) * 0.45);
  }

  :global(.whisper-download-card) {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius-soft);
    padding: 0.7rem 0.8rem;
    background: var(--whisper-surface);
    display: grid;
    gap: calc(var(--space-xs) * 0.25);
    box-shadow: var(--edge-highlight);
  }

  :global(.whisper-download-title),
  :global(.whisper-download-meta) {
    margin: 0;
  }

  :global(.whisper-download-title) {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  :global(.whisper-download-meta) {
    font-size: calc(var(--text-sm) * 0.9);
    color: rgb(var(--color-text-rgb) / 0.42);
  }

  :global(.whisper-download-link) {
    width: fit-content;
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.35);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-download-link):hover,
  :global(.whisper-download-link):focus-visible {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
    outline: none;
  }

  /* ── Log ────────────────────────────────────────────────── */
  .whisper-log-wrap {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    background: rgb(var(--color-text-rgb) / 0.01);
    overflow: hidden;
    box-shadow: var(--edge-highlight);
  }

  .whisper-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--whisper-edge);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .whisper-log-header:hover .whisper-log-title {
    color: rgb(var(--color-text-rgb) / 0.58);
  }

  .whisper-log-header-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .whisper-log-chevron {
    width: 0.75rem;
    height: 0.75rem;
    color: rgb(var(--color-text-rgb) / 0.3);
    transition: transform var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-chevron {
    transform: rotate(-90deg);
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-header {
    border-bottom-color: transparent;
  }

  .whisper-log-wrap.whisper-log-collapsed .whisper-log-output {
    max-height: 0;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
  }

  .whisper-log-output {
    transition:
      max-height var(--duration-normal) var(--ease-out),
      min-height var(--duration-normal) var(--ease-out),
      padding var(--duration-normal) var(--ease-out);
  }

  .whisper-log-title {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
  }

  :global(.whisper-log-hint) {
    margin: 0;
    padding: 0.45rem 0.8rem 0;
    font-size: var(--whisper-text-micro);
    color: rgb(var(--color-text-rgb) / 0.38);
    line-height: 1.35;
  }

  .whisper-log-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.12);
    flex-shrink: 0;
    transition: background var(--duration-slow) var(--ease-out);
  }

  .whisper-log-dot:global(.whisper-log-active) {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.4);
    animation: whisper-log-blink 1s ease-in-out infinite;
  }

  @keyframes whisper-log-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .whisper-log-output {
    margin: 0;
    min-height: 7rem;
    max-height: clamp(14rem, 12rem + 8vw, 24rem);
    overflow: auto;
    font-family: var(--whisper-font-mono);
    font-size: calc(var(--text-sm) * 0.9);
    line-height: 1.6;
    padding: 0.65rem 0.8rem;
    color: rgb(var(--color-text-rgb) / 0.6);
    background: transparent;
  }

  /* ── Insights ──────────────────────────────────────────── */
  .whisper-insights {
    display: grid;
    gap: calc(var(--space-xs) * 0.9);
  }

  .insights-title {
    margin: 0;
    font-size: var(--text-lg);
    color: rgb(var(--color-text-rgb) / 0.8);
    letter-spacing: -0.01em;
  }

  .insights-text {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.44);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .insights-text strong {
    color: rgb(var(--color-text-rgb) / 0.55);
    font-weight: 500;
  }

  .insights-text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    text-decoration-color: rgb(var(--color-text-rgb) / 0.3);
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .insights-text a:visited {
    color: inherit;
  }

  .insights-text a:hover {
    color: rgb(var(--color-text-rgb) / 0.68);
    text-decoration-color: rgb(var(--color-text-rgb) / 0.5);
  }

  .insights-text a:focus-visible {
    outline: 1px solid rgb(var(--color-text-rgb) / 0.45);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .insights-text em {
    color: rgb(var(--color-text-rgb) / 0.65);
    font-style: italic;
  }

  /* ── Fixed Action Bar ──────────────────────────────────── */
  .whisper-actions {
    border-radius: var(--whisper-radius);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    max-width: min(
      var(--content-width),
      calc(100vw - 2 * clamp(0.75rem, 4vw, 1.5rem))
    );
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .whisper-actions::-webkit-scrollbar {
    display: none;
  }

  .action-btn {
    border-radius: calc(var(--whisper-radius) * 0.625);
  }

  .action-btn--primary {
    background: rgb(var(--tool-action-run) / 0.1);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:hover:not(:disabled) {
    background: rgb(var(--tool-action-run) / 0.18);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:global(.action-btn--loading) {
    background: rgb(var(--tool-action-load) / 0.16);
    color: rgb(var(--tool-action-load));
    pointer-events: none;
  }

  .action-btn--primary:global(.action-btn--ran) {
    animation: whisper-run-ack 900ms var(--ease-spring);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.22) 0%,
      rgb(var(--chromatic-cyan) / 0.1) 100%
    );
    color: rgb(var(--chromatic-cyan));
    border: 1px solid rgb(var(--chromatic-cyan) / 0.35);
  }

  @keyframes whisper-run-ack {
    0% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
    35% {
      transform: translateY(-1px) scale(1.03);
      box-shadow: 0 0 14px rgb(var(--chromatic-cyan) / 0.24);
    }
    100% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
  }

  .action-btn--icon {
    min-width: var(--touch-target);
    padding-inline: calc(var(--space-xs) * 0.8);
  }

  .lens-handoff-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .action-btn:hover:not(:disabled) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .action-btn:disabled {
    cursor: not-allowed;
    color: rgb(var(--color-text-rgb) / 0.38);
    background: transparent;
    opacity: 1;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .whisper-upload-zone {
      padding: var(--space-lg) var(--space-sm);
    }

    .upload-icon {
      display: none;
    }

    .whisper-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }

  /* ── Touch devices ─────────────────────────────────────── */
  @media (hover: none) {
    .whisper-upload-zone:hover {
      border-color: rgb(var(--color-text-rgb) / 0.14);
      background: linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.012) 0%,
        transparent 60%
      );
      box-shadow: var(--edge-highlight);
    }

    .whisper-upload-zone:hover .upload-icon {
      color: rgb(var(--color-text-rgb) / 0.14);
      transform: none;
    }

    .whisper-upload-zone:hover .upload-text {
      color: rgb(var(--color-text-rgb) / 0.6);
    }

    .whisper-upload-zone:active {
      border-color: rgb(var(--chromatic-cyan) / 0.35);
      background: linear-gradient(
        180deg,
        rgb(var(--chromatic-cyan) / 0.03) 0%,
        rgb(var(--chromatic-cyan) / 0.008) 50%,
        transparent 100%
      );
    }

    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }

    .action-btn--primary:hover {
      background: rgb(var(--tool-action-run) / 0.1);
      color: rgb(var(--tool-action-run));
    }

    .action-btn--primary:active {
      background: rgb(var(--tool-action-run) / 0.2);
    }

    .whisper-mode-btn:not(.whisper-mode-btn--active):hover {
      color: rgb(var(--color-text-rgb) / 0.55);
      border-color: transparent;
    }

    .whisper-mode-btn:not(.whisper-mode-btn--active):active {
      color: rgb(var(--color-text-rgb));
      border-color: rgb(var(--color-text-rgb) / 0.18);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    :global(.wl-spinner) {
      animation: none;
    }

    .whisper-log-dot:global(.whisper-log-active) {
      animation: none;
    }

    .whisper-log-chevron {
      transition: none;
    }

    .whisper-log-output {
      transition: none;
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Live — Mode Styles
     ═══════════════════════════════════════════════════════ */

  .whisper-op-live {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  :global(.wl-phase) {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

  :global(.wl-phase--chat) {
    margin-top: 0;
  }

  :global(.whisper-op-live.wl-connected .wl-phase--chat) {
    margin-top: calc(var(--space-sm) * -1);
  }

  .wl-head {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: calc(var(--space-xs) * 0.6) var(--space-sm);
    background: var(--whisper-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      border-radius var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);

    /* Surgical fix: allow tooltip to overflow the panel */
    overflow: visible;
  }

  .wl-head-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    grid-column: 1;
    grid-row: 1;

    /* Ensure tooltip isn't clipped by the title row flexbox */
    overflow: visible;
  }

  .wl-head-title {
    margin: 0;
    font-size: var(--text-ui-base);
    line-height: 1.15;
    letter-spacing: 0.015em;
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  /* the e2e badge is no longer a pill of its own: it is a surgical status
     pip that lives inside the fingerprint chip's wrapper, its dot carrying
     the whole meaning (color + glow + tooltip). the wrapper (.wl-fp-wrap)
     is what visually encloses the pip and the emoji/name together as one
     unit. see .wl-fp-wrap below. */
  .wl-e2e-badge {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    vertical-align: middle;
    user-select: none;
    position: relative;
    cursor: default;
    /* Strictly inert when not connected */
    pointer-events: none;
  }

  .whisper-op-live.wl-connected .wl-e2e-badge,
  .whisper-op-live.wl-recovering .wl-e2e-badge,
  .whisper-op-live.wl-preview .wl-e2e-badge {
    cursor: help;
    pointer-events: auto;
  }

  .wl-e2e-tip {
    --_tip-gap: calc(var(--space-xs) * 0.8);
    --_tip-arrow: 5px;
    --_tip-slide: 4px;

    position: absolute;
    bottom: calc(100% + var(--_tip-gap) + var(--_tip-arrow));
    left: 50%;
    transform: translateX(-50%) translateY(var(--_tip-slide));
    width: max-content;
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-xs) * 0.9);
    background: var(--color-bg);
    background-image: var(--surface-sheen);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow:
      var(--edge-highlight),
      0 8px 32px rgba(0, 0, 0, 0.5);
    color: var(--color-text-muted);
    font-size: var(--whisper-text-soft);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    z-index: 1000;
    white-space: nowrap;
    display: none;
  }

  .wl-e2e-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: var(--_tip-arrow) solid transparent;
    border-top-color: var(--color-border);
  }

  /* Hover/Focus states (only when active/preview) */
  .whisper-op-live.wl-connected .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge:hover .wl-e2e-tip,
  .whisper-op-live.wl-connected .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge:focus-within .wl-e2e-tip,
  .whisper-op-live.wl-connected .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip,
  .whisper-op-live.wl-recovering .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip,
  .whisper-op-live.wl-preview .wl-e2e-badge.wl-e2e-tip--open .wl-e2e-tip {
    display: block;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-e2e-tip {
      transition: none;
    }
  }

  /* live connection stats line, second row of the tooltip — empty until polled */
  .wl-e2e-tip-stats {
    display: block;
    margin-top: calc(var(--space-xs) * 0.3);
    font-family: var(--whisper-font-mono);
    font-size: var(--whisper-text-hairline);
    letter-spacing: 0.02em;
    color: rgb(var(--color-text-rgb) / 0.5);
  }

  .wl-e2e-tip-stats:empty {
    display: none;
  }

  /* the pip is the kizuna bond itself: two interlocking rings, two peers
     sealed. it wears the site's chromatic split and takes the connection's
     color. the left ring leans cyan, the right red, so at rest it already
     carries the rgb-split signature; the state color washes over both. */
  .wl-e2e-dot {
    display: inline-flex;
    align-items: center;
    color: rgb(var(--color-text-rgb) / 0.3);
    flex: 0 0 auto;
    transition: color var(--duration-normal) var(--ease-out),
      filter var(--duration-normal) var(--ease-out);
  }

  .wl-e2e-glyph {
    width: 1.25em;
    height: 0.9em;
    overflow: visible;
  }

  /* the two rings split chromatically: a hair of cyan on one, red on the
     other, so the bond shimmers the way the rest of whisper does. */
  .wl-e2e-glyph circle:first-child {
    filter: drop-shadow(-0.6px 0 rgb(var(--chromatic-cyan) / 0.5));
  }
  .wl-e2e-glyph circle:last-child {
    filter: drop-shadow(0.6px 0 rgb(var(--chromatic-red) / 0.4));
  }

  .whisper-op-live.wl-connected .wl-e2e-dot {
    color: rgb(var(--chromatic-cyan));
    filter: drop-shadow(0 0 3px rgb(var(--chromatic-cyan) / 0.5));
  }

  /* relayed path (TURN fallback) — the bond leans to the violet used for
     other "external assist" affordances, in place of the direct-path cyan */
  .whisper-op-live.wl-connected .wl-e2e-badge[data-path="relayed"] .wl-e2e-dot {
    color: rgb(var(--tool-action-load));
    filter: drop-shadow(0 0 3px rgb(var(--tool-action-load) / 0.5));
  }

  .whisper-op-live.wl-preview .wl-e2e-dot {
    color: rgb(var(--color-text-rgb) / 0.3);
    filter: none;
  }

  /* recovering: the bond strains amber, its glow breathing while the link
     tries to re-seal. the resting cyan/red ring-split is neutralized here so
     the amber reads clean rather than fighting the chromatic tint. */
  .whisper-op-live.wl-recovering .wl-e2e-dot {
    color: rgb(var(--tool-status-warning));
    animation: wl-e2e-bond-pulse 1.1s ease-in-out infinite;
  }

  .whisper-op-live.wl-recovering .wl-e2e-glyph circle {
    filter: none;
  }

  @keyframes wl-e2e-bond-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 1px rgb(var(--tool-status-warning) / 0.3));
      opacity: 0.7;
    }
    50% {
      filter: drop-shadow(0 0 5px rgb(var(--tool-status-warning) / 0.7));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whisper-op-live.wl-recovering .wl-e2e-dot {
      animation: none;
    }
  }

  /* the fingerprint wrapper is now the unit the e2e pip belongs to: the pip
     leads, the emoji/name follows, and the whole thing reads as one chip.
     the pip tucks toward the chip so it sits at its leading edge rather than
     floating beside it, and the chip's own border carries the e2e color so
     the encryption state visibly wraps the peer's identity. */
  .wl-head-title-row .wl-fp-wrap {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    min-width: 0;
    position: relative;
  }

  /* the bond wears its own little chamber: an iris box adhered to the
     chip's leading edge, split-button anatomy. it owns three walls; the
     chip's left border is the shared hairline between them, so the two
     boxes read as one instrument. hidden until there is an identity to
     secure (a lone iris at idle reads as a stray artifact). */
  .wl-head-title-row .wl-e2e-badge {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 0.42em;
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-right: none;
    border-radius: var(--whisper-radius-soft) 0 0 var(--whisper-radius-soft);
    background: rgb(10 10 10 / 0.6);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  :global(.whisper-op-live.wl-connected) .wl-head-title-row .wl-e2e-badge,
  :global(.whisper-op-live.wl-recovering) .wl-head-title-row .wl-e2e-badge,
  :global(.whisper-op-live.wl-preview) .wl-head-title-row .wl-e2e-badge {
    display: inline-flex;
  }

  /* the chip flattens its leading corners to receive the iris. */
  :global(.whisper-op-live.wl-connected) .wl-head-title-row :global(.wl-fp-chip),
  :global(.whisper-op-live.wl-recovering) .wl-head-title-row :global(.wl-fp-chip),
  :global(.whisper-op-live.wl-preview) .wl-head-title-row :global(.wl-fp-chip) {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  /* state colors wash over the whole instrument: iris walls, shared
     hairline, and chip border together. */
  :global(.whisper-op-live.wl-connected) .wl-head-title-row .wl-e2e-badge {
    border-color: rgb(var(--chromatic-cyan) / 0.32);
    background: rgb(var(--chromatic-cyan) / 0.05);
  }

  :global(.whisper-op-live.wl-connected) .wl-head-title-row :global(.wl-fp-chip) {
    border-color: rgb(var(--chromatic-cyan) / 0.32);
  }

  :global(.whisper-op-live.wl-connected)
    .wl-head-title-row
    .wl-e2e-badge[data-path="relayed"] {
    border-color: rgb(var(--tool-action-load) / 0.32);
    background: rgb(var(--tool-action-load) / 0.05);
  }

  :global(.whisper-op-live.wl-connected)
    .wl-head-title-row
    :global(.wl-e2e-badge[data-path="relayed"]
    ~ .wl-fp-chip) {
    border-color: rgb(var(--tool-action-load) / 0.32);
  }

  :global(.whisper-op-live.wl-recovering) .wl-head-title-row .wl-e2e-badge {
    border-color: rgb(var(--tool-status-warning) / 0.32);
    background: rgb(var(--tool-status-warning) / 0.05);
  }

  :global(.whisper-op-live.wl-recovering) .wl-head-title-row :global(.wl-fp-chip) {
    border-color: rgb(var(--tool-status-warning) / 0.32);
  }

  .wl-head-right {
    display: none;
    justify-self: end;
    grid-column: 2;
    grid-row: 3;
    align-self: center;
  }

  .whisper-op-live.wl-connected .wl-head {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow: none;
    padding-top: calc(var(--space-sm) * 0.6);
    padding-bottom: calc(var(--space-sm) * 0.6);
  }

  .whisper-op-live.wl-connected .wl-head-right {
    display: flex;
    grid-row: 1;
    min-width: 0;
    overflow: hidden;
    justify-self: stretch;
    justify-content: flex-end;
