  .whisper-page[data-mode="embed"] .whisper-op-seal,
  .whisper-page[data-mode="extract"] .whisper-op-seal,
  .whisper-page[data-mode="live"] .whisper-op-seal {
    display: none;
  }

  .whisper-page[data-mode="live"] .whisper-op-solo,
  .whisper-page[data-mode="seal"] .whisper-op-solo,
  .whisper-page[data-mode="live"] .whisper-section--solo {
    display: none;
  }

  /* seal bar: visibility managed by JS in WhisperSealPanel (inline style) */
  .seal-actions-bar {
    border-radius: var(--radius-lg);
