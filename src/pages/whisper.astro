---
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "Whisper | woflo",
  description:
    "Carrier-bound stealth payload embedding and extraction. Inert-space scan, encrypted embed, and multi-file hunt — fully local in your browser.",
  image: "/images/social-card.png",
};
---

<Layout seo={seo}>
  <div class="whisper-page" id="whisper-page" data-mode="embed" data-busy="0" data-breadcrumb-controller>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section
      class="mt-8 content-section whisper-intro"
    >
      <div class="whisper-title-row">
        <h1 class="page-title whisper-title" id="whisper-title">Whisper</h1>
        <span class="whisper-alpha-badge" id="whisper-alpha-badge">ALPHA</span>
      </div>
      <p class="whisper-tagline">carrier-bound inert-space encryption</p>
      <p class="whisper-privacy-badge">
        <span class="privacy-dot"></span>
        local to this browser
      </p>
    </section>

    <!-- ── Mode Selector ────────────────────────────────────── -->
    <section
      class="mt-[var(--space-md)] content-section"
    >
      <div class="whisper-mode-bar" role="group" aria-label="Whisper mode">
        <button
          class="whisper-mode-btn whisper-mode-btn--active"
          data-whisper-mode="embed"
          aria-pressed="true"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="2" y="2" width="12" height="12" rx="2"></rect>
            <path d="M5 8h6M8 5v6"></path>
          </svg>
          Embed
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="extract"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="2" y="2" width="12" height="12" rx="2"></rect>
            <path d="M5 8h6"></path>
          </svg>
          Extract
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="hunt"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="7" cy="7" r="4"></circle>
            <path d="M10 10l3.5 3.5"></path>
          </svg>
          Hunt
        </button>
        <button
          class="whisper-mode-btn"
          data-whisper-mode="live"
          aria-pressed="false"
          type="button"
        >
          <svg class="whisper-mode-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="5" cy="8" r="3"></circle>
            <circle cx="11" cy="8" r="3"></circle>
            <path d="M8 6v4"></path>
          </svg>
          Live
        </button>
      </div>
    </section>

    <!-- ── Upload Zone (carrier) ────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] content-section whisper-section--solo"
    >
      <div
        class="whisper-upload-zone"
        id="whisper-upload-zone"
        role="button"
        tabindex="0"
        aria-label="Upload a carrier file"
      >
        <div class="upload-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v12"></path>
            <path d="M8 11l4 4 4-4"></path>
            <rect x="3" y="17" width="18" height="4" rx="2"></rect>
            <circle cx="7" cy="19" r="0.5" fill="currentColor"></circle>
          </svg>
        </div>
        <p class="upload-text" id="whisper-upload-text">drop a carrier file here</p>
        <p class="upload-subtext">or click / paste to browse</p>
        <p class="upload-formats">PNG &middot; JPEG &middot; TIFF &middot; BMP &middot; any file</p>
        <p class="upload-file-meta" id="whisper-upload-meta"></p>
        <input
          type="file"
          id="whisper-carrier-input"
          class="sr-only"
          aria-hidden="true"
        />
      </div>
    </section>

    <!-- ── Operation Panel ──────────────────────────────────── -->
    <section
      class="mt-[var(--space-sm)] content-section"
    >
      <!-- Solo mode content (embed / extract / hunt) -->
      <div class="whisper-op-solo">
        <div class="whisper-panel">
          <div class="whisper-panel-header">
            <h2 class="whisper-panel-title" id="whisper-op-title">
              <span class="whisper-op whisper-op--idle whisper-op--embed">Embed</span>
              <span class="whisper-op whisper-op--idle whisper-op--extract">Extract</span>
              <span class="whisper-op whisper-op--idle whisper-op--hunt">Hunt</span>

              <span class="whisper-op whisper-op--busy whisper-op--embedding">Embedding</span>
              <span class="whisper-op whisper-op--busy whisper-op--extracting">Extracting</span>
              <span class="whisper-op whisper-op--busy whisper-op--hunting">Hunting</span>
            </h2>
            <span class="whisper-panel-mode" id="whisper-status-line">drop a carrier file to begin</span>
          </div>

          <!-- Hunt multi-file input -->
          <label class="whisper-field whisper-field--hunt" for="whisper-hunt-carrier-input">
            <span class="whisper-field-label">carrier files <span class="whisper-field-hint">(hunt mode)</span></span>
            <div class="whisper-file-btn" tabindex="-1">
              <span class="whisper-file-btn-text" id="whisper-hunt-label">choose files&hellip;</span>
              <input id="whisper-hunt-carrier-input" type="file" multiple class="sr-only" aria-hidden="true" />
            </div>
          </label>

          <!-- Payload input -->
          <label class="whisper-field whisper-field--embed" for="whisper-payload-input">
            <span class="whisper-field-label">payload file <span class="whisper-field-hint">(embed mode)</span></span>
            <div class="whisper-file-btn" tabindex="-1">
              <span class="whisper-file-btn-text" id="whisper-payload-label">choose file&hellip;</span>
              <input id="whisper-payload-input" type="file" class="sr-only" aria-hidden="true" />
            </div>
          </label>

          <!-- Password -->
          <label class="whisper-field" for="whisper-password-input">
            <span class="whisper-field-label">password</span>
            <div class="whisper-password-row">
              <input
                id="whisper-password-input"
                type="password"
                class="whisper-input whisper-password-input"
                autocomplete="off"
                placeholder="password to encrypt"
              />
              <div class="whisper-password-tools" role="group" aria-label="Password tools">
                <button
                  id="whisper-password-gen"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Generate a strong random password"
                  title="Generate"
                >Generate</button>
                <button
                  id="whisper-password-copy"
                  class="whisper-mini-btn"
                  type="button"
                  aria-label="Copy password to clipboard"
                  title="Copy"
                >Copy</button>
              </div>
            </div>
            <p id="whisper-password-meta" class="whisper-password-meta whisper-field-hint" aria-live="polite"></p>
          </label>

          <!-- Privacy toggle (embed only) -->
          <div class="whisper-field whisper-field--embed">
            <span class="whisper-field-label">privacy</span>
            <label class="whisper-toggle" for="whisper-only-decode-here">
              <input id="whisper-only-decode-here" type="checkbox" class="whisper-toggle-input" />
              <span class="whisper-toggle-text">
                only decode here
                <span class="whisper-field-hint">(locks decryption to this browser profile)</span>
              </span>
            </label>
          </div>

          <!-- Embed behavior (embed only) -->
          <div class="whisper-field whisper-field--embed">
            <span class="whisper-field-label">embed</span>
            <label class="whisper-toggle" for="whisper-allow-tail-fallback">
              <input id="whisper-allow-tail-fallback" type="checkbox" class="whisper-toggle-input" checked />
              <span class="whisper-toggle-text">
                allow tail fallback
                <span class="whisper-field-hint">(if no inert slot fits, attach a small tail)</span>
              </span>
            </label>
          </div>

          <!-- Clue -->
          <label class="whisper-field whisper-field--hunt" for="whisper-clue-input">
            <span class="whisper-field-label">payload clue <span class="whisper-field-hint">(optional)</span></span>
            <input
              id="whisper-clue-input"
              type="text"
              class="whisper-input"
              placeholder="name fragment or hash prefix"
            />
          </label>
        </div>
      </div>

      <!-- Live mode content (all phases live inside the same section) -->
      <div class="whisper-op-live" id="wl-section">
        <div class="wl-head whisper-panel" aria-label="Whisper Live status">
          <h2 class="wl-head-title">Whisper Live</h2>
          <div class="wl-head-right">
            <span class="wl-head-meta">peer-to-peer</span>
          </div>

          <div class="wl-status-chip" role="status" aria-live="polite">
            <span class="wl-status-dot" aria-hidden="true"></span>
            <span id="wl-status-line" class="wl-status-text">ready to connect</span>
          </div>
        </div>

        <!-- Phase: idle — create or join -->
        <div class="wl-phase" id="wl-idle-phase">
          <div class="wl-grid">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Create</h3>
                <span class="whisper-panel-mode">start a new channel</span>
              </div>
              <button id="wl-create" type="button" class="whisper-mini-btn wl-primary">Create channel</button>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Join</h3>
                <span class="whisper-panel-mode">paste an offer code</span>
              </div>
              <div class="wl-join-row">
                <input
                  id="wl-join-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="offer code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="wl-join" type="button" class="whisper-mini-btn">Join</button>
              </div>
            </div>
          </div>

          <div class="whisper-panel wl-phrase-panel">
            <label class="whisper-field" for="wl-phrase">
              <span class="whisper-field-label">shared phrase <span class="whisper-field-hint">(optional — match on both sides)</span></span>
              <input
                id="wl-phrase"
                type="password"
                class="whisper-input"
                placeholder="a short phrase you both know"
                autocomplete="off"
              />
            </label>

            <div class="whisper-field">
              <span class="whisper-field-label">network</span>
              <label class="whisper-toggle" for="wl-external-assist">
                <input id="wl-external-assist" type="checkbox" class="whisper-toggle-input" />
                <span class="whisper-toggle-text">
                  external assist (stun)
                  <span class="whisper-field-hint">(helps connect across networks. may expose network metadata during setup. it turns off after connect)</span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- Phase: offering — show offer code, wait for answer -->
        <div class="wl-phase" id="wl-offer-section" style="display:none">
          <div class="wl-grid">
            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Send</h3>
                <span class="whisper-panel-mode">offer code</span>
              </div>
              <div class="wl-code-display-wrap">
                <pre id="wl-offer-code" class="wl-code-display"></pre>
                <button id="wl-offer-copy" type="button" class="whisper-mini-btn">Copy</button>
              </div>
            </div>

            <div class="whisper-panel wl-card">
              <div class="whisper-panel-header">
                <h3 class="whisper-panel-title">Receive</h3>
                <span class="whisper-panel-mode">paste reply</span>
              </div>
              <div class="wl-join-row">
                <input
                  id="wl-answer-input"
                  type="text"
                  class="whisper-input wl-code-input"
                  placeholder="answer code"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="wl-answer-apply" type="button" class="whisper-mini-btn wl-primary">Connect</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Phase: answering — show answer code to copy back -->
        <div class="wl-phase" id="wl-answer-section" style="display:none">
          <div class="whisper-panel wl-answer-only">
            <div class="whisper-panel-header">
              <h3 class="whisper-panel-title">Send back</h3>
              <span class="whisper-panel-mode">answer code</span>
            </div>
            <div class="wl-code-display-wrap">
              <pre id="wl-answer-code" class="wl-code-display"></pre>
              <button id="wl-answer-copy" type="button" class="whisper-mini-btn">Copy</button>
            </div>
          </div>
        </div>

        <!-- Phase: connecting/handshaking -->
        <div class="wl-phase" id="wl-connecting-section" style="display:none">
          <div class="whisper-panel wl-connecting-panel">
            <div class="wl-spinner" aria-hidden="true"></div>
            <p id="wl-connecting-status" class="wl-connecting-text">establishing connection...</p>
          </div>
        </div>

        <!-- Phase: verify fingerprint -->
        <div class="wl-phase" id="wl-verify-section" style="display:none">
          <div class="whisper-panel wl-verify-panel">
            <h2 class="whisper-panel-title">Verify fingerprint</h2>
            <p class="whisper-field-hint">does your peer see the same emoji?</p>
            <p id="wl-fingerprint" class="wl-fingerprint" aria-live="polite"></p>
            <div class="wl-verify-actions">
              <button id="wl-confirm" type="button" class="whisper-mini-btn wl-confirm-btn">They match</button>
              <button id="wl-reject" type="button" class="whisper-mini-btn wl-reject-btn">They don't match</button>
            </div>
          </div>
        </div>

        <!-- Phase: live chat -->
        <div class="wl-phase" id="wl-chat-section" style="display:none">
          <div class="whisper-panel wl-chat-panel">
            <div class="wl-chat-header">
              <div class="wl-transport" role="radiogroup" aria-label="Transport mode">
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="naked" checked class="wl-transport-radio" /> naked</label>
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="dressed" class="wl-transport-radio" /> dressed</label>
                <label class="wl-transport-label"><input type="radio" name="wl-transport" value="silent" class="wl-transport-radio" /> silent</label>
              </div>
              <button id="wl-disconnect" type="button" class="whisper-mini-btn wl-disconnect-btn">Disconnect</button>
            </div>

            <div id="wl-chat-messages" class="wl-chat-messages" aria-live="polite" aria-relevant="additions"></div>

            <div class="wl-chat-compose">
              <input
                id="wl-chat-input"
                type="text"
                class="whisper-input wl-chat-text-input"
                placeholder="type a message"
                autocomplete="off"
                spellcheck="false"
              />
              <button id="wl-chat-file-btn" type="button" class="whisper-mini-btn wl-chat-file-btn" aria-label="Send a file" title="Send file">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" class="wl-file-icon" aria-hidden="true">
                  <path d="M8 2v8M4 6l4-4 4 4"></path>
                  <path d="M2 10v3a1 1 0 001 1h10a1 1 0 001-1v-3"></path>
                </svg>
              </button>
              <input id="wl-chat-file-input" type="file" class="sr-only" aria-hidden="true" />
              <button id="wl-chat-send" type="button" class="whisper-mini-btn wl-chat-send-btn">Send</button>
            </div>
          </div>
        </div>

        <!-- Phase: silent mode — show shared secret -->
        <div class="wl-phase" id="wl-silent-section" style="display:none">
          <div class="whisper-panel wl-silent-panel">
            <h2 class="whisper-panel-title">Shared secret</h2>
            <p class="whisper-field-hint">use this as your Whisper password for solo-mode dead drops through any channel</p>
            <div class="wl-code-display-wrap">
              <pre id="wl-silent-secret" class="wl-code-display wl-secret-display"></pre>
              <button id="wl-silent-copy" type="button" class="whisper-mini-btn">Copy</button>
            </div>
            <button id="wl-silent-disconnect" type="button" class="whisper-mini-btn wl-disconnect-btn">End session</button>
          </div>
        </div>

        <!-- Phase: disconnected -->
        <div class="wl-phase" id="wl-disconnected-section" style="display:none">
          <div class="whisper-panel wl-end-panel">
            <p class="wl-end-text">session ended — no trace remains</p>
            <button id="wl-new-session" type="button" class="whisper-mini-btn">New session</button>
          </div>
        </div>

        <!-- Phase: error -->
        <div class="wl-phase" id="wl-error-section" style="display:none">
          <div class="whisper-panel wl-error-panel">
            <p id="wl-error-message" class="wl-error-text"></p>
            <button id="wl-error-retry" type="button" class="whisper-mini-btn">Try again</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Progress Bar ─────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--solo" id="whisper-progress-section" style="display:none">
      <div class="whisper-progress">
        <div class="whisper-progress-fill" id="whisper-progress-fill"></div>
      </div>
    </section>

    <!-- ── Results ──────────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--solo">
      <div id="whisper-results" class="whisper-results" aria-live="polite"></div>
      <div id="whisper-download-area" class="whisper-downloads"></div>
    </section>

    <!-- ── Runtime Log ──────────────────────────────────────── -->
    <section class="mt-[var(--space-sm)] content-section whisper-section--shared">
      <div class="whisper-log-wrap">
        <div class="whisper-log-header">
          <p class="whisper-log-title">runtime log</p>
          <span class="whisper-log-dot" id="whisper-log-dot"></span>
        </div>
        <pre id="whisper-log-output" class="whisper-log-output"></pre>
      </div>
    </section>

    <!-- ── Insights ─────────────────────────────────────────── -->
    <section class="mt-[var(--space-lg)] mb-[var(--space-xl)] content-section whisper-section--solo">
      <div class="whisper-insights">
        <h2 class="insights-title">what does this do?</h2>
        <p class="insights-text">
          whisper takes a normal file (a "carrier"), and hides something secret inside it. the secret payload is injected into padding, gaps, and dead space most formats already have. the carrier file retiains all functionality. if there's
          not enough room, it can attach as a tail.
        </p>
        <p class="insights-text">
          it’s intentionally fragile. edit the carrier, re-save it, recompress
          it, or move the bytes around even a little and it won’t decrypt anymore. the payload
          is bound to that exact file.
        </p>
        <p class="insights-text">
          everything runs locally. nothing gets uploaded. embed hides a payload, 
          extract pulls it back out, hunt checks whether one is
          present, and live combines these so you can do it peer to peer between
          two browsers.
        </p>
      </div>
    </section>

    <!-- ── Fixed Action Bar (hidden until carrier loaded) ──── -->
    <div
      class="whisper-actions whisper-section--solo"
      id="whisper-actions"
      role="group"
      aria-label="Whisper controls"
      style="display:none;opacity:0"
    >
      <button
        class="action-btn action-btn--primary"
        id="whisper-action-run"
        type="button"
        disabled
      >Embed</button>
      <button
        class="action-btn"
        id="whisper-action-upload"
        type="button"
      >New File</button>
      <button
        class="action-btn action-btn--icon"
        id="whisper-action-lens"
        type="button"
        aria-label="View with Lens"
        title="View with Lens"
        style="display:none"
      >
        <svg
          class="lens-handoff-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
        </svg>
      </button>
      <button
        class="action-btn"
        id="whisper-action-clear"
        type="button"
        disabled
      >Clear</button>
    </div>
  </div>

  <script>
    import { initWhisper, resolveWhisperUIOptions } from "../scripts/whisper-ui";
    import { initWhisperLive, resolveWhisperLiveUIOptions } from "../scripts/whisper-live-ui";

    const WHISPER_LIFECYCLE_KEY = "__whisperLifecycle";
    type WhisperLifecycle = {
      boot: () => void;
      teardown: () => void;
      detach?: () => void;
    };

    let cleanupWhisper: (() => void) | null = null;
    let cleanupLive: (() => void) | null = null;
    const whisperWindow = window as unknown as Record<string, WhisperLifecycle | undefined>;

    function boot() {
      teardown();
      const whisperOptions = resolveWhisperUIOptions(document);
      if (whisperOptions) cleanupWhisper = initWhisper(whisperOptions);
      const liveOptions = resolveWhisperLiveUIOptions(document);
      if (liveOptions) cleanupLive = initWhisperLive(liveOptions);
    }

    function teardown() {
      cleanupWhisper?.();
      cleanupWhisper = null;
      cleanupLive?.();
      cleanupLive = null;
    }

    function detachLifecycle() {
      document.removeEventListener("astro:after-swap", boot);
      document.removeEventListener("astro:before-swap", handleBeforeSwap);
    }

    function handleBeforeSwap() {
      teardown();
      detachLifecycle();
      const current = whisperWindow[WHISPER_LIFECYCLE_KEY];
      if (current?.boot === boot) {
        delete whisperWindow[WHISPER_LIFECYCLE_KEY];
      }
    }

    function attachLifecycle() {
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", handleBeforeSwap);
    }

    const prev = whisperWindow[WHISPER_LIFECYCLE_KEY];
    if (prev) {
      if (prev.detach) {
        prev.detach();
      } else {
        document.removeEventListener("astro:after-swap", prev.boot);
        document.removeEventListener("astro:before-swap", prev.teardown);
      }
      prev.teardown?.();
    }

    whisperWindow[WHISPER_LIFECYCLE_KEY] = {
      boot,
      teardown,
      detach: detachLifecycle,
    };

    boot();
    attachLifecycle();
  </script>
</Layout>

<style>
  /* ── Page Shell ────────────────────────────────────────── */
  .whisper-page {
    --whisper-radius: var(--radius-lg);
    --whisper-muted: rgb(var(--color-text-rgb) / 0.58);
    --whisper-faint: rgb(var(--color-text-rgb) / 0.3);
    --whisper-edge: rgb(var(--color-text-rgb) / 0.14);
    --whisper-surface: rgb(var(--color-text-rgb) / 0.015);
    --whisper-action-offset: calc(var(--touch-target) + (var(--space-sm) * 2));
    padding-bottom: calc(var(--whisper-action-offset) + var(--space-lg));
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .whisper-intro {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

    .whisper-title-row {
      display: flex;
      align-items: center;
      gap: calc(var(--space-xs) * 0.7);
    }

  .whisper-title {
    margin: 0;
    line-height: 1.03;
    letter-spacing: -0.018em;
  }

    .whisper-alpha-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      min-height: calc(var(--touch-target) * 0.5);
      padding: calc(var(--space-xs) * 0.2) calc(var(--space-xs) * 0.6);
      border-radius: calc(var(--whisper-radius) * 0.55);
      border: 1px solid rgb(var(--chromatic-red) / 0.35);
      background: rgb(var(--chromatic-red) / 0.1);
      color: rgb(var(--chromatic-red));
      font-size: calc(var(--text-sm) * 0.66);
      font-weight: 700;
      letter-spacing: 0.08em;
      user-select: none;
    }

  .whisper-tagline {
    margin: 0;
    color: var(--whisper-muted);
  }

  .whisper-privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.28);
    margin-top: calc(var(--space-xs) * 0.3);
  }

  .privacy-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: rgb(var(--tool-status-success));
    box-shadow: 0 0 6px rgb(var(--tool-status-success) / 0.35);
    flex-shrink: 0;
    animation: privacy-pulse 4s ease-in-out infinite;
  }

  @keyframes privacy-pulse {
    0%,
    100% {
      box-shadow: 0 0 5px rgb(var(--tool-status-success) / 0.3);
    }
    50% {
      box-shadow: 0 0 10px rgb(var(--tool-status-success) / 0.5);
    }
  }

  /* ── Mode Bar ──────────────────────────────────────────── */
  .whisper-mode-bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: calc(var(--space-xs) * 0.3);
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    padding: calc(var(--space-xs) * 0.35);
    background: var(--whisper-surface);
    box-shadow: var(--edge-highlight);
  }

  .whisper-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    border: 1px solid transparent;
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.55);
    padding: 0.45rem 0.85rem;
    min-height: var(--touch-target);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      background-color var(--duration-normal) var(--ease-out);
  }

  .whisper-mode-icon {
    width: 0.95em;
    height: 0.95em;
    flex-shrink: 0;
  }

  .whisper-mode-btn:hover,
  .whisper-mode-btn:focus-visible {
    color: rgb(var(--color-text-rgb));
    border-color: rgb(var(--color-text-rgb) / 0.18);
    outline: none;
  }

  .whisper-mode-btn:focus-visible {
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
  }

  .whisper-mode-btn--active {
    border-color: rgb(var(--chromatic-cyan) / 0.4);
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .whisper-mode-btn--active:hover {
    border-color: rgb(var(--chromatic-cyan) / 0.55);
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.12);
  }

  /* ── Upload Zone ───────────────────────────────────────── */
  .whisper-upload-zone {
    position: relative;
    border: 2px dashed rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--whisper-radius);
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    cursor: pointer;
    background: linear-gradient(
      180deg,
      rgb(var(--color-text-rgb) / 0.012) 0%,
      transparent 60%
    );
    box-shadow: var(--edge-highlight);
    transition:
      border-color var(--duration-slow) var(--ease-spring),
      background var(--duration-slow) var(--ease-spring),
      box-shadow var(--duration-slow) var(--ease-spring);
  }

  .whisper-upload-zone:hover,
  .whisper-upload-zone:global(.whisper-drop-active) {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.03) 0%,
      rgb(var(--chromatic-cyan) / 0.008) 50%,
      transparent 100%
    );
    box-shadow: var(--edge-highlight);
  }

  .whisper-upload-zone:active {
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.05) 0%,
      rgb(var(--chromatic-cyan) / 0.015) 50%,
      transparent 100%
    );
  }

  .whisper-upload-zone:focus-visible {
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    box-shadow:
      var(--edge-highlight),
      0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
    outline: none;
  }

  .upload-icon {
    position: absolute;
    top: calc(var(--space-sm) * 1.2);
    left: calc(var(--space-sm) * 1.2);
    width: var(--space-xl);
    height: var(--space-xl);
    color: rgb(var(--color-text-rgb) / 0.14);
    line-height: 0;
    transition:
      color var(--duration-slow) var(--ease-spring),
      transform var(--duration-slow) var(--ease-spring);
  }

  .whisper-upload-zone:hover .upload-icon {
    color: rgb(var(--chromatic-cyan) / 0.4);
    transform: scale(1.06);
  }

  .whisper-upload-zone:active .upload-icon {
    transform: scale(0.94);
  }

  .upload-text {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 calc(var(--space-xs) * 0.3);
    color: rgb(var(--color-text-rgb) / 0.6);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .whisper-upload-zone:hover .upload-text {
    color: rgb(var(--color-text-rgb) / 0.8);
  }

  .upload-subtext {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-sm);
    color: rgb(var(--color-text-rgb) / 0.28);
  }

  .upload-formats {
    font-size: calc(var(--text-sm) * 0.85);
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.15);
    letter-spacing: 0.06em;
  }

  /* ── Upload file meta (hidden until file loaded) ────────── */
  .upload-file-meta {
    display: none;
    margin: 0;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.38);
  }

  /* ── Upload Zone compact (after file loaded) ────────────── */
  .whisper-upload-zone:global(.whisper-upload-zone--compact) {
    padding: calc(var(--space-sm) * 0.9) var(--space-sm);
    border-style: solid;
    border-width: 1px;
    text-align: left;
    cursor: pointer;
    background: var(--whisper-surface);
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-icon {
    display: none;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-text {
    font-weight: 600;
    color: rgb(var(--color-text-rgb) / 0.86);
    margin: 0;
    word-break: break-word;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-subtext,
  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-formats {
    display: none;
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact) .upload-file-meta {
    display: block;
    margin-top: calc(var(--space-xs) * 0.35);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .whisper-upload-zone:global(.whisper-upload-zone--compact):hover .upload-file-meta {
    color: rgb(var(--chromatic-cyan) / 0.55);
  }

  /* ── Operation Panel ───────────────────────────────────── */
  .whisper-panel {
    display: grid;
    gap: var(--space-sm);
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    padding: var(--space-sm);
    background: var(--whisper-surface);
    box-shadow: var(--edge-highlight);
  }

  .whisper-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .whisper-panel-title {
    margin: 0;
    font-size: var(--text-base);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  .whisper-op {
    display: none;
  }

  .whisper-page[data-busy="0"][data-mode="embed"] .whisper-op--embed,
  .whisper-page[data-busy="0"][data-mode="extract"] .whisper-op--extract,
  .whisper-page[data-busy="0"][data-mode="hunt"] .whisper-op--hunt {
    display: inline;
  }

  .whisper-page[data-busy="1"][data-mode="embed"] .whisper-op--embedding,
  .whisper-page[data-busy="1"][data-mode="extract"] .whisper-op--extracting,
  .whisper-page[data-busy="1"][data-mode="hunt"] .whisper-op--hunting {
    display: inline;
  }

  .whisper-panel-mode {
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .whisper-panel-mode:global(.whisper-status--ready) {
    color: rgb(var(--chromatic-cyan));
  }

  .whisper-field {
    display: grid;
    gap: calc(var(--space-xs) * 0.35);
  }

  .whisper-field-label {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.62);
  }

  .whisper-field-hint {
    color: rgb(var(--color-text-rgb) / 0.32);
    font-size: calc(var(--text-sm) * 0.88);
  }

  .whisper-input {
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    color: var(--color-text);
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .whisper-input::placeholder {
    color: rgb(var(--color-text-rgb) / 0.22);
  }

  .whisper-input:focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  .whisper-password-row {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
  }

  .whisper-password-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .whisper-mini-btn {
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    border-radius: calc(var(--whisper-radius) * 0.75);
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    background: rgb(var(--color-text-rgb) / 0.02);
    color: rgb(var(--color-text-rgb) / 0.6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .whisper-password-tools {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: stretch;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    overflow: hidden;
  }

  .whisper-password-tools .whisper-mini-btn {
    border: 0;
    border-radius: 0;
    background: transparent;
    min-height: var(--touch-target);
  }

  .whisper-password-tools .whisper-mini-btn + .whisper-mini-btn {
    border-left: 1px solid rgb(var(--color-text-rgb) / 0.14);
  }

  .whisper-mini-btn:hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
    color: rgb(var(--color-text-rgb) / 0.75);
  }

  .whisper-password-tools .whisper-mini-btn:hover {
    border-color: transparent;
  }

  .whisper-mini-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .whisper-password-meta {
    margin: 0;
    min-height: 1.25em;
  }

  .whisper-mini-btn:focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  .whisper-file-btn {
    display: flex;
    align-items: center;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .whisper-file-btn:hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .whisper-file-btn-text {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  .whisper-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .whisper-toggle:hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .whisper-toggle:focus-within {
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  .whisper-toggle-input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: rgb(var(--chromatic-cyan));
    flex-shrink: 0;
  }

  .whisper-toggle-text {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.66);
  }

  /* ── Mode-conditional visibility ───────────────────────── */

  /* Field-level: hide hunt fields in embed/extract, embed fields in extract/hunt */
  .whisper-page[data-mode="embed"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--embed,
  .whisper-page[data-mode="hunt"] .whisper-field--embed {
    display: none;
  }

  /* Solo vs live: the operation panel section holds both, only one shows */
  .whisper-page[data-mode="embed"] .whisper-op-live,
  .whisper-page[data-mode="extract"] .whisper-op-live,
  .whisper-page[data-mode="hunt"] .whisper-op-live {
    display: none;
  }

  .whisper-page[data-mode="live"] .whisper-op-solo {
    display: none;
  }

  /* Solo-only sections: upload zone, progress, results, action bar.
     Keep insights visible across modes for continuity. */
  .whisper-page[data-mode="live"] #whisper-upload-zone,
  .whisper-page[data-mode="live"] #whisper-progress-section,
  .whisper-page[data-mode="live"] #whisper-results,
  .whisper-page[data-mode="live"] #whisper-download-area,
  .whisper-page[data-mode="live"] #whisper-actions {
    display: none;
  }

  /* ── Progress ──────────────────────────────────────────── */
  .whisper-progress {
    height: 4px;
    border-radius: 2px;
    background: rgb(var(--color-text-rgb) / 0.06);
    overflow: hidden;
  }

  .whisper-progress-fill {
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-cyan));
    border-radius: 2px;
    transition: width 0.3s linear;
  }

  .whisper-progress-fill:global(.whisper-progress--indeterminate) {
    width: 100%;
    animation: whisper-progress-pulse 1.5s ease-in-out infinite;
  }

  @keyframes whisper-progress-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* ── Results ───────────────────────────────────────────── */
  .whisper-results {
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
  }

  .whisper-result {
    margin: 0;
    border: 1px solid var(--whisper-edge);
    border-radius: calc(var(--whisper-radius) * 0.75);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .whisper-result--ok {
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--color-text-rgb) / 0.86);
    background: rgb(var(--chromatic-cyan) / 0.03);
  }

  .whisper-result--warn {
    border-color: rgb(var(--tool-status-warning) / 0.35);
    color: rgb(var(--tool-status-warning));
    background: rgb(var(--tool-status-warning) / 0.04);
  }

  .whisper-result--error {
    border-color: rgb(var(--chromatic-red) / 0.35);
    color: rgb(var(--chromatic-red));
    background: rgb(var(--chromatic-red) / 0.04);
  }

  /* ── Downloads ─────────────────────────────────────────── */
  .whisper-downloads {
    margin-top: var(--space-sm);
    display: grid;
    gap: calc(var(--space-xs) * 0.45);
  }

  .whisper-download-card {
    border: 1px solid var(--whisper-edge);
    border-radius: calc(var(--whisper-radius) * 0.75);
    padding: 0.7rem 0.8rem;
    background: var(--whisper-surface);
    display: grid;
    gap: calc(var(--space-xs) * 0.25);
    box-shadow: var(--edge-highlight);
  }

  .whisper-download-title,
  .whisper-download-meta {
    margin: 0;
  }

  .whisper-download-title {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  .whisper-download-meta {
    font-size: calc(var(--text-sm) * 0.9);
    color: rgb(var(--color-text-rgb) / 0.42);
  }

  .whisper-download-link {
    width: fit-content;
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.35);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .whisper-download-link:hover,
  .whisper-download-link:focus-visible {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
    outline: none;
  }

  /* ── Log ────────────────────────────────────────────────── */
  .whisper-log-wrap {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    background: rgb(var(--color-text-rgb) / 0.01);
    overflow: hidden;
    box-shadow: var(--edge-highlight);
  }

  .whisper-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--whisper-edge);
  }

  .whisper-log-title {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
  }

  .whisper-log-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.12);
    flex-shrink: 0;
    transition: background var(--duration-slow) var(--ease-out);
  }

  .whisper-log-dot:global(.whisper-log-active) {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.4);
    animation: whisper-log-blink 1s ease-in-out infinite;
  }

  @keyframes whisper-log-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .whisper-log-output {
    margin: 0;
    min-height: 7rem;
    max-height: clamp(14rem, 12rem + 8vw, 24rem);
    overflow: auto;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.9);
    line-height: 1.6;
    padding: 0.65rem 0.8rem;
    color: rgb(var(--color-text-rgb) / 0.6);
    background: transparent;
  }

  /* ── Insights ──────────────────────────────────────────── */
  .whisper-insights {
    display: grid;
    gap: calc(var(--space-xs) * 0.9);
  }

  .insights-title {
    margin: 0;
    font-size: var(--text-lg);
    color: rgb(var(--color-text-rgb) / 0.8);
    letter-spacing: -0.01em;
  }

  .insights-text {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.44);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* ── Fixed Action Bar ──────────────────────────────────── */
  .whisper-actions {
    position: fixed;
    bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    gap: calc(var(--space-xs) * 0.25);
    padding: calc(var(--space-xs) * 0.7);
    background: var(--tool-actionbar-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--whisper-radius);
    box-shadow: var(--edge-highlight), 0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 40;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    max-width: min(
      var(--content-width),
      calc(100vw - 2 * clamp(0.75rem, 4vw, 1.5rem))
    );
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .whisper-actions::-webkit-scrollbar {
    display: none;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: calc(var(--space-xs) * 0.8) calc(var(--space-xs) * 1.5);
    background: transparent;
    border: none;
    border-radius: calc(var(--whisper-radius) * 0.625);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
  }

  .action-btn--primary {
    background: rgb(var(--tool-action-run) / 0.1);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:hover:not(:disabled) {
    background: rgb(var(--tool-action-run) / 0.18);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:global(.action-btn--loading) {
    background: rgb(var(--tool-action-load) / 0.16);
    color: rgb(var(--tool-action-load));
    pointer-events: none;
  }

  .action-btn--primary:global(.action-btn--ran) {
    animation: whisper-run-ack 900ms var(--ease-spring);
    background: linear-gradient(180deg, rgb(var(--chromatic-cyan) / 0.22) 0%, rgb(var(--chromatic-cyan) / 0.1) 100%);
    color: rgb(var(--chromatic-cyan));
    border: 1px solid rgb(var(--chromatic-cyan) / 0.35);
  }

  @keyframes whisper-run-ack {
    0% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
    35% {
      transform: translateY(-1px) scale(1.03);
      box-shadow: 0 0 14px rgb(var(--chromatic-cyan) / 0.24);
    }
    100% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
  }

  .action-btn--icon {
    min-width: var(--touch-target);
    padding-inline: calc(var(--space-xs) * 0.8);
  }

  .lens-handoff-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .action-btn:hover:not(:disabled) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .action-btn:disabled {
    cursor: not-allowed;
    color: rgb(var(--color-text-rgb) / 0.38);
    background: transparent;
    opacity: 1;
  }

  @supports not (
    (-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))
  ) {
    .whisper-actions {
      background: var(--tool-actionbar-bg-fallback);
    }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .whisper-upload-zone {
      padding: var(--space-lg) var(--space-sm);
    }

    .upload-icon {
      display: none;
    }

    .whisper-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }

  /* ── Touch devices ─────────────────────────────────────── */
  @media (hover: none) {
    .whisper-upload-zone:hover {
      border-color: rgb(var(--color-text-rgb) / 0.14);
      background: linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.012) 0%,
        transparent 60%
      );
      box-shadow: var(--edge-highlight);
    }

    .whisper-upload-zone:hover .upload-icon {
      color: rgb(var(--color-text-rgb) / 0.14);
      transform: none;
    }

    .whisper-upload-zone:hover .upload-text {
      color: rgb(var(--color-text-rgb) / 0.6);
    }

    .whisper-upload-zone:active {
      border-color: rgb(var(--chromatic-cyan) / 0.35);
      background: linear-gradient(
        180deg,
        rgb(var(--chromatic-cyan) / 0.03) 0%,
        rgb(var(--chromatic-cyan) / 0.008) 50%,
        transparent 100%
      );
    }

    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }

    .action-btn--primary:hover {
      background: rgb(var(--tool-action-run) / 0.1);
      color: rgb(var(--tool-action-run));
    }

    .action-btn--primary:active {
      background: rgb(var(--tool-action-run) / 0.2);
    }

    .whisper-mode-btn:hover {
      color: rgb(var(--color-text-rgb) / 0.55);
      border-color: transparent;
    }

    .whisper-mode-btn:active {
      color: rgb(var(--color-text-rgb));
      border-color: rgb(var(--color-text-rgb) / 0.18);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .privacy-dot {
      animation: none;
    }

    .whisper-log-dot:global(.whisper-log-active) {
      animation: none;
    }

    .wl-spinner {
      animation: none;
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Live — Mode Styles
     ═══════════════════════════════════════════════════════ */

  .whisper-op-live {
    display: grid;
    gap: var(--space-sm);
  }

  .wl-head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: calc(var(--space-xs) * 0.6) var(--space-sm);
  }

  .wl-head-title {
    margin: 0;
    font-size: var(--text-base);
    letter-spacing: 0.015em;
    color: rgb(var(--color-text-rgb) / 0.86);
    grid-column: 1;
    grid-row: 1;
  }

  .wl-head-right {
    flex: 0 0 auto;
    justify-self: end;
    grid-column: 2;
    grid-row: 1;
  }

  .wl-head-meta {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.35);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .wl-status-chip {
    grid-column: 1 / -1;
    grid-row: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0;
    padding: calc(var(--space-xs) * 0.5) calc(var(--space-xs) * 0.75);
    border-radius: calc(var(--whisper-radius) * 0.75);
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.018);
    color: rgb(var(--color-text-rgb) / 0.62);
  }

  .wl-status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.24);
    box-shadow: 0 0 0 2px rgb(var(--color-text-rgb) / 0.06);
    flex: 0 0 auto;
  }

  .wl-status-text {
    font-size: calc(var(--text-sm) * 0.9);
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wl-status-text.whisper-status--ready {
    color: rgb(var(--chromatic-cyan));
  }

  .wl-status-chip:has(.wl-status-text.whisper-status--ready) .wl-status-dot {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.25);
  }

  .wl-grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  @media (min-width: 680px) {
    .wl-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  .wl-card {
    /* whisper-panel already defines padding/border/radius/background for consistent spacing */
  }

  .wl-join-row {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
  }

  .wl-code-input {
    flex: 1;
    min-width: 0;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.9);
  }

  .whisper-mini-btn.wl-primary {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border-color: rgb(var(--chromatic-cyan) / 0.28);
    color: rgb(var(--chromatic-cyan));
  }

  .whisper-mini-btn.wl-primary:hover {
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    color: rgb(var(--chromatic-cyan));
  }

  .whisper-mini-btn.wl-primary:focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
  }

  /* Card-local spacing without inflating the panel itself */
  .wl-card .wl-join-row,
  .wl-card .wl-code-display-wrap {
    margin-top: calc(var(--space-xs) * 0.6);
  }

  .wl-card .whisper-mini-btn {
    justify-content: center;
  }

  .wl-card .wl-primary {
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.06);
  }

  /* ── Code display (offer/answer) ────────────────────────── */
  .wl-code-display-wrap {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
  }

  .wl-code-display {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.8);
    line-height: 1.5;
    color: rgb(var(--color-text-rgb) / 0.72);
    word-break: break-all;
    white-space: pre-wrap;
    max-height: 6rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* ── Connecting spinner ─────────────────────────────────── */
  .wl-connecting-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .wl-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(var(--color-text-rgb) / 0.1);
    border-top-color: rgb(var(--chromatic-cyan));
    border-radius: var(--radius-full);
    animation: wl-spin 0.8s linear infinite;
  }

  @keyframes wl-spin {
    to { transform: rotate(360deg); }
  }

  .wl-connecting-text {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  /* ── Fingerprint verify ─────────────────────────────────── */
  .wl-verify-panel {
    display: grid;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-lg);
  }

  .wl-fingerprint {
    margin: 0;
    font-size: 3rem;
    letter-spacing: 0.3em;
    line-height: 1.4;
    user-select: none;
  }

  .wl-verify-actions {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    justify-content: center;
  }

  .wl-confirm-btn {
    background: rgb(var(--tool-status-success) / 0.1);
    border-color: rgb(var(--tool-status-success) / 0.35);
    color: rgb(var(--tool-status-success));
  }

  .wl-confirm-btn:hover {
    background: rgb(var(--tool-status-success) / 0.18);
    border-color: rgb(var(--tool-status-success) / 0.5);
    color: rgb(var(--tool-status-success));
  }

  .wl-reject-btn {
    background: rgb(var(--chromatic-red) / 0.08);
    border-color: rgb(var(--chromatic-red) / 0.3);
    color: rgb(var(--chromatic-red));
  }

  .wl-reject-btn:hover {
    background: rgb(var(--chromatic-red) / 0.14);
    border-color: rgb(var(--chromatic-red) / 0.45);
    color: rgb(var(--chromatic-red));
  }

  /* ── Chat ───────────────────────────────────────────────── */
  .wl-chat-panel {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .wl-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-sm) * 0.8);
    border-bottom: 1px solid var(--whisper-edge);
  }

  .wl-transport {
    display: inline-flex;
    gap: calc(var(--space-xs) * 0.8);
    align-items: center;
  }

  .wl-transport-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.5);
    cursor: pointer;
    user-select: none;
  }

  .wl-transport-radio {
    width: 0.85rem;
    height: 0.85rem;
    accent-color: rgb(var(--chromatic-cyan));
  }

  .wl-disconnect-btn {
    font-size: calc(var(--text-sm) * 0.85);
    padding: 0.35rem 0.65rem;
    min-height: auto;
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.2);
  }

  .wl-disconnect-btn:hover {
    color: rgb(var(--chromatic-red));
    border-color: rgb(var(--chromatic-red) / 0.4);
    background: rgb(var(--chromatic-red) / 0.06);
  }

  .wl-chat-messages {
    min-height: 16rem;
    max-height: clamp(16rem, 14rem + 12vw, 28rem);
    overflow-y: auto;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-xs) * 0.4);
    scrollbar-width: thin;
    transition: background var(--duration-normal) var(--ease-out);
  }

  .wl-chat-messages:global(.wl-chat-drop-active) {
    background: rgb(var(--chromatic-cyan) / 0.03);
  }

  .wl-msg {
    display: flex;
    align-items: flex-end;
    gap: calc(var(--space-xs) * 0.4);
    max-width: 80%;
  }

  .wl-msg--self {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .wl-msg--peer {
    align-self: flex-start;
  }

  .wl-msg--system {
    align-self: center;
    max-width: 90%;
  }

  .wl-msg-text {
    padding: 0.45rem 0.7rem;
    border-radius: calc(var(--whisper-radius) * 0.6);
    font-size: var(--text-sm);
    line-height: 1.5;
    word-break: break-word;
  }

  .wl-msg--self .wl-msg-text {
    background: rgb(var(--chromatic-cyan) / 0.1);
    color: rgb(var(--color-text-rgb) / 0.88);
    border-bottom-right-radius: calc(var(--whisper-radius) * 0.2);
  }

  .wl-msg--peer .wl-msg-text {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: rgb(var(--color-text-rgb) / 0.82);
    border-bottom-left-radius: calc(var(--whisper-radius) * 0.2);
  }

  .wl-msg-system {
    padding: 0.35rem 0.65rem;
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.35);
    text-align: center;
    font-style: italic;
  }

  .wl-msg-time {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--color-text-rgb) / 0.25);
    flex-shrink: 0;
    padding-bottom: 0.15rem;
  }

  .wl-msg-file {
    display: grid;
    gap: calc(var(--space-xs) * 0.2);
    padding: 0.5rem 0.7rem;
    border-radius: calc(var(--whisper-radius) * 0.6);
    border: 1px solid var(--whisper-edge);
    background: var(--whisper-surface);
  }

  .wl-msg-file-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgb(var(--color-text-rgb) / 0.8);
    word-break: break-word;
  }

  .wl-msg-file-size {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  .wl-msg-file-download {
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.3);
    width: fit-content;
  }

  .wl-msg-file-download:hover {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
  }

  .wl-chat-compose {
    display: flex;
    gap: calc(var(--space-xs) * 0.35);
    align-items: stretch;
    padding: calc(var(--space-xs) * 0.6);
    border-top: 1px solid var(--whisper-edge);
  }

  .wl-chat-text-input {
    flex: 1;
    min-width: 0;
    min-height: auto;
    padding: 0.45rem 0.65rem;
    border-radius: calc(var(--whisper-radius) * 0.5);
  }

  .wl-chat-send-btn {
    min-height: auto;
    padding: 0.45rem 0.75rem;
    background: rgb(var(--chromatic-cyan) / 0.08);
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--chromatic-cyan));
  }

  .wl-chat-send-btn:hover {
    background: rgb(var(--chromatic-cyan) / 0.14);
    border-color: rgb(var(--chromatic-cyan) / 0.45);
  }

  .wl-chat-file-btn {
    min-height: auto;
    padding: 0.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .wl-file-icon {
    width: 1rem;
    height: 1rem;
  }

  /* ── Silent mode ─────────────────────────────────────────── */
  .wl-silent-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-secret-display {
    font-size: calc(var(--text-sm) * 0.75);
    color: rgb(var(--chromatic-cyan));
  }

  /* ── End/Error panels ────────────────────────────────────── */
  .wl-end-panel,
  .wl-error-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-end-text {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .wl-error-text {
    margin: 0;
    color: rgb(var(--chromatic-red));
    font-size: var(--text-sm);
  }

  /* ── Live mode responsive ────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-fingerprint {
      font-size: 2.2rem;
      letter-spacing: 0.2em;
    }

    .wl-chat-messages {
      min-height: 12rem;
    }

    .wl-msg {
      max-width: 90%;
    }

    .wl-transport {
      gap: calc(var(--space-xs) * 0.5);
    }

    .wl-transport-label {
      font-size: calc(var(--text-sm) * 0.8);
    }
  }

  /* ── Live mode touch ─────────────────────────────────────── */
  @media (hover: none) {
    .wl-create-btn:hover {
      background: rgb(var(--chromatic-cyan) / 0.08);
      border-color: rgb(var(--chromatic-cyan) / 0.3);
    }

