  }

  .whisper-mini-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .whisper-password-meta {
    margin: 0;
  }

  .whisper-password-meta:empty {
    display: none;
  }

  .whisper-mini-btn:focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  .whisper-file-btn {
    display: flex;
    align-items: center;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .whisper-file-btn:hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .whisper-file-btn-text {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  .whisper-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    min-height: var(--touch-target);
    padding: 0.55rem 0.75rem;
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .whisper-toggle:hover {
    border-color: rgb(var(--color-text-rgb) / 0.24);
    background: rgb(var(--color-text-rgb) / 0.04);
  }

  .whisper-toggle:focus-within {
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.1);
  }

  .whisper-toggle-input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: rgb(var(--chromatic-cyan));
    flex-shrink: 0;
  }

  .whisper-toggle-text {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.66);
  }

  /* ── Mode-conditional visibility ───────────────────────── */

  /* Field-level: hide hunt fields in embed/extract, embed fields in extract/hunt */
  .whisper-page[data-mode="embed"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--hunt,
  .whisper-page[data-mode="extract"] .whisper-field--embed,
  .whisper-page[data-mode="hunt"] .whisper-field--embed {
    display: none;
  }

  /* Solo vs live: operation panels — only the active mode shows */
  .whisper-page[data-mode="embed"] .whisper-op-live,
  .whisper-page[data-mode="extract"] .whisper-op-live,
  .whisper-page[data-mode="hunt"] .whisper-op-live {
    display: none;
  }

  .whisper-page[data-mode="live"] .whisper-op-solo {
    display: none;
  }

  /* Solo-only sections: upload zone, progress, results, action bar.
     Keep insights visible across modes for continuity. */
  .whisper-page[data-mode="live"] #whisper-upload-zone,
  .whisper-page[data-mode="live"] #whisper-progress-section,
  .whisper-page[data-mode="live"] #whisper-results,
  .whisper-page[data-mode="live"] #whisper-download-area,
  .whisper-page[data-mode="live"] #whisper-actions {
    display: none;
  }

  /* Carrier toggle: only visible in embed mode */
  .whisper-page:not([data-mode="embed"]) .ws-carrier-toggle-wrap { display: none; }

  /* When carrier=url: hide file-specific embed fields, upload zone, and file password */
  .whisper-page[data-mode="embed"][data-carrier="url"] .whisper-field--embed:not(.ws-carrier-toggle-wrap):not([for="ws-message"]) { display: none; }
  .whisper-page[data-mode="embed"][data-carrier="url"] #whisper-upload-zone { display: none; }
  .whisper-page[data-mode="embed"][data-carrier="url"] .whisper-field--file-password { display: none; }

  /* When carrier=file (default): hide URL-only seal fields */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-url-only { display: none; }

  /* Seal fields hidden in non-embed modes */
  .whisper-page:not([data-mode="embed"]) .ws-seal-fields { display: none; }

  /* Seal mode chip + inline code only when carrier=url */
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-btn,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-inline,
  .whisper-page[data-mode="embed"]:not([data-carrier="url"]) .ws-my-seal-inline-panel { display: none; }

  /* Password tools (generate/copy) only in embed mode; paste link only in extract/hunt */
  .whisper-page:not([data-mode="embed"]) .whisper-password-tools { display: none; }

  /* Overlay hides solo panel when active (JS-managed via style) */
  .ws-overlay { display: grid; gap: var(--space-sm); min-width: 0; }

  /* Hide overlay in live mode */
  .whisper-page[data-mode="live"] .ws-overlay { display: none; }

  /* ── Progress ──────────────────────────────────────────── */
  .whisper-progress {
    height: 4px;
    border-radius: 2px;
    background: rgb(var(--color-text-rgb) / 0.06);
    overflow: hidden;
  }

  .whisper-progress-fill {
    height: 100%;
    width: 0%;
    background: rgb(var(--chromatic-cyan));
    border-radius: 2px;
    transition: width 0.3s linear;
  }

  .whisper-progress-fill:global(.whisper-progress--indeterminate) {
    width: 100%;
    animation: whisper-progress-pulse 1.5s ease-in-out infinite;
  }

  @keyframes whisper-progress-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* ── Results ───────────────────────────────────────────── */
  .whisper-results {
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
  }

  .whisper-result {
    margin: 0;
    border: 1px solid var(--whisper-edge);
    border-radius: calc(var(--whisper-radius) * 0.75);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .whisper-result--ok {
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--color-text-rgb) / 0.86);
    background: rgb(var(--chromatic-cyan) / 0.03);
  }

  .whisper-result--warn {
    border-color: rgb(var(--tool-status-warning) / 0.35);
    color: rgb(var(--tool-status-warning));
    background: rgb(var(--tool-status-warning) / 0.04);
  }

  .whisper-result--error {
    border-color: rgb(var(--chromatic-red) / 0.35);
    color: rgb(var(--chromatic-red));
    background: rgb(var(--chromatic-red) / 0.04);
  }

  /* ── Downloads ─────────────────────────────────────────── */
  .whisper-downloads {
    margin-top: var(--space-sm);
    display: grid;
    gap: calc(var(--space-xs) * 0.45);
  }

  .whisper-download-card {
    border: 1px solid var(--whisper-edge);
    border-radius: calc(var(--whisper-radius) * 0.75);
    padding: 0.7rem 0.8rem;
    background: var(--whisper-surface);
    display: grid;
    gap: calc(var(--space-xs) * 0.25);
    box-shadow: var(--edge-highlight);
  }

  .whisper-download-title,
  .whisper-download-meta {
    margin: 0;
  }

  .whisper-download-title {
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.86);
  }

  .whisper-download-meta {
    font-size: calc(var(--text-sm) * 0.9);
    color: rgb(var(--color-text-rgb) / 0.42);
  }

  .whisper-download-link {
    width: fit-content;
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.35);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .whisper-download-link:hover,
  .whisper-download-link:focus-visible {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
    outline: none;
  }

  /* ── Log ────────────────────────────────────────────────── */
  .whisper-log-wrap {
    border: 1px solid var(--whisper-edge);
    border-radius: var(--whisper-radius);
    background: rgb(var(--color-text-rgb) / 0.01);
    overflow: hidden;
    box-shadow: var(--edge-highlight);
  }

  .whisper-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--whisper-edge);
  }

  .whisper-log-title {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    letter-spacing: 0.04em;
  }

  .whisper-log-hint {
    margin: 0;
    padding: 0.45rem 0.8rem 0;
    font-size: calc(var(--text-sm) * 0.76);
    color: rgb(var(--color-text-rgb) / 0.38);
    line-height: 1.35;
  }

  .whisper-log-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.12);
    flex-shrink: 0;
    transition: background var(--duration-slow) var(--ease-out);
  }

  .whisper-log-dot:global(.whisper-log-active) {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.4);
    animation: whisper-log-blink 1s ease-in-out infinite;
  }

  @keyframes whisper-log-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .whisper-log-output {
    margin: 0;
    min-height: 7rem;
    max-height: clamp(14rem, 12rem + 8vw, 24rem);
    overflow: auto;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.9);
    line-height: 1.6;
    padding: 0.65rem 0.8rem;
    color: rgb(var(--color-text-rgb) / 0.6);
    background: transparent;
  }

  /* ── Insights ──────────────────────────────────────────── */
  .whisper-insights {
    display: grid;
    gap: calc(var(--space-xs) * 0.9);
  }

  .insights-title {
    margin: 0;
    font-size: var(--text-lg);
    color: rgb(var(--color-text-rgb) / 0.8);
    letter-spacing: -0.01em;
  }

  .insights-text {
    margin: 0;
    color: rgb(var(--color-text-rgb) / 0.44);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* ── Fixed Action Bar ──────────────────────────────────── */
  .whisper-actions {
    position: fixed;
    bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    gap: calc(var(--space-xs) * 0.25);
    padding: calc(var(--space-xs) * 0.7);
    background: var(--tool-actionbar-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    border-radius: var(--whisper-radius);
    box-shadow: var(--edge-highlight), 0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 40;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    max-width: min(
      var(--content-width),
      calc(100vw - 2 * clamp(0.75rem, 4vw, 1.5rem))
    );
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .whisper-actions::-webkit-scrollbar {
    display: none;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: calc(var(--space-xs) * 0.8) calc(var(--space-xs) * 1.5);
    background: transparent;
    border: none;
    border-radius: calc(var(--whisper-radius) * 0.625);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
  }

  .action-btn--primary {
    background: rgb(var(--tool-action-run) / 0.1);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:hover:not(:disabled) {
    background: rgb(var(--tool-action-run) / 0.18);
    color: rgb(var(--tool-action-run));
  }

  .action-btn--primary:global(.action-btn--loading) {
    background: rgb(var(--tool-action-load) / 0.16);
    color: rgb(var(--tool-action-load));
    pointer-events: none;
  }

  .action-btn--primary:global(.action-btn--ran) {
    animation: whisper-run-ack 900ms var(--ease-spring);
    background: linear-gradient(180deg, rgb(var(--chromatic-cyan) / 0.22) 0%, rgb(var(--chromatic-cyan) / 0.1) 100%);
    color: rgb(var(--chromatic-cyan));
    border: 1px solid rgb(var(--chromatic-cyan) / 0.35);
  }

  @keyframes whisper-run-ack {
    0% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
    35% {
      transform: translateY(-1px) scale(1.03);
      box-shadow: 0 0 14px rgb(var(--chromatic-cyan) / 0.24);
    }
    100% {
      transform: translateY(0) scale(1);
      box-shadow: 0 0 0 rgb(var(--chromatic-cyan) / 0);
    }
  }

  .action-btn--icon {
    min-width: var(--touch-target);
    padding-inline: calc(var(--space-xs) * 0.8);
  }

  .lens-handoff-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .action-btn:hover:not(:disabled) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: var(--color-text);
  }

  .action-btn:active {
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  .action-btn:focus-visible {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.4);
    outline-offset: 1px;
    color: var(--color-text);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .action-btn:disabled {
    cursor: not-allowed;
    color: rgb(var(--color-text-rgb) / 0.38);
    background: transparent;
    opacity: 1;
  }

  @supports not (
    (-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))
  ) {
    .whisper-actions {
      background: var(--tool-actionbar-bg-fallback);
    }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .whisper-upload-zone {
      padding: var(--space-lg) var(--space-sm);
    }

    .upload-icon {
      display: none;
    }

    .whisper-actions {
      gap: calc(var(--space-xs) * 0.18);
      padding: calc(var(--space-xs) * 0.6);
    }

    .action-btn {
      font-size: calc(var(--text-sm) * 0.9);
      padding-inline: calc(var(--space-xs) * 1);
    }
  }

  /* ── Touch devices ─────────────────────────────────────── */
  @media (hover: none) {
    .whisper-upload-zone:hover {
      border-color: rgb(var(--color-text-rgb) / 0.14);
      background: linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.012) 0%,
        transparent 60%
      );
      box-shadow: var(--edge-highlight);
    }

    .whisper-upload-zone:hover .upload-icon {
      color: rgb(var(--color-text-rgb) / 0.14);
      transform: none;
    }

    .whisper-upload-zone:hover .upload-text {
      color: rgb(var(--color-text-rgb) / 0.6);
    }

    .whisper-upload-zone:active {
      border-color: rgb(var(--chromatic-cyan) / 0.35);
      background: linear-gradient(
        180deg,
        rgb(var(--chromatic-cyan) / 0.03) 0%,
        rgb(var(--chromatic-cyan) / 0.008) 50%,
        transparent 100%
      );
    }

    .action-btn:hover {
      background: transparent;
      color: var(--color-text-muted);
    }

    .action-btn:active {
      background: rgb(var(--color-text-rgb) / 0.1);
      color: var(--color-text);
    }

    .action-btn--primary:hover {
      background: rgb(var(--tool-action-run) / 0.1);
      color: rgb(var(--tool-action-run));
    }

    .action-btn--primary:active {
      background: rgb(var(--tool-action-run) / 0.2);
    }

    .whisper-mode-btn:hover {
      color: rgb(var(--color-text-rgb) / 0.55);
      border-color: transparent;
    }

    .whisper-mode-btn:active {
      color: rgb(var(--color-text-rgb));
      border-color: rgb(var(--color-text-rgb) / 0.18);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .privacy-dot {
      animation: none;
    }

    .whisper-log-dot:global(.whisper-log-active) {
      animation: none;
    }

    .wl-spinner {
      animation: none;
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Live — Mode Styles
     ═══════════════════════════════════════════════════════ */

  .whisper-op-live {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .wl-phase {
    display: grid;
    gap: calc(var(--space-xs) * 0.7);
  }

  .wl-phase--chat {
    margin-top: 0;
  }

  .whisper-op-live.wl-connected .wl-phase--chat {
    margin-top: calc(var(--space-sm) * -1);
  }

  .wl-head {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: calc(var(--space-xs) * 0.6) var(--space-sm);
    background: var(--whisper-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      border-radius var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .wl-head-title {
    margin: 0;
    font-size: var(--text-base);
    letter-spacing: 0.015em;
    color: rgb(var(--color-text-rgb) / 0.86);
    grid-column: 1;
    grid-row: 1;
  }

  .wl-head-right {
    display: none;
    flex: 0 0 auto;
    justify-self: end;
    grid-column: 2;
    grid-row: 3;
    align-self: center;
  }

  .whisper-op-live.wl-connected .wl-head {
    grid-template-columns: 1fr auto;
  }

  .whisper-op-live.wl-connected .wl-head-right {
    display: flex;
  }

  .whisper-op-live.wl-connected .wl-head {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow: none;
  }

  .wl-head-subtitle {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.46);
    letter-spacing: 0.01em;
    grid-column: 1;
    grid-row: 2;
    max-width: 48ch;
  }

  .wl-head-meta {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.35);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .wl-status-chip {
    grid-column: 1;
    grid-row: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0;
    overflow: hidden;
    padding: calc(var(--space-xs) * 0.5) calc(var(--space-xs) * 0.75);
    border-radius: calc(var(--whisper-radius) * 0.75);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(10 10 10 / 0.9);
    color: rgb(var(--color-text-rgb) / 0.62);
  }

  .wl-status-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wl-status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-text-rgb) / 0.24);
    box-shadow: 0 0 0 2px rgb(var(--color-text-rgb) / 0.06);
    flex: 0 0 auto;
  }

  .wl-status-text {
    font-size: calc(var(--text-sm) * 0.9);
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wl-status-text.whisper-status--ready {
    color: rgb(var(--chromatic-cyan));
  }

  .wl-status-chip:has(.wl-status-text.whisper-status--ready) .wl-status-dot {
    background: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 8px rgb(var(--chromatic-cyan) / 0.25);
  }

  .wl-grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  .wl-phase-lede {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.44);
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .wl-inline-hint {
    margin: calc(var(--space-xs) * -0.15) 0 0;
    font-size: calc(var(--text-sm) * 0.84);
    color: rgb(var(--color-text-rgb) / 0.4);
    line-height: 1.35;
  }

  @media (min-width: 680px) {
    .wl-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .wl-grid.wl-grid--offer {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .wl-card {
    /* Keep card content compact even when sibling cards are taller. */
    align-content: start;
  }

  .wl-actions-panel {
    gap: var(--space-sm);
    padding: var(--space-sm);
  }

  .wl-actions-row {
    display: flex;
    align-items: start;
    gap: var(--space-sm);
  }

  .wl-action-label {
    display: block;
    font-size: calc(var(--text-sm) * 0.82);
    color: rgb(var(--color-text-rgb) / 0.38);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: calc(var(--space-xs) * 0.25);
  }

  .wl-action-create {
    flex: 0 0 auto;
  }

  .wl-action-create .wl-primary {
    white-space: nowrap;
  }

  .wl-action-join {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* ── Relay panel (default clean view) ─────────────────── */

  .wl-relay-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-sm);
    background: var(--whisper-surface);
  }

  .wl-relay-connect-row {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
  }

  .wl-relay-connect-row .whisper-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .wl-relay-connect-row .whisper-mini-btn {
    flex: 0 0 auto;
  }

  .wl-relay-hint {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    line-height: 1.4;
  }

  .wl-relay-panel .whisper-field-label {
    font-size: var(--text-sm);
  }

  .wl-relay-panel .whisper-input {
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
  }

  /* ── Mode switch link ──────────────────────────────────── */

  .wl-mode-switch {
    margin: calc(var(--space-xs) * 0.6) 0 0;
    text-align: center;
  }

  .wl-mode-switch-btn {
    all: unset;
    font-size: calc(var(--text-sm) * 0.8);
    color: rgb(var(--color-text-rgb) / 0.3);
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .wl-mode-switch-btn:hover {
    color: rgb(var(--chromatic-cyan) / 0.7);
  }

  .wl-mode-switch-btn:focus-visible {
    outline: none;
    color: rgb(var(--chromatic-cyan));
  }

  /* Flare link gets amber hover when pointing at flare mode (relay/manual views) */
  .wl-mode-switch:not([data-idle-mode="flare"]) .wl-mode-switch-btn--flare:hover {
    color: rgb(255 160 40 / 0.7);
  }

  .wl-mode-switch:not([data-idle-mode="flare"]) .wl-mode-switch-btn--flare:focus-visible {
    color: rgb(255 160 40);
  }

  .wl-mode-switch-sep {
    color: rgb(var(--color-text-rgb) / 0.15);
    font-size: calc(var(--text-sm) * 0.8);
    margin: 0 0.15em;
    user-select: none;
  }

  /* ── Signal Flare panel ────────────────────────────────── */

  .wl-flare-panel {
    --chromatic-flare: 255 160 40;
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-sm);
    background: var(--whisper-surface);
  }

  .wl-flare-head {
    display: flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.5);
  }

  .wl-flare-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgb(var(--chromatic-flare));
    letter-spacing: 0.02em;
  }

  .wl-flare-lede {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.42);
    line-height: 1.4;
  }

  .wl-flare-panel .whisper-field-label {
    font-size: var(--text-sm);
  }

  .wl-flare-panel .whisper-input {
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
  }

  .wl-flare-fire-btn {
    border-color: rgb(var(--chromatic-flare) / 0.4) !important;
    color: rgb(var(--chromatic-flare)) !important;
    background: rgb(var(--chromatic-flare) / 0.08) !important;
  }

  .wl-flare-fire-btn:hover:not(:disabled) {
    border-color: rgb(var(--chromatic-flare) / 0.55) !important;
    background: rgb(var(--chromatic-flare) / 0.12) !important;
  }

  /* Burning state */

  .wl-flare-burning {
    display: grid;
    gap: var(--space-sm);
  }

  .wl-flare-burning-indicator {
    display: flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.5);
    padding: calc(var(--space-xs) * 0.6) calc(var(--space-xs) * 0.8);
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--chromatic-flare) / 0.25);
    background: rgb(var(--chromatic-flare) / 0.04);
  }

  .wl-flare-ember {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(var(--chromatic-flare));
    box-shadow: 0 0 6px rgb(var(--chromatic-flare) / 0.5);
    animation: wl-flare-pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes wl-flare-pulse {
    0%, 100% { opacity: 0.6; box-shadow: 0 0 4px rgb(var(--chromatic-flare) / 0.3); }
    50% { opacity: 1; box-shadow: 0 0 10px rgb(var(--chromatic-flare) / 0.6); }
  }

  .wl-flare-burning-text {
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--chromatic-flare));
    font-weight: 500;
  }

  .wl-flare-elapsed {
    font-size: calc(var(--text-sm) * 0.78);
    color: rgb(var(--color-text-rgb) / 0.35);
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .wl-flare-burning-hint {
    margin: 0;
    font-size: calc(var(--text-sm) * 0.82);
    color: rgb(var(--color-text-rgb) / 0.38);
    line-height: 1.4;
  }

  /* Peer arrived state */

  .wl-flare-arrived {
    display: grid;
    gap: var(--space-sm);
    padding: calc(var(--space-xs) * 0.8);
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--chromatic-flare) / 0.35);
    background: rgb(var(--chromatic-flare) / 0.06);
    animation: wl-flare-arrived-flash 0.6s ease-out;
  }

  @keyframes wl-flare-arrived-flash {
    0% { background: rgb(var(--chromatic-flare) / 0.18); }
    100% { background: rgb(var(--chromatic-flare) / 0.06); }
  }

  .wl-flare-arrived-text {
    margin: 0;
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-flare));
    font-weight: 500;
  }

  .wl-flare-arrived-actions {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
  }

  /* ── Manual mode options ───────────────────────────────── */

  .wl-manual-options {
    display: grid;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--whisper-edge);
    margin-top: 0;
  }

  .wl-manual-options .whisper-field-label {
    font-size: var(--text-sm);
  }

  .wl-manual-options .whisper-input {
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
  }

  .wl-manual-options .whisper-toggle {
    min-height: var(--touch-target);
    padding: 0.55rem 0.75rem;
  }

  .wl-manual-options .whisper-toggle-text {
    font-size: var(--text-sm);
  }

  @media (min-width: 860px) {
    .wl-manual-options {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .wl-actions-divider {
    width: 1px;
    align-self: stretch;
    background: var(--whisper-edge);
    flex: 0 0 1px;
  }

  /* Inline text-link tools under join input */
  .wl-tool-link {
    all: unset;
    font-size: calc(var(--text-sm) * 0.78);
    color: rgb(var(--color-text-rgb) / 0.34);
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .wl-tool-link:hover {
    color: rgb(var(--chromatic-cyan) / 0.85);
  }

  .wl-tool-link:focus-visible {
    outline: none;
    color: rgb(var(--chromatic-cyan));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .wl-tool-link--stop {
    color: rgb(var(--chromatic-red) / 0.55);
  }

  .wl-tool-link--stop:hover {
    color: rgb(var(--chromatic-red) / 0.85);
  }

  .wl-tool-sep {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--color-text-rgb) / 0.18);
    user-select: none;
  }


  /* wl-phrase-panel still used by campfire */
  .wl-phrase-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-sm);
  }

  .wl-phrase-panel .whisper-field-label {
    font-size: var(--text-sm);
  }

  .wl-phrase-panel .whisper-input {
    min-height: var(--touch-target);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
  }

  .wl-phrase-panel .whisper-toggle {
    min-height: var(--touch-target);
    padding: 0.55rem 0.75rem;
  }

  .wl-phrase-panel .whisper-toggle-text {
    font-size: var(--text-sm);
  }

  @media (min-width: 860px) {
    .wl-phrase-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .wl-join-row {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: stretch;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .wl-join-row .whisper-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .wl-join-row .whisper-mini-btn {
    flex: 0 0 auto;
    min-width: 5.25rem;
  }

  .wl-code-input {
    flex: 1;
    min-width: 0;
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.9);
  }

  .whisper-mini-btn.wl-primary {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border-color: rgb(var(--chromatic-cyan) / 0.28);
    color: rgb(var(--chromatic-cyan));
  }

  .whisper-mini-btn.wl-primary:hover {
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.45);
    color: rgb(var(--chromatic-cyan));
  }

  .whisper-mini-btn.wl-primary:focus-visible {
    outline: none;
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.12);
  }

  /* Card-local spacing without inflating the panel itself */
  .wl-card .wl-join-row,
  .wl-card .wl-code-display-wrap {
    margin-top: calc(var(--space-xs) * 0.6);
  }

  .wl-card .whisper-mini-btn {
    justify-content: center;
  }

  .wl-card .wl-primary {
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.06);
  }

  .wl-join-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--space-xs) * 0.35);
    margin-top: calc(var(--space-xs) * 0.3);
  }

  .wl-join-qr-panel {
    border: 1px solid rgb(var(--chromatic-cyan) / 0.18);
    border-radius: calc(var(--whisper-radius) * 0.55);
    background: rgb(var(--chromatic-cyan) / 0.04);
    padding: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.5);
  }

  .wl-join-qr-video {
    width: 100%;
    max-height: 16rem;
    border-radius: calc(var(--whisper-radius) * 0.45);
    background: rgb(var(--color-bg-rgb));
    object-fit: cover;
  }

  .wl-join-qr-status {
    display: block;
    margin-top: calc(var(--space-xs) * 0.5);
  }

  .wl-join-qr-status:empty {
    display: none;
  }

  .wl-live-qr-wrap {
    display: grid;
    justify-items: center;
    gap: calc(var(--space-xs) * 0.45);
    margin-top: calc(var(--space-xs) * 0.55);
    padding-top: calc(var(--space-xs) * 0.25);
    border-top: 1px dashed rgb(var(--color-text-rgb) / 0.08);
  }

  .wl-live-qr-toggle-row {
    margin-top: calc(var(--space-xs) * 0.6);
    display: flex;
    justify-content: center;
  }

  .wl-offer-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(var(--space-xs) * 0.75);
  }

  .wl-live-qr-status {
    text-align: center;
    min-height: 1.2em;
  }

  /* ── Code display (offer/answer) ────────────────────────── */
  .wl-code-display-wrap {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: flex-start;
  }

  .wl-code-display-wrap .whisper-mini-btn {
    min-height: auto;
    padding: 0.45rem 0.7rem;
  }

  .wl-code-display {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.8);
    line-height: 1.5;
    color: rgb(var(--color-text-rgb) / 0.72);
    word-break: break-all;
    white-space: pre-wrap;
    max-height: 6rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* ── Connecting spinner ─────────────────────────────────── */
  .wl-connecting-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .wl-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(var(--color-text-rgb) / 0.1);
    border-top-color: rgb(var(--chromatic-cyan));
    border-radius: var(--radius-full);
    animation: wl-spin 0.8s linear infinite;
  }

  @keyframes wl-spin {
    to { transform: rotate(360deg); }
  }

  .wl-connecting-text {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  /* ── Fingerprint verify ─────────────────────────────────── */
  .wl-verify-panel {
    display: grid;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-lg);
  }

  .wl-fingerprint {
    margin: 0;
    font-size: 3rem;
    letter-spacing: 0.3em;
    line-height: 1.4;
    user-select: none;
  }

  .wl-verify-actions {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    justify-content: center;
  }

  .wl-confirm-btn {
    background: rgb(var(--tool-status-success) / 0.1);
    border-color: rgb(var(--tool-status-success) / 0.35);
    color: rgb(var(--tool-status-success));
  }

  .wl-confirm-btn:hover {
    background: rgb(var(--tool-status-success) / 0.18);
    border-color: rgb(var(--tool-status-success) / 0.5);
    color: rgb(var(--tool-status-success));
  }

  .wl-reject-btn {
    background: rgb(var(--chromatic-red) / 0.08);
    border-color: rgb(var(--chromatic-red) / 0.3);
    color: rgb(var(--chromatic-red));
  }

  .wl-reject-btn:hover {
    background: rgb(var(--chromatic-red) / 0.14);
    border-color: rgb(var(--chromatic-red) / 0.45);
    color: rgb(var(--chromatic-red));
  }

  /* ── Chat ───────────────────────────────────────────────── */
  .wl-chat-panel {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--whisper-surface-deep);
    border-top-left-radius: var(--whisper-radius);
    border-top-right-radius: var(--whisper-radius);
    border-top: 1px solid var(--whisper-edge);
  }

  .whisper-op-live.wl-connected .wl-chat-panel {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow: var(--edge-highlight);
  }

  .wl-chat-tools {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.45);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .wl-disconnect-btn {
    font-size: calc(var(--text-sm) * 0.8);
    padding: 0.32rem 0.62rem;
    min-height: auto;
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.2);
    background: rgb(var(--chromatic-red) / 0.04);
  }

  .wl-disconnect-btn:hover {
    color: rgb(var(--chromatic-red));
    border-color: rgb(var(--chromatic-red) / 0.4);
    background: rgb(var(--chromatic-red) / 0.06);
  }

  .wl-chat-messages {
    min-height: 16rem;
    max-height: clamp(16rem, 14rem + 12vw, 28rem);
    overflow-y: auto;
    padding: calc(var(--space-sm) * 0.95);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-xs) * 0.42);
    scrollbar-width: thin;
    transition: background var(--duration-normal) var(--ease-out);
    background:
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.018) 0%,
        transparent 50%
      ),
      rgb(10 10 10 / 0.92);
  }

  .wl-chat-messages:global(.wl-chat-drop-active) {
    background: rgb(var(--chromatic-cyan) / 0.05);
  }

  .wl-msg {
    display: flex;
    align-items: flex-end;
    gap: calc(var(--space-xs) * 0.3);
    max-width: 80%;
  }

  .wl-msg--self {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .wl-msg--peer {
    align-self: flex-start;
  }

  .wl-msg--system {
    align-self: center;
    max-width: 90%;
  }

  .wl-msg-text {
    padding: 0.52rem 0.75rem;
    border-radius: calc(var(--whisper-radius) * 0.62);
    font-size: var(--text-sm);
    line-height: 1.42;
    word-break: break-word;
    border: 1px solid transparent;
  }

  .wl-msg--self .wl-msg-text {
    background: rgb(var(--chromatic-cyan) / 0.12);
    color: rgb(var(--color-text-rgb) / 0.92);
    border-color: rgb(var(--chromatic-cyan) / 0.26);
    border-bottom-right-radius: calc(var(--whisper-radius) * 0.2);
  }

  .wl-msg--peer .wl-msg-text {
    background: rgb(var(--color-text-rgb) / 0.055);
    color: rgb(var(--color-text-rgb) / 0.86);
    border-color: rgb(var(--color-text-rgb) / 0.16);
    border-bottom-left-radius: calc(var(--whisper-radius) * 0.2);
  }

  .wl-msg-system {
    padding: 0.25rem 0.54rem;
    font-size: calc(var(--text-sm) * 0.8);
    color: rgb(var(--color-text-rgb) / 0.45);
    text-align: center;
    border-radius: var(--radius-full);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(var(--color-text-rgb) / 0.02);
  }

  .wl-msg-time {
    font-size: calc(var(--text-sm) * 0.68);
    color: rgb(var(--color-text-rgb) / 0.28);
    flex-shrink: 0;
    padding-bottom: 0.2rem;
  }

  .wl-msg-file {
    display: grid;
    gap: calc(var(--space-xs) * 0.2);
    padding: 0.5rem 0.7rem;
    border-radius: calc(var(--whisper-radius) * 0.6);
    border: 1px solid var(--whisper-edge);
    background: var(--whisper-surface);
  }

  .wl-msg-file-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgb(var(--color-text-rgb) / 0.8);
    word-break: break-word;
  }

  .wl-msg-file-size {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  .wl-msg-file-download {
    font-size: var(--text-sm);
    color: rgb(var(--chromatic-cyan));
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--chromatic-cyan) / 0.3);
    width: fit-content;
  }

  .wl-msg-file-download:hover {
    color: var(--color-text);
    border-bottom-color: rgb(var(--color-text-rgb) / 0.5);
  }

  .wl-chat-compose {
    --wl-activity: 0;
    --wl-velocity: 0;
    --wl-flow: 50%;
    display: flex;
    gap: calc(var(--space-xs) * 0.4);
    align-items: stretch;
    flex-wrap: wrap;
    padding: calc(var(--space-xs) * 0.7);
    border-top: 1px solid var(--whisper-edge);
    background:
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.02) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      rgb(10 10 10 / 0.94);
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      filter var(--duration-fast) linear;
    transform: translateZ(0);
    filter: saturate(calc(1 + (var(--wl-activity) * 0.24)));
  }

  .wl-chat-compose:focus-within {
    border-top-color: rgb(var(--chromatic-cyan) / 0.28);
  }

  .wl-chat-compose[data-intent="idle"] {
    border-top-color: rgb(var(--color-text-rgb) / 0.12);
    box-shadow: none;
  }

  .wl-chat-compose[data-intent="connecting"] {
    border-top-color: rgb(var(--tool-action-load) / 0.44);
    box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.18);
  }

  .wl-chat-compose[data-intent="ready"] {
    border-top-color: rgb(var(--chromatic-cyan) / 0.34);
    box-shadow: inset 0 1px 0 rgb(var(--chromatic-cyan) / 0.14);
  }

  .wl-chat-compose[data-intent="typing"] {
    border-top-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow:
      inset 0 1px 0 rgb(var(--chromatic-cyan) / 0.18),
      0 -1px 0 rgb(var(--chromatic-cyan) / 0.22);
    background:
      linear-gradient(
        110deg,
        rgb(var(--chromatic-cyan) / calc(0.025 + (var(--wl-activity) * 0.06))) 0%,
        rgb(var(--tool-action-load) / calc(0.02 + (var(--wl-activity) * 0.05))) var(--wl-flow),
        rgb(var(--chromatic-cyan) / calc(0.025 + (var(--wl-activity) * 0.06))) 100%
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.02) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      rgb(10 10 10 / 0.94);
    background-size: calc(100% + (var(--wl-velocity) * 110%)) 100%, 100% 100%, 100% 100%;
    background-position: calc((var(--wl-flow) - 50%) * 0.2) 0, 0 0, 0 0;
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background-size 80ms linear,
      background-position 90ms linear,
      background var(--duration-normal) var(--ease-out);
  }

  .wl-chat-compose[data-intent="drop"] {
    border-top-color: rgb(var(--tool-status-success) / 0.52);
    box-shadow:
      inset 0 1px 0 rgb(var(--tool-status-success) / 0.2),
      0 -1px 0 rgb(var(--tool-status-success) / 0.24);
  }

  .wl-chat-compose[data-intent="sending"] {
    border-top-color: rgb(var(--tool-action-load) / 0.52);
    animation: wl-intent-sending 580ms cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  .wl-chat-compose[data-intent="success"] {
    border-top-color: rgb(var(--tool-status-success) / 0.6);
    animation: wl-intent-success 860ms cubic-bezier(0.17, 0.8, 0.22, 1);
  }

  .wl-chat-compose[data-intent="error"] {
    border-top-color: rgb(var(--chromatic-red) / 0.58);
    animation: wl-intent-error 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) 2;
  }

  .wl-chat-text-input {
    flex: 1 1 14rem;
    min-width: 0;
    width: 100%;
    min-height: auto;
    padding: 0.52rem 0.72rem;
    border-radius: calc(var(--whisper-radius) * 0.5);
    border-color: rgb(var(--color-text-rgb) / 0.14);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      outline-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-text-input {
    border-color: rgb(var(--tool-action-load) / 0.28);
  }

  .wl-chat-compose[data-intent="ready"] .wl-chat-text-input,
  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    transform: translateY(calc(var(--wl-activity) * -0.35px)) scaleY(calc(1 + (var(--wl-velocity) * 0.01)));
  }

  .wl-chat-compose[data-intent="drop"] .wl-chat-text-input,
  .wl-chat-compose[data-intent="success"] .wl-chat-text-input {
    border-color: rgb(var(--tool-status-success) / 0.38);
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-red) / 0.42);
  }

  .wl-chat-input-has-value .wl-chat-send-btn {
    opacity: 1;
  }

  .wl-chat-send-btn {
    min-height: auto;
    padding: 0.48rem 0.8rem;
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.2) 0%,
      rgb(var(--chromatic-cyan) / 0.12) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.42);
    color: rgb(var(--chromatic-cyan));
    box-shadow: 0 0 12px rgb(var(--chromatic-cyan) / 0.1);
    opacity: 0.86;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-send-btn {
    transform: translateY(calc(var(--wl-activity) * -0.6px)) scale(calc(1 + (var(--wl-velocity) * 0.018)));
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-send-btn,
  .wl-chat-compose[data-intent="sending"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-action-load) / 0.44);
    background: rgb(var(--tool-action-load) / 0.15);
    color: rgb(var(--tool-action-load));
  }

  .wl-chat-compose[data-intent="success"] .wl-chat-send-btn,
  .wl-chat-compose[data-intent="drop"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-status-success) / 0.5);
    background: rgb(var(--tool-status-success) / 0.14);
    color: rgb(var(--tool-status-success));
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-send-btn {
    border-color: rgb(var(--chromatic-red) / 0.5);
    background: rgb(var(--chromatic-red) / 0.12);
    color: rgb(var(--chromatic-red));
  }

  .wl-chat-send-btn:hover {
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.24) 0%,
      rgb(var(--chromatic-cyan) / 0.15) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.5);
  }

  .wl-chat-file-btn {
    min-height: auto;
    padding: 0.48rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-color: rgb(var(--color-text-rgb) / 0.18);
  }



 

  .wl-file-icon {
    width: 1rem;
    height: 1rem;
  }

  @keyframes wl-intent-sending {
    0% {
      border-top-color: rgb(var(--tool-action-load) / 0.34);
      box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.12);
    }
    55% {
      border-top-color: rgb(var(--tool-action-load) / 0.66);
      box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.28);
    }
    100% {
      border-top-color: rgb(var(--tool-action-load) / 0.52);
      box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.18);
    }
  }

  @keyframes wl-intent-success {
    0% {
      border-top-color: rgb(var(--tool-status-success) / 0.28);
      box-shadow: inset 0 1px 0 rgb(var(--tool-status-success) / 0.1);
    }
    45% {
      border-top-color: rgb(var(--tool-status-success) / 0.72);
      box-shadow: inset 0 1px 0 rgb(var(--tool-status-success) / 0.34);
    }
    100% {
      border-top-color: rgb(var(--tool-status-success) / 0.6);
      box-shadow: inset 0 1px 0 rgb(var(--tool-status-success) / 0.2);
    }
  }

  @keyframes wl-intent-error {
    0% { transform: translateX(0); }
    25% { transform: translateX(-1px); }
    50% { transform: translateX(1px); }
    100% { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-chat-compose,
    .wl-chat-text-input,
    .wl-chat-send-btn {
      animation: none !important;
      transition-duration: 0ms !important;
      transform: none !important;
      background-size: 100% 100%, 100% 100%, 100% 100% !important;
      background-position: 0 0, 0 0, 0 0 !important;
    }
  }

  /* ── Silent mode ─────────────────────────────────────────── */
  .wl-silent-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-secret-display {
    font-size: calc(var(--text-sm) * 0.75);
    color: rgb(var(--chromatic-cyan));
  }

  /* ── End/Error panels ────────────────────────────────────── */
  .wl-end-panel,
  .wl-error-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-end-text {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .wl-error-text {
    margin: 0;
    color: rgb(var(--chromatic-red));
    font-size: var(--text-sm);
  }

  /* ── Live mode responsive ────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto auto;
    }

    .wl-head-title {
      grid-column: 1 / -1;
    }

    .wl-head-subtitle {
      grid-column: 1 / -1;
    }

    .wl-status-chip {
      grid-row: 3;
      grid-column: 1;
      display: flex;
      flex-wrap: wrap;
      gap: calc(var(--space-xs) * 0.5);
    }

    .wl-head-right {
      grid-column: 2;
      grid-row: 3;
      justify-self: end;
      align-self: center;
    }

    .cf-live-mode-toggle {
      margin-top: 0;
      width: auto;
    }

    .wl-phase-lede {
      font-size: calc(var(--text-sm) * 0.84);
    }

    .wl-inline-hint {
      font-size: calc(var(--text-sm) * 0.8);
    }

    .wl-join-row .whisper-mini-btn {
      min-width: 4.8rem;
      padding-inline: 0.65rem;
    }

    .wl-code-display-wrap {
      flex-direction: column;
    }

    .wl-code-display-wrap .whisper-mini-btn {
      width: 100%;
    }

    .wl-offer-actions {
      justify-content: stretch;
    }

    .wl-offer-actions .whisper-mini-btn {
      width: 100%;
    }

    .wl-chat-header {
      align-items: stretch;
    }

    .wl-chat-tools {
      width: 100%;
      justify-content: stretch;
    }

    .wl-disconnect-btn {
      width: 100%;
      justify-content: center;
    }

    .wl-chat-compose {
      gap: calc(var(--space-xs) * 0.45);
    }

    .wl-chat-file-btn,
    .wl-chat-send-btn {
      flex: 1 1 calc(50% - var(--space-xs));
      justify-content: center;
    }

    .wl-fingerprint {
      font-size: 2.2rem;
      letter-spacing: 0.2em;
    }

    .wl-chat-messages {
      min-height: 12rem;
    }

    .wl-msg {
      max-width: 90%;
    }

  }

  @media (max-height: 760px) {
    .wl-chat-messages {
      min-height: 10rem;
      max-height: 18rem;
    }

    .wl-code-display {
      max-height: 4.5rem;
    }

    .wl-head-subtitle,
    .wl-phase-lede {
      line-height: 1.35;
    }
  }

  /* ── Live mode touch ─────────────────────────────────────── */
  @media (hover: none) {
    .wl-create-btn:hover {
      background: rgb(var(--chromatic-cyan) / 0.08);
      border-color: rgb(var(--chromatic-cyan) / 0.3);
    }

    .wl-create-btn:active {
      background: rgb(var(--chromatic-cyan) / 0.16);
      border-color: rgb(var(--chromatic-cyan) / 0.5);
    }

    .wl-confirm-btn:hover {
      background: rgb(var(--tool-status-success) / 0.1);
      border-color: rgb(var(--tool-status-success) / 0.35);
    }

    .wl-reject-btn:hover {
      background: rgb(var(--chromatic-red) / 0.08);
      border-color: rgb(var(--chromatic-red) / 0.3);
    }

    .wl-chat-send-btn:hover {
      background: rgb(var(--chromatic-cyan) / 0.08);
      border-color: rgb(var(--chromatic-cyan) / 0.3);
    }
  }

  /* ═══════════════════════════════════════════════════════
     Whisper Seal — Inline & Overlay Styles
     ═══════════════════════════════════════════════════════ */

  /* Carrier toggle (pill control matching Live transport toggle) */
  .ws-carrier-toggle {
    display: flex;
    gap: calc(var(--space-xs) * 0.8);
    align-items: center;
    min-width: 0;
  }

  .ws-carrier-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: calc(var(--text-sm) * 0.88);
    color: rgb(var(--color-text-rgb) / 0.5);
    cursor: pointer;
  }

  .ws-carrier-radio {
    width: 0.85rem;
    height: 0.85rem;
    accent-color: rgb(var(--chromatic-cyan));
  }

  .ws-carrier-label {
    white-space: nowrap;
  }

  /* Inline seal code (next to My Seal button) */
  .ws-my-seal-inline {
    --ws-copy-pulse-rgb: var(--chromatic-cyan);
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.92);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.06);
    border: 1px solid rgb(var(--chromatic-cyan) / 0.2);
    border-radius: calc(var(--whisper-radius) * 0.5);
    padding: 0.25em 0.55em;
    cursor: pointer;
    user-select: all;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .ws-my-seal-btn {
    position: relative;
  }

  .ws-seal-mode-chip {
    --ws-copy-pulse-rgb: var(--tool-action-load);
    border-color: rgb(var(--tool-action-load) / 0.35);
    color: rgb(var(--tool-action-load));
    background: rgb(var(--tool-action-load) / 0.08);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .ws-seal-mode-chip:hover {
    border-color: rgb(var(--tool-action-load) / 0.5);
    background: rgb(var(--tool-action-load) / 0.14);
  }

  .ws-seal-mode-chip:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .ws-seal-mode-chip.ws-seal-mode-chip--active {
    box-shadow: none;
  }

  .ws-seal-mode-chip.ws-seal-mode-chip--unstable {
    --ws-copy-pulse-rgb: var(--chromatic-red);
    border-color: rgb(var(--chromatic-red) / 0.42);
    color: rgb(var(--chromatic-red));
    background: rgb(var(--chromatic-red) / 0.09);
  }

  .ws-seal-mode-chip.ws-seal-mode-chip--unstable:hover {
    border-color: rgb(var(--chromatic-red) / 0.58);
    background: rgb(var(--chromatic-red) / 0.15);
  }

  .ws-seal-mode-chip.ws-seal-mode-chip--unstable:focus-visible {
    box-shadow: none;
  }

  .ws-my-seal-inline:hover {
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.35);
  }

  .ws-my-seal-inline:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.15);
  }

  /* Copy-confirm pulse — used on My Seal btn and inline seal code */
  @keyframes ws-copy-pulse {
    0%   { background: rgb(var(--ws-copy-pulse-rgb, var(--chromatic-cyan)) / 0.25); border-color: rgb(var(--ws-copy-pulse-rgb, var(--chromatic-cyan)) / 0.5); }
    100% { background: transparent; border-color: rgb(var(--color-text-rgb) / 0.14); }
  }

  .ws-copy-pulse {
    animation: ws-copy-pulse 0.7s ease-out;
  }

  /* Reject pulse — red flash for invalid actions (matches ws-copy-pulse pattern) */
  @keyframes ws-reject-pulse {
    0%   { background: rgb(var(--chromatic-red) / 0.25); border-color: rgb(var(--chromatic-red) / 0.5); }
    100% { background: transparent; border-color: rgb(var(--color-text-rgb) / 0.14); }
  }

  .ws-reject-pulse {
    animation: ws-reject-pulse 0.7s ease-out !important;
  }

  /* Computing shimmer — repeating border glow while working */
  @keyframes ws-computing-shimmer {
    0%   { border-color: rgb(var(--chromatic-cyan) / 0.15); box-shadow: 0 0 0 0 rgb(var(--chromatic-cyan) / 0); }
    50%  { border-color: rgb(var(--chromatic-cyan) / 0.5); box-shadow: 0 0 6px 0 rgb(var(--chromatic-cyan) / 0.15); }
    100% { border-color: rgb(var(--chromatic-cyan) / 0.15); box-shadow: 0 0 0 0 rgb(var(--chromatic-cyan) / 0); }
  }

  .ws-computing {
    animation: ws-computing-shimmer 1.2s ease-in-out infinite;
  }

  /* Sealed URL inline result */
  .ws-sealed-result {
    display: grid;
    gap: calc(var(--space-xs) * 0.4);
    margin-top: var(--space-sm);
  }

  .ws-sealed-result-label {
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.4);
    letter-spacing: 0.03em;
  }

  .ws-sealed-url-inline {
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.06);
    border: 1px solid rgb(var(--chromatic-cyan) / 0.2);
    border-radius: calc(var(--whisper-radius) * 0.5);
    padding: 0.5em 0.65em;
    margin: 0;
    word-break: break-all;
    white-space: pre-wrap;
    max-width: 100%;
    max-height: 5rem;
    overflow-y: auto;
    cursor: pointer;
    user-select: all;
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .ws-sealed-url-inline:hover {
    background: rgb(var(--chromatic-cyan) / 0.1);
    border-color: rgb(var(--chromatic-cyan) / 0.35);
  }

  .ws-sealed-url-inline:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(var(--chromatic-cyan) / 0.15);
  }

  .ws-sealed-result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space-xs) * 0.5);
    font-size: calc(var(--text-sm) * 0.85);
    color: rgb(var(--color-text-rgb) / 0.4);
  }

  .ws-sealed-result-warning {
    color: rgb(var(--tool-status-warning) / 0.8);
  }

  /* Seal fields container */
  .ws-seal-fields {
    display: grid;
    gap: var(--space-sm);
  }

  /* Overlay panel wrapper — visibility managed by JS via inline styles.
     Initial state is style="display:none" in HTML. */

  /* Seal code display — big, monospace, prominent */
  .ws-seal-code {
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: clamp(0.7rem, 3.8vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgb(var(--chromatic-cyan));
    display: block;
    text-align: center;
    padding: var(--space-md) 0;
    word-break: break-all;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .ws-seal-code-wrap {
    background: rgb(var(--chromatic-cyan) / 0.06);
    border: 1px solid rgb(var(--chromatic-cyan) / 0.2);
    border-radius: calc(var(--whisper-radius) * 0.75);
    margin: var(--space-sm) 0;
    padding: 0 var(--space-sm);
    min-width: 0;
    overflow: hidden;
  }

  .ws-seal-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.44);
    line-height: 1.5;
  }

  .ws-seal-qr-wrap {
    display: grid;
    justify-items: center;
    gap: calc(var(--space-xs) * 0.6);
    margin: 0 0 var(--space-sm);
    min-width: 0;
    max-width: 100%;
  }

  .ws-my-seal-inline-panel {
    margin-top: calc(var(--space-xs) * 0.55);
    padding: calc(var(--space-xs) * 0.6);
    border: 1px solid rgb(var(--tool-action-load) / 0.22);
    border-radius: calc(var(--whisper-radius) * 0.55);
    background: rgb(var(--tool-action-load) / 0.04);
    min-width: 0;
    overflow: hidden;
  }

  .whisper-page[data-seal-mode="unstable"] .ws-my-seal-inline-panel {
    border-color: rgb(var(--chromatic-red) / 0.24);
    background: rgb(var(--chromatic-red) / 0.04);
  }

  .whisper-page[data-seal-mode="unstable"] .ws-my-seal-inline {
