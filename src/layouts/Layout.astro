---
import "../styles/global.css";
// katex's stylesheet used to live here and therefore in every route's css.
// it now travels with MathStyles.astro, rendered only by posts containing maths.
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import { ClientRouter } from "astro:transitions";
import { navBarLinks, identity } from "../config";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
const isContactPage = Astro.url.pathname === "/contact";

// trailingSlash is "never", so pathnames arrive unadorned. normalise anyway so
// a stray slash cannot silently drop the current-page marker.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (url: string) => (url.replace(/\/+$/, "") || "/") === currentPath;
---

<script>
  (function() {
    // Prevent duplicate listener registration across navigations
    if (window.__layoutListenersInit) return;
    window.__layoutListenersInit = true;

    function updateLogoHint() {
      var logo = document.getElementById('logo-link');
      if (logo) logo.classList.toggle('logo-hint', location.pathname !== '/');
    }

    // Close mobile menu instantly without triggering CSS transitions
    function closeMenuInstantly() {
      var menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

      // Disable transitions temporarily to prevent flicker
      var content = menu.querySelector<HTMLElement>('.mobile-menu-content');
      var indicator = menu.querySelector<HTMLElement>('.menu-indicator');
      var menuEl = menu;

      if (content instanceof HTMLElement) content.style.transition = 'none';
      if (indicator instanceof HTMLElement) indicator.style.transition = 'none';
      menu.style.setProperty('--menu-transition', 'none');

      menu.open = false;

      // Re-enable transitions after a frame
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          if (content instanceof HTMLElement) content.style.transition = '';
          if (indicator instanceof HTMLElement) indicator.style.transition = '';
          menuEl.style.removeProperty('--menu-transition');
        });
      });
    }

    function handleOutsideMenuTap(event: PointerEvent) {
      var menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
      if (!(event.target instanceof Node)) return;
      if (menu.contains(event.target)) return;
      closeMenuInstantly();
    }

    var logoController: AbortController | null = null;

    function setupLogoScroll() {
      var logo = document.getElementById('logo-link');
      if (!logo) return;

      if (logoController) logoController.abort();
      logoController = new AbortController();

      logo.addEventListener('click', function(e: MouseEvent) {
        if (location.pathname === '/') {
          e.preventDefault();
          window.scrollTo({ top: 0 });
        }
      }, { signal: logoController.signal });
    }

    // Prepare for navigation - close menu and update logo hint BEFORE transition starts
    function prepareForNavigation(e: Event) {
      closeMenuInstantly();

      // Pre-update logo hint based on the destination URL to avoid post-swap flash
      var logo = document.getElementById('logo-link');
      var destination = (e as { to?: string }).to;
      if (logo && destination) {
        try {
          var destPath = new URL(destination, location.origin).pathname;
          var shouldHint = destPath !== '/';
          var hasHint = logo.classList.contains('logo-hint');

          if (shouldHint !== hasHint) {
            logo.classList.add('no-transition');
            logo.classList.toggle('logo-hint', shouldHint);

            var logoRef = logo;
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                logoRef.classList.remove('no-transition');
              });
            });
          }
        } catch (_) {}
      }
    }

    updateLogoHint();
    setupLogoScroll();

    // Do not remove: iOS touch WebKit still has unreliable behavior for
    // background-attachment: fixed on scrolled pages/containers.
    // We keep the desktop effect everywhere else, and only emulate it here.
    var needsIosParallaxFallback = window.matchMedia('(hover: none) and (pointer: coarse)').matches
      && !!(window.CSS && CSS.supports && CSS.supports('-webkit-touch-callout', 'none'));

    if (needsIosParallaxFallback) {
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var iosParallaxRaf = 0;
      var iosParallaxTarget = window.scrollY;
      var iosParallaxCurrent = window.scrollY;
      var iosParallaxLerp = prefersReducedMotion ? 1 : 0.18;
      var rootElement = document.documentElement;
      rootElement.setAttribute('data-ios-parallax', 'js');
      if (prefersReducedMotion) {
        rootElement.style.setProperty('--ios-parallax-strength', '0.35');
      }

      function applyIosParallaxScroll() {
        iosParallaxRaf = 0;
        iosParallaxCurrent += (iosParallaxTarget - iosParallaxCurrent) * iosParallaxLerp;
        if (Math.abs(iosParallaxTarget - iosParallaxCurrent) < 0.25) {
          iosParallaxCurrent = iosParallaxTarget;
        }
        rootElement.style.setProperty('--ios-scroll-y', iosParallaxCurrent + 'px');

        if (iosParallaxCurrent !== iosParallaxTarget) {
          iosParallaxRaf = requestAnimationFrame(applyIosParallaxScroll);
        }
      }

      function scheduleIosParallaxScroll() {
        iosParallaxTarget = window.scrollY;
        if (iosParallaxRaf) return;
        iosParallaxRaf = requestAnimationFrame(applyIosParallaxScroll);
      }

      function forceIosParallaxScroll() {
        iosParallaxTarget = window.scrollY;
        if (iosParallaxRaf) {
          cancelAnimationFrame(iosParallaxRaf);
          iosParallaxRaf = 0;
        }
        iosParallaxRaf = requestAnimationFrame(applyIosParallaxScroll);
      }

      function nudgeIosParallaxLifecycle() {
        // Mobile WebKit can miss/strand a frame around view transitions.
        // Force a fresh schedule across a few ticks so we always recover.
        forceIosParallaxScroll();
        requestAnimationFrame(forceIosParallaxScroll);
        setTimeout(forceIosParallaxScroll, 140);
      }

      applyIosParallaxScroll();
      window.addEventListener('scroll', scheduleIosParallaxScroll, { passive: true });
      window.addEventListener('resize', scheduleIosParallaxScroll, { passive: true });
      window.addEventListener('orientationchange', nudgeIosParallaxLifecycle, { passive: true });
      window.addEventListener('pageshow', nudgeIosParallaxLifecycle, { passive: true });
      window.addEventListener('pagehide', function() {
        if (!iosParallaxRaf) return;
        cancelAnimationFrame(iosParallaxRaf);
        iosParallaxRaf = 0;
      });
      document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') nudgeIosParallaxLifecycle();
      });
      document.addEventListener('astro:before-swap', function() {
        if (!iosParallaxRaf) return;
        cancelAnimationFrame(iosParallaxRaf);
        iosParallaxRaf = 0;
      });
      document.addEventListener('astro:after-swap', nudgeIosParallaxLifecycle);
      document.addEventListener('astro:page-load', nudgeIosParallaxLifecycle);

      // Keep in sync through route lifecycle; some mobile WebKit transitions
      // won't emit a useful scroll tick immediately after navigation.
      document.addEventListener('astro:before-preparation', function() {
        requestAnimationFrame(nudgeIosParallaxLifecycle);
      });
    } else {
      document.documentElement.removeAttribute('data-ios-parallax');
    }

    document.addEventListener("astro:before-preparation", prepareForNavigation);
    document.addEventListener("astro:after-swap", updateLogoHint);
    document.addEventListener("astro:after-swap", setupLogoScroll);
    document.addEventListener("pointerdown", handleOutsideMenuTap);
  })();
</script>

<script is:inline>
  (function() {
    if (window.__c) return;
    window.__c = true;
    function init() {
      var s = 'color:#0ff;font-family:monospace;', b = document.body, cl = b.classList;
      console.log('%c╔════════════════════╗\n║ Why hello there :) ║\n║ try help()         ║\n╚════════════════════╝', s);
      window.help = function() { console.log('%c╔════════════════════╗\n║ glitch() chromatic ║\n║ pride()  rainbow   ║\n║ invert() colors    ║\n║ hi()     hey       ║\n╚════════════════════╝', s); };
      window.glitch = function(loop) {
        if (loop === 0) { var on = cl.toggle('glitch-loop'); cl.toggle('glitch-active', on); return 'loop ' + (on ? 'on' : 'off'); }
        cl.remove('glitch-active', 'glitch-loop');
        requestAnimationFrame(function() { requestAnimationFrame(function() { cl.add('glitch-active'); }); });
        return 'glitching...';
      };
      window.invert = function() { return cl.toggle('invert') ? 'on' : 'off'; };
      window.pride = window.prideful = function() { return cl.toggle('pride') ? 'on' : 'off'; };
      window.hi = function() { return 'hey :)'; };
    }
    if (document.body) init();
    else document.addEventListener('DOMContentLoaded', init, { once: true });
  })();
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="author" content="woflo" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* the body face is otherwise discovered only after the stylesheet parses,
        which delays the first line of text on every cold visit */}
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/site.webmanifest" />
    {import.meta.env.PROD && (
      <script is:inline>
        (function () {
          if (!('serviceWorker' in navigator)) return;
          var register = function () { navigator.serviceWorker.register('/sw.js'); };
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(register, { timeout: 2000 });
          } else {
            window.addEventListener('load', register, { once: true });
          }
        })();
      </script>
    )}
    {isContactPage && <link rel="preconnect" href="https://formsubmit.co" crossorigin />}
    {isContactPage && <link rel="dns-prefetch" href="//formsubmit.co" />}
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={Astro.url.href} />
    {/* a feed nobody can find is not a feed. readers and browser extensions
        look for exactly this tag, so it goes on every page rather than only
        on the blog. */}
    <link rel="alternate" type="application/rss+xml" title="woflo" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={`${Astro.url.origin}${seo.image}`} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={`${Astro.url.origin}${seo.image}`} />
    <ClientRouter />

    {!import.meta.env.PROD && (
      <script is:inline>
        (function () {
          try {
            if (!('serviceWorker' in navigator)) return;
            if (sessionStorage.getItem('__swCleared') === '1') return;
            navigator.serviceWorker.getRegistrations().then(function (regs) {
              if (!regs || regs.length === 0) return;
              sessionStorage.setItem('__swCleared', '1');
              regs.forEach(function (r) { try { r.unregister(); } catch (e) {} });
              if ('caches' in window) {
                caches.keys().then(function (keys) {
                  keys.forEach(function (k) { try { caches.delete(k); } catch (e) {} });
                });
              }
              // One refresh to ensure we’re not running stale cached assets.
              setTimeout(function () { location.reload(); }, 50);
            });
          } catch (e) {}
        })();
      </script>
    )}

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": identity.name,
      "url": Astro.site,
      "sameAs": [identity.github]
    })} />
  </head>
  <body class="ambient-depth">
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header sticky top-0 z-50 @container bg-[var(--color-bg)]/95 backdrop-blur" transition:persist="site-header">
      <div
        class="py-2 content-section flex items-center justify-between"
      >
        <a href="/" transition:persist="logo" id="logo-link" aria-current={isCurrent("/") ? "page" : undefined}>
          <Image
            src={identity.logo}
            alt={`${identity.name} - Home`}
            width={50}
            height={50}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            class="size-(--size-avatar-md) object-cover"
            transition:name="site-logo"
          />
        </a>
        {/* the crumbs are buttons that jump to headings, so the strip is a
            navigation region. both landmarks are named, otherwise a screen
            reader announces two unlabelled navigations in one header. */}
        <span id="header-breadcrumb" role="navigation" aria-label="On this page" class="flex items-center gap-[5px] ml-[10px] text-[length:var(--text-sm)] opacity-0 transition-opacity duration-300 overflow-hidden"></span>
        <nav aria-label="Main" class="ml-auto mr-4 @sm:mr-0">
          {/* Desktop/Tablet nav - visible at @sm (480px+) for better tablet support */}
          {/* invisible, not merely transparent: a control faded to zero still
              takes a tab stop, so the desktop list was three phantom stops on a
              phone. visibility:hidden removes it from sequential focus. */}
          <ul class="absolute right-[clamp(1rem,4vw,1.5rem)] top-1/2 -translate-y-1/2 flex items-center gap-1 group invisible opacity-0 pointer-events-none @sm:visible @sm:opacity-100 @sm:pointer-events-auto">
            {
              navBarLinks.map((link) => (
                <li>
                  {/* .interactive already carries the resting opacity, the
                      touch-target floor, the dim-siblings-on-hover rule and the
                      pop back to full. no reason to restate it per link. */}
                  <a
                    class="interactive px-3 py-2.5 flex items-center rounded-lg"
                    href={link.url}
                    target={link.external ? "_blank" : "_self"}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-current={isCurrent(link.url) ? "page" : undefined}
                  >
                    {link.title}
                  </a>
                </li>
              ))
            }
            <li class="ml-1 relative">
              <a
                href="/contact"
                class="interactive peer p-2.5 min-w-[var(--touch-target)] flex items-center justify-center rounded-lg"
                aria-label="Contact"
                aria-current={isCurrent("/contact") ? "page" : undefined}
              >
                <Icon name="mdi:message-outline" width={20} height={20} />
              </a>
              <span class="casual-lazy surface-raised absolute top-full right-0 mt-2 px-3 py-1.5 text-[length:var(--text-sm)] text-[var(--color-text)]/60 bg-[var(--color-bg)]/90 border border-[var(--color-border)] rounded-md opacity-0 translate-y-1 peer-hover:opacity-100 peer-hover:translate-y-0 peer-focus-visible:opacity-100 peer-focus-visible:translate-y-0 pointer-events-none whitespace-nowrap transition-[opacity,transform] [transition-duration:var(--duration-slow)] [transition-timing-function:var(--ease-spring)] [transition-delay:var(--duration-normal)]">
                Contact me
              </span>
            </li>
          </ul>
          {/* Mobile menu - only on small screens (below @sm/480px) */}
          <details class="mobile-menu relative invisible opacity-0 pointer-events-none @max-sm:visible @max-sm:opacity-100 @max-sm:pointer-events-auto">
            <summary class="mobile-menu-toggle relative p-3 min-h-[var(--touch-target)] min-w-[var(--touch-target)] flex items-center justify-center opacity-70 hover:opacity-100 cursor-pointer list-none [&::-webkit-details-marker]:hidden" aria-label="Toggle navigation menu">
              <span class="menu-indicator"></span>
            </summary>
            <ul class="mobile-menu-content surface-raised group absolute p-2 right-0 rounded-lg w-48 z-[100] bg-[var(--color-bg)] border border-[var(--color-border)]">
              {
                navBarLinks.map((link) => (
                  <li>
                    <a
                      class="interactive block px-4 py-3 rounded-lg hover:bg-white/5"
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      aria-current={isCurrent(link.url) ? "page" : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }
              <li>
                <a
                  class="interactive block px-4 py-3 rounded-lg hover:bg-white/5"
                  href="/contact"
                  aria-current={isCurrent("/contact") ? "page" : undefined}
                >
                  Contact me
                </a>
              </li>
            </ul>
          </details>
        </nav>
      </div>
    </header>
    {/* tabindex allows the skip link to actually move focus here. without it
        gecko sends the caret but leaves focus on the body. */}
    <main id="main" class="pb-16" tabindex="-1">
      <slot />
    </main>
    <footer id="site-footer" class="border-t border-[var(--color-border)]" style="display: none;">
      <div class="content-section py-5 text-center">
        {/* the footnote still has to be readable: at opacity 0.25 this measured
            2.1:1 against the page. --opacity-text-floor is the 4.5:1 mark. */}
        <p class="text-[length:var(--text-sm)] opacity-[var(--opacity-text-floor)]">Whisper Codec Stack | Patent Pending | <a href="https://github.com/worflor/worflor.github.io/blob/main/src/scripts/whisper/LICENSE.md" target="_blank" rel="noopener" class="underline-offset-2 hover:opacity-100 transition-opacity" title="License tl;dr: only for-profit companies need a license">License</a></p>
      </div>
    </footer>
    <script is:inline data-astro-rerun>
      (function() {
        var footer = document.getElementById('site-footer');
        if (footer && window.location.pathname.startsWith('/whisper')) {
          footer.style.display = 'block';
        }

        var header = document.querySelector('.site-header');
        var breadcrumb = document.getElementById('header-breadcrumb');
        if (!(header instanceof HTMLElement)) return;
        var headerH = header.offsetHeight;

        // publish the measured height so scroll-padding-top can keep anchors
        // and :target from landing underneath the sticky header
        function publishHeaderHeight() {
          headerH = header.offsetHeight;
          document.documentElement.style.setProperty('--header-h', headerH + 'px');
        }
        publishHeaderHeight();

        var hideThreshold = headerH * 1.25;
        var lastScroll = window.scrollY;
        var hidePoint = 0;

        // Breadcrumb sizing: measure space between logo and nav
        var logo = document.getElementById('logo-link');
        var navUl = header.querySelector('nav > ul');
        var mobileMenu = header.querySelector('.mobile-menu');
        function getAvailableSpace() {
          if (!logo) return { space: 300, compact: false };
          var logoRect = logo.getBoundingClientRect();

          // Check if desktop nav is visible (opacity > 0 at @sm/480px container width)
          var navVisible = navUl && getComputedStyle(navUl).opacity !== '0';

          if (navVisible && navUl instanceof HTMLElement) {
            var navRect = navUl.getBoundingClientRect();
            var space = navRect.left - logoRect.right - 10;
            return { space: Math.max(0, space), compact: space < 200 };
          }

          // Mobile: measure to hamburger menu instead
          if (mobileMenu instanceof HTMLElement) {
            var menuRect = mobileMenu.getBoundingClientRect();
            var space = menuRect.left - logoRect.right - 16;
            return { space: Math.max(0, space), compact: true };
          }

          return { space: window.innerWidth * 0.7, compact: false };
        }

        function applyBreadcrumbSize() {
          if (!breadcrumb) return;
          var info = getAvailableSpace();
          breadcrumb.style.maxWidth = info.space + 'px';
        }
        applyBreadcrumbSize();
        function onResize() {
          publishHeaderHeight();
          applyBreadcrumbSize();
        }
        window.addEventListener('resize', onResize);

        // only write the style when the state actually flips. this used to run a
        // style mutation on every scroll event regardless.
        var headerShown = true;
        function setHeaderShown(shown) {
          if (shown === headerShown) return;
          headerShown = shown;
          header.style.transform = shown ? 'translateY(0)' : 'translateY(-100%)';
        }

        function onScroll() {
          var scroll = window.scrollY;
          if (scroll < hideThreshold) {
            setHeaderShown(true);
          } else if (scroll > lastScroll) {
            setHeaderShown(false);
            hidePoint = scroll;
            if (mobileMenu instanceof HTMLDetailsElement) mobileMenu.open = false;
          } else if (hidePoint - scroll > hideThreshold) {
            setHeaderShown(true);
          }
          lastScroll = scroll;
        }

        window.addEventListener('scroll', onScroll, { passive: true });

        // tabbing into a hidden header would otherwise put focus off screen.
        // the header persists across view transitions while this script reruns,
        // so the listener has to come off again in the cleanup below.
        function onHeaderFocus() { setHeaderShown(true); }
        header.addEventListener('focusin', onHeaderFocus);

        document.addEventListener('astro:before-swap', function cleanup() {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onResize);
          header.removeEventListener('focusin', onHeaderFocus);
          document.removeEventListener('astro:before-swap', cleanup);
        }, { once: true });
        // Pages with [data-breadcrumb-controller] manage their own breadcrumb
        if (document.querySelector('[data-breadcrumb-controller]')) return;

        var headings = Array.from(document.querySelectorAll('main h1, main h2, main h3'));
        if (!headings.length || !breadcrumb) return;

        var currentCrumbs = [];
        var typeTimer = null;

        function scrollToHeading(el) {
          var y = el.getBoundingClientRect().top + window.scrollY - header.offsetHeight - 16;
          window.scrollTo({ top: Math.max(0, y) });
        }

        function buildCrumbDOM(crumbs, compact) {
          breadcrumb.innerHTML = '';
          var visible = (compact && crumbs.length > 1) ? crumbs.slice(-1) : crumbs;
          breadcrumb.classList.toggle('single-crumb', visible.length === 1);
          if (!visible.length) return;

          visible.forEach(function(c, i) {
            var hideOnMobile = i === 0 && visible.length > 1;

            var dot = document.createElement('span');
            dot.textContent = '·';
            dot.className = 'crumb-sep' + (hideOnMobile ? ' mobile-hidden' : '');
            dot.setAttribute('aria-hidden', 'true');

            // a real button rather than a span wearing role="button": native
            // semantics bring enter/space, the correct role and focus handling
            // without a hand-rolled keydown listener
            var crumb = document.createElement('button');
            crumb.type = 'button';
            crumb.className = 'crumb' + (hideOnMobile ? ' mobile-hidden' : '');

            var inner = document.createElement('span');
            inner.className = 'crumb-inner';
            inner.textContent = c.text;
            crumb.appendChild(inner);

            breadcrumb.appendChild(dot);
            breadcrumb.appendChild(crumb);

            crumb.onclick = function() { scrollToHeading(c.el); };
          });
        }

        function checkOverflow() {
          breadcrumb.querySelectorAll('.crumb').forEach(function(crumb) {
            var inner = crumb.querySelector('.crumb-inner');
            if (!inner) return;

            var overflow = inner.scrollWidth - crumb.offsetWidth;
            crumb.classList.remove('overflow', 'truncated');

            if (overflow > 0) {
              crumb.classList.add('truncated');
              if (overflow > 10) {
                crumb.style.setProperty('--scroll-dist', '-' + overflow + 'px');
                crumb.style.setProperty('--scroll-duration', Math.max(6, overflow / 10) + 's');
                requestAnimationFrame(function() {
                  requestAnimationFrame(function() { crumb.classList.add('overflow'); });
                });
              }
            }
          });
        }

        // the typewriter is motion. reduced-motion readers get the finished text.
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function typeOut(crumbs) {
          if (typeTimer) clearInterval(typeTimer);
          var info = getAvailableSpace();
          buildCrumbDOM(crumbs, info.compact);
          breadcrumb.style.maxWidth = info.space + 'px';
          breadcrumb.style.opacity = 'var(--opacity-dim)';

          if (reduceMotion.matches) { checkOverflow(); return; }

          var inners = Array.from(breadcrumb.querySelectorAll('.crumb-inner'));
          var texts = inners.map(function(el) { var t = el.textContent; el.textContent = ''; return t; });
          var total = texts.reduce(function(a, t) { return a + t.length; }, 0);
          var i = 0;

          typeTimer = setInterval(function() {
            if (i > total) { clearInterval(typeTimer); typeTimer = null; checkOverflow(); return; }
            var rem = i++;
            inners.forEach(function(el, idx) {
              var len = Math.min(rem, texts[idx].length);
              el.textContent = texts[idx].slice(0, len);
              rem -= len;
            });
          }, 35);
        }

        function clearThenType(crumbs) {
          if (typeTimer) clearInterval(typeTimer);

          if (reduceMotion.matches) {
            if (crumbs.length) typeOut(crumbs);
            else { breadcrumb.style.opacity = '0'; breadcrumb.innerHTML = ''; }
            return;
          }

          var inners = Array.from(breadcrumb.querySelectorAll('.crumb-inner'));
          var total = inners.reduce(function(a, el) { return a + el.textContent.length; }, 0);
          var i = total;

          typeTimer = setInterval(function() {
            if (i <= 0) {
              clearInterval(typeTimer);
              if (crumbs.length) typeOut(crumbs);
              else { breadcrumb.style.opacity = '0'; breadcrumb.innerHTML = ''; }
              return;
            }
            var rem = --i;
            for (var j = inners.length - 1; j >= 0; j--) {
              var text = inners[j].textContent;
              if (rem >= text.length) { rem -= text.length; }
              else {
                inners[j].textContent = text.slice(0, rem);
                for (var k = j + 1; k < inners.length; k++) inners[k].textContent = '';
                break;
              }
            }
          }, 20);
        }

        function setCrumbs(crumbs) {
          var key = crumbs.map(function(c) { return c.text; }).join('|');
          if (key === currentCrumbs.map(function(c) { return c.text; }).join('|')) return;
