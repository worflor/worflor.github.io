        }

        var crumbThreshold = headerH + 100;

        function updateBreadcrumb() {
          if (window.scrollY <= headerH) { setCrumbs([]); return; }

          var stack = [];
          headings.forEach(function(h) {
            var top = h.getBoundingClientRect().top;
            if (top > crumbThreshold) return;
            var level = +h.tagName[1];
            while (stack.length && stack[stack.length - 1].level >= level) stack.pop();
            stack.push({ el: h, level: level });
          });

          if (!stack.length) { setCrumbs([]); return; }

          setCrumbs(stack.slice(-2).map(function(item) {
            var t = item.el.textContent.trim();
            return { text: t.length > 60 ? t.slice(0, 57) + '...' : t, el: item.el };
          }));
        }

        window.addEventListener('scroll', updateBreadcrumb, { passive: true });
        updateBreadcrumb();

        document.addEventListener('astro:before-swap', function cleanup() {
          if (typeTimer) clearInterval(typeTimer);
          breadcrumb.style.opacity = '0';
          breadcrumb.innerHTML = '';
          window.removeEventListener('scroll', updateBreadcrumb);
          document.removeEventListener('astro:before-swap', cleanup);
        }, { once: true });
      })();
