---
// Standalone layout for the Neuron subsite (/neuron, /neuron/about).
// Intentionally self-contained: it does NOT pull in the portfolio's global
// header/footer/ClientRouter or global.css, so the bespoke Neuron design
// renders 1:1 with its source. Only the shared favicon + SEO shape carry over.
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050604" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {seo.image && <meta property="og:image" content={`${Astro.url.origin}${seo.image}`} />}
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={`${Astro.url.origin}${seo.image}`} />}

    {/* Self-hosted, the way the rest of the site already does it.
        These pages used to pull both families from fonts.googleapis.com, which
        sent every visitor's address to a third party, put a render-blocking
        request on the critical path, and made the landing page's fit-to-width
        logic race a font it did not control.

        Preloaded because the layout genuinely depends on their metrics: the
        trigger row measures text and truncates to fit, so a late swap is a
        visible reflow rather than a cosmetic one.

        Variable woff2, latin and latin-ext, which is exactly the set a browser
        used to fetch from Google for this content. 82 KB for all four. */}
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      /* ── Ordered dither ────────────────────────────────────────────────
         Not texture for its own sake: the card's own background is
         linear-gradient(180deg, #060705, #040503), which is a three-level
         range stretched over ~900px. Sampled down the left gutter at 1280,
         that renders as four flat plateaus with hard 1-level steps at
         y≈60, 512 and 868. Standard 8-bit banding, and on an OLED in a dark
         room those boundaries are visible as horizontal lines.

         The texture is blue noise, not an ordered matrix. The first attempt
         used an 8x8 Bayer tile and it was wrong twice over: Bayer decides
         per-pixel quantization, it is not built to be tiled as an overlay,
         and repeating it produced a visible crosshatch with vertical
         striping. Blue noise has its energy pushed into the high frequencies
         and none in the low ones, so it has no structure to resolve and no
         obvious repeat: it reads as fine grain, which is the whole point.
         Generated by iterative cyclic high-pass and rank-ordered to a flat
         histogram; measured low-frequency sd 0.0125.

         One source pixel must land on one device pixel or the grain becomes
         a chunky 2x2 grid, which was the second half of what went wrong. CSS
         cannot read devicePixelRatio, so the tile is resized per resolution
         band below to keep the mapping 1:1.

         3.8 KB, cached, shared by both pages, no script, no blend mode.
         --dither is the only dial; deleting this block removes the effect. */
      [data-card],
      [data-dither] {
        --dither: 0.014;
      }

      [data-card]::after,
      [data-dither]::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background-image: url("/images/bluenoise-64.png");
        background-repeat: repeat;
        background-size: 64px 64px;
        image-rendering: pixelated;
        opacity: var(--dither);
      }

      /* 1:1 source-pixel to device-pixel at each common density. */
      @media (min-resolution: 2dppx) {
        [data-card]::after,
        [data-dither]::after {
          background-size: 32px 32px;
        }
      }
      @media (min-resolution: 3dppx) {
        [data-card]::after,
        [data-dither]::after {
          background-size: 21.3333px 21.3333px;
        }
      }

      /* Decoration has no place in either of these. Forced colours paints its
         own palette and a grain over it is noise on a surface someone needs
         to read; a contrast request is the opposite of adding texture. */
      @media (forced-colors: active), (prefers-contrast: more) {
        [data-card]::after,
        [data-dither]::after {
          display: none;
        }
      }

      /* swap, not block: text stays readable while the face arrives, and the
         landing page re-fits itself on document.fonts.ready. */
      @font-face {
        font-family: "JetBrains Mono";
        src: url("/fonts/jetbrains-mono-latin.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url("/fonts/jetbrains-mono-latinext.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
          U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0,
          U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Space Grotesk";
        src: url("/fonts/space-grotesk-latin.woff2") format("woff2");
        font-weight: 500 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Space Grotesk";
        src: url("/fonts/space-grotesk-latinext.woff2") format("woff2");
        font-weight: 500 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
          U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0,
          U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      html,
      body {
        margin: 0;
        background: #050604;
      }
      ::selection {
        background: rgba(57, 255, 106, 0.25);
        color: #f4fff7;
      }

      /* Native cross-document view transitions between /neuron and
         /neuron/about. The whole page cross-fades (so the hero's border melts
         into the borderless about page instead of hard-cutting), and any
         element with a shared view-transition-name morphs across the nav. */
      @view-transition {
        navigation: auto;
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 260ms;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />

    <script>
      // Reproduces the Neuron design-doc `style-hover` / `style-active`
      // attributes. In the source runtime these compile to real
      // `.scpN:hover{…}` / `.scpN:active{…}` rules; here we merge those
      // declarations onto the element's inline style on pointer state changes,
      // which guarantees they win the cascade over the base inline style.
      (function wirePseudoStyles() {
        const nodes = document.querySelectorAll<HTMLElement>(
          "[style-hover], [style-active]",
        );
        nodes.forEach((el) => {
          const base = el.getAttribute("style") || "";
          const hover = el.getAttribute("style-hover") || "";
          const active = el.getAttribute("style-active") || "";
          let over = false;
          let down = false;
          const refresh = () => {
            el.setAttribute(
              "style",
              base +
                (over && hover ? ";" + hover : "") +
                (down && active ? ";" + active : ""),
            );
          };
          el.addEventListener("pointerenter", () => {
            over = true;
            refresh();
          });
          el.addEventListener("pointerleave", () => {
            over = false;
            down = false;
            refresh();
          });
          el.addEventListener("pointerdown", () => {
            down = true;
            refresh();
          });
          window.addEventListener("pointerup", () => {
            if (down) {
              down = false;
              refresh();
            }
          });
        });
      })();
    </script>
  </body>
</html>
