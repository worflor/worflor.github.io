---
/**
 * WhisperSealPanel — Digital Signature Encryption with Whisper Glyph.
 *
 * Layout uses fixed spatial regions: File, Sign, Strictness, Action, Pipeline,
 * Status. Each region has a stable position and surfaces what's happening at
 * that stage, so power users see the process without modal jargon.
 */
---

<section class="seal-panel" data-seal-panel>
  <header class="seal-intro">
    <h2 class="seal-title">Digital Signature Encryption with Whisper Glyph</h2>
    <p class="seal-subtitle">sign it or whatever, see if I care</p>
  </header>

  <!-- ── sign ──────────────────────────────────────────────── -->
  <section class="seal-region" aria-labelledby="seal-region-sign">
    <div class="seal-canvas-wrap">
      <canvas
        class="seal-canvas"
        data-seal-canvas
        width="640"
        height="200"
        aria-label="signature canvas"
      ></canvas>
      <div class="seal-canvas-stats" data-seal-region-aside="sign" aria-label="signature stats">
        <span class="seal-stat" data-seal-stat-wrap="strokes">
          <span class="seal-stat-value" data-seal-stat="strokes">0</span>
          <span class="seal-stat-unit">strokes</span>
        </span>
        <span class="seal-stat" data-seal-stat-wrap="bits">
          <span class="seal-stat-value" data-seal-stat="bits">0</span>
          <span class="seal-stat-unit">bits</span>
        </span>
        <span class="seal-stat seal-stat--secondary" data-seal-stat-wrap="samples">
          <span class="seal-stat-value" data-seal-stat="samples">0</span>
          <span class="seal-stat-unit">pts</span>
        </span>
        <span class="seal-stat seal-stat--secondary" data-seal-stat-wrap="blocks">
          <span class="seal-stat-value" data-seal-stat="blocks">0</span>
          <span class="seal-stat-unit">blk</span>
        </span>
        <span class="seal-stat seal-stat--secondary" data-seal-stat-wrap="period">
          <span class="seal-stat-value" data-seal-stat="period">&mdash;</span>
          <span class="seal-stat-unit">Hz</span>
        </span>
      </div>
      <button
        class="seal-mini-btn seal-canvas-clear"
        data-seal-canvas-clear
        type="button"
      >clear</button>
      <span class="seal-input-chip" data-seal-input-indicator hidden title="">
        <span class="seal-input-dot" data-seal-input-dot></span>
        <span class="seal-input-label" data-seal-input-label></span>
      </span>
    </div>
  </section>

  <!-- ── tolerance ─────────────────────────────────────────── -->
  <section
    class="seal-region seal-region--strictness"
    aria-labelledby="seal-region-strictness"
    data-seal-strictness-group
  >
    <div class="seal-region-row">
      <h3 class="seal-region-label" id="seal-region-strictness">tolerance</h3>
      <p class="seal-region-aside seal-region-aside--note" data-seal-strictness-note>
        how closely must the signature match
      </p>
    </div>
    <div class="seal-tol-bars" data-seal-tolerance>
      <div class="seal-tol-strip" data-tol-strip="shape">
        <span class="seal-tol-label">shape</span>
        <div class="seal-tol-track" data-tol-track>
          <div class="seal-tol-fill"></div>
        </div>
      </div>
      <div class="seal-tol-strip" data-tol-strip="speed">
        <span class="seal-tol-label">speed</span>
        <div class="seal-tol-track" data-tol-track>
          <div class="seal-tol-fill"></div>
        </div>
      </div>
      <div class="seal-tol-strip" data-tol-strip="pressure">
        <span class="seal-tol-label">pressure</span>
        <div class="seal-tol-track" data-tol-track>
          <div class="seal-tol-fill"></div>
        </div>
      </div>
    </div>
    <input type="hidden" data-seal-slider="shape" value="40" />
    <input type="hidden" data-seal-slider="speed" value="0" />
    <input type="hidden" data-seal-slider="pressure" value="0" />
  </section>

  <!-- ── phrase ────────────────────────────────────────────── -->
  <label class="whisper-field seal-phrase-field" for="seal-phrase-input">
    <span class="whisper-field-label"
      >shared phrase <span class="whisper-field-hint">(optional)</span></span
    >
    <input
      id="seal-phrase-input"
      type="password"
      class="whisper-input"
      data-seal-phrase
      placeholder="a short phrase between friends"
      autocomplete="new-password"
      autocapitalize="off"
      spellcheck="false"
      data-lpignore="true"
      data-1p-ignore="true"
      data-form-type="other"
    />
  </label>

  <!-- action buttons live in the floating bar (#seal-actions-bar in whisper.astro) -->

  <p class="seal-status" data-seal-status role="status" aria-live="polite"></p>

  <p class="seal-disclaimer">
    your stroke dynamics (position, velocity, pressure, tilt) are modeled
    as damped oscillators, quantized into a fuzzy commitment, and used as
    the encryption key. reproduce the motion to unlock the file.
  </p>

  <!-- ── compare ──────────────────────────────────────────── -->
  <section class="seal-match" data-seal-match>
    <div class="seal-match-pair">
      <div class="seal-match-slot" data-match-slot="a">
        <div class="seal-match-slot-head">
          <span class="seal-match-slot-tag">A</span>
          <span class="seal-match-slot-info" data-match-info>0 blk</span>
          <label class="seal-mini-btn seal-match-load-btn"><input type="file" accept=".glyph" data-match-file hidden />load</label>
          <button class="seal-mini-btn" data-match-clear type="button">clear</button>
        </div>
        <div class="seal-canvas-wrap seal-match-canvas-wrap">
          <canvas class="seal-canvas seal-match-canvas" data-match-canvas width="640" height="200"></canvas>
          <span class="seal-match-hint" data-match-drop-label>draw or load .glyph</span>
        </div>
      </div>
      <div class="seal-match-vs" data-match-vs>
        <button class="seal-match-vs-btn" data-match-compare type="button">
          <span class="seal-match-vs-icon">&#x2194;</span>
        </button>
      </div>
      <div class="seal-match-slot" data-match-slot="b">
        <div class="seal-match-slot-head">
          <span class="seal-match-slot-tag">B</span>
          <span class="seal-match-slot-info" data-match-info>0 blk</span>
          <label class="seal-mini-btn seal-match-load-btn"><input type="file" accept=".glyph" data-match-file hidden />load</label>
          <button class="seal-mini-btn" data-match-clear type="button">clear</button>
        </div>
        <div class="seal-canvas-wrap seal-match-canvas-wrap">
          <canvas class="seal-canvas seal-match-canvas" data-match-canvas width="640" height="200"></canvas>
          <span class="seal-match-hint" data-match-drop-label>draw or load .glyph</span>
        </div>
      </div>
    </div>
    <div class="seal-match-results" data-match-results hidden>
      <div class="seal-match-score">
        <span class="seal-match-pct" data-match-overall-pct>0</span><span class="seal-match-pct-sign">%</span>
        <span class="seal-match-score-label">eigenmotion likeness</span>
      </div>
      <div class="seal-match-breakdown">
        <div class="seal-match-axis" data-match-axis="shape">
          <span class="seal-match-axis-label">shape</span>
          <div class="seal-match-axis-track"><div class="seal-match-axis-fill" data-match-bar="shape"></div></div>
          <span class="seal-match-axis-pct" data-match-axis-pct="shape">0%</span>
        </div>
        <div class="seal-match-axis" data-match-axis="speed">
          <span class="seal-match-axis-label">speed</span>
          <div class="seal-match-axis-track"><div class="seal-match-axis-fill" data-match-bar="speed"></div></div>
          <span class="seal-match-axis-pct" data-match-axis-pct="speed">0%</span>
        </div>
        <div class="seal-match-axis" data-match-axis="pressure">
          <span class="seal-match-axis-label">pressure</span>
          <div class="seal-match-axis-track"><div class="seal-match-axis-fill" data-match-bar="pressure"></div></div>
          <span class="seal-match-axis-pct" data-match-axis-pct="pressure">0%</span>
        </div>
      </div>
      <div class="seal-match-blocks" data-match-blocks></div>
      <div class="seal-match-overlay-wrap">
        <canvas class="seal-match-overlay-canvas" data-match-overlay width="640" height="200"></canvas>
      </div>
    </div>
  </section>
</section>

<script>
  import {
    sealFile,
    unsealFile,
    isSealBlob,
    readSealStrictness,
    binWidthFromSlider,
    bitsPerCoef,
    DIGEST_AXIS_COUNTS,
    encodeAllBlocks,
    compareBlocks,
    extractEigenMotion,
    likeness,
    trajectoryFromBlocks,
    fingerprint,
    fingerprintLikeness,
    type SealStrictness,
    type SignatureStroke,
    type CompareResult,
    type LikenessResult,
    type Trajectory,
  } from "../../scripts/whisper/live-seal";
  import { GlyphCodec, GLYPH_CHANNELS, type GlyphBlock } from "../../scripts/whisper/live-wasm-glyph";

  interface CapturedPoint {
    x: number;
    y: number;
    p: number;
    tilt: number;
    azimuth: number;
  }

  const CH = 5;

  function init() {
    const panelRaw = document.querySelector<HTMLElement>("[data-seal-panel]");
    if (!panelRaw) return;
    const panel = panelRaw;
    if ((panel as HTMLElement & { __sealInit?: boolean }).__sealInit) return;
    (panel as HTMLElement & { __sealInit?: boolean }).__sealInit = true;

    // use the shared whisper upload zone (consistent with embed/extract)
    const fileInput = document.getElementById("whisper-carrier-input") as HTMLInputElement;
    if (!fileInput) return;
    const canvas = panel.querySelector<HTMLCanvasElement>("[data-seal-canvas]")!;
    const canvasClear = panel.querySelector<HTMLButtonElement>("[data-seal-canvas-clear]")!;
    // action buttons live in the floating bar, not inline in the panel
    const sealBtn = document.getElementById("seal-bar-seal") as HTMLButtonElement;
    const unsealBtn = document.getElementById("seal-bar-unseal") as HTMLButtonElement;
    const sealBar = document.getElementById("seal-actions-bar") as HTMLElement | null;
    const phraseInput = panel.querySelector<HTMLInputElement>("[data-seal-phrase]");
    if (!sealBtn || !unsealBtn) return;

    // the seal action bar starts hidden (visible={false}). show/hide it based on
    // the whisper page's data-mode attribute, managed via JS not CSS so it works
    // across astro component boundaries.
    const pageEl = document.getElementById("whisper-page");
    function syncSealBarVisibility() {
      if (!sealBar) return;
      const isSeal = pageEl?.dataset.mode === "seal";
      sealBar.style.display = isSeal ? "inline-flex" : "none";
      sealBar.style.opacity = isSeal ? "1" : "0";
    }
    if (pageEl) {
      new MutationObserver(syncSealBarVisibility)
        .observe(pageEl, { attributes: true, attributeFilter: ["data-mode"] });
    }
    syncSealBarVisibility();
    const status = panel.querySelector<HTMLElement>("[data-seal-status]")!;
    const sliders = panel.querySelectorAll<HTMLInputElement>("[data-seal-slider]");
    const strictnessGroup = panel.querySelector<HTMLElement>("[data-seal-strictness-group]")!;
    const strictnessNote = panel.querySelector<HTMLElement>("[data-seal-strictness-note]")!;
    void document.querySelector<HTMLElement>("[data-seal-pipeline]");

    const inputIndicator = panel.querySelector<HTMLElement>("[data-seal-input-indicator]")!;

    const rawCtx = canvas.getContext("2d");
    if (!rawCtx) return;
    const ctx: CanvasRenderingContext2D = rawCtx;
    const root: HTMLElement = panel;

    // input tracking across the entire signing session (not just last stroke)
    let seenPressureVariation = false;
    const usedPointerTypes = new Set<string>();
    let latestPressure = 0.5;

    function setInputChip(label: string, status: "ok" | "warn", tooltip: string) {
      inputIndicator.hidden = false;
      inputIndicator.setAttribute("data-status", status);
      inputIndicator.setAttribute("title", tooltip);
      const labelEl = inputIndicator.querySelector("[data-seal-input-label]");
      if (labelEl) labelEl.textContent = label;
    }

    let chipFadeTimer = 0;
    let isDrawing = false;

    function refreshInputChip() {
      const types = Array.from(usedPointerTypes);
      const hasPen = types.includes("pen") || types.includes("touch");
      const hasMouse = types.includes("mouse");
      const device = types.join(" + ");

      // pressure readout only while actively drawing, and only for pen/touch
      const pStr = (isDrawing && hasPen) ? ` · ${Math.round(latestPressure * 100)}%` : "";

      if (hasMouse && !hasPen) {
        setInputChip("mouse", "warn", "mouse: pressure is uniform across the stroke");
      } else if (hasMouse && hasPen) {
        setInputChip(device + pStr, "warn", "mixed input: some strokes lack pressure data");
      } else if (!seenPressureVariation && strokes.length > 0 && totalSamples() > 20) {
        setInputChip(device + pStr, "warn", `${device}: pressure appears flat`);
      } else {
        setInputChip(device + pStr, "ok", hasPen ? `${device}: pressure active` : device);
      }
    }

    function scheduleChipFade() {
      clearTimeout(chipFadeTimer);
      chipFadeTimer = setTimeout(() => {
        if (!isDrawing && usedPointerTypes.size > 0) {
          // after drawing stops, fade to device-only (no pressure %)
          refreshInputChip();
          // then fade out entirely after another beat
          chipFadeTimer = setTimeout(() => {
            inputIndicator.classList.add("seal-input-chip--fading");
          }, 2500) as unknown as number;
        }
      }, 800) as unknown as number;
    }

    let droppedFile: File | null = null;
    let droppedIsSeal = false;
    const strokes: CapturedPoint[][] = [];
    // parallel to `strokes`: per-stroke per-block signals from Glyph encoding.
    // attention = residual L1 norm normalized [0..1] per-stroke. drives corridor width + opacity.
    // speed = |G| magnitude normalized [0..1]. drives stroke hue (cyan=fast, red=slow). this is
    // the ACTUAL stroke dynamics, not the filter setting — shows where you were fast vs deliberate.
    const strokeAttentions: number[][] = [];
    const strokeSpeeds: number[][] = [];
    let activeStroke: CapturedPoint[] | null = null;
    let blockCount = 0;

    // CSS-pixel canvas dimensions (kept in sync with backing-store size via DPR scaling)
    let canvasW = canvas.clientWidth || canvas.width;
    let canvasH = canvas.clientHeight || canvas.height;

    // ── stats ─────────────────────────────────────────────────
    const statEls = {
      strokes: root.querySelector<HTMLElement>('[data-seal-stat="strokes"]')!,
      samples: root.querySelector<HTMLElement>('[data-seal-stat="samples"]')!,
      blocks: root.querySelector<HTMLElement>('[data-seal-stat="blocks"]')!,
      bits: root.querySelector<HTMLElement>('[data-seal-stat="bits"]')!,
      period: root.querySelector<HTMLElement>('[data-seal-stat="period"]')!,
    };

    function totalSamples(): number {
      let n = 0;
      for (const s of strokes) n += s.length;
      return n;
    }

    function computeEntropyBits(strictness: SealStrictness, blocks: number): number {
      const perBlock =
        bitsPerCoef(binWidthFromSlider(strictness.shape)) * DIGEST_AXIS_COUNTS.shape +
        bitsPerCoef(binWidthFromSlider(strictness.speed)) * DIGEST_AXIS_COUNTS.speed +
        bitsPerCoef(binWidthFromSlider(strictness.pressure)) * DIGEST_AXIS_COUNTS.pressure;
      return Math.round(blocks * perBlock);
    }

    /**
     * encode all strokes, compute per-block residual L1 norm, normalize PER-STROKE
     * to [0..1]. per-stroke normalization means adding a new stroke can't change an
     * older stroke's attention values — no surprise visual shifts mid-signing.
     */
    function recomputeBlocksAndAttention(): void {
      strokeAttentions.length = 0;
      strokeSpeeds.length = 0;

      // use the same encode path as sealFile so block count and kI match
      const allSigs = strokesToBuffer(strokes);
      const allBlocks = encodeAllBlocks(allSigs);
      blockCount = allBlocks.length;

      // compute kI sum from the canonical block set
      let sumKI = 0;
      for (const b of allBlocks) sumKI += Math.abs(b.kI);

      // per-stroke attention and speed for visualization only.
      // per-stroke normalization prevents adding a stroke from shifting
      // an older stroke's attention colors.
      let blockIdx = 0;
      for (const s of strokes) {
        if (s.length < 2) {
          strokeAttentions.push([]);
          strokeSpeeds.push([]);
          continue;
        }
        const sig = strokesToBuffer([s])[0];
        if (!sig || sig.points.length < 4 * GLYPH_CHANNELS) {
          strokeAttentions.push([]);
          strokeSpeeds.push([]);
          continue;
        }
        try {
          const sBlocks = GlyphCodec.encode(sig.points, undefined, { adaptiveSegmentation: false });
          const norms: number[] = [];
          const speeds: number[] = [];
          let maxNorm = 0;
          for (const b of sBlocks) {
            let sum = 0;
            for (let j = 0; j < b.residuals.length; j++) sum += Math.abs(b.residuals[j]);
            norms.push(sum);
            if (sum > maxNorm) maxNorm = sum;
            const gMag = Math.sqrt(b.gR * b.gR + b.gI * b.gI) / 16384;
            speeds.push(Math.min(1, gMag));
          }
          strokeAttentions.push(maxNorm > 0 ? norms.map((n) => n / maxNorm) : norms.map(() => 0.5));
          strokeSpeeds.push(speeds);
          blockIdx += sBlocks.length;
        } catch {
          strokeAttentions.push([]);
          strokeSpeeds.push([]);
        }
      }
      if (blockCount > 0) {
        // per-axis eigenfrequencies: shape breathes at spatial oscillator rate,
        // speed at velocity decay rate, pressure at sidecar frequency
        let sumKI2 = 0, sumGR = 0, sumGI = 0, sumScK = 0;
        for (const b of allBlocks) {
          sumKI2 += Math.abs(b.kI);
          sumGR += Math.abs(b.gR);
          sumGI += Math.abs(b.gI);
          sumScK += Math.abs(b.scK);
        }
        const shapeOmega = ((sumKI2 / blockCount) / 16384) * Math.PI;
        const speedOmega = (Math.sqrt(sumGR * sumGR + sumGI * sumGI) / blockCount / 16384) * Math.PI;
        const pressOmega = ((sumScK / blockCount) / 16384) * Math.PI;

        function toPeriod(omega: number): number {
          return omega > 0.01 ? Math.min(6, Math.max(1, (2 * Math.PI) / omega)) : 3;
        }
        const shapePeriod = toPeriod(shapeOmega);
        const speedPeriod = toPeriod(speedOmega);
        const pressPeriod = toPeriod(pressOmega);

        panel.style.setProperty("--seal-breathe-period", `${shapePeriod.toFixed(2)}s`);
        panel.style.setProperty("--seal-breathe-shape", `${shapePeriod.toFixed(2)}s`);
        panel.style.setProperty("--seal-breathe-speed", `${speedPeriod.toFixed(2)}s`);
        panel.style.setProperty("--seal-breathe-pressure", `${pressPeriod.toFixed(2)}s`);
        statEls.period.textContent = (1 / shapePeriod).toFixed(2);
      } else {
        panel.style.removeProperty("--seal-breathe-period");
        panel.style.removeProperty("--seal-breathe-shape");
        panel.style.removeProperty("--seal-breathe-speed");
        panel.style.removeProperty("--seal-breathe-pressure");
        statEls.period.textContent = "—";
      }
    }

    function updateStats() {
      statEls.strokes.textContent = String(strokes.length);
      statEls.samples.textContent = String(totalSamples());
      statEls.blocks.textContent = String(blockCount);
      const bits = computeEntropyBits(readStrictness(), blockCount);
      statEls.bits.textContent = String(bits);
    }

    // ── tolerance (per-axis dot grid) ──────────────────────────
    function readStrictness(): SealStrictness {
      const get = (name: string): number => {
        const el = root.querySelector<HTMLInputElement>(`[data-seal-slider="${name}"]`);
        return el ? Number(el.value) : 40;
      };
      return { shape: get("shape"), speed: get("speed"), pressure: get("pressure") };
    }

    const strips = panel.querySelectorAll<HTMLElement>('[data-tol-strip]');

    function syncFills(animate = true) {
      strips.forEach(strip => {
        const axis = strip.dataset.tolStrip!;
        const input = panel.querySelector<HTMLInputElement>(`[data-seal-slider="${axis}"]`);
        const fill = strip.querySelector<HTMLElement>('.seal-tol-fill');
        if (!input || !fill) return;
        const val = Number(input.value);
        fill.classList.toggle('seal-tol-fill--animated', animate);
        fill.style.width = `${val}%`;
        fill.toggleAttribute('data-empty', val === 0);
      });
    }

    let activeTolStrip: HTMLElement | null = null;

    function handleStripInput(strip: HTMLElement, clientX: number) {
      const axis = strip.dataset.tolStrip!;
      const input = panel.querySelector<HTMLInputElement>(`[data-seal-slider="${axis}"]`);
      if (!input || input.disabled) return;
      const track = strip.querySelector<HTMLElement>('[data-tol-track]')!;
      const rect = track.getBoundingClientRect();
      const frac = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      input.value = String(Math.round(frac * 100));
      syncFills();
      updateStats();
      if (blockCount > 0) redrawAll();
    }

    strips.forEach(strip => {
      const track = strip.querySelector<HTMLElement>('[data-tol-track]')!;
      track.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        activeTolStrip = strip;
        try { track.setPointerCapture(e.pointerId); } catch {}
        handleStripInput(strip, e.clientX);
      }, { passive: false });
      track.addEventListener('pointermove', (e) => {
        if (activeTolStrip !== strip) return;
        e.preventDefault();
        handleStripInput(strip, e.clientX);
      }, { passive: false });
      const endDrag = () => { activeTolStrip = null; };
      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointercancel', endDrag);
    });

    function reflectStrictnessFromContainer(s: SealStrictness) {
      const map: Record<string, number> = { shape: s.shape, speed: s.speed, pressure: s.pressure };
      sliders.forEach((slider) => {
        const name = slider.getAttribute("data-seal-slider");
        if (!name) return;
        slider.value = String(Math.round(map[name]));
      });
      syncFills(false);
    }


    // ── canvas ─────────────────────────────────────────────────
    function fillBackground() {
      ctx.fillStyle = "rgb(6, 8, 10)";
      ctx.fillRect(0, 0, canvasW, canvasH);
    }

    // High-DPI rendering: backing store matches device pixel ratio while the
    // drawing API stays in CSS pixel units. Re-run on size or DPR changes.
    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(1, Math.floor(rect.width));
      const h = Math.max(1, Math.floor(rect.height));
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvasW = w;
      canvasH = h;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      redrawAll();
    }

    function clearCanvas() {
      strokes.length = 0;
      strokeAttentions.length = 0;
      strokeSpeeds.length = 0;
      activeStroke = null;
      blockCount = 0;
      lastProgressiveBlock = 0;
      seenPressureVariation = false;
      usedPointerTypes.clear();
      latestPressure = 0.5;
      inputIndicator.hidden = true;
      fillBackground();
      updateStats();
    }

    function featuresFor(e: PointerEvent): CapturedPoint {
      const rect = canvas.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const y = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
      const p = e.pressure > 0 ? e.pressure : 0.5;
      const tx = e.tiltX || 0;
      const ty = e.tiltY || 0;
      const tilt = Math.min(1, Math.hypot(tx, ty) / 90);
      const azRaw = Math.atan2(ty, tx);
      const azimuth = (azRaw / (Math.PI * 2)) + 0.5;
      return { x, y, p, tilt, azimuth };
    }

    // ── continuous visualization ──────────────────────────────
    // three visual channels, each driven by its strictness axis + per-block attention:
    //   shape  → corridor WIDTH  (wider = looser bins)
    //   speed  → stroke COLOR    (cyan = loose, red = strict)
    //   pressure → corridor OPACITY (faint = loose, saturated = strict)
    //
    // all three interpolate continuously — no bucketing.

    // continuous bin width → corridor pixel radius (log-scaled for visual range)
    function corridorPx(binWidth: number): number {
      // map bin width 64..2048 to corridor 3..30 px
      const t = Math.log2(Math.max(64, binWidth)) - Math.log2(64); // 0 at 64, 5 at 2048
      return 3 + (t / 5) * 27;
    }

    // continuous bin width → corridor opacity
    function corridorAlpha(effBinWidth: number): number {
      // map bin width 2048..64 to alpha 0.06..0.35
      const t = 1 - (Math.log2(Math.max(64, effBinWidth)) - Math.log2(64)) / 5;
      return 0.06 + 0.29 * t;
    }

    // effective bin width for one block given a base slider + this block's attention [0..1]
    function effBW(baseSlider: number, attention: number): number {
      const base = binWidthFromSlider(baseSlider);
      return Math.max(16, Math.round(base * (1.5 - attention)));
    }

    function paintLiveSegment(prev: CapturedPoint, cur: CapturedPoint) {
      ctx.save();
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      ctx.moveTo(prev.x * canvasW, prev.y * canvasH);
      ctx.lineTo(cur.x * canvasW, cur.y * canvasH);
      ctx.shadowColor = "rgba(0, 220, 220, 0.5)";
      ctx.shadowBlur = 6;
      ctx.strokeStyle = "rgba(0, 230, 230, 0.85)";
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.restore();
    }

    function strokeBlockPath(
      stroke: CapturedPoint[],
      from: number,
      to: number,
      width: number,
      color: string,
    ) {
      if (to <= from) return;
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      ctx.moveTo(stroke[from].x * canvasW, stroke[from].y * canvasH);
      for (let i = from + 1; i <= to && i < stroke.length; i++) {
        ctx.lineTo(stroke[i].x * canvasW, stroke[i].y * canvasH);
      }
      ctx.stroke();
    }

    function redrawAll() {
      fillBackground();
      const base = readStrictness();

      for (let si = 0; si < strokes.length; si++) {
        const stroke = strokes[si];
        if (stroke.length < 2) continue;
        const atts = strokeAttentions[si] ?? [];
        const nBlocks = atts.length;
        if (nBlocks === 0) continue;

        // pass 1: tolerance corridor (shape width × pressure opacity)
        ctx.shadowBlur = 0;
        for (let bi = 0; bi < nBlocks; bi++) {
          const a = atts[bi] ?? 0.5;
          const shapeBw = effBW(base.shape, a);
          const pressureBw = effBW(base.pressure, a);
          const cw = corridorPx(shapeBw);
          const ca = corridorAlpha(pressureBw);
          const from = bi * 16;
          const to = Math.min(from + 16, stroke.length - 1);
          strokeBlockPath(stroke, from, to, cw, `rgba(0, 220, 220, ${ca.toFixed(3)})`);
        }

        // pass 2: stroke line colored by speed, with glow
        const spds = strokeSpeeds[si] ?? [];
        ctx.save();
        ctx.shadowColor = "rgba(0, 200, 200, 0.35)";
        ctx.shadowBlur = 8;
        for (let bi = 0; bi < nBlocks; bi++) {
          const rawSpeed = spds[bi] ?? 0.5;
          // speed slider modulates how much color variation is visible:
          // loose (0) = neutral color for all blocks (speed doesn't matter)
          // strict (100) = full cyan-to-red range (speed matters a lot)
          const intensity = base.speed / 100;
          const speed = 0.5 + (rawSpeed - 0.5) * intensity;
          const r = Math.round(40 + 200 * speed);
          const g = Math.round(230 - 120 * speed);
          const b = Math.round(230 - 130 * speed);
          const from = bi * 16;
          const to = Math.min(from + 16, stroke.length - 1);
          let pSum = 0;
          let pN = 0;
          for (let i = from; i <= to && i < stroke.length; i++) { pSum += stroke[i].p; pN++; }
          const avgP = pN > 0 ? pSum / pN : 0.5;
          const pw = 2 + avgP * 2;
          strokeBlockPath(stroke, from, to, pw, `rgba(${r}, ${g}, ${b}, 1)`);
        }
        ctx.restore();
      }
    }

    resizeCanvas();

    // ── pointer polish ───────────────────────────────────────
    // suppress every browser gesture that could fire while the pen is on the canvas:
    // context menu, scroll-wheel (pen barrel button), text selection drag.
    canvas.addEventListener("contextmenu", (e) => e.preventDefault());
    canvas.addEventListener("wheel", (e) => e.preventDefault(), { passive: false });
    canvas.addEventListener("dragstart", (e) => e.preventDefault());

    canvas.addEventListener("pointerdown", (e) => {
      // primary mouse only; pen/touch always report button 0 so they're fine.
      if (e.pointerType === "mouse" && e.button !== 0) return;
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      const pt = featuresFor(e);
      activeStroke = [pt];
      strokes.push(activeStroke);
      strokeAttentions.push([]);
      lastProgressiveBlock = 0;
      statEls.strokes.textContent = String(strokes.length);
      ctx.save();
      ctx.shadowColor = "rgba(0, 220, 220, 0.6)";
      ctx.shadowBlur = 8;
      ctx.fillStyle = "rgba(0, 230, 230, 0.9)";
      ctx.beginPath();
      ctx.arc(pt.x * canvasW, pt.y * canvasH, 3, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // cumulative input device tracking
      usedPointerTypes.add(e.pointerType);
      latestPressure = e.pressure > 0 ? e.pressure : 0.5;
      isDrawing = true;
      clearTimeout(chipFadeTimer);
      inputIndicator.classList.remove("seal-input-chip--fading");
      refreshInputChip();
    }, { passive: false });

    // progressive attention: every time a glyph block completes (16 samples),
    // recompute and immediately reveal its corridor + color. the user sees the
    // heatmap build up in real time as they draw.
    let lastProgressiveBlock = 0;

    function drawLiveTail() {
      if (!activeStroke || activeStroke.length < 2) return;
      // samples beyond the last completed block render at neutral
      const attBlocks = (strokeAttentions[strokes.length - 1] ?? []).length;
      const completedSamples = attBlocks * 16;
      for (let i = Math.max(1, completedSamples); i < activeStroke.length; i++) {
        paintLiveSegment(activeStroke[i - 1], activeStroke[i]);
      }
    }

    canvas.addEventListener("pointermove", (e) => {
      if (!activeStroke) return;
      e.preventDefault();
      const events: PointerEvent[] = (typeof e.getCoalescedEvents === "function")
        ? e.getCoalescedEvents()
        : [e];
      for (const ev of events) {
        const pt = featuresFor(ev);
        const prev = activeStroke[activeStroke.length - 1];
        activeStroke.push(pt);
        paintLiveSegment(prev, pt);
      }
      statEls.samples.textContent = String(totalSamples());

      // live pressure: read from the raw event, not the stored point (which has a 0.5 fallback)
      const rawP = e.pressure;
      latestPressure = rawP > 0 ? rawP : 0.5;
      if (!seenPressureVariation && activeStroke.length > 4) {
        const recent = activeStroke.slice(-4);
        const pMin = Math.min(...recent.map((p) => p.p));
        const pMax = Math.max(...recent.map((p) => p.p));
        if (pMax - pMin > 0.02) seenPressureVariation = true;
      }
      // refresh chip frequently enough that pressure feels live (~20Hz at 60Hz input)
      if (activeStroke.length % 3 === 0) refreshInputChip();

      // check if a new block just completed (every 16 samples)
      const currentBlocks = Math.floor(activeStroke.length / 16);
      if (currentBlocks > lastProgressiveBlock && activeStroke.length >= 16) {
        lastProgressiveBlock = currentBlocks;
        recomputeBlocksAndAttention();
        updateStats();
        redrawAll();
        drawLiveTail();
      }
    }, { passive: false });

    function endStroke(e: PointerEvent) {
      if (!activeStroke) return;
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      activeStroke = null;
      isDrawing = false;
      recomputeBlocksAndAttention();
      redrawAll();
      updateStats();
      scheduleChipFade();
    }
    canvas.addEventListener("pointerup", endStroke);
    canvas.addEventListener("pointercancel", endStroke);
    canvas.addEventListener("pointerleave", endStroke);

    canvasClear.addEventListener("click", () => {
      clearCanvas();
      setStatus("");
    });

    // re-rasterize on DPR / size changes (rotating device, zoom, window resize)
    const ro = new ResizeObserver(() => resizeCanvas());
    ro.observe(canvas);
    window.addEventListener("resize", resizeCanvas);

    // Chrome on Android marks touch listeners passive by default, which silently
    // ignores preventDefault and lets the page scroll mid-stroke. Explicit
    // non-passive touch handlers fix this. Must be unconditional (not gated on
    // activeStroke) because touchstart fires BEFORE pointerdown sets activeStroke.
    // The canvas is for drawing, not scrolling — blocking all touch-scroll on it
    // is the correct behavior.
    canvas.addEventListener("touchstart", (e) => e.preventDefault(), { passive: false });
    canvas.addEventListener("touchmove", (e) => e.preventDefault(), { passive: false });

    // ── file handling (via shared upload zone) ─────────────────
    // reads from the page's shared upload zone. does NOT modify any upload zone DOM.

    async function ingestFile(file: File) {
      droppedFile = file;
      const head = await file.slice(0, 4).arrayBuffer();
      droppedIsSeal = isSealBlob(new Uint8Array(head));

      if (droppedIsSeal) {
        try {
          const full = new Uint8Array(await file.arrayBuffer());
          reflectStrictnessFromContainer(readSealStrictness(full));
        } catch { /* ignore parse errors */ }
      }

      sliders.forEach((s) => { s.disabled = droppedIsSeal; });
      strips.forEach(s => {
        s.querySelector<HTMLElement>('[data-tol-track]')?.classList.toggle('seal-tol-track--disabled', droppedIsSeal);
      });
      strictnessGroup.classList.toggle("seal-region--locked", droppedIsSeal);
      strictnessNote.textContent = droppedIsSeal
        ? "read from sealed file"
        : "how closely must the signature match";
      sealBtn.disabled = droppedIsSeal;
      unsealBtn.disabled = !droppedIsSeal;
      setStatus("");
    }

    // pick up files from the shared input, only when in seal mode
    fileInput.addEventListener("change", () => {
      const page = document.getElementById("whisper-page");
      if (page?.dataset.mode !== "seal") return;
      const f = fileInput.files?.[0];
      if (f) ingestFile(f);
    });

    // ── actions ────────────────────────────────────────────────
    function setStatus(message: string, kind: "info" | "error" | "ok" = "info") {
      status.textContent = message;
      status.classList.toggle("seal-status--error", kind === "error");
      status.classList.toggle("seal-status--ok", kind === "ok");
    }

    function strokesToBuffer(src: CapturedPoint[][]): SignatureStroke[] {
      const result: SignatureStroke[] = [];
      for (const s of src) {
        if (s.length < 2) continue;
        const buf = new Int32Array((2 + s.length) * CH);
        const seed = [
          Math.round(s[0].x * 32767),
          Math.round(s[0].y * 32767),
          Math.round(s[0].p * 32767),
          Math.round(s[0].tilt * 32767),
          Math.round(s[0].azimuth * 32767),
        ];
        for (let c = 0; c < CH; c++) {
          buf[c] = seed[c];
          buf[CH + c] = seed[c];
        }
        for (let i = 0; i < s.length; i++) {
          const off = (2 + i) * CH;
          buf[off + 0] = Math.round(s[i].x * 32767);
          buf[off + 1] = Math.round(s[i].y * 32767);
          buf[off + 2] = Math.round(s[i].p * 32767);
          buf[off + 3] = Math.round(s[i].tilt * 32767);
          buf[off + 4] = Math.round(s[i].azimuth * 32767);
        }
        result.push({ points: buf });
      }
      return result;
    }

    function downloadBytes(bytes: Uint8Array, filename: string) {
      const blob = new Blob([new Uint8Array(bytes)], {
        type: "application/octet-stream",
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    sealBtn.addEventListener("click", async () => {
      if (!droppedFile || droppedIsSeal) return;
      const sigStrokes = strokesToBuffer(strokes);
      if (sigStrokes.length === 0) {
        setStatus("sign first.", "error");
        return;
      }
      try {
        setStatus("sealing…");
        sealBtn.disabled = true;
        const plaintext = new Uint8Array(await droppedFile.arrayBuffer());
        const sealed = await sealFile(plaintext, droppedFile.name, sigStrokes, readStrictness(), phraseInput?.value);
        downloadBytes(sealed, droppedFile.name + ".seal");
        const overhead = sealed.length - plaintext.length;
        setStatus(
          `sealed ${formatBytes(sealed.length)} (+${formatBytes(overhead)} overhead)`,
          "ok",
        );
      } catch (err) {
        setStatus(err instanceof Error ? err.message : String(err), "error");
      } finally {
        sealBtn.disabled = false;
      }
    });

    unsealBtn.addEventListener("click", async () => {
      if (!droppedFile || !droppedIsSeal) return;
      const sigStrokes = strokesToBuffer(strokes);
      if (sigStrokes.length === 0) {
        setStatus("sign first.", "error");
        return;
      }
      try {
        setStatus("unsealing…");
        unsealBtn.disabled = true;
        const bytes = new Uint8Array(await droppedFile.arrayBuffer());
        const result = await unsealFile(bytes, sigStrokes, phraseInput?.value);
        downloadBytes(result.plaintext, result.filename);
        setStatus(`unsealed ${result.filename} (${formatBytes(result.plaintext.length)})`, "ok");
      } catch {
        setStatus("signature or phrase didn't match. try again.", "error");
      } finally {
        unsealBtn.disabled = false;
      }
    });

    // ── match section ──────────────────────────────────────────
    const matchSection = panel.querySelector<HTMLElement>("[data-seal-match]");
    if (matchSection) {
      interface MatchSlot {
        strokes: CapturedPoint[][];
        blocks: GlyphBlock[];
        loaded: boolean;
        clear(): void;
      }

      function createMatchSlot(el: HTMLElement): MatchSlot {
        const cvs = el.querySelector<HTMLCanvasElement>("[data-match-canvas]")!;
        const info = el.querySelector<HTMLElement>("[data-match-info]")!;
        const clearBtn = el.querySelector<HTMLButtonElement>("[data-match-clear]")!;
        const fileInput = el.querySelector<HTMLInputElement>("[data-match-file]")!;
        const hint = el.querySelector<HTMLElement>("[data-match-drop-label]")!;
        const mctx = cvs.getContext("2d")!;
        let cw = cvs.clientWidth || cvs.width;
        let ch = cvs.clientHeight || cvs.height;

        const slot: MatchSlot = {
          strokes: [],
          blocks: [],
          loaded: false,
          clear() {
            slot.strokes.length = 0;
            slot.blocks = [];
            slot.loaded = false;
            active = null;
            hint.textContent = "draw or load .glyph";
            hint.hidden = false;
            fillBg();
            syncInfo();
          },
        };

        let active: CapturedPoint[] | null = null;

        function fillBg() {
          mctx.fillStyle = "rgb(6, 8, 10)";
          mctx.fillRect(0, 0, cw, ch);
        }

        function syncInfo() {
          info.textContent = `${slot.blocks.length} blk`;
        }

        function resize() {
          const rect = cvs.getBoundingClientRect();
          const dpr = window.devicePixelRatio || 1;
          const w = Math.max(1, Math.floor(rect.width));
          const h = Math.max(1, Math.floor(rect.height));
          cvs.width = w * dpr;
          cvs.height = h * dpr;
          cw = w;
          ch = h;
          mctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          redraw();
        }

        function redraw() {
          fillBg();
          if (slot.loaded) {
            mctx.fillStyle = "rgb(var(--chromatic-cyan) / 0.15)";
            mctx.font = `${Math.max(11, ch * 0.12)}px monospace`;
            mctx.textAlign = "center";
            mctx.textBaseline = "middle";
            mctx.fillText(`${slot.blocks.length} blocks from file`, cw / 2, ch / 2);
            return;
          }
          for (const s of slot.strokes) {
            if (s.length < 2) continue;
            mctx.strokeStyle = "rgba(0, 230, 230, 0.85)";
            mctx.lineWidth = 2;
            mctx.lineCap = "round";
            mctx.lineJoin = "round";
            mctx.beginPath();
            mctx.moveTo(s[0].x * cw, s[0].y * ch);
            for (let i = 1; i < s.length; i++) mctx.lineTo(s[i].x * cw, s[i].y * ch);
            mctx.stroke();
          }
        }

        function recompute() {
          if (slot.loaded) return;
          const sigs = strokesToBuffer(slot.strokes);
          slot.blocks = encodeAllBlocks(sigs);
          syncInfo();
        }

        function feat(e: PointerEvent): CapturedPoint {
          const rect = cvs.getBoundingClientRect();
          return {
            x: Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width)),
            y: Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height)),
            p: e.pressure > 0 ? e.pressure : 0.5,
            tilt: Math.min(1, Math.hypot(e.tiltX || 0, e.tiltY || 0) / 90),
            azimuth: (Math.atan2(e.tiltY || 0, e.tiltX || 0) / (Math.PI * 2)) + 0.5,
          };
        }

        cvs.addEventListener("contextmenu", (e) => e.preventDefault());
        cvs.addEventListener("touchstart", (e) => e.preventDefault(), { passive: false });
        cvs.addEventListener("touchmove", (e) => e.preventDefault(), { passive: false });

        cvs.addEventListener("pointerdown", (e) => {
          if (e.pointerType === "mouse" && e.button !== 0) return;
          if (slot.loaded) { slot.clear(); }
          e.preventDefault();
          try { cvs.setPointerCapture(e.pointerId); } catch {}
          hint.hidden = true;
          const pt = feat(e);
          active = [pt];
          slot.strokes.push(active);
        }, { passive: false });

        cvs.addEventListener("pointermove", (e) => {
          if (!active) return;
          e.preventDefault();
          const events: PointerEvent[] = typeof e.getCoalescedEvents === "function" ? e.getCoalescedEvents() : [e];
          for (const ev of events) {
            const pt = feat(ev);
            const prev = active[active.length - 1];
            active.push(pt);
            mctx.strokeStyle = "rgba(0, 230, 230, 0.85)";
            mctx.lineWidth = 2;
            mctx.lineCap = "round";
            mctx.beginPath();
            mctx.moveTo(prev.x * cw, prev.y * ch);
            mctx.lineTo(pt.x * cw, pt.y * ch);
            mctx.stroke();
          }
        }, { passive: false });

        const endStroke = () => {
          if (!active) return;
          active = null;
          recompute();
        };
        cvs.addEventListener("pointerup", endStroke);
        cvs.addEventListener("pointercancel", endStroke);

        clearBtn.addEventListener("click", () => slot.clear());

        fileInput.addEventListener("change", async () => {
          const f = fileInput.files?.[0];
          if (!f) return;
          try {
            const bytes = new Uint8Array(await f.arrayBuffer());
            slot.blocks = GlyphCodec.unpack(bytes);
            slot.strokes.length = 0;
            slot.loaded = true;
            hint.textContent = f.name;
            hint.hidden = false;
            redraw();
            syncInfo();
          } catch {
            hint.textContent = "invalid .glyph";
            hint.hidden = false;
          }
          fileInput.value = "";
        });

        const ro = new ResizeObserver(() => resize());
        ro.observe(cvs);
        resize();
        return slot;
      }

      const slotEls = matchSection.querySelectorAll<HTMLElement>("[data-match-slot]");
      const slotA = createMatchSlot(slotEls[0]);
      const slotB = createMatchSlot(slotEls[1]);

      const compareBtn = matchSection.querySelector<HTMLButtonElement>("[data-match-compare]")!;
      const resultsEl = matchSection.querySelector<HTMLElement>("[data-match-results]")!;
      const overallPct = matchSection.querySelector<HTMLElement>("[data-match-overall-pct]")!;
      const blocksViz = matchSection.querySelector<HTMLElement>("[data-match-blocks]")!;
      const overlayCvs = matchSection.querySelector<HTMLCanvasElement>("[data-match-overlay]")!;
      const overlayCtx = overlayCvs.getContext("2d")!;

      function renderOverlay(tA: Trajectory, tB: Trajectory) {
        const rect = overlayCvs.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        const w = Math.max(1, Math.floor(rect.width));
        const h = Math.max(1, Math.floor(rect.height));
        overlayCvs.width = w * dpr;
        overlayCvs.height = h * dpr;
        overlayCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        overlayCtx.fillStyle = "rgb(6, 8, 10)";
        overlayCtx.fillRect(0, 0, w, h);

        // normalize both trajectories into the same coordinate space
        function bounds(t: Trajectory) {
          let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
          for (let i = 0; i < t.n; i++) {
            if (t.x[i] < minX) minX = t.x[i];
            if (t.x[i] > maxX) maxX = t.x[i];
            if (t.y[i] < minY) minY = t.y[i];
            if (t.y[i] > maxY) maxY = t.y[i];
          }
          return { minX, maxX, minY, maxY };
        }
        const bA = bounds(tA), bB = bounds(tB);
        const minX = Math.min(bA.minX, bB.minX);
        const maxX = Math.max(bA.maxX, bB.maxX);
        const minY = Math.min(bA.minY, bB.minY);
        const maxY = Math.max(bA.maxY, bB.maxY);
        const rangeX = maxX - minX || 1;
        const rangeY = maxY - minY || 1;
        const pad = 0.08;

        function tx(v: number) { return pad * w + ((v - minX) / rangeX) * w * (1 - 2 * pad); }
        function ty(v: number) { return pad * h + ((v - minY) / rangeY) * h * (1 - 2 * pad); }

        function drawTrajectory(t: Trajectory, color: string) {
          if (t.n < 2) return;
          overlayCtx.strokeStyle = color;
          overlayCtx.lineWidth = 1.5;
          overlayCtx.lineCap = "round";
          overlayCtx.lineJoin = "round";
          overlayCtx.globalCompositeOperation = "screen";
          overlayCtx.beginPath();
          overlayCtx.moveTo(tx(t.x[0]), ty(t.y[0]));
          for (let i = 1; i < t.n; i++) overlayCtx.lineTo(tx(t.x[i]), ty(t.y[i]));
          overlayCtx.stroke();
          overlayCtx.globalCompositeOperation = "source-over";
        }

        drawTrajectory(tA, "rgba(0, 200, 220, 0.7)");
        drawTrajectory(tB, "rgba(220, 160, 40, 0.7)");
      }

      function slotTrajectory(slot: MatchSlot): Trajectory {
        if (slot.loaded) return trajectoryFromBlocks(slot.blocks);
        // drawn strokes: flatten all strokes into one trajectory
        let total = 0;
        for (const s of slot.strokes) total += s.length;
        const x = new Float32Array(total);
        const y = new Float32Array(total);
        const p = new Float32Array(total);
        let off = 0;
        for (const s of slot.strokes) {
          for (const pt of s) {
            x[off] = pt.x; y[off] = pt.y; p[off] = pt.p;
            off++;
          }
        }
        return { n: total, x, y, p };
      }

      function renderResult(l: LikenessResult) {
        resultsEl.hidden = false;
        overallPct.textContent = String(Math.round(l.overall * 100));

        for (const axis of ["shape", "speed", "pressure"] as const) {
          const bar = matchSection.querySelector<HTMLElement>(`[data-match-bar="${axis}"]`);
          const pct = matchSection.querySelector<HTMLElement>(`[data-match-axis-pct="${axis}"]`);
          if (bar) {
            bar.style.width = `${Math.round(l[axis] * 100)}%`;
            bar.toggleAttribute("data-empty", l[axis] === 0);
          }
          if (pct) pct.textContent = `${Math.round(l[axis] * 100)}%`;
        }

        // DTW path quality as a sparkline of dots
        blocksViz.innerHTML = "";
        const step = Math.max(1, Math.floor(l.perStep.length / 64));
        for (let i = 0; i < l.perStep.length; i += step) {
          const s = l.perStep[i];
          const avg = (s.shape + s.speed + s.pressure) / 3;
          const dot = document.createElement("span");
          dot.className = "seal-match-block-dot";
          dot.setAttribute("data-match-level",
            avg > 0.85 ? "full" : avg > 0.5 ? "partial" : "none"
          );
          dot.title = `shape ${(s.shape * 100).toFixed(0)}% · speed ${(s.speed * 100).toFixed(0)}% · pressure ${(s.pressure * 100).toFixed(0)}%`;
          blocksViz.appendChild(dot);
        }
      }

      compareBtn.addEventListener("click", () => {
        const hasA = slotA.strokes.length > 0 || slotA.blocks.length > 0;
        const hasB = slotB.strokes.length > 0 || slotB.blocks.length > 0;
        if (!hasA || !hasB) return;
        const tA = slotTrajectory(slotA);
        const tB = slotTrajectory(slotB);
        if (tA.n < 2 || tB.n < 2) return;
        const l = likeness(tA, tB);
        renderResult(l);
        renderOverlay(tA, tB);
      });
    }

    syncFills(false);
  }

  function formatBytes(n: number): string {
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
    return `${(n / (1024 * 1024)).toFixed(2)} MB`;
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init, { once: true });
</script>

