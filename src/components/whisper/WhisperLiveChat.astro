<!-- Phase: offering — show offer code, wait for answer -->
<div class="wl-phase" id="wl-offer-section" style="display:none">
  <p class="wl-phase-lede">
    send your offer to the other peer, then paste their reply to
    complete the handshake.
  </p>
  <div class="wl-grid wl-grid--offer">
    <div class="whisper-panel wl-card">
      <div class="whisper-panel-header">
        <h3 class="whisper-panel-title">Send</h3>
        <span class="whisper-panel-mode">offer code</span>
      </div>
      <p class="wl-inline-hint">
        share this with your peer through any channel.
      </p>
      <div class="wl-code-display-wrap">
        <pre id="wl-offer-code" class="wl-code-display"></pre>
        <button
          id="wl-offer-copy"
          type="button"
          class="whisper-mini-btn">Copy</button
        >
        <button
          id="wl-offer-share"
          type="button"
          class="whisper-mini-btn">Share</button
        >
      </div>
      <div class="wl-live-qr-toggle-row">
        <button
          id="wl-offer-qr-toggle"
          type="button"
          class="whisper-mini-btn"
          aria-expanded="false">Show QR</button
        >
      </div>
      <div
        id="wl-offer-qr-panel"
        class="wl-live-qr-wrap"
        style="display:none"
      >
        <canvas
          id="wl-offer-qr-canvas"
          class="ws-seal-qr-canvas"
          data-qr-size="132"
          aria-label="QR code for this Whisper Live offer"></canvas>
        <p
          id="wl-offer-qr-status"
          class="ws-seal-hint wl-live-qr-status"
        >
        </p>
      </div>
    </div>

    <div class="whisper-panel wl-card">
      <div class="whisper-panel-header">
        <h3 class="whisper-panel-title">Receive</h3>
        <span class="whisper-panel-mode">paste reply</span>
      </div>
      <p class="wl-inline-hint">
        paste their answer code here, then connect.
      </p>
      <div class="wl-join-row">
        <input
          id="wl-answer-input"
          type="text"
          class="whisper-input wl-code-input"
          placeholder="answer code"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="wl-answer-apply"
          type="button"
          class="whisper-mini-btn wl-primary">Connect</button
        >
      </div>
    </div>
  </div>
  <div class="wl-offer-actions">
    <button id="wl-offer-back" type="button" class="whisper-mini-btn"
      >Back</button
    >
  </div>
</div>

<!-- Phase: answering — show answer code to copy back -->
<div class="wl-phase" id="wl-answer-section" style="display:none">
  <p class="wl-phase-lede">
    send this answer code back to the creator to finish connecting.
  </p>
  <div class="whisper-panel wl-answer-only">
    <div class="whisper-panel-header">
      <h3 class="whisper-panel-title">Send back</h3>
      <span class="whisper-panel-mode">answer code</span>
    </div>
    <p class="wl-inline-hint">
      keep this tab open until the creator confirms connection.
    </p>
    <div class="wl-code-display-wrap">
      <pre id="wl-answer-code" class="wl-code-display"></pre>
      <button id="wl-answer-copy" type="button" class="whisper-mini-btn"
        >Copy</button
      >
      <button
        id="wl-answer-share"
        type="button"
        class="whisper-mini-btn">Share</button
      >
    </div>
    <div class="wl-live-qr-toggle-row">
      <button
        id="wl-answer-qr-toggle"
        type="button"
        class="whisper-mini-btn"
        aria-expanded="false">Show QR</button
      >
    </div>
    <div
      id="wl-answer-qr-panel"
      class="wl-live-qr-wrap"
      style="display:none"
    >
      <canvas
        id="wl-answer-qr-canvas"
        class="ws-seal-qr-canvas"
        data-qr-size="132"
        aria-label="QR code for this Whisper Live answer"></canvas>
      <p
        id="wl-answer-qr-status"
        class="ws-seal-hint wl-live-qr-status"
      >
      </p>
    </div>
  </div>
</div>

<!-- Phase: connecting/handshaking -->
<div class="wl-phase" id="wl-connecting-section" style="display:none">
  <div class="whisper-panel wl-connecting-panel">
    <div class="wl-spinner" aria-hidden="true"></div>
    <p id="wl-connecting-status" class="wl-connecting-text">
      establishing connection...
    </p>
  </div>
</div>

<!-- Phase: verify fingerprint -->
<div class="wl-phase" id="wl-verify-section" style="display:none">
  <div class="whisper-panel wl-verify-panel">
    <h2 class="whisper-panel-title">Security check</h2>
    <p class="whisper-field-hint">
      ask your peer: do they see the same emoji? if not, stop.
    </p>
    <p id="wl-fingerprint" class="wl-fingerprint" aria-live="polite">
    </p>
    <div class="wl-verify-actions">
      <button
        id="wl-confirm"
        type="button"
        class="whisper-mini-btn wl-confirm-btn">Match · continue</button
      >
      <button
        id="wl-reject"
        type="button"
        class="whisper-mini-btn wl-reject-btn">No match · stop</button
      >
    </div>
  </div>
</div>

<!-- Phase: live chat -->
<div
  class="wl-phase wl-phase--chat"
  id="wl-chat-section"
  style="display:none"
>
  <div class="whisper-panel wl-chat-panel">
    <div
      id="wl-chat-messages"
      class="wl-chat-messages"
      aria-live="polite"
      aria-relevant="additions"
    >
      <p class="wl-chat-empty" id="wl-chat-empty"></p>
    </div>

    <div class="wl-chat-compose">
      <div class="wl-chat-input-wrap">
        <input
          id="wl-chat-input"
          type="text"
          class="whisper-input wl-chat-text-input"
          placeholder="whisper something..."
          autocomplete="off"
          spellcheck="false"
        />
        <div class="wl-mic-wrap" id="wl-chat-mic-wrap">
          <button
            id="wl-chat-mic-cancel"
            type="button"
            class="wl-mic-split wl-mic-cancel"
            aria-label="Cancel recording"
            tabindex="-1"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M4 4l8 8M12 4l-8 8"></path>
            </svg>
          </button>
          <button
            id="wl-chat-mic-btn"
            type="button"
            class="wl-chat-mic-btn"
            aria-label="Record audio message"
            title="record audio"
            disabled
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="wl-mic-icon"
              aria-hidden="true"
            >
              <rect x="5.5" y="1.5" width="5" height="9" rx="2.5"
              ></rect>
              <path d="M3 7.5a5 5 0 0010 0"></path>
              <path d="M8 13v2"></path>
            </svg>
          </button>
          <button
            id="wl-chat-mic-send"
            type="button"
            class="wl-mic-split wl-mic-send"
            aria-label="Send recording"
            tabindex="-1"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M3 8l4 4 6-7"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="wl-media-wrap">
        <button
          id="wl-chat-media-btn"
          type="button"
          class="whisper-mini-btn wl-chat-media-btn"
          aria-label="More actions"
          title="more"
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            class="wl-media-btn-icon"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="1"/>
            <circle cx="3" cy="8" r="1"/>
            <circle cx="13" cy="8" r="1"/>
          </svg>
        </button>
        <div class="wl-media-popover" id="wl-media-popover">
          <button id="wl-media-clear" type="button" class="wl-media-option wl-media-clear"
            data-clear-state="idle" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"
              stroke-width="1.3" aria-hidden="true">
              <path d="M2 4h12M5.3 4V2.7a.7.7 0 01.7-.7h4a.7.7 0 01.7.7V4M6 7v5M10 7v5"
                stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3.5 4l.7 9.3a1.4 1.4 0 001.4 1.2h4.8a1.4 1.4 0 001.4-1.2L12.5 4"
                stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            request clear
          </button>
          <button id="wl-media-draw" type="button" class="wl-media-option">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"
              stroke-width="1.3" aria-hidden="true">
              <path d="M11.5 1.5l3 3L5 14H2v-3L11.5 1.5z"/>
            </svg>
            draw
          </button>
          <button id="wl-media-file" type="button" class="wl-media-option">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"
              stroke-width="1.3" aria-hidden="true">
              <path d="M8 2v8M4 6l4-4 4 4"></path>
              <path d="M2 10v3a1 1 0 001 1h10a1 1 0 001-1v-3"></path>
            </svg>
            file
          </button>
        </div>
        <input
          id="wl-chat-file-input"
          type="file"
          class="sr-only"
          aria-hidden="true"
        />
      </div>
      <button
        id="wl-chat-send"
        type="button"
        class="whisper-mini-btn wl-chat-send-btn">Send</button
      >
    </div>
  </div>
</div>

<!-- Phase: silent mode — show shared secret -->
<div class="wl-phase" id="wl-silent-section" style="display:none">
  <div class="whisper-panel wl-silent-panel">
    <h2 class="whisper-panel-title">Shared secret</h2>
    <p class="whisper-field-hint">
      use this as your Whisper password for solo-mode dead drops through
      any channel
    </p>
    <div class="wl-code-display-wrap">
      <pre
        id="wl-silent-secret"
        class="wl-code-display wl-secret-display">
      </pre>
      <button id="wl-silent-copy" type="button" class="whisper-mini-btn"
        >Copy</button
      >
    </div>
    <button
      id="wl-silent-disconnect"
      type="button"
      class="whisper-mini-btn wl-disconnect-btn">End session</button
    >
  </div>
</div>

<!-- Phase: disconnected -->
<div class="wl-phase" id="wl-disconnected-section" style="display:none">
  <div class="whisper-panel wl-end-panel">
    <p class="wl-end-text">no trace remains.</p>
    <button id="wl-new-session" type="button" class="whisper-mini-btn"
      >Start over</button
    >
  </div>
</div>

<!-- Phase: error -->
<div class="wl-phase" id="wl-error-section" style="display:none">
  <div class="whisper-panel wl-error-panel">
    <p id="wl-error-message" class="wl-error-text"></p>
    <button id="wl-error-retry" type="button" class="whisper-mini-btn"
      >Try again</button
    >
  </div>
</div>

<style>
  /* ── Code display (offer/answer) — shared with Campfire & Seal ── */
  :global(.wl-code-display-wrap) {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: flex-start;
  }

  :global(.wl-code-display-wrap) :global(.whisper-mini-btn) {
    min-height: auto;
    padding: 0.45rem 0.7rem;
  }

  :global(.wl-code-display) {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: calc(var(--whisper-radius) * 0.75);
    background: rgb(var(--color-text-rgb) / 0.02);
    font-family: "Cascadia Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: calc(var(--text-sm) * 0.8);
    line-height: 1.5;
    color: rgb(var(--color-text-rgb) / 0.72);
    word-break: break-all;
    white-space: pre-wrap;
    max-height: 6rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* ── Connecting spinner — shared with Campfire ─────────── */
  :global(.whisper-panel.wl-connecting-panel) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  :global(.wl-connecting-text) {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  /* ── Fingerprint verify ─────────────────────────────────── */
  .wl-verify-panel {
    display: grid;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-lg);
  }

  .wl-fingerprint {
    margin: 0;
    font-size: 3rem;
    letter-spacing: 0.3em;
    line-height: 1.4;
    user-select: none;
  }

  .wl-verify-actions {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    justify-content: center;
  }

  .wl-confirm-btn {
    background: rgb(var(--tool-status-success) / 0.1);
    border-color: rgb(var(--tool-status-success) / 0.35);
    color: rgb(var(--tool-status-success));
  }

  .wl-confirm-btn:hover {
    background: rgb(var(--tool-status-success) / 0.18);
    border-color: rgb(var(--tool-status-success) / 0.5);
    color: rgb(var(--tool-status-success));
  }

  .wl-reject-btn {
    background: rgb(var(--chromatic-red) / 0.08);
    border-color: rgb(var(--chromatic-red) / 0.3);
    color: rgb(var(--chromatic-red));
  }

  .wl-reject-btn:hover {
    background: rgb(var(--chromatic-red) / 0.14);
    border-color: rgb(var(--chromatic-red) / 0.45);
    color: rgb(var(--chromatic-red));
  }

  /* ── Fingerprint chip (status bar) ── */
  /* These elements live in the parent template (wl-head), so :global() is needed */
  :global(.wl-fp-chip) {
    display: none;
    align-items: center;
    gap: 0.4em;
    padding: calc(var(--space-xs) * 0.4) calc(var(--space-xs) * 0.8);
    border-radius: calc(var(--whisper-radius) * 0.75);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(10 10 10 / 0.6);
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }
  :global(.wl-fp-chip--verified) {
    display: inline-flex;
  }
  :global(.wl-fp-chip--recovering) {
    display: inline-flex;
  }
  :global(.wl-fp-chip):hover {
    border-color: rgb(var(--color-text-rgb) / 0.2);
    background: rgb(10 10 10 / 0.85);
  }

  /* Emoji inside chip — compact */
  :global(.wl-fp-chip-emoji) {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    line-height: 1;
    white-space: nowrap;
    filter: saturate(0.4) opacity(0.6);
    transition: filter var(--duration-normal) var(--ease-out);
  }
  :global(.wl-fp-chip--verified .wl-fp-chip-emoji) {
    filter: saturate(1) opacity(0.85);
  }
  :global(.wl-fp-chip--recovering .wl-fp-chip-emoji) {
    filter: saturate(0.2) opacity(0.4);
  }

  /* Nickname label inside chip */
  :global(.wl-fp-chip-name) {
    display: none;
    font-size: 0.78rem;
    font-weight: 500;
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--color-text-rgb) / 0.85);
  }
  :global(.wl-fp-chip--named .wl-fp-chip-emoji) {
    display: none;
  }
  :global(.wl-fp-chip--named .wl-fp-chip-name) {
    display: inline-block;
  }

  /* Nickname input — replaces the chip in place when editing */
  :global(.wl-fp-nickname-input) {
    display: none;
    width: 8rem;
    padding: calc(var(--space-xs) * 0.4) calc(var(--space-xs) * 0.8);
    border-radius: calc(var(--whisper-radius) * 0.75);
    border: 1px solid rgb(var(--color-text-rgb) / 0.2);
    background: rgb(10 10 10 / 0.6);
    font-size: 0.85rem;
    color: rgb(var(--color-text-rgb) / 0.9);
    outline: none;
    box-shadow: none;
  }
  :global(.wl-fp-nickname-input):focus {
    outline: none;
    box-shadow: none;
  }
  :global(.wl-fp-wrap--editing .wl-fp-chip) {
    display: none;
  }
  :global(.wl-fp-wrap--editing .wl-fp-nickname-input) {
    display: inline-block;
  }
  :global(.wl-fp-nickname-input)::placeholder {
    color: rgb(var(--color-text-rgb) / 0.3);
  }

  /* ── Chat — shared with Campfire ────────────────────────── */
  :global(.whisper-panel.wl-chat-panel) {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--whisper-surface-deep);
    border-top-left-radius: var(--whisper-radius);
    border-top-right-radius: var(--whisper-radius);
    border-top: 1px solid var(--whisper-edge);
  }

  :global(.whisper-op-live.wl-connected) :global(.wl-chat-panel) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow: var(--edge-highlight);
  }

  /* wl-chat-tools and wl-disconnect-btn live in parent template (wl-head) */
  :global(.wl-chat-tools) {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.45);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  :global(.wl-disconnect-btn) {
    font-size: calc(var(--text-sm) * 0.8);
    padding: 0.32rem 0.62rem;
    min-height: auto;
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.2);
    background: rgb(var(--chromatic-red) / 0.04);
  }

  :global(.wl-disconnect-btn):hover {
    color: rgb(var(--chromatic-red));
    border-color: rgb(var(--chromatic-red) / 0.4);
    background: rgb(var(--chromatic-red) / 0.06);
  }

  :global(.wl-chat-messages) {
    min-height: 16rem;
    max-height: clamp(32rem, 28rem + 12vw, 56rem);
    overflow-y: auto;
    scroll-behavior: auto;
    padding: calc(var(--space-sm) * 0.95);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-xs) * 0.42);
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      black 14px,
      black calc(100% - 14px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      black 14px,
      black calc(100% - 14px),
      transparent 100%
    );
    transition: background var(--duration-normal) var(--ease-out);
    background:
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.018) 0%,
        transparent 50%
      ),
      rgb(10 10 10 / 0.92);
  }

  /* Custom scrollbar only for pointer devices — touch keeps native overlay */
  @media (hover: hover) {
    :global(.wl-chat-messages)::-webkit-scrollbar {
      width: 4px;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-track {
      background: transparent;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-thumb {
      background: rgb(var(--color-text-rgb) / 0.12);
      border-radius: 4px;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-thumb:hover {
      background: rgb(var(--color-text-rgb) / 0.22);
    }
  }

  .wl-chat-empty {
    margin: auto 0;
    text-align: center;
    font-size: calc(var(--text-sm) * 0.78);
    color: rgb(var(--color-text-rgb) / 0.16);
    font-style: italic;
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.01em;
  }

  :global(.wl-chat-messages.wl-chat-drop-active) {
    background: rgb(var(--chromatic-cyan) / 0.05);
  }

  :global(.wl-chat-messages) :global(.wl-msg) {
    --msg-accent: var(--color-text-rgb);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    max-width: 80%;
    animation: wl-msg-in 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.wl-chat-messages) :global(.wl-msg + .wl-msg) {
    margin-top: calc(var(--space-xs) * 0.35);
  }

  :global(.wl-chat-messages) :global(.wl-msg--self) {
    align-self: flex-end;
    align-items: flex-end;
    animation-name: wl-msg-in-right;
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer) {
    --msg-accent: var(--pride-purple);
    align-self: flex-start;
    align-items: flex-start;
  }

  :global(.wl-chat-messages) :global(.wl-msg--system) {
    align-self: center;
    align-items: center;
    max-width: 90%;
    animation-name: wl-msg-in-center;
  }

  :global(.wl-chat-messages) :global(.wl-msg-text) {
    padding: 0.42rem 0.65rem;
    border-radius: calc(var(--whisper-radius) * 0.55);
    font-size: var(--text-sm);
    line-height: 1.42;
    word-break: break-word;
    white-space: pre-wrap;
    border: 1px solid rgb(var(--msg-accent) / 0.16);
    background: rgb(var(--msg-accent) / 0.06);
    color: rgb(var(--color-text-rgb) / 0.72);
  }

  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-peer-draw) {
    border-bottom-right-radius: calc(var(--whisper-radius) * 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-text) {
    transition:
      color 400ms ease-out,
      border-color 400ms ease-out;
  }

  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-peer-draw) {
    color: rgb(var(--color-text-rgb) / 0.88);
    border-color: rgb(var(--color-text-rgb) / 0.22);
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-peer-draw) {
    color: rgb(var(--msg-accent) / 0.9);
    border-bottom-left-radius: calc(var(--whisper-radius) * 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-msg-system) {
    padding: 0.2rem 0;
    font-size: calc(var(--text-sm) * 0.76);
    color: rgb(var(--color-text-rgb) / 0.32);
    text-align: center;
    border: none;
    background: none;
  }

  /* Hide timestamp on grouped messages — show only on the last in a run */
  :global(.wl-chat-messages) :global(.wl-msg--self:has(+ .wl-msg--self) .wl-msg-time),
  :global(.wl-chat-messages) :global(.wl-msg--peer:has(+ .wl-msg--peer) .wl-msg-time) {
    display: none;
  }

  /* Tighter spacing within a group */
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer) {
    margin-top: calc(var(--space-xs) * 0.1);
  }

  /* Soften corner between grouped bubbles */
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self .wl-msg-peer-draw) {
    border-top-right-radius: calc(var(--whisper-radius) * 0.2);
  }
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer .wl-msg-peer-draw) {
    border-top-left-radius: calc(var(--whisper-radius) * 0.2);
  }

  :global(.wl-chat-messages) :global(.wl-msg-time) {
    display: block;
    font-size: calc(var(--text-sm) * 0.62);
    color: rgb(var(--color-text-rgb) / 0.22);
    padding: 0 0.25rem;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    user-select: none;
  }

  /* ── Reaction shelf — hidden until message is tapped ──────── */
  /* Zero chrome at rest: invisible, collapsed, pointer events off */
  :global(.wl-chat-messages) :global(.wl-react-shelf) {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.4rem 0.2rem;
    margin-top: -0.4rem;
    margin-bottom: -0.4rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-3px);
    transition:
      max-height 200ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  /* Shelf open: slides down from under the bubble */
  :global(.wl-chat-messages) :global([data-shelf-open] .wl-react-shelf) {
    max-height: 3.4rem;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Individual emoji quick-pick + more button */
  :global(.wl-chat-messages) :global(.wl-react-btn) {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(var(--color-text-rgb) / 0.04);
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 130ms ease,
      border-color 130ms ease,
      transform 100ms ease;
    flex-shrink: 0;
  }

  :global(.wl-chat-messages) :global(.wl-react-btn:hover) {
    background: rgb(var(--color-text-rgb) / 0.1);
    border-color: rgb(var(--color-text-rgb) / 0.22);
    transform: scale(1.16);
  }

  :global(.wl-chat-messages) :global(.wl-react-btn:active) {
    transform: scale(0.88);
  }

  /* "+" more-emoji button: slightly muted */
  :global(.wl-chat-messages) :global(.wl-react-btn--more) {
    font-size: 0.75rem;
    color: rgb(var(--color-text-rgb) / 0.42);
    font-weight: 600;
    letter-spacing: 0;
  }

  :global(.wl-chat-messages) :global(.wl-react-btn--more:hover) {
    color: rgb(var(--color-text-rgb) / 0.72);
  }

  /* ── Reaction pills (placed below message after reacting) ── */
  :global(.wl-chat-messages) :global(.wl-msg-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.18rem;
    padding: 0.12rem 0.2rem 0;
  }

  :global(.wl-chat-messages) :global(.wl-reaction) {
    font-size: 0.8rem;
    padding: 0.07rem 0.32rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.04);
    cursor: pointer;
    transition:
      background 120ms ease,
      border-color 120ms ease,
      transform 80ms ease;
    line-height: 1.4;
  }

  :global(.wl-chat-messages) :global(.wl-reaction:hover) {
    background: rgb(var(--color-text-rgb) / 0.1);
    border-color: rgb(var(--color-text-rgb) / 0.22);
  }

  :global(.wl-chat-messages) :global(.wl-reaction:active) {
    transform: scale(0.9);
  }

  /* Self reaction: cyan tint */
  :global(.wl-chat-messages) :global(.wl-reaction--self) {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
    background: rgb(var(--chromatic-cyan) / 0.09);
  }

  :global(.wl-chat-messages) :global(.wl-reaction--self:hover) {
    background: rgb(var(--chromatic-cyan) / 0.16);
    border-color: rgb(var(--chromatic-cyan) / 0.5);
  }

  /* Peer reaction: purple tint */
  :global(.wl-chat-messages) :global(.wl-reaction--peer) {
    border-color: rgb(var(--pride-purple) / 0.3);
    background: rgb(var(--pride-purple) / 0.07);
  }

  /* Both self + peer: blended */
  :global(.wl-chat-messages) :global(.wl-reaction--self.wl-reaction--peer) {
    border-color: rgb(var(--chromatic-cyan) / 0.4);
    background: linear-gradient(
      90deg,
      rgb(var(--chromatic-cyan) / 0.1),
      rgb(var(--pride-purple) / 0.08)
    );
  }

  @keyframes reaction-pop {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    60% {
      transform: scale(1.22);
      opacity: 1;
    }
    80% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Applied to a pill the moment it's added to the DOM */
  :global(.wl-chat-messages) :global(.wl-reaction--entering) {
    animation: reaction-pop 280ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file) {
    display: grid;
    gap: calc(var(--space-xs) * 0.15);
    padding: 0.42rem 0.65rem;
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--msg-accent) / 0.16);
    background: rgb(var(--msg-accent) / 0.06);
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-name) {
    font-size: calc(var(--text-sm) * 0.92);
    font-weight: 600;
    color: rgb(var(--msg-accent) / 0.8);
    word-break: break-word;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-size) {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--color-text-rgb) / 0.32);
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-download) {
    font-size: calc(var(--text-sm) * 0.78);
    color: rgb(var(--msg-accent) / 0.6);
    text-decoration: none;
    width: fit-content;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-download:hover) {
    color: rgb(var(--msg-accent) / 0.85);
  }

  /* ── Audio player ─────────────────────────────────────────── */
  :global(.wl-chat-messages) :global(.wl-msg-audio) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--msg-accent) / 0.14);
    background: linear-gradient(
      135deg,
      rgb(var(--msg-accent) / 0.07) 0%,
      rgb(var(--msg-accent) / 0.03) 100%
    );
    min-width: 11rem;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  /* Subtle glow when playing */
  :global(.wl-chat-messages) :global(.wl-msg-audio[data-playing]) {
    border-color: rgb(var(--msg-accent) / 0.28);
    box-shadow: 0 0 8px rgb(var(--msg-accent) / 0.08);
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn) {
    width: 1.7rem;
    height: 1.7rem;
    min-width: 1.7rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--msg-accent) / 0.22);
    background: rgb(var(--msg-accent) / 0.08);
    color: rgb(var(--msg-accent) / 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 120ms ease;
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn:hover) {
    background: rgb(var(--msg-accent) / 0.15);
    border-color: rgb(var(--msg-accent) / 0.38);
    color: rgb(var(--msg-accent) / 0.85);
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn:active) {
    transform: scale(0.92);
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  :global(.wl-chat-messages) :global(.wl-audio-wave) {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    height: 1.8rem;
    cursor: pointer;
  }

  :global(.wl-chat-messages) :global(.wl-audio-duration) {
    font-size: calc(var(--text-sm) * 0.7);
    color: rgb(var(--msg-accent) / 0.4);
    white-space: nowrap;
    min-width: 2.2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    transition: color 300ms ease;
  }

  :global(.wl-chat-messages) :global(.wl-msg-audio[data-playing] .wl-audio-duration) {
    color: rgb(var(--msg-accent) / 0.65);
  }

  /* ── Media viewer (image / video) ──────────────────────────── */
  :global(.wl-chat-messages) :global(.wl-msg-media) {
    display: grid;
    gap: 0;
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--msg-accent) / 0.14);
    background: linear-gradient(
      135deg,
      rgb(var(--msg-accent) / 0.07) 0%,
      rgb(var(--msg-accent) / 0.03) 100%
    );
    overflow: hidden;
    max-width: min(18rem, 100%);
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  :global(.wl-chat-messages) :global(.wl-msg-peer-draw) {
    display: grid;
    gap: 0;
    border-radius: calc(var(--whisper-radius) * 0.55);
    border: 1px solid rgb(var(--msg-accent) / 0.14);
    background: linear-gradient(
      135deg,
      rgb(var(--msg-accent) / 0.07) 0%,
      rgb(var(--msg-accent) / 0.03) 100%
    );
    overflow: hidden;
    max-width: min(18rem, 100%);
    width: min(18rem, 100%);
    aspect-ratio: 4 / 3;
  }

  :global(.wl-chat-messages) :global(.wl-peer-draw-inline) {
    width: 100%;
    height: 100%;
    display: block;
    background: rgb(0 0 0 / 0.12);
  }

  :global(.wl-chat-messages) :global(.wl-peer-draw-status) {
    font-size: calc(var(--text-sm) * 0.68);
    color: rgb(var(--msg-accent) / 0.62);
    letter-spacing: 0.02em;
    padding: 0 0.25rem;
    user-select: none;
  }

  :global(.wl-chat-messages) :global(.wl-msg-glyph-actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.28rem 0.4rem 0.34rem;
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb) {
    position: relative;
    cursor: pointer;
    line-height: 0;
    overflow: hidden;
    background: rgb(var(--msg-accent) / 0.06);
    min-height: 3rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: filter 180ms ease;
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb:hover) {
    filter: brightness(1.06);
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb:active) {
    filter: brightness(0.95);
  }

  :global(.wl-chat-messages) :global(.wl-media-img),
  :global(.wl-chat-messages) :global(.wl-media-video) {
    display: block;
    width: 100%;
    max-height: 22rem;
    object-fit: contain;
    background: rgb(0 0 0 / 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-media-play-overlay) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb:hover .wl-media-play-overlay) {
    opacity: 0.85;
  }

  :global(.wl-chat-messages) :global(.wl-media-info) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.6rem;
    min-height: 2rem;
  }

  :global(.wl-chat-messages) :global(.wl-media-name) {
    flex: 1 1 0;
    min-width: 0;
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(var(--msg-accent) / 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.wl-chat-messages) :global(.wl-media-size) {
    font-size: calc(var(--text-sm) * 0.7);
    color: rgb(var(--color-text-rgb) / 0.28);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--msg-accent) / 0.22);
    background: rgb(var(--msg-accent) / 0.08);
    color: rgb(var(--msg-accent) / 0.6);
    transition:
      color 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    padding: 0.3rem;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl svg) {
    width: 100%;
    height: 100%;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl:hover) {
    color: rgb(var(--msg-accent) / 0.85);
    background: rgb(var(--msg-accent) / 0.15);
    border-color: rgb(var(--msg-accent) / 0.38);
  }

  :global(.wl-chat-messages) :global(.wl-media-dl:active) {
    transform: scale(0.92);
  }

  /* ── Lightbox overlay ──────────────────────────────────────── */
  :global(.wl-lightbox) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 180ms ease;
    touch-action: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
             env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  :global(.wl-lightbox--open) {
    opacity: 1;
  }

  :global(.wl-lightbox-inner) {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow: hidden;
  }

  :global(.wl-lightbox-img) {
    max-width: 100%;
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    object-fit: contain;
    border-radius: calc(var(--whisper-radius) * 0.55);
    box-shadow: 0 4px 32px rgb(0 0 0 / 0.4);
    user-select: none;
    -webkit-user-select: none;
    touch-action: pinch-zoom;
  }

  :global(.wl-lightbox-video) {
    max-width: 100%;
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    border-radius: calc(var(--whisper-radius) * 0.55);
    box-shadow: 0 4px 32px rgb(0 0 0 / 0.4);
    outline: none;
    touch-action: manipulation;
  }

  :global(.wl-lightbox-bar) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.08);
    max-width: calc(100vw - 2rem);
  }

  :global(.wl-lightbox-name) {
    font-size: calc(var(--text-sm) * 0.72);
    color: rgb(255 255 255 / 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1 1 0;
  }

  :global(.wl-lightbox-dl) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0.55rem;
    margin: -0.55rem;
    margin-right: -0.35rem;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.5);
    transition:
      color 200ms ease,
      background 200ms ease;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-lightbox-dl:hover) {
    color: rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.1);
  }

  :global(.wl-lightbox-dl:active) {
    transform: scale(0.92);
  }

  :global(.wl-lightbox-close) {
    position: absolute;
    top: 0.75rem;
    top: calc(0.75rem + env(safe-area-inset-top));
    right: 0.75rem;
    right: calc(0.75rem + env(safe-area-inset-right));
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.06);
    color: rgb(255 255 255 / 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 120ms ease;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-lightbox-close:hover) {
    background: rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.9);
    border-color: rgb(255 255 255 / 0.22);
  }

  :global(.wl-lightbox-close:active) {
    transform: scale(0.92);
  }

  :global(.wl-chat-compose) {
    --wl-activity: 0;
    --wl-velocity: 0;
    --wl-flow: 50%;
    --wl-send-energy: 0;
    --wl-peer-typing: 0;
    --wl-typing-pos: 0;
    position: relative;
    display: flex;
    gap: calc(var(--space-xs) * 0.4);
    align-items: stretch;
    flex-wrap: nowrap;
    padding: calc(var(--space-xs) * 0.7);
    border-top: 1px solid var(--whisper-edge);
    background:
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.02) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      rgb(10 10 10 / 0.94);
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      filter var(--duration-fast) linear;
    transform: translateZ(0);
    filter: saturate(calc(1 + (var(--wl-activity) * 0.24)));
  }

  .wl-chat-compose::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    /* Bar thickens slightly on overflow — energy has nowhere to go */
    height: calc(1px + var(--wl-send-overflow, 0) * 1px);
    pointer-events: none;
    /* On overflow the center fades — energy pools at the edges like hitting a wall.
       Edges stay full-bright while the middle hollows out. */
    --_alpha: calc(
      var(--wl-send-energy) * 0.9 + var(--wl-send-overflow, 0) * 0.1
    );
    --_hollow: calc(var(--wl-send-overflow, 0) * 0.7);
    background: linear-gradient(
      90deg,
      rgb(var(--tool-status-success) / var(--_alpha)) 0%,
      rgb(
          var(--tool-status-success) /
            calc(var(--_alpha) * (1 - var(--_hollow)))
        )
        35%,
      rgb(
          var(--tool-status-success) /
            calc(var(--_alpha) * (1 - var(--_hollow)))
        )
        65%,
      rgb(var(--tool-status-success) / var(--_alpha)) 100%
    );
    /* Clip-path: energy 0->1 fills center->edges. No overflow inset needed —
       the gradient handles the pooling visual. */
    --_base: calc(50% * (1 - var(--wl-send-energy)));
    --_shift: calc((var(--wl-energy-center, 0.5) - 0.5) * 100%);
    clip-path: inset(
      0 calc(var(--_base) - var(--_shift)) 0 calc(var(--_base) + var(--_shift))
    );
    /* Glow: velocity bloom + overflow bloom (heavy spam = bright edges) */
    box-shadow:
      0 0
        calc(
          (var(--wl-send-energy) * 4px) + (var(--wl-send-velocity, 0) * 8px) +
            (var(--wl-send-overflow, 0) * 6px)
        )
        rgb(
          var(--tool-status-success) /
            calc(var(--wl-send-energy) * 0.5 + var(--wl-send-overflow, 0) * 0.3)
        ),
      0 0
        calc(
          (var(--wl-send-energy) * 8px) + (var(--wl-send-velocity, 0) * 18px) +
            (var(--wl-send-overflow, 0) * 14px)
        )
        rgb(
          var(--tool-status-success) /
            calc(
              var(--wl-send-energy) * 0.15 + var(--wl-send-overflow, 0) * 0.12
            )
        );
  }

  .wl-chat-compose::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    opacity: var(--wl-peer-typing);
    /* Width: base * squeeze (send interaction) * width (breath/stretch/sustain).
       Blob swells at edges (pooling), stretches at center (motion blur),
       and widens subtly during sustained typing (warmth). */
    background: radial-gradient(
      ellipse
        calc(
          (12% + var(--wl-peer-typing) * 4%) * var(--wl-typing-squeeze, 1) *
            var(--wl-typing-width, 1)
        )
        100% at calc(var(--wl-typing-pos) * 100%) 50%,
      rgb(var(--pride-purple) / 0.95) 0%,
      rgb(var(--pride-purple) / calc(0.4 + var(--wl-interaction, 0) * 0.25)) 40%,
      transparent 100%
    );
    /* Glow: base + interaction boost + speed/sustain bloom.
       Fast motion = wider trail, sustained typing = warmer ambient. */
    box-shadow:
      0 0
        calc(
          var(--wl-peer-typing) *
            (
              8px + var(--wl-interaction, 0) * 4px + var(--wl-typing-glow, 0) *
                6px
            )
        )
        rgb(
          var(--pride-purple) /
            calc(
              var(--wl-peer-typing) *
                (
                  0.35 + var(--wl-interaction, 0) * 0.2 +
                    var(--wl-typing-glow, 0) * 0.15
                )
            )
        ),
      0 0
        calc(
          var(--wl-peer-typing) *
            (
              16px + var(--wl-interaction, 0) * 6px + var(--wl-typing-glow, 0) *
                10px
            )
        )
        rgb(
          var(--pride-purple) /
            calc(
              var(--wl-peer-typing) * (0.12 + var(--wl-typing-glow, 0) * 0.06)
            )
        );
  }

  .wl-chat-compose:focus-within {
    border-top-color: rgb(var(--chromatic-cyan) / 0.28);
  }

  .wl-chat-compose[data-intent="idle"] {
    border-top-color: rgb(var(--color-text-rgb) / 0.12);
    box-shadow: none;
  }

  .wl-chat-compose[data-intent="connecting"] {
    border-top-color: rgb(var(--tool-action-load) / 0.44);
    box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.18);
  }

  .wl-chat-compose[data-intent="ready"] {
    border-top-color: rgb(var(--chromatic-cyan) / 0.34);
    box-shadow: inset 0 1px 0 rgb(var(--chromatic-cyan) / 0.14);
  }

  .wl-chat-compose[data-intent="typing"] {
    border-top-color: rgb(var(--chromatic-cyan) / 0.5);
    box-shadow:
      inset 0 1px 0 rgb(var(--chromatic-cyan) / 0.18),
      0 -1px 0 rgb(var(--chromatic-cyan) / 0.22);
    background:
      linear-gradient(
        110deg,
        rgb(var(--chromatic-cyan) / calc(0.025 + (var(--wl-activity) * 0.06)))
          0%,
        rgb(var(--tool-action-load) / calc(0.02 + (var(--wl-activity) * 0.05)))
          var(--wl-flow),
        rgb(var(--chromatic-cyan) / calc(0.025 + (var(--wl-activity) * 0.06)))
          100%
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.02) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      rgb(10 10 10 / 0.94);
    background-size:
      calc(100% + (var(--wl-velocity) * 110%)) 100%,
      100% 100%,
      100% 100%;
    background-position:
      calc((var(--wl-flow) - 50%) * 0.2) 0,
      0 0,
      0 0;
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background-size 80ms linear,
      background-position 90ms linear,
      background var(--duration-normal) var(--ease-out);
  }

  .wl-chat-compose[data-intent="drop"] {
    border-top-color: rgb(var(--tool-status-success) / 0.52);
    box-shadow:
      inset 0 1px 0 rgb(var(--tool-status-success) / 0.2),
      0 -1px 0 rgb(var(--tool-status-success) / 0.24);
  }

  .wl-chat-compose[data-intent="error"] {
    border-top-color: rgb(var(--chromatic-red) / 0.58);
    animation: wl-intent-error 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) 2;
  }

  .wl-chat-input-wrap {
    flex: 1 1 0;
    position: relative;
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  :global(.whisper-input.wl-chat-text-input) {
    flex: 1;
    min-width: 0;
    width: 100%;
    min-height: auto;
    padding: 0.52rem 2.4rem 0.52rem 0.72rem;
    border-radius: calc(var(--whisper-radius) * 0.5);
    border-color: rgb(var(--color-text-rgb) / 0.14);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-mic-wrap {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 2px;
    align-items: center;
    border-radius: 9999px;
    touch-action: none;
  }

  .wl-mic-wrap[data-hidden] {
    display: none;
  }

  .wl-chat-mic-btn {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.04);
    color: rgb(var(--color-text-rgb) / 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease,
      width 200ms ease,
      opacity 200ms ease;
    touch-action: none;
  }

  .wl-chat-mic-btn:hover:not(:disabled) {
    border-color: rgb(var(--chromatic-cyan) / 0.4);
    color: rgb(var(--chromatic-cyan) / 0.7);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .wl-chat-mic-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Split buttons (cancel + send) — collapsed by default */
  .wl-mic-split {
    width: 0;
    overflow: hidden;
    opacity: 0;
    height: 1.4rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      width 200ms ease,
      opacity 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
  }

  .wl-mic-split svg {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
  }

  /* Recording state — expand split buttons, hide mic */
  .wl-mic-wrap[data-recording="true"] .wl-chat-mic-btn {
    width: 0;
    overflow: hidden;
    opacity: 0;
    border: none;
    padding: 0;
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-split {
    width: 1.4rem;
    opacity: 1;
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-cancel {
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.3);
    background: rgb(var(--chromatic-red) / 0.08);
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-cancel:hover {
    background: rgb(var(--chromatic-red) / 0.18);
    border-color: rgb(var(--chromatic-red) / 0.5);
    color: rgb(var(--chromatic-red));
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-send {
    color: rgb(var(--chromatic-cyan) / 0.7);
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-send:hover {
    background: rgb(var(--chromatic-cyan) / 0.18);
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    color: rgb(var(--chromatic-cyan));
  }

  .wl-mic-split:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Pulse on the wrapper during recording */
  .wl-mic-wrap[data-recording="true"] {
    animation: wl-mic-pulse 1.2s ease-in-out infinite;
  }

  @keyframes wl-mic-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(var(--chromatic-red) / 0.25);
    }
    50% {
      box-shadow: 0 0 0 4px rgb(var(--chromatic-red) / 0);
    }
  }

  .wl-mic-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-text-input {
    border-color: rgb(var(--tool-action-load) / 0.28);
  }

  .wl-chat-compose[data-intent="ready"] .wl-chat-text-input,
  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    transform: translateY(calc(var(--wl-activity) * -0.35px))
      scaleY(calc(1 + (var(--wl-velocity) * 0.01)));
  }

  .wl-chat-compose[data-intent="drop"] .wl-chat-text-input {
    border-color: rgb(var(--tool-status-success) / 0.38);
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-red) / 0.42);
  }

  .wl-chat-input-has-value .wl-chat-send-btn {
    opacity: 1;
  }

  :global(.whisper-mini-btn.wl-chat-send-btn) {
    flex: 0 0 auto;
    align-self: stretch;
    min-height: auto;
    padding: 0 0.8rem;
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.2) 0%,
      rgb(var(--chromatic-cyan) / 0.12) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.42);
    color: rgb(var(--chromatic-cyan));
    box-shadow: inset 0 1px 0 rgb(var(--chromatic-cyan) / 0.08);
    opacity: 0.86;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-send-btn {
    transform: translateY(calc(var(--wl-activity) * -0.6px))
      scale(calc(1 + (var(--wl-velocity) * 0.018)));
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-action-load) / 0.44);
    background: rgb(var(--tool-action-load) / 0.15);
    color: rgb(var(--tool-action-load));
  }

  .wl-chat-compose[data-intent="drop"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-status-success) / 0.5);
    background: rgb(var(--tool-status-success) / 0.14);
    color: rgb(var(--tool-status-success));
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-send-btn {
    border-color: rgb(var(--chromatic-red) / 0.5);
    background: rgb(var(--chromatic-red) / 0.12);
    color: rgb(var(--chromatic-red));
  }

  :global(.whisper-mini-btn.wl-chat-send-btn):hover {
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.24) 0%,
      rgb(var(--chromatic-cyan) / 0.15) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.5);
  }

  :global(.whisper-mini-btn.wl-chat-send-btn):active:not(:disabled) {
    transform: scale(0.96);
    background: rgb(var(--chromatic-cyan) / 0.28);
    transition-duration: 40ms;
  }

  /* ── Media button + popover ───────────────────────────────── */
  .wl-media-wrap {
    position: relative;
    flex: 0 0 auto;
    align-self: stretch;
    display: flex;
  }

  .wl-chat-media-btn {
    position: relative;
    min-height: auto;
    height: 100%;
    padding: 0 0.42rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-color: rgb(var(--color-text-rgb) / 0.18);
    transition:
      transform 120ms linear,
      border-color var(--duration-normal) var(--ease-out);
  }

  .wl-chat-media-btn:hover:not(:disabled) {
    border-color: rgb(var(--color-text-rgb) / 0.3);
  }

  .wl-chat-media-btn:active:not(:disabled) {
    transform: scale(0.94);
    transition-duration: 40ms;
  }

  :global(.wl-media-btn-icon) {
    width: 0.85rem;
    height: 0.85rem;
    display: block;
    fill: currentColor;
    stroke: none !important;
    transform: rotate(90deg);
  }

  :global(.wl-media-popover) {
    display: none;
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.3rem;
    border-radius: calc(var(--whisper-radius, 12px) * 0.65);
    background: rgb(30 30 34 / 0.96);
    border: 1px solid rgb(255 255 255 / 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.5);
    z-index: 100;
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  :global(.wl-media-popover.--open) {
    display: flex;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  :global(.wl-media-option) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border: none;
    border-radius: calc(var(--whisper-radius, 12px) * 0.45);
    background: transparent;
    color: rgb(255 255 255 / 0.7);
    font-size: calc(var(--text-sm, 0.875rem) * 0.82);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-media-option) svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  :global(.wl-media-option:hover),
  :global(.wl-media-option.--hover) {
    background: rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.95);
  }

  :global(.wl-media-option:active) {
    background: rgb(255 255 255 / 0.15);
  }

  /* ── Clear option in popover — state feedback ─────────── */
  :global(.wl-media-clear:disabled) {
    opacity: 0.35;
    pointer-events: none;
  }

  :global(.wl-media-clear[data-clear-state="pending-out"]) {
    color: rgb(255 255 255 / 0.5);
  }

  :global(.wl-media-clear[data-clear-state="pending-out"]) svg {
    animation: wl-clear-spin 2.4s linear infinite;
  }

  @keyframes wl-clear-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  :global(.wl-media-clear[data-clear-state="pending-in"]) {
    color: rgb(var(--chromatic-cyan, 0 200 255));
    background: rgb(var(--chromatic-cyan, 0 200 255) / 0.12);
  }

  :global(.wl-media-clear[data-clear-state="pending-in"]) svg {
    animation: wl-clear-icon-shake 0.85s ease-in-out infinite;
  }

  @keyframes wl-clear-icon-shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-14deg); }
    75% { transform: rotate(14deg); }
  }

  /* Notification dot on media btn when clear request is pending-in */
  :global(.wl-chat-media-btn[data-notify])::after {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--chromatic-cyan, 0 200 255));
    box-shadow: 0 0 4px rgb(var(--chromatic-cyan, 0 200 255) / 0.6);
    pointer-events: none;
  }

  /* Chat clear animation — messages fade + drift down, container flashes */
  @keyframes wl-msg-clear {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
    30% {
      opacity: 0.7;
      transform: translateY(2px) scale(0.99);
      filter: blur(0px);
    }
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
      filter: blur(3px);
    }
  }
  @keyframes wl-chat-clear-flash {
    0% {
      background-color: transparent;
    }
    18% {
      background-color: rgb(var(--chromatic-cyan) / 0.05);
    }
    100% {
      background-color: transparent;
    }
  }
  :global(.wl-chat-messages)[data-clearing] {
    animation: wl-chat-clear-flash 320ms ease-out forwards;
    pointer-events: none;
  }
  :global(.wl-chat-messages)[data-clearing] :global(.wl-msg) {
    animation: wl-msg-clear 220ms ease-in forwards;
    /* stagger: first message leads, later ones follow (capped at index 10) */
    animation-delay: calc(var(--msg-idx, 0) * 16ms);
  }

  .wl-file-icon {
    width: 1rem;
    height: 1rem;
  }

  @keyframes wl-intent-error {
    0% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-1px);
    }
    50% {
      transform: translateX(1px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Message entrance: peer slides from left, self from right, system fades */
  @keyframes wl-msg-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes wl-msg-in-right {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes wl-msg-in-center {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-spinner {
      animation: none;
    }

    .wl-chat-compose,
    .wl-chat-text-input,
    .wl-chat-send-btn,
    :global(.wl-chat-messages) :global(.wl-msg) {
      animation: none !important;
      transition-duration: 0ms !important;
      transform: none !important;
      background-size:
        100% 100%,
        100% 100%,
        100% 100% !important;
      background-position:
        0 0,
        0 0,
        0 0 !important;
    }
    .wl-chat-compose::before,
    .wl-chat-compose::after {
      display: none !important;
    }
    .wl-chat-mic-btn {
      animation: none !important;
      transition: none !important;
    }
    .wl-mic-wrap {
      animation: none !important;
    }
    .wl-mic-split {
      transition: none !important;
    }
    :global(.wl-chat-messages)[data-clearing] :global(.wl-msg) {
      animation: none !important;
      opacity: 0 !important;
    }
  }

  /* ── Silent mode ─────────────────────────────────────────── */
  .wl-silent-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-secret-display {
    font-size: calc(var(--text-sm) * 0.75);
    color: rgb(var(--chromatic-cyan));
  }

  /* ── End/Error panels — shared with Campfire ─────────────── */
  :global(.whisper-panel.wl-end-panel),
  .wl-error-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  :global(.wl-end-text) {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .wl-error-text {
    margin: 0;
    color: rgb(var(--chromatic-red));
    font-size: var(--text-sm);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-code-display-wrap {
      flex-direction: column;
    }

    .wl-code-display-wrap :global(.whisper-mini-btn) {
      width: 100%;
    }

    :global(.wl-chat-tools) {
      width: 100%;
      justify-content: stretch;
    }

    :global(.wl-disconnect-btn) {
      width: 100%;
      justify-content: center;
    }

    :global(.wl-chat-compose) {
      gap: calc(var(--space-xs) * 0.45);
    }

    .wl-fingerprint {
      font-size: 2.2rem;
      letter-spacing: 0.2em;
    }

    :global(.wl-chat-messages) {
      min-height: 12rem;
    }

    :global(.wl-chat-messages) :global(.wl-msg) {
      max-width: 90%;
