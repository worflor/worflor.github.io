<!-- Phase: offering — show offer code, wait for answer -->
<div class="wl-phase" id="wl-offer-section" style="display:none">
  <p class="wl-phase-lede">
    send your offer to the other peer, then paste their reply to complete the
    handshake.
  </p>
  <div class="wl-grid wl-grid--offer">
    <div class="whisper-panel wl-card">
      <div class="whisper-panel-header">
        <h3 class="whisper-panel-title">Send</h3>
        <span class="whisper-panel-mode">offer code</span>
      </div>
      <p class="wl-inline-hint">
        share this with your peer through any channel.
      </p>
      <div class="wl-code-display-wrap">
        <pre id="wl-offer-code" class="wl-code-display"></pre>
        <button id="wl-offer-copy" type="button" class="whisper-mini-btn"
          >Copy</button
        >
        <button id="wl-offer-share" type="button" class="whisper-mini-btn"
          >Share</button
        >
      </div>
      <div class="wl-live-qr-toggle-row">
        <button
          id="wl-offer-qr-toggle"
          type="button"
          class="whisper-mini-btn"
          aria-expanded="false">Show QR</button
        >
      </div>
      <div id="wl-offer-qr-panel" class="wl-live-qr-wrap" style="display:none">
        <canvas
          id="wl-offer-qr-canvas"
          class="ws-seal-qr-canvas"
          data-qr-size="132"
          aria-label="QR code for this Whisper Live offer"></canvas>
        <p id="wl-offer-qr-status" class="ws-seal-hint wl-live-qr-status"></p>
      </div>
    </div>

    <div class="whisper-panel wl-card">
      <div class="whisper-panel-header">
        <h3 class="whisper-panel-title">Receive</h3>
        <span class="whisper-panel-mode">paste reply</span>
      </div>
      <p class="wl-inline-hint">paste their answer code here, then connect.</p>
      <div class="wl-join-row">
        <input
          id="wl-answer-input"
          type="text"
          class="whisper-input wl-code-input"
          placeholder="answer code"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="wl-answer-apply"
          type="button"
          class="whisper-mini-btn wl-primary">Connect</button
        >
      </div>
    </div>
  </div>
  <div class="wl-offer-actions">
    <button id="wl-offer-back" type="button" class="whisper-mini-btn"
      >Back</button
    >
  </div>
</div>

<!-- Phase: answering — show answer code to copy back -->
<div class="wl-phase" id="wl-answer-section" style="display:none">
  <p class="wl-phase-lede">
    send this answer code back to the creator to finish connecting.
  </p>
  <div class="whisper-panel wl-answer-only">
    <div class="whisper-panel-header">
      <h3 class="whisper-panel-title">Send back</h3>
      <span class="whisper-panel-mode">answer code</span>
    </div>
    <p class="wl-inline-hint">
      keep this tab open until the creator confirms connection.
    </p>
    <div class="wl-code-display-wrap">
      <pre id="wl-answer-code" class="wl-code-display"></pre>
      <button id="wl-answer-copy" type="button" class="whisper-mini-btn"
        >Copy</button
      >
      <button id="wl-answer-share" type="button" class="whisper-mini-btn"
        >Share</button
      >
    </div>
    <div class="wl-live-qr-toggle-row">
      <button
        id="wl-answer-qr-toggle"
        type="button"
        class="whisper-mini-btn"
        aria-expanded="false">Show QR</button
      >
    </div>
    <div id="wl-answer-qr-panel" class="wl-live-qr-wrap" style="display:none">
      <canvas
        id="wl-answer-qr-canvas"
        class="ws-seal-qr-canvas"
        data-qr-size="132"
        aria-label="QR code for this Whisper Live answer"></canvas>
      <p id="wl-answer-qr-status" class="ws-seal-hint wl-live-qr-status"></p>
    </div>
  </div>
</div>

<!-- Phase: connecting/handshaking -->
<div class="wl-phase" id="wl-connecting-section" style="display:none">
  <div class="whisper-panel wl-connecting-panel">
    <div class="wl-spinner" aria-hidden="true"></div>
    <p id="wl-connecting-status" class="wl-connecting-text">
      establishing connection...
    </p>
  </div>
</div>

<!-- Phase: verify fingerprint -->
<div class="wl-phase" id="wl-verify-section" style="display:none">
  <div class="whisper-panel wl-verify-panel">
    <h2 class="whisper-panel-title">Security check</h2>
    <p class="whisper-field-hint">
      ask your peer: do they see the same emoji? if not, stop.
    </p>
    <p id="wl-fingerprint" class="wl-fingerprint" aria-live="polite"></p>
    <div class="wl-verify-actions">
      <button
        id="wl-confirm"
        type="button"
        class="whisper-mini-btn wl-confirm-btn">Match · continue</button
      >
      <button
        id="wl-reject"
        type="button"
        class="whisper-mini-btn wl-reject-btn">No match · stop</button
      >
    </div>
  </div>
</div>

<!-- Phase: live chat -->
<div class="wl-phase wl-phase--chat" id="wl-chat-section" style="display:none">
  <div class="whisper-panel wl-chat-panel">
    <div
      id="wl-chat-messages"
      class="wl-chat-messages"
      aria-live="polite"
      aria-relevant="additions"
    >
      <p class="wl-chat-empty" id="wl-chat-empty">
        the channel is open. only the two of you can hear it.
      </p>
    </div>

    <div class="wl-chat-compose">
      <div class="wl-chat-input-wrap">
        <input
          id="wl-chat-input"
          type="text"
          class="whisper-input wl-chat-text-input"
          placeholder="whisper something..."
          autocomplete="off"
          spellcheck="false"
        />
        <div class="wl-mic-wrap" id="wl-chat-mic-wrap">
          <button
            id="wl-chat-paste-btn"
            type="button"
            class="wl-chat-paste-btn"
            aria-label="Paste from clipboard"
            title="paste from clipboard"
            disabled
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="wl-paste-svg"
              aria-hidden="true"
            >
              <!-- board body -->
              <rect class="wl-paste-board" x="4" y="3" width="8" height="11" rx="1.2"></rect>
              <!-- clip tab -->
              <path class="wl-paste-clip" d="M6.2 1.5h3.6a.8.8 0 01.8.8V3H5.4v-.7a.8.8 0 01.8-.8z"></path>
              <!-- content lines (clipboard state) / checkmark (send state) -->
              <path class="wl-paste-glyph" d="M6.8 7L6.8 7L9.2 7M6.8 9.2L6.8 9.2L9.2 9.2" stroke-linecap="round"></path>
            </svg>
          </button>
          <button
            id="wl-chat-mic-cancel"
            type="button"
            class="wl-mic-split wl-mic-cancel"
            aria-label="Cancel recording"
            tabindex="-1"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M4 4l8 8M12 4l-8 8"></path>
            </svg>
          </button>
          <button
            id="wl-chat-mic-btn"
            type="button"
            class="wl-chat-mic-btn"
            aria-label="Record audio message"
            title="record audio"
            disabled
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="wl-mic-icon"
              aria-hidden="true"
            >
              <rect x="5.5" y="1.5" width="5" height="9" rx="2.5"></rect>
              <path d="M3 7.5a5 5 0 0010 0"></path>
              <path d="M8 13v2"></path>
            </svg>
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              class="wl-edit-cancel-icon"
              aria-hidden="true"
            >
              <path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path>
            </svg>
          </button>
          <button
            id="wl-chat-mic-send"
            type="button"
            class="wl-mic-split wl-mic-send"
            aria-label="Send recording"
            tabindex="-1"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M3 8l4 4 6-7"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="wl-media-wrap">
        <button
          id="wl-chat-media-btn"
          type="button"
          class="whisper-mini-btn wl-chat-media-btn"
          aria-label="More actions"
          title="more"
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            class="wl-media-btn-icon"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="1"></circle>
            <circle cx="3" cy="8" r="1"></circle>
            <circle cx="13" cy="8" r="1"></circle>
          </svg>
        </button>
        <div class="wl-media-popover" id="wl-media-popover">
          <button
            id="wl-media-clear"
            type="button"
            class="wl-media-option wl-media-clear"
            data-clear-state="idle"
            disabled
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              aria-hidden="true"
            >
              <path
                d="M2 4h12M5.3 4V2.7a.7.7 0 01.7-.7h4a.7.7 0 01.7.7V4M6 7v5M10 7v5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M3.5 4l.7 9.3a1.4 1.4 0 001.4 1.2h4.8a1.4 1.4 0 001.4-1.2L12.5 4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            request clear
          </button>
          <button id="wl-media-draw" type="button" class="wl-media-option">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              aria-hidden="true"
            >
              <path d="M11.5 1.5l3 3L5 14H2v-3L11.5 1.5z"></path>
            </svg>
            draw
          </button>
          <button id="wl-media-file" type="button" class="wl-media-option">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              aria-hidden="true"
            >
              <path d="M8 2v8M4 6l4-4 4 4"></path>
              <path d="M2 10v3a1 1 0 001 1h10a1 1 0 001-1v-3"></path>
            </svg>
            file
          </button>
          <div class="wl-media-divider"></div>
          <button id="wl-media-alpha" type="button" class="wl-media-option wl-media-alpha">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              class="wl-alpha-iris"
              aria-hidden="true"
            >
              <path class="wl-iris-blade wl-iris-1"/>
              <path class="wl-iris-blade wl-iris-2"/>
              <path class="wl-iris-blade wl-iris-3"/>
            </svg>
            alpha
          </button>
          <div class="wl-alpha-panel" id="wl-alpha-panel">
            <div class="wl-alpha-section" id="wl-alpha-audio-section">
              <div class="wl-alpha-label">
                <span>harmonic <button type="button" class="wl-alpha-reset" id="wl-alpha-reset" title="reset to default"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" class="wl-alpha-mic-icon" aria-hidden="true"><rect x="5.5" y="1" width="5" height="8.5" rx="2.5"/><path d="M4 8.5a4 4 0 008 0" stroke-linecap="round"/><path d="M8 12.5V15" stroke-linecap="round"/></svg></button></span>
                <span class="wl-alpha-q" id="wl-alpha-audio-q-value">24</span>
              </div>
              <div class="wl-alpha-status" id="wl-alpha-hint"></div>
              <div class="wl-alpha-orbit-wrap" id="wl-alpha-orbit-wrap">
                <svg class="wl-alpha-orbit" id="wl-alpha-orbit" viewBox="-1.1 -1.1 2.2 2.2" aria-hidden="true">
                  <defs>
                    <filter id="wl-orbit-glow" x="-50%" y="-50%" width="200%" height="200%">
                      <feGaussianBlur in="SourceGraphic" stdDeviation="0.04"/>
                    </filter>
                  </defs>
                  <path id="wl-alpha-orbit-glow" class="wl-orbit-glow" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#wl-orbit-glow)"/>
                  <path id="wl-alpha-orbit-ghost" class="wl-orbit-ghost" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
                  <path id="wl-alpha-orbit-path" class="wl-orbit-line" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
                </svg>
              </div>
              <div class="wl-alpha-track-wrap" id="wl-alpha-audio-track">
                <div class="wl-alpha-track">
                  <div class="wl-alpha-fill" id="wl-alpha-audio-fill"></div>
                </div>
                <div class="wl-alpha-thumb" id="wl-alpha-audio-thumb"></div>
              </div>
            </div>
          </div>
          <div class="wl-media-divider"></div>
          <button
            id="wl-media-voice"
            type="button"
            class="wl-media-option wl-media-option--soon"
            disabled
            title="coming soon"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4.5 2.5c-.8 0-1.5.7-1.5 1.5 0 5.5 4.5 10 10 10 .8 0 1.5-.7 1.5-1.5v-1.8c0-.4-.3-.8-.7-.9l-2.3-.6c-.3-.1-.7 0-.9.3l-.8 1c-1.5-.8-2.8-2.1-3.6-3.6l1-.8c.3-.2.4-.6.3-.9l-.6-2.3c-.1-.4-.5-.7-.9-.7H4.5z"></path>
            </svg>
            voice
          </button>
          <button
            id="wl-media-call-video"
            type="button"
            class="wl-media-option wl-media-option--soon"
            disabled
            title="coming soon"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 5a1.5 1.5 0 011.5-1.5h5A1.5 1.5 0 0110 5v6a1.5 1.5 0 01-1.5 1.5h-5A1.5 1.5 0 012 11V5z"></path>
              <path d="M10 7l3.3-2v6L10 9"></path>
            </svg>
            video
          </button>
        </div>
        <input
          id="wl-chat-file-input"
          type="file"
          multiple
          class="sr-only"
          aria-hidden="true"
        />
      </div>
      <button
        id="wl-chat-send"
        type="button"
        class="whisper-mini-btn wl-chat-send-btn">Send</button
      >
    </div>
  </div>
</div>

<!-- Phase: silent mode — show shared secret -->
<div class="wl-phase" id="wl-silent-section" style="display:none">
  <div class="whisper-panel wl-silent-panel">
    <h2 class="whisper-panel-title">Shared secret</h2>
    <p class="whisper-field-hint">
      use this as your Whisper password for solo-mode dead drops through any
      channel
    </p>
    <div class="wl-code-display-wrap">
      <pre id="wl-silent-secret" class="wl-code-display wl-secret-display">
      </pre>
      <button id="wl-silent-copy" type="button" class="whisper-mini-btn"
        >Copy</button
      >
    </div>
    <button
      id="wl-silent-disconnect"
      type="button"
      class="whisper-mini-btn wl-disconnect-btn">End session</button
    >
  </div>
</div>

<!-- Phase: disconnected -->
<div class="wl-phase" id="wl-disconnected-section" style="display:none">
  <div class="whisper-panel wl-end-panel">
    <p class="wl-end-text">no trace remains.</p>
    <button id="wl-new-session" type="button" class="whisper-mini-btn"
      >Start over</button
    >
  </div>
</div>

<!-- Phase: error -->
<div class="wl-phase" id="wl-error-section" style="display:none">
  <div class="whisper-panel wl-error-panel">
    <p id="wl-error-message" class="wl-error-text"></p>
    <button id="wl-error-retry" type="button" class="whisper-mini-btn"
      >Try again</button
    >
  </div>
</div>

<style>
  /* ── Code display (offer/answer) — shared with Campfire & Seal ── */
  :global(.wl-code-display-wrap) {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    align-items: flex-start;
  }

  :global(.wl-code-display-wrap) :global(.whisper-mini-btn) {
    min-height: auto;
    padding: var(--whisper-compact-button-padding);
  }

  :global(.wl-code-display) {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: var(--whisper-control-padding);
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    border-radius: var(--whisper-radius-soft);
    background: rgb(var(--color-text-rgb) / 0.02);
    box-shadow: var(--edge-highlight);
    font-family: var(--whisper-font-mono);
    font-size: var(--whisper-text-compact);
    line-height: 1.5;
    color: rgb(var(--chromatic-cyan) / 0.65);
    word-break: break-all;
    white-space: pre-wrap;
    max-height: 6rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* ── Connecting spinner — shared with Campfire ─────────── */
  :global(.whisper-panel.wl-connecting-panel) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  :global(.wl-connecting-text) {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  /* chromatic ring: cyan leading arc (base spinner) + red trailing echo,
     scoped to this phase only so the shared .wl-spinner elsewhere is untouched */
  #wl-connecting-section .wl-spinner {
    position: relative;
    border-top-color: rgb(var(--chromatic-cyan) / 0.85);
  }

  #wl-connecting-section .wl-spinner::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-bottom-color: rgb(var(--chromatic-red) / 0.4);
    border-radius: var(--radius-full);
    animation: wl-connecting-spin 0.8s linear infinite;
    animation-delay: -0.15s;
  }

  @keyframes wl-connecting-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Fingerprint verify ─────────────────────────────────── */
  .wl-verify-panel {
    display: grid;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-lg);
    animation: wl-verify-glow 6s ease-in-out infinite;
  }

  /* sacred-moment breathing: very slow, very faint cyan glow around the check */
  @keyframes wl-verify-glow {
    0%, 100% {
      box-shadow: var(--edge-highlight), 0 0 22px rgb(var(--chromatic-cyan) / 0.04);
    }
    50% {
      box-shadow: var(--edge-highlight), 0 0 30px rgb(var(--chromatic-cyan) / 0.09);
    }
  }

  .wl-fingerprint {
    margin: 0;
    font-size: var(--text-3xl);
    letter-spacing: 0.3em;
    line-height: 1.4;
    user-select: none;
  }

  /* each emoji glyph is wrapped in a span by handleFingerprint() so it can stagger in */
  :global(.wl-fingerprint-glyph) {
    display: inline-block;
    opacity: 0;
    transform: scale(0.6);
    animation: wl-fingerprint-in var(--duration-slow) var(--ease-spring) forwards;
  }
  :global(.wl-fingerprint-glyph:nth-child(1)) {
    animation-delay: 0ms;
  }
  :global(.wl-fingerprint-glyph:nth-child(2)) {
    animation-delay: 70ms;
  }
  :global(.wl-fingerprint-glyph:nth-child(3)) {
    animation-delay: 140ms;
  }
  :global(.wl-fingerprint-glyph:nth-child(4)) {
    animation-delay: 210ms;
  }

  @keyframes wl-fingerprint-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .wl-verify-actions {
    display: flex;
    gap: calc(var(--space-xs) * 0.5);
    justify-content: center;
  }

  .wl-confirm-btn {
    background: rgb(var(--tool-status-success) / 0.1);
    border-color: rgb(var(--tool-status-success) / 0.35);
    color: rgb(var(--tool-status-success));
  }

  .wl-confirm-btn:hover {
    background: rgb(var(--tool-status-success) / 0.18);
    border-color: rgb(var(--tool-status-success) / 0.5);
    color: rgb(var(--tool-status-success));
  }

  .wl-reject-btn {
    background: rgb(var(--chromatic-red) / 0.08);
    border-color: rgb(var(--chromatic-red) / 0.3);
    color: rgb(var(--chromatic-red));
  }

  .wl-reject-btn:hover {
    background: rgb(var(--chromatic-red) / 0.14);
    border-color: rgb(var(--chromatic-red) / 0.45);
    color: rgb(var(--chromatic-red));
  }

  /* ── Fingerprint chip (status bar) ── */
  /* These elements live in the parent template (wl-head), so :global() is needed */
  :global(.wl-fp-chip) {
    display: none;
    align-items: center;
    gap: 0.4em;
    padding: calc(var(--space-xs) * 0.4) calc(var(--space-xs) * 0.8);
    border-radius: var(--whisper-radius-soft);
    border: 1px solid rgb(var(--color-text-rgb) / 0.1);
    background: rgb(10 10 10 / 0.6);
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }
  :global(.wl-fp-chip--verified) {
    display: inline-flex;
  }
  :global(.wl-fp-chip--recovering) {
    display: inline-flex;
  }
  :global(.wl-fp-chip):hover {
    border-color: rgb(var(--color-text-rgb) / 0.2);
    background: rgb(10 10 10 / 0.85);
  }

  /* Emoji inside chip — compact */
  :global(.wl-fp-chip-emoji) {
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    line-height: 1;
    white-space: nowrap;
    filter: saturate(0.4) opacity(0.6);
    transition: filter var(--duration-normal) var(--ease-out);
  }
  :global(.wl-fp-chip--verified .wl-fp-chip-emoji) {
    filter: saturate(1) opacity(0.85);
