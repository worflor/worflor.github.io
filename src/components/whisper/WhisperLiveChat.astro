  /* Nickname label inside chip */
  :global(.wl-fp-chip-name) {
    display: none;
    font-size: calc(var(--text-sm) * 0.9);
    font-weight: 500;
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--color-text-rgb) / 0.85);
  }
  :global(.wl-fp-chip--named .wl-fp-chip-emoji) {
    display: none;
  }
  :global(.wl-fp-chip--named .wl-fp-chip-name) {
    display: inline-block;
  }

  /* Nickname input — replaces the chip in place when editing */
  :global(.wl-fp-nickname-input) {
    display: none;
    width: 8rem;
    padding: calc(var(--space-xs) * 0.4) calc(var(--space-xs) * 0.8);
    border-radius: var(--whisper-radius-soft);
    border: 1px solid rgb(var(--color-text-rgb) / 0.2);
    background: rgb(10 10 10 / 0.6);
    font-size: var(--text-ui-sm);
    color: rgb(var(--color-text-rgb) / 0.9);
    outline: none;
    box-shadow: none;
  }
  :global(.wl-fp-nickname-input):focus {
    outline: none;
    box-shadow: none;
  }
  :global(.wl-fp-wrap--editing .wl-fp-chip) {
    display: none;
  }
  :global(.wl-fp-wrap--editing .wl-fp-nickname-input) {
    display: inline-block;
  }
  :global(.wl-fp-nickname-input)::placeholder {
    color: rgb(var(--color-text-rgb) / 0.3);
  }

  /* ── Chat — shared with Campfire ────────────────────────── */
  :global(.whisper-panel.wl-chat-panel) {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
    background: var(--whisper-surface);
    border-top-left-radius: var(--whisper-radius);
    border-top-right-radius: var(--whisper-radius);
    border-top: 1px solid var(--whisper-edge);
    box-shadow:
      var(--edge-highlight),
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.02);
  }

  :global(.whisper-op-live.wl-connected) :global(.wl-chat-panel) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top-color: rgb(var(--color-text-rgb) / 0.08);
    box-shadow:
      var(--edge-highlight),
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.018);
  }

  /* wl-chat-tools and wl-disconnect-btn live in parent template (wl-head) */
  :global(.wl-chat-tools) {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-xs) * 0.45);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  :global(.wl-disconnect-btn) {
    font-size: var(--whisper-text-compact);
    padding: 0.32rem 0.62rem;
    min-height: auto;
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.2);
    background: rgb(var(--chromatic-red) / 0.04);
  }

  :global(.wl-disconnect-btn):hover {
    color: rgb(var(--chromatic-red));
    border-color: rgb(var(--chromatic-red) / 0.4);
    background: rgb(var(--chromatic-red) / 0.06);
  }

  :global(.wl-chat-messages) {
    /* offsetParent anchor for the shared reaction shelf (see .wl-react-shelf
       below) — message divs and the shelf are direct children, so this is
       the coordinate space live-ui.ts positions the shelf in. */
    position: relative;
    /* compact floor: the chat starts at roughly half its full height and
       earns the rest as messages arrive, growing naturally until the max,
       then scrolling. a tall empty void reads as abandoned; a half-set room
       reads as waiting. */
    min-height: 16rem;
    max-height: clamp(32rem, 28rem + 12vw, 56rem);
    overflow-y: auto;
    /* the shelf clamps itself to stay within bounds horizontally; this is
       just a backstop so it (or anything else) can never force a horizontal
       scrollbar on the whole message list. */
    overflow-x: hidden;
    scroll-behavior: auto;
    padding: calc(var(--space-sm) * 0.92);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-xs) * 0.48);
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      black 14px,
      black calc(100% - 14px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      black 14px,
      black calc(100% - 14px),
      transparent 100%
    );
    transition: background var(--duration-normal) var(--ease-out);
    background: rgb(10 10 10 / 0.86);
    -webkit-user-select: none;
    user-select: none;
  }

  /* Custom scrollbar only for pointer devices — touch keeps native overlay */
  @media (hover: hover) {
    :global(.wl-chat-messages)::-webkit-scrollbar {
      width: 4px;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-track {
      background: transparent;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-thumb {
      background: rgb(var(--color-text-rgb) / 0.12);
      border-radius: 4px;
    }
    :global(.wl-chat-messages)::-webkit-scrollbar-thumb:hover {
      background: rgb(var(--color-text-rgb) / 0.22);
    }
  }

  .wl-chat-empty {
    margin: auto 0;
    text-align: center;
    font-size: var(--whisper-text-compact);
    color: rgb(var(--color-text-rgb) / 0.22);
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.06em;
    animation: wl-empty-in 1.2s var(--ease-out) both;
  }

  @keyframes wl-empty-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-chat-empty {
      animation: none;
    }
  }

  :global(.wl-chat-messages.wl-chat-drop-active) {
    background: rgb(var(--chromatic-cyan) / 0.05);
  }

  :global(.wl-chat-messages) :global(.wl-msg) {
    --msg-accent: var(--color-text-rgb);
    --msg-bg: rgb(var(--color-text-rgb) / 0.04);
    --msg-border: rgb(var(--color-text-rgb) / 0.12);
    --msg-text-color: rgb(var(--color-text-rgb) / 0.82);
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    max-width: 80%;
    animation: wl-msg-in 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.wl-chat-messages) :global(.wl-msg + .wl-msg) {
    margin-top: calc(var(--space-xs) * 0.35);
  }

  :global(.wl-chat-messages) :global(.wl-msg--self) {
    --msg-accent: var(--chromatic-cyan);
    --msg-bg: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.12) 0%,
      rgb(var(--chromatic-cyan) / 0.075) 100%
    );
    --msg-border: rgb(var(--chromatic-cyan) / 0.2);
    --msg-text-color: rgb(var(--color-text-rgb) / 0.88);
    align-self: flex-end;
    align-items: flex-end;
    animation-name: wl-msg-in-right;
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer) {
    --msg-accent: var(--ring-base);
    --msg-bg: linear-gradient(
      180deg,
      rgb(var(--ring-base) / 0.12) 0%,
      rgb(var(--ring-base) / 0.075) 100%
    );
    --msg-border: rgb(var(--ring-base) / 0.2);
    --msg-text-color: rgb(var(--color-text-rgb) / 0.88);
    align-self: flex-start;
    align-items: flex-start;
  }

  :global(.wl-chat-messages) :global(.wl-msg--system) {
    align-self: center;
    align-items: center;
    max-width: 90%;
    animation-name: wl-msg-in-center;
  }

  :global(.wl-chat-messages) :global(.wl-msg-text) {
    padding: var(--whisper-bubble-padding);
    border-radius: var(--whisper-radius-bubble);
    font-size: var(--text-sm);
    line-height: 1.48;
    word-break: break-word;
    white-space: pre-wrap;
    border: 1px solid var(--msg-border);
    background: var(--msg-bg);
    color: var(--msg-text-color);
    box-shadow: inset 0 1px 0 rgb(var(--color-text-rgb) / 0.018);
    will-change: transform, filter, background-color, box-shadow;
    touch-action: manipulation;
    -webkit-user-select: text;
    user-select: text;
  }

  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-peer-draw) {
    border-bottom-right-radius: calc(var(--whisper-radius) * 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-msg .wl-msg-text) {
    transition:
      transform 120ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 120ms ease-out,
      background 120ms ease-out,
      border-color 160ms ease-out,
      box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    :global(.wl-chat-messages) :global(.wl-msg-text:hover) {
      border-color: rgb(var(--msg-accent) / 0.24);
      filter: brightness(1.04);
    }
  }

  :global(.wl-chat-messages) :global(.wl-msg--self .wl-msg-text) {
    transition:
      color 400ms ease-out,
      border-color 400ms ease-out;
  }

  :global(.wl-msg-edited) {
    font-size: var(--whisper-text-micro);
    color: rgb(var(--color-text-rgb) / 0.25);
    margin-left: 0.4em;
    font-style: italic;
    user-select: none;
  }

  :global(.wl-msg--editing) {
    outline: 1px solid rgb(var(--chromatic-cyan) / 0.25);
    outline-offset: 1px;
  }

  :global(.wl-edit-cancel-icon) {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-mic-icon) {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-edit-cancel-icon) {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-chat-mic-btn) {
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.3);
    background: rgb(var(--chromatic-red) / 0.08);
    opacity: 1 !important;
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-chat-mic-btn:hover) {
    color: rgb(var(--chromatic-red));
    border-color: rgb(var(--chromatic-red) / 0.5);
    background: rgb(var(--chromatic-red) / 0.18);
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-chat-paste-btn) {
    display: none;
  }

  :global(.wl-chat-compose[data-editing]) :global(.wl-chat-text-input)::placeholder {
    color: rgb(var(--color-text-rgb) / 0.35);
  }

  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--delivered .wl-msg-peer-draw) {
    color: rgb(var(--color-text-rgb) / 0.88);
    border-color: rgb(var(--msg-accent) / 0.22);
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-text),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-file),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-audio),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-media),
  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-msg-peer-draw) {
    color: rgb(var(--color-text-rgb) / 0.82);
    border-bottom-left-radius: calc(var(--whisper-radius) * 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-msg-system) {
    padding: 0.28rem 0.7rem;
    font-size: var(--whisper-text-micro);
    color: rgb(var(--color-text-rgb) / 0.34);
    text-align: center;
    border: 1px solid rgb(var(--color-text-rgb) / 0.08);
    border-radius: 999px;
    background: rgb(var(--color-text-rgb) / 0.02);
  }

  /* Hide timestamp on grouped messages — show only on the last in a run */
  :global(.wl-chat-messages)
    :global(.wl-msg--self:has(+ .wl-msg--self) .wl-msg-time),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer:has(+ .wl-msg--peer) .wl-msg-time) {
    display: none;
  }

  /* Tighter spacing within a group */
  :global(.wl-chat-messages) :global(.wl-msg--self + .wl-msg--self),
  :global(.wl-chat-messages) :global(.wl-msg--peer + .wl-msg--peer) {
    margin-top: calc(var(--space-xs) * 0.1);
  }

  /* Soften corner between grouped bubbles */
  :global(.wl-chat-messages)
    :global(.wl-msg--self + .wl-msg--self .wl-msg-text),
  :global(.wl-chat-messages)
    :global(.wl-msg--self + .wl-msg--self .wl-msg-file),
  :global(.wl-chat-messages)
    :global(.wl-msg--self + .wl-msg--self .wl-msg-audio),
  :global(.wl-chat-messages)
    :global(.wl-msg--self + .wl-msg--self .wl-msg-media),
  :global(.wl-chat-messages)
    :global(.wl-msg--self + .wl-msg--self .wl-msg-peer-draw) {
    border-top-right-radius: calc(var(--whisper-radius) * 0.2);
  }
  :global(.wl-chat-messages)
    :global(.wl-msg--peer + .wl-msg--peer .wl-msg-text),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer + .wl-msg--peer .wl-msg-file),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer + .wl-msg--peer .wl-msg-audio),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer + .wl-msg--peer .wl-msg-media),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer + .wl-msg--peer .wl-msg-peer-draw) {
    border-top-left-radius: calc(var(--whisper-radius) * 0.2);
  }

  :global(.wl-chat-messages) :global(.wl-msg-time) {
    display: block;
    font-size: var(--whisper-text-hairline);
    color: rgb(var(--color-text-rgb) / 0.24);
    padding: 0 0.3rem;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    user-select: none;
  }

  /* ── Delivery receipt dot — sits inline right after the timestamp ── */
  /* sent: hollow ring. delivered: filled, dim. seen: filled cyan, soft pop. */
  :global(.wl-msg-receipt) {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-left: 0.32em;
    vertical-align: middle;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.3);
    background: transparent;
    transition: background 200ms ease, border-color 200ms ease;
  }

  :global(.wl-msg--delivered) :global(.wl-msg-receipt) {
    border-color: transparent;
    background: rgb(var(--color-text-rgb) / 0.32);
  }

  /* seen: the dot yields to the timestamp itself. the time glyphs arrive
     split apart in cyan and red and converge into focus, settling as a
     whisper-faint chromatic split. the metaphor is literal: seen means
     brought into focus by the other pair of eyes. */
  :global(.wl-msg--seen) :global(.wl-msg-receipt) {
    border-color: transparent;
    background: transparent;
    width: 0;
    margin-left: 0;
    transition: width 300ms var(--ease-out), margin-left 300ms var(--ease-out), background 200ms ease;
  }

  :global(.wl-msg--seen) :global(.wl-msg-time-text) {
    color: rgb(var(--color-text-rgb) / 0.68);
    text-shadow:
      -0.75px 0 rgb(var(--chromatic-cyan) / 0.34),
      0.75px 0 rgb(var(--chromatic-red) / 0.26);
    animation: wl-seen-focus 640ms var(--ease-spring) 1;
  }

  @keyframes wl-seen-focus {
    0% {
      text-shadow:
        -2.5px 0 rgb(var(--chromatic-cyan) / 0.6),
        2.5px 0 rgb(var(--chromatic-red) / 0.5);
      opacity: 0.35;
    }
    55% {
      text-shadow:
        -1px 0 rgb(var(--chromatic-cyan) / 0.4),
        1px 0 rgb(var(--chromatic-red) / 0.3);
      opacity: 1;
    }
    100% {
      text-shadow:
        -0.75px 0 rgb(var(--chromatic-cyan) / 0.34),
        0.75px 0 rgb(var(--chromatic-red) / 0.26);
    }
  }

  /* hovering a seen bubble makes its edge glisten: the same split, worn
     as a ring. flares wide on arrival, then holds a quiet split. */
  :global(.wl-msg--seen) :global(.wl-msg-text),
  :global(.wl-msg--seen) :global(.wl-msg-file) {
    position: relative;
  }

  :global(.wl-msg--seen) :global(.wl-msg-text)::after,
  :global(.wl-msg--seen) :global(.wl-msg-file)::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      -1.5px 0 0 rgb(var(--chromatic-cyan) / 0.4),
      1.5px 0 0 rgb(var(--chromatic-red) / 0.3);
    transition: opacity 260ms var(--ease-out);
  }

  :global(.wl-msg--seen) :global(.wl-msg-text:hover)::after,
  :global(.wl-msg--seen) :global(.wl-msg-file:hover)::after {
    opacity: 1;
    animation: wl-edge-glisten 800ms var(--ease-out) 1;
  }

  @keyframes wl-edge-glisten {
    0% {
      box-shadow:
        -3px 0 0 rgb(var(--chromatic-cyan) / 0.55),
        3px 0 0 rgb(var(--chromatic-red) / 0.45);
    }
    100% {
      box-shadow:
        -1.5px 0 0 rgb(var(--chromatic-cyan) / 0.4),
        1.5px 0 0 rgb(var(--chromatic-red) / 0.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.wl-msg--seen) :global(.wl-msg-time-text),
    :global(.wl-msg--seen) :global(.wl-msg-text:hover)::after,
    :global(.wl-msg--seen) :global(.wl-msg-file:hover)::after {
      animation: none;
    }
  }

  @keyframes wl-receipt-pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.9); }
    100% { transform: scale(1); }
  }

  /* ── Reaction shelf — ONE shared instance for the whole chat ──────
   * Absolutely positioned inside #wl-chat-messages (position:relative,
   * see above) and anchored to whichever bubble was tapped; live-ui.ts
   * sets top/left/transform-origin per open. Being out of flow means
   * opening it never pushes later messages down and needs no negative
   * margins to hug the bubble.
   *
   * Fixed geometry: the shelf stacks two rows — the button row and the
   * status caption below it — and its whole box is measured exactly once,
   * at open (see positionReactionShelf in live-ui.ts). Nothing inside ever
   * changes that measurement again. The button row (.wl-shelf-row) never
   * wraps; the ⋮ actions and the mark composer both open as absolutely
   * positioned overlays *on top of* the row instead of growing it, so
   * nothing the user is about to tap can move underneath them.
   * Zero footprint at rest: transparent, unscaled, no pointer events. */
  :global(.wl-chat-messages) :global(.wl-react-shelf) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.26rem;
    padding: 0.36rem 0.5rem 0.32rem;
    max-width: min(88vw, 22rem);
    border-radius: var(--whisper-radius-medium);
    background: rgb(10 10 10 / 0.92);
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 18px 30px -24px rgb(0 0 0 / 0.92),
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.02);
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* The transition lives only on this modifier, not the base rule, so
     opening springs in (transition value is picked up on the same recalc
     that changes opacity/transform) but removing the class — closing —
     reverts with no transition at all: instant, per spec. */
  :global(.wl-chat-messages) :global(.wl-react-shelf--open) {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    transition:
      opacity var(--duration-fast) var(--ease-spring),
      transform var(--duration-fast) var(--ease-spring);
  }

  /* Quick-pick buttons stagger in. Capped at 5 (4 hardcoded + 1 deduped
     last-used), trimmed to 3 on narrow viewports — see quickPickLimit()
     in live-ui.ts. quickpicksWrap holds nothing else, so this can target
     every child directly. */
  :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn) {
    animation: wl-react-pick-in var(--duration-fast) var(--ease-spring) both;
  }
  :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn:nth-child(2)) { animation-delay: 20ms; }
  :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn:nth-child(3)) { animation-delay: 40ms; }
  :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn:nth-child(4)) { animation-delay: 60ms; }
  :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn:nth-child(5)) { animation-delay: 80ms; }

  @keyframes wl-react-pick-in {
    from { opacity: 0; transform: translateY(4px) scale(0.85); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.wl-chat-messages) :global(.wl-react-shelf--open) {
      transition: opacity var(--duration-fast) linear;
      transform: scale(1) !important;
    }
    :global(.wl-chat-messages) :global(.wl-react-shelf--open .wl-shelf-quickpicks > .wl-react-btn) {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Reject pulse — brief shake/dim when a reaction is capped (mirrors ws-reject-pulse) */
  @keyframes wl-react-shelf-capped {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-3px); }
    40% { transform: translateX(3px); }
    60% { transform: translateX(-2px); }
    80% { transform: translateX(2px); }
  }

  :global(.wl-chat-messages) :global(.wl-react-shelf--capped) {
    animation: wl-react-shelf-capped 280ms ease-out;
  }

  /* ── The one fixed row: quick-picks, mark button, ⋮ toggle ──────
     Never wraps — this is the whole point of the rebuild. position:relative
     so the action/composer overlays below can lay themselves over it via
     inset:0 without influencing its size (position:absolute descendants
     are excluded from flex layout entirely). */
  :global(.wl-chat-messages) :global(.wl-shelf-row) {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.22rem;
  }

  /* Quick-pick buttons as a dimmable unit, independent of the mark/⋮
     buttons beside them (see the [data-actions-open]/[data-glyph-open]
     dim rules further down). */
  :global(.wl-chat-messages) :global(.wl-shelf-quickpicks) {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.22rem;
    transition: opacity var(--duration-fast) ease;
  }

  /* Individual emoji quick-pick + more button */
  :global(.wl-chat-messages) :global(.wl-react-btn) {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.03);
    font-size: var(--text-ui-base);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 130ms ease,
      border-color 130ms ease,
      transform 100ms ease;
    flex-shrink: 0;
  }

  :global(.wl-chat-messages) :global(.wl-react-btn:hover) {
    background: rgb(var(--color-text-rgb) / 0.07);
    border-color: rgb(var(--color-text-rgb) / 0.22);
    transform: scale(1.16);
  }

  :global(.wl-chat-messages) :global(.wl-react-btn:active) {
    transform: scale(0.88);
  }

  /* "+" more-emoji button: slightly muted */
  :global(.wl-chat-messages) :global(.wl-react-btn--more) {
    font-size: calc(var(--text-sm) * 0.9);
    color: rgb(var(--color-text-rgb) / 0.42);
    font-weight: 600;
    letter-spacing: 0;
  }

  :global(.wl-chat-messages) :global(.wl-react-btn--more:hover) {
    color: rgb(var(--color-text-rgb) / 0.72);
  }

  /* ⋮ toggle — same look as .wl-react-btn--more, but a permanent row item
     now: it never collapses or resizes, it just rotates to signal "close"
     while its overlay is open (see [aria-expanded="true"] below). */
  :global(.wl-chat-messages) :global(.wl-action-btn-toggle) {
    color: rgb(var(--color-text-rgb) / 0.42);
    transition:
      color 150ms ease,
      background 130ms ease,
      border-color 130ms ease,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  :global(.wl-chat-messages) :global(.wl-action-btn-toggle[aria-expanded="true"]) {
    transform: rotate(90deg);
    color: rgb(var(--color-text-rgb) / 0.72);
  }

  /* SVG inside toggle fades + scales so icon swaps feel fluid */
  :global(.wl-chat-messages) :global(.wl-action-btn-toggle svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: opacity 110ms ease, transform 110ms ease;
    transform-origin: center;
  }
  :global(.wl-chat-messages) :global(.wl-action-btn-toggle.wl-toggle--swapping svg) {
    opacity: 0;
    transform: scale(0.55);
  }

  :global(.wl-chat-messages) :global(.wl-action-btn-toggle:hover) {
    color: rgb(var(--color-text-rgb) / 0.72);
  }

  /* When editing, the toggle becomes the edit icon and stays highlighted red */
  :global(.wl-chat-messages) :global(.wl-action-btn-toggle.wl-toggle--is-editing) {
    color: rgb(var(--chromatic-red) / 0.9);
    background: rgb(var(--chromatic-red) / 0.15);
    border-color: rgb(var(--chromatic-red) / 0.4);
  }

  /* Toggle: ✓ flash after copy */
  :global(.wl-chat-messages) :global(.wl-action-btn-toggle[data-copied]) {
    color: rgb(var(--chromatic-cyan));
    background: rgb(var(--chromatic-cyan) / 0.12);
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    transform: scale(1.1);
  }

  /* ── Overlay panels — shared base for the ⋮ actions and the mark
     composer's input. Both sit *inside* the row (inset relative to
     .wl-shelf-row, which is position:relative), so opening either one
     never changes the shelf's outer geometry — only transform+opacity
     animate. Background mirrors the shelf's own treatment, one notch
     lighter, with a lighter blur (not stacking a second heavy blur). ──── */
  :global(.wl-chat-messages) :global(.wl-shelf-overlay) {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: calc(var(--whisper-radius-medium) - 2px);
    background: rgb(10 10 10 / 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transform: translateX(6px);
    transform-origin: right center;
    transition:
      opacity var(--duration-fast) var(--ease-spring),
      transform var(--duration-fast) var(--ease-spring);
  }

  /* Actions panel: anchored right, but stops short of the ⋮ toggle's own
     box so it stays visibly on top and clickable throughout — "leaving
     the toggle in place" means literally never covering it. */
  :global(.wl-chat-messages) :global(.wl-shelf-overlay--actions) {
    left: 0;
    right: calc(1.85rem + 0.22rem);
    justify-content: flex-end;
    padding-right: 0.1rem;
  }

  :global(.wl-chat-messages) :global(.wl-react-action-container[data-expanded]) {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  /* Mark composer's input: full row width — it needs the room to type in,
     and closes via Escape/outside-tap/commit rather than by re-tapping
     the mark button (which the overlay legitimately covers). */
  :global(.wl-chat-messages) :global(.wl-shelf-overlay--mark) {
    left: 0;
    right: 0;
    padding: 0 0.4rem;
  }

  :global(.wl-chat-messages) :global(.wl-react-shelf[data-glyph-open] .wl-shelf-overlay--mark) {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  /* Row beneath an open overlay dims rather than disappears — a scrim, not
     a swap. Each overlay dims the quick-picks plus whichever of mark/⋮
     isn't the one currently driving it. */
  :global(.wl-chat-messages) :global(.wl-react-shelf[data-actions-open] .wl-shelf-quickpicks),
  :global(.wl-chat-messages) :global(.wl-react-shelf[data-actions-open] .wl-react-btn--custom) {
    opacity: 0.25;
    pointer-events: none;
  }

  /* mark drawer: the row beneath fades to almost nothing — a half-visible
     toggle behind the input reads as a phantom misaligned button. */
  :global(.wl-chat-messages) :global(.wl-react-shelf[data-glyph-open] .wl-shelf-quickpicks),
  :global(.wl-chat-messages) :global(.wl-react-shelf[data-glyph-open] .wl-react-btn--custom),
  :global(.wl-chat-messages) :global(.wl-react-shelf[data-glyph-open] .wl-action-btn-toggle) {
    opacity: 0.08;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.wl-chat-messages) :global(.wl-shelf-overlay) {
      transition: opacity var(--duration-fast) linear;
      transform: none !important;
    }
    :global(.wl-chat-messages) :global(.wl-action-btn-toggle[aria-expanded="true"]) {
      transition: color 150ms ease;
    }
  }

  /* Copy/edit buttons — fixed size always; visibility comes entirely from
     the overlay's own opacity/transform, not a per-button width transition. */
  :global(.wl-chat-messages) :global(.wl-action-split) {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 130ms ease,
      border-color 130ms ease,
      color 130ms ease,
      transform 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.wl-chat-messages) :global(.wl-action-split svg) {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  /* Copy: cyan — mirrors mic send button */
  :global(.wl-chat-messages) :global(.wl-action-copy-btn) {
    color: rgb(var(--chromatic-cyan) / 0.7);
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }
  :global(.wl-chat-messages) :global(.wl-action-copy-btn:hover),
  :global(.wl-chat-messages) :global(.wl-action-copy-btn.wl-action--drag-hover) {
    background: rgb(var(--chromatic-cyan) / 0.15);
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    color: rgb(var(--chromatic-cyan));
  }

  /* Edit: red — mirrors mic cancel button */
  :global(.wl-chat-messages) :global(.wl-action-edit-btn) {
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.3);
    background: rgb(var(--chromatic-red) / 0.08);
  }
  :global(.wl-chat-messages) :global(.wl-action-edit-btn:hover),
  :global(.wl-chat-messages) :global(.wl-action-edit-btn.wl-action--drag-hover) {
    background: rgb(var(--chromatic-red) / 0.15);
    border-color: rgb(var(--chromatic-red) / 0.5);
    color: rgb(var(--chromatic-red));
  }

  /* Tap squish */
  :global(.wl-chat-messages) :global(.wl-action-split:active) {
    transform: scale(0.82);
  }

  :global(.wl-chat-messages) :global(.wl-react-btn--custom) {
    font-size: var(--text-sm);
    transition: color 130ms ease, border-color 130ms ease, background 130ms ease;
  }

  :global(.wl-chat-messages) :global([data-glyph-open] .wl-react-btn--custom) {
    color: rgb(var(--chromatic-cyan) / 0.82);
    border-color: rgb(var(--chromatic-cyan) / 0.34);
    background: rgb(var(--chromatic-cyan) / 0.09);
  }

  /* Mark composer's field — lives inside .wl-shelf-overlay--mark now, so it
     always fills that overlay's width; no width transition of its own,
     the overlay's transform+opacity carries the whole reveal. */
  :global(.wl-chat-messages) :global(.wl-react-custom-field) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    width: 100%;
    border-radius: 9999px;
    border: 1px solid rgb(var(--chromatic-cyan) / 0.3);
    /* solid, not translucent: the drawer must never show fuzzy row buttons
       through its own input surface. */
    background: rgb(10 10 10 / 0.94);
    padding: 0.14rem 0.16rem;
  }

  /* the explicit confirm inside the field: same circle language as the
     preview glyph on the far side, centered on the shared axis. */
  :global(.wl-chat-messages) :global(.wl-react-custom-commit) {
    width: 1.45rem;
    height: 1.45rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgb(var(--chromatic-cyan) / 0.34);
    background: rgb(var(--chromatic-cyan) / 0.09);
    color: rgb(var(--chromatic-cyan) / 0.85);
    font-size: 0.72rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-spring);
  }

  :global(.wl-chat-messages) :global(.wl-react-custom-commit:hover) {
    background: rgb(var(--chromatic-cyan) / 0.18);
    transform: scale(var(--scale-hover-lg));
  }

  :global(.wl-chat-messages) :global(.wl-react-custom-preview) {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: rgb(var(--color-text-rgb) / 0.78);
    background: rgb(var(--color-text-rgb) / 0.06);
  }

  :global(.wl-chat-messages) :global(.wl-react-custom-input) {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.86);
    font: inherit;
    font-size: var(--text-ui-sm);
    line-height: 1;
    padding: 0;
    box-shadow: none;
  }

  :global(.wl-chat-messages) :global(.wl-react-custom-input::placeholder) {
    color: rgb(var(--color-text-rgb) / 0.38);
  }

  /* ── Status caption — always present while the shelf is open, part of
     the fixed geometry measured at open time. Never appears/disappears
     on its own; see updateShelfCaption() in live-ui.ts. */
  :global(.wl-chat-messages) :global(.wl-shelf-caption) {
    min-height: 1.1rem;
    line-height: 1.1rem;
    font-family: var(--whisper-font-mono);
    font-size: 0.6rem;
    color: rgb(var(--color-text-rgb) / 0.45);
    text-transform: lowercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-user-select: none;
    user-select: none;
  }

  /* ── Reaction pills (placed below message after reacting) ── */
  :global(.wl-chat-messages) :global(.wl-msg-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.18rem;
    padding: 0.12rem 0.2rem 0;
  }

  :global(.wl-chat-messages) :global(.wl-reaction) {
    font-size: var(--text-sm);
    padding: 0.07rem 0.32rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.04);
    cursor: pointer;
    transition:
      background 120ms ease,
      border-color 120ms ease,
      transform 80ms ease;
    line-height: 1.4;
  }

  :global(.wl-chat-messages) :global(.wl-reaction:hover) {
    background: rgb(var(--color-text-rgb) / 0.1);
    border-color: rgb(var(--color-text-rgb) / 0.22);
  }

  :global(.wl-chat-messages) :global(.wl-reaction:active) {
    transform: scale(0.9);
  }

  /* Self reaction: cyan tint */
  :global(.wl-chat-messages) :global(.wl-reaction--self) {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
    background: rgb(var(--chromatic-cyan) / 0.09);
  }

  :global(.wl-chat-messages) :global(.wl-reaction--self:hover) {
    background: rgb(var(--chromatic-cyan) / 0.16);
    border-color: rgb(var(--chromatic-cyan) / 0.5);
  }

  /* Peer reaction: purple tint */
  :global(.wl-chat-messages) :global(.wl-reaction--peer) {
    border-color: rgb(var(--pride-purple) / 0.3);
    background: rgb(var(--pride-purple) / 0.07);
  }

  /* Both self + peer: blended */
  :global(.wl-chat-messages) :global(.wl-reaction--self.wl-reaction--peer) {
    border-color: rgb(var(--chromatic-cyan) / 0.4);
    background: linear-gradient(
      90deg,
      rgb(var(--chromatic-cyan) / 0.1),
      rgb(var(--pride-purple) / 0.08)
    );
  }

  @keyframes reaction-pop {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    60% {
      transform: scale(1.22);
      opacity: 1;
    }
    80% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Applied to a pill the moment it's added to the DOM */
  :global(.wl-chat-messages) :global(.wl-reaction--entering) {
    animation: reaction-pop 280ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file) {
    display: grid;
    gap: calc(var(--space-xs) * 0.15);
    padding: var(--whisper-bubble-padding);
    border-radius: var(--whisper-radius-bubble);
    border: 1px solid var(--msg-border);
    background: var(--msg-bg);
    box-shadow: inset 0 1px 0 rgb(var(--color-text-rgb) / 0.018);
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-name) {
    font-size: var(--whisper-text-emphasis);
    font-weight: 600;
    color: var(--msg-text-color);
    word-break: break-word;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-size) {
    font-size: var(--whisper-text-fine);
    color: rgb(var(--color-text-rgb) / 0.32);
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-download) {
    font-size: var(--whisper-text-support);
    color: rgb(var(--msg-accent) / 0.72);
    text-decoration: none;
    width: fit-content;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file-download:hover) {
    color: rgb(var(--msg-accent) / 0.9);
  }

  /* ── Chunked file-transfer progress card ───────────────────
   * live send/receive state rendered as an energy fill, not a spinner —
   * .wl-transfer-track/.wl-transfer-fill mirror the composer's send-energy
   * language but stay self-contained (own custom property, own transition). */
  :global(.wl-chat-messages) :global(.wl-msg-transfer) {
    min-width: 12rem;
  }

  :global(.wl-chat-messages) :global(.wl-transfer-bytes) {
    font-family: var(--whisper-font-mono);
    font-variant-numeric: tabular-nums;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file[data-transfer-state="active"]) {
    position: relative;
    padding-right: 2.1rem;
  }

  :global(.wl-chat-messages) :global(.wl-transfer-track) {
    position: relative;
    height: 3px;
    border-radius: 999px;
    background: rgb(var(--color-text-rgb) / 0.08);
    overflow: hidden;
    margin-top: calc(var(--space-xs) * 0.3);
  }

  :global(.wl-chat-messages) :global(.wl-transfer-fill) {
    position: absolute;
    inset: 0;
    width: calc(var(--wl-transfer-ratio, 0) * 100%);
    background: rgb(var(--chromatic-cyan) / 0.55);
    transition: width var(--duration-fast) linear;
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer .wl-transfer-fill) {
    background: rgb(var(--pride-purple) / 0.5);
  }

  :global(.wl-chat-messages) :global(.wl-transfer-cancel) {
    position: absolute;
    top: 0.42rem;
    right: 0.42rem;
    width: 1.3rem;
    height: 1.3rem;
    min-width: 1.3rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.14);
    background: rgb(var(--color-text-rgb) / 0.06);
    color: rgb(var(--color-text-rgb) / 0.5);
    font-size: 0.7rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-chat-messages) :global(.wl-transfer-cancel:hover) {
    background: rgb(var(--chromatic-red) / 0.14);
    border-color: rgb(var(--chromatic-red) / 0.4);
    color: rgb(var(--chromatic-red) / 0.85);
  }

  /* cancelled — quiet, no drama: dim the whole card, drop the byte counter
     to a plain italic label, no red/error treatment */
  :global(.wl-chat-messages) :global(.wl-msg-file[data-transfer-state="cancelled"]) {
    opacity: 0.5;
  }

  :global(.wl-chat-messages) :global(.wl-msg-file[data-transfer-state="cancelled"] .wl-transfer-bytes) {
    font-style: italic;
    font-family: inherit;
  }

  :global(.wl-chat-messages) :global(.wl-transfer-delivered) {
    font-size: var(--whisper-text-fine);
    color: rgb(var(--tool-status-success) / 0.75);
  }

  /* ── Audio player ─────────────────────────────────────────── */
  :global(.wl-chat-messages) :global(.wl-msg-audio) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.72rem;
    border-radius: var(--whisper-radius-bubble);
    border: 1px solid var(--msg-border);
    background: var(--msg-bg);
    min-width: 11rem;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      filter 180ms ease;
    box-shadow: inset 0 1px 0 rgb(var(--color-text-rgb) / 0.018);
  }

  /* Subtle glow when playing */
  :global(.wl-chat-messages) :global(.wl-msg-audio[data-playing]) {
    border-color: rgb(var(--msg-accent) / 0.28);
    box-shadow: inset 0 1px 0 rgb(var(--color-text-rgb) / 0.024);
  }

  /* Decode failed — quiet dead state, not a hover-teasing dead button */
  :global(.wl-chat-messages) :global(.wl-audio-play-btn[aria-disabled="true"]) {
    opacity: 0.35;
    cursor: default;
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn) {
    width: 1.7rem;
    height: 1.7rem;
    min-width: 1.7rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--msg-accent) / 0.22);
    background: rgb(var(--msg-accent) / 0.07);
    color: rgb(var(--msg-accent) / 0.68);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 120ms ease;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn:hover) {
    background: rgb(var(--msg-accent) / 0.15);
    border-color: rgb(var(--msg-accent) / 0.38);
    color: rgb(var(--msg-accent) / 0.85);
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn:active) {
    transform: scale(0.92);
  }

  :global(.wl-chat-messages) :global(.wl-audio-play-btn svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  :global(.wl-chat-messages) :global(.wl-audio-wave) {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    height: 1.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-chat-messages) :global(.wl-audio-duration) {
    font-size: calc(var(--text-sm) * 0.7);
    color: rgb(var(--msg-accent) / 0.4);
    white-space: nowrap;
    min-width: 2.2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    transition: color 300ms ease;
  }

  :global(.wl-chat-messages)
    :global(.wl-msg-audio[data-playing] .wl-audio-duration) {
    color: rgb(var(--msg-accent) / 0.65);
  }

  /* ── Media viewer (image / video) ──────────────────────────── */
  :global(.wl-chat-messages) :global(.wl-msg-media) {
    display: grid;
    gap: 0;
    border-radius: var(--whisper-radius-bubble);
    border: 1px solid var(--msg-border);
    background: var(--msg-bg);
    overflow: hidden;
    max-width: min(18rem, 100%);
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
    box-shadow: inset 0 1px 0 rgb(var(--color-text-rgb) / 0.018);
  }

  :global(.wl-chat-messages) :global(.wl-msg-peer-draw) {
    width: 100%;
  }

  :global(.wl-chat-messages) :global(.wl-msg-peer-draw-thumb) {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #1a1a1a;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.wl-chat-messages) :global(.wl-peer-draw-bg) {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.wl-chat-messages) :global(.wl-peer-draw-inline) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.wl-chat-messages)
    :global(.wl-msg-peer-draw[data-draw-state="active"]),
  :global(.wl-chat-messages)
    :global(
      .wl-msg--peer-draw-live[data-draw-state="active"] .wl-msg-peer-draw
    ) {
    border-color: rgb(var(--chromatic-cyan) / 0.42);
  }

  :global(.wl-chat-messages) :global(.wl-msg-peer-draw[data-draw-state="sent"]),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer-draw-live[data-draw-state="sent"] .wl-msg-peer-draw) {
    border-color: rgb(var(--tool-status-success) / 0.4);
  }

  :global(.wl-chat-messages)
    :global(.wl-msg-peer-draw[data-draw-state="clear"]),
  :global(.wl-chat-messages)
    :global(
      .wl-msg--peer-draw-live[data-draw-state="clear"] .wl-msg-peer-draw
    ) {
    border-color: rgb(var(--chromatic-red) / 0.35);
  }

  :global(.wl-peer-draw) {
    display: none !important;
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb) {
    position: relative;
    cursor: pointer;
    line-height: 0;
    overflow: hidden;
    background: rgb(var(--msg-accent) / 0.05);
    min-height: 3rem;
    min-width: 4rem;
    /* set from JS once natural dims are known (clamped to a sane portrait/
       landscape range) — falls back to a generic 4:3 box before load so the
       bubble doesn't jump. max-width caps upscale of tiny sources (e.g. a
       1x1 image) to ~6x their native size instead of stretching to fill. */
    aspect-ratio: var(--wl-media-aspect, 4 / 3);
    max-width: min(100%, var(--wl-media-max-w, 100%));
    max-height: 22rem;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: filter 180ms ease, aspect-ratio var(--duration-normal) var(--ease-out);
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb:hover) {
    filter: brightness(1.06);
  }

  :global(.wl-chat-messages) :global(.wl-media-thumb:active) {
    filter: brightness(0.95);
  }

  :global(.wl-chat-messages) :global(.wl-msg--peer-draw-live .wl-media-thumb) {
    cursor: default;
  }

  :global(.wl-chat-messages)
    :global(.wl-msg[data-stream-finalized="true"] .wl-media-thumb) {
    cursor: default;
  }

  :global(.wl-chat-messages)
    :global(.wl-msg--peer-draw-live .wl-media-thumb:hover),
  :global(.wl-chat-messages)
    :global(.wl-msg--peer-draw-live .wl-media-thumb:active) {
    filter: none;
  }

  :global(.wl-chat-messages)
    :global(.wl-msg[data-stream-finalized="true"] .wl-media-thumb:hover),
  :global(.wl-chat-messages)
    :global(.wl-msg[data-stream-finalized="true"] .wl-media-thumb:active) {
    filter: none;
  }

  :global(.wl-chat-messages) :global(.wl-media-img),
  :global(.wl-chat-messages) :global(.wl-media-video) {
    display: block;
    width: 100%;
    height: 100%;
    margin-inline: auto;
    object-fit: contain;
    background: rgb(0 0 0 / 0.15);
  }

  :global(.wl-chat-messages) :global(.wl-media-play-overlay) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  :global(.wl-chat-messages)
    :global(.wl-media-thumb:hover .wl-media-play-overlay) {
    opacity: 0.85;
  }

  :global(.wl-chat-messages) :global(.wl-media-info) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.68rem;
    min-height: 2rem;
  }

  :global(.wl-chat-messages) :global(.wl-media-name) {
    flex: 1 1 0;
    min-width: 0;
    font-size: var(--whisper-text-fine);
    color: rgb(var(--msg-accent) / 0.62);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.wl-chat-messages) :global(.wl-media-size) {
    font-size: calc(var(--text-sm) * 0.7);
    color: rgb(var(--color-text-rgb) / 0.28);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--msg-accent) / 0.22);
    background: rgb(var(--msg-accent) / 0.07);
    color: rgb(var(--msg-accent) / 0.68);
    transition:
      color 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    padding: 0.3rem;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl svg) {
    width: 100%;
    height: 100%;
  }

  :global(.wl-chat-messages) :global(.wl-media-dl:hover) {
    color: rgb(var(--msg-accent) / 0.85);
    background: rgb(var(--msg-accent) / 0.15);
    border-color: rgb(var(--msg-accent) / 0.38);
  }

  :global(.wl-chat-messages) :global(.wl-media-dl:active) {
    transform: scale(0.92);
  }

  /* ── z-index sanity ────────────────────────────────────────── */
  /* the draw overlay and lightbox are appended straight to
     document.body and painted at z-index 10000/9999, so the site
     action bar (z-index 40) should never out-stack them on its own.
     in practice a mode switch can leave the action bar visible via
     a leftover inline style (e.g. the seal bar bled into live mode),
     which wins over a plain stylesheet rule regardless of z-index —
     so guard by presence, not by mode, and this applies everywhere,
     not just stage mode. */
  :global(:root:has(.wl-draw) .action-bar),
  :global(:root:has(.wl-draw) .tool-actions-shell),
  :global(:root:has(.wl-lightbox) .action-bar),
  :global(:root:has(.wl-lightbox) .tool-actions-shell) {
    display: none !important;
  }

  /* ── Lightbox overlay ──────────────────────────────────────── */
  :global(.wl-lightbox) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 180ms ease;
    touch-action: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  :global(.wl-lightbox--open) {
    opacity: 1;
  }

  :global(.wl-lightbox-inner) {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow: hidden;
  }

  :global(.wl-lightbox-img) {
    max-width: 100%;
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    object-fit: contain;
    border-radius: var(--whisper-radius-tight);
    box-shadow: 0 4px 32px rgb(0 0 0 / 0.4);
    user-select: none;
    -webkit-user-select: none;
    touch-action: pinch-zoom;
  }

  :global(.wl-lightbox-video) {
    max-width: 100%;
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    border-radius: var(--whisper-radius-tight);
    box-shadow: 0 4px 32px rgb(0 0 0 / 0.4);
    outline: none;
    touch-action: manipulation;
  }

  :global(.wl-lightbox-bar) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.08);
    max-width: calc(100vw - 2rem);
  }

  :global(.wl-lightbox-name) {
    font-size: var(--whisper-text-fine);
    color: rgb(255 255 255 / 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1 1 0;
  }

  :global(.wl-lightbox-dl) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0.55rem;
    margin: -0.55rem;
    margin-right: -0.35rem;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.5);
    transition:
      color 200ms ease,
      background 200ms ease;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-lightbox-dl:hover) {
    color: rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.1);
  }

  :global(.wl-lightbox-dl:active) {
    transform: scale(0.92);
  }

  :global(.wl-lightbox-close) {
    position: absolute;
    top: 0.75rem;
    top: calc(0.75rem + env(safe-area-inset-top));
    right: 0.75rem;
    right: calc(0.75rem + env(safe-area-inset-right));
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.06);
    color: rgb(255 255 255 / 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 120ms ease;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-lightbox-close:hover) {
    background: rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.9);
    border-color: rgb(255 255 255 / 0.22);
  }

  :global(.wl-lightbox-close:active) {
    transform: scale(0.92);
  }

  :global(.wl-chat-compose) {
    --wl-activity: 0;
    --wl-velocity: 0;
    --wl-flow: 50%;
    --wl-send-energy: 0;
    --wl-peer-typing: 0;
    --wl-typing-pos: 0;
    position: relative;
    display: flex;
    gap: calc(var(--space-xs) * 0.4);
    align-items: stretch;
    flex-wrap: nowrap;
    padding: calc(var(--space-xs) * 0.7);
    border-top: 1px solid var(--whisper-edge);
    background:
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.016) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      var(--whisper-surface);
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      filter var(--duration-fast) linear;
    transform: translateZ(0);
    filter: saturate(calc(1 + (var(--wl-activity) * 0.24)));
  }

  .wl-chat-compose::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    /* Bar thickens slightly on overflow — energy has nowhere to go */
    height: calc(1px + var(--wl-send-overflow, 0) * 1px);
    pointer-events: none;
    /* On overflow the center fades — energy pools at the edges like hitting a wall.
       Edges stay full-bright while the middle hollows out. */
    --_alpha: calc(
      var(--wl-send-energy) * 0.9 + var(--wl-send-overflow, 0) * 0.1
    );
    --_hollow: calc(var(--wl-send-overflow, 0) * 0.7);
    background: linear-gradient(
      90deg,
      rgb(var(--tool-status-success) / var(--_alpha)) 0%,
      rgb(
          var(--tool-status-success) /
            calc(var(--_alpha) * (1 - var(--_hollow)))
        )
        35%,
      rgb(
          var(--tool-status-success) /
            calc(var(--_alpha) * (1 - var(--_hollow)))
        )
        65%,
      rgb(var(--tool-status-success) / var(--_alpha)) 100%
    );
    /* Clip-path: energy 0->1 fills center->edges. No overflow inset needed —
       the gradient handles the pooling visual. */
    --_base: calc(50% * (1 - var(--wl-send-energy)));
    --_shift: calc((var(--wl-energy-center, 0.5) - 0.5) * 100%);
    clip-path: inset(
      0 calc(var(--_base) - var(--_shift)) 0 calc(var(--_base) + var(--_shift))
    );
    /* Glow: velocity bloom + overflow bloom (heavy spam = bright edges) */
    box-shadow:
      0 0
        calc(
          (var(--wl-send-energy) * 4px) + (var(--wl-send-velocity, 0) * 8px) +
            (var(--wl-send-overflow, 0) * 6px)
        )
        rgb(
          var(--tool-status-success) /
            calc(var(--wl-send-energy) * 0.5 + var(--wl-send-overflow, 0) * 0.3)
        ),
      0 0
        calc(
          (var(--wl-send-energy) * 8px) + (var(--wl-send-velocity, 0) * 18px) +
            (var(--wl-send-overflow, 0) * 14px)
        )
        rgb(
          var(--tool-status-success) /
            calc(
              var(--wl-send-energy) * 0.15 + var(--wl-send-overflow, 0) * 0.12
            )
        );
  }

  .wl-chat-compose::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    opacity: var(--wl-peer-typing);
    /* Width: base * squeeze (send interaction) * width (breath/stretch/sustain).
       Blob swells at edges (pooling), stretches at center (motion blur),
       and widens subtly during sustained typing (warmth). */
    background: radial-gradient(
      ellipse
        calc(
          (12% + var(--wl-peer-typing) * 4%) * var(--wl-typing-squeeze, 1) *
            var(--wl-typing-width, 1)
        )
        100% at calc(var(--wl-typing-pos) * 100%) 50%,
      rgb(var(--pride-purple) / 0.95) 0%,
      rgb(var(--pride-purple) / calc(0.4 + var(--wl-interaction, 0) * 0.25)) 40%,
      transparent 100%
    );
    /* Glow: base + interaction boost + speed/sustain bloom.
       Fast motion = wider trail, sustained typing = warmer ambient. */
    box-shadow:
      0 0
        calc(
          var(--wl-peer-typing) *
            (
              8px + var(--wl-interaction, 0) * 4px + var(--wl-typing-glow, 0) *
                6px
            )
        )
        rgb(
          var(--pride-purple) /
            calc(
              var(--wl-peer-typing) *
                (
                  0.35 + var(--wl-interaction, 0) * 0.2 +
                    var(--wl-typing-glow, 0) * 0.15
                )
            )
        ),
      0 0
        calc(
          var(--wl-peer-typing) *
            (
              16px + var(--wl-interaction, 0) * 6px + var(--wl-typing-glow, 0) *
                10px
            )
        )
        rgb(
          var(--pride-purple) /
            calc(
              var(--wl-peer-typing) * (0.12 + var(--wl-typing-glow, 0) * 0.06)
            )
        );
  }

  .wl-chat-compose:focus-within {
    border-top-color: rgb(var(--color-text-rgb) / 0.18);
  }

  .wl-chat-compose[data-intent="idle"] {
    border-top-color: rgb(var(--color-text-rgb) / 0.12);
    box-shadow: none;
  }

  .wl-chat-compose[data-intent="connecting"] {
    border-top-color: rgb(var(--tool-action-load) / 0.44);
    box-shadow: inset 0 1px 0 rgb(var(--tool-action-load) / 0.18);
  }

  .wl-chat-compose[data-intent="ready"] {
    border-top-color: rgb(var(--color-text-rgb) / 0.16);
    box-shadow: none;
  }

  .wl-chat-compose[data-intent="typing"] {
    border-top-color: rgb(var(--color-text-rgb) / 0.2);
    box-shadow: none;
    background:
      linear-gradient(
        110deg,
        rgb(var(--color-text-rgb) / calc(0.02 + (var(--wl-activity) * 0.04)))
          0%,
        rgb(var(--color-text-rgb) / calc(0.015 + (var(--wl-activity) * 0.03)))
          var(--wl-flow),
        rgb(var(--color-text-rgb) / calc(0.02 + (var(--wl-activity) * 0.04)))
          100%
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-text-rgb) / 0.02) 0%,
        rgb(var(--color-text-rgb) / 0.008) 100%
      ),
      rgb(10 10 10 / 0.94);
    background-size:
      calc(100% + (var(--wl-velocity) * 110%)) 100%,
      100% 100%,
      100% 100%;
    background-position:
      calc((var(--wl-flow) - 50%) * 0.2) 0,
      0 0,
      0 0;
    transition:
      border-top-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background-size 80ms linear,
      background-position 90ms linear,
      background var(--duration-normal) var(--ease-out);
  }

  .wl-chat-compose[data-intent="drop"] {
    border-top-color: rgb(var(--tool-status-success) / 0.52);
    box-shadow:
      inset 0 1px 0 rgb(var(--tool-status-success) / 0.2),
      0 -1px 0 rgb(var(--tool-status-success) / 0.24);
  }

  .wl-chat-compose[data-intent="error"] {
    border-top-color: rgb(var(--chromatic-red) / 0.58);
    animation: wl-intent-error 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) 2;
  }

  .wl-chat-input-wrap {
    flex: 1 1 0;
    position: relative;
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  :global(.whisper-input.wl-chat-text-input) {
    flex: 1;
    min-width: 0;
    width: 100%;
    min-height: auto;
    padding: 0.52rem 4.2rem 0.52rem 0.72rem;
    border-radius: var(--whisper-radius-medium);
    border-color: rgb(var(--color-text-rgb) / 0.14);
    background: rgb(10 10 10 / 0.82);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-mic-wrap {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 2px;
    align-items: center;
    border-radius: 9999px;
    touch-action: none;
  }

  .wl-mic-wrap[data-hidden] {
    display: none;
  }

  .wl-chat-mic-btn {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.03);
    color: rgb(var(--color-text-rgb) / 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease,
      width 200ms ease,
      opacity 200ms ease;
    touch-action: none;
  }

  .wl-chat-mic-btn:hover:not(:disabled) {
    border-color: rgb(var(--chromatic-cyan) / 0.4);
    color: rgb(var(--chromatic-cyan) / 0.7);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .wl-chat-mic-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ── Paste button — mirrors mic button ──────────────────── */
  .wl-chat-paste-btn {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: rgb(var(--color-text-rgb) / 0.03);
    color: rgb(var(--color-text-rgb) / 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition:
      width 250ms cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 200ms ease,
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 180ms cubic-bezier(0.34, 1.4, 0.64, 1);
    touch-action: none;
  }

  .wl-chat-paste-btn:hover:not(:disabled) {
    border-color: rgb(var(--color-text-rgb) / 0.28);
    color: rgb(var(--color-text-rgb) / 0.7);
    background: rgb(var(--color-text-rgb) / 0.08);
  }

  .wl-chat-paste-btn:active:not(:disabled) {
    transform: scale(0.88);
    transition-duration: 60ms;
  }

  .wl-chat-paste-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .wl-paste-svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    overflow: visible;
  }

  /* board + clip dissolve upward when pasted */
  .wl-paste-board,
  .wl-paste-clip {
    transition:
      opacity 200ms ease,
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .wl-chat-paste-btn[data-pasted] .wl-paste-board {
    opacity: 0;
    transform: translateY(-1.5px) scale(0.85);
  }

  .wl-chat-paste-btn[data-pasted] .wl-paste-clip {
    opacity: 0;
    transform: translateY(-2.5px) scale(0.7);
  }

  /* glyph path morphs: two lines → checkmark with draw-in */
  .wl-paste-glyph {
    stroke-width: 1.3;
    transition:
      d 300ms cubic-bezier(0.34, 1.4, 0.64, 1),
      stroke-width 250ms ease;
  }

  .wl-chat-paste-btn[data-pasted] .wl-paste-glyph {
    d: path("M4.5 8.2L7 10.7L11.5 5.5M4.5 8.2L7 10.7L11.5 5.5");
    stroke-width: 1.7;
    stroke-dasharray: 14;
    animation: wl-paste-draw 400ms cubic-bezier(0.22, 0.61, 0.36, 1) 80ms both;
  }

  @keyframes wl-paste-draw {
    from { stroke-dashoffset: 14; }
    to   { stroke-dashoffset: 0; }
  }

  /* pop animation on entering pasted state */
  @keyframes wl-paste-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.18); }
    70%  { transform: scale(0.95); }
    100% { transform: scale(1); }
  }

  .wl-chat-paste-btn[data-pasted] {
    color: rgb(var(--color-text-rgb) / 0.65);
    border-color: rgb(var(--color-text-rgb) / 0.22);
    background: rgb(var(--color-text-rgb) / 0.06);
    animation: wl-paste-pop 350ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .wl-chat-paste-btn[data-pasted]:hover {
    color: rgb(var(--color-text-rgb) / 0.85);
    border-color: rgb(var(--color-text-rgb) / 0.32);
    background: rgb(var(--color-text-rgb) / 0.1);
  }

  /* collapse paste button during recording */
  .wl-mic-wrap[data-recording="true"] .wl-chat-paste-btn {
    width: 0;
    opacity: 0;
    border-color: transparent;
    padding: 0;
    transition:
      width 180ms cubic-bezier(0.4, 0, 1, 1),
      opacity 150ms ease;
  }

  /* Split buttons (cancel + send) — collapsed by default */
  .wl-mic-split {
    width: 0;
    overflow: hidden;
    opacity: 0;
    height: 1.4rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      width 200ms ease,
      opacity 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
  }

  .wl-mic-split svg {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
  }

  /* Recording state — expand split buttons, hide mic */
  .wl-mic-wrap[data-recording="true"] .wl-chat-mic-btn {
    width: 0;
    overflow: hidden;
    opacity: 0;
    border: none;
    padding: 0;
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-split {
    width: 1.4rem;
    opacity: 1;
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-cancel {
    color: rgb(var(--chromatic-red) / 0.7);
    border-color: rgb(var(--chromatic-red) / 0.3);
    background: rgb(var(--chromatic-red) / 0.08);
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-cancel:hover {
    background: rgb(var(--chromatic-red) / 0.18);
    border-color: rgb(var(--chromatic-red) / 0.5);
    color: rgb(var(--chromatic-red));
  }

  /* armed state — confirm cancel, more urgent */
  .wl-mic-wrap[data-recording="true"] .wl-mic-cancel[data-armed] {
    background: rgb(var(--chromatic-red) / 0.22);
    border-color: rgb(var(--chromatic-red) / 0.65);
    color: rgb(var(--chromatic-red));
    animation: wl-cancel-pulse 600ms ease-in-out infinite;
  }

  @keyframes wl-cancel-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(var(--chromatic-red) / 0.3); }
    50%      { box-shadow: 0 0 0 3px rgb(var(--chromatic-red) / 0); }
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-send {
    color: rgb(var(--chromatic-cyan) / 0.7);
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    background: rgb(var(--chromatic-cyan) / 0.08);
  }

  .wl-mic-wrap[data-recording="true"] .wl-mic-send:hover {
    background: rgb(var(--chromatic-cyan) / 0.18);
    border-color: rgb(var(--chromatic-cyan) / 0.5);
    color: rgb(var(--chromatic-cyan));
  }

  .wl-mic-split:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Pulse on the wrapper during recording */
  .wl-mic-wrap[data-recording="true"] {
    animation: wl-mic-pulse 1.2s ease-in-out infinite;
  }

  @keyframes wl-mic-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(var(--chromatic-red) / 0.25);
    }
    50% {
      box-shadow: 0 0 0 4px rgb(var(--chromatic-red) / 0);
    }
  }

  .wl-mic-icon {
    width: 0.85rem;
    height: 0.85rem;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-text-input {
    border-color: rgb(var(--tool-action-load) / 0.28);
  }

  .wl-chat-compose[data-intent="ready"] .wl-chat-text-input,
  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-cyan) / 0.35);
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-text-input {
    transform: translateY(calc(var(--wl-activity) * -0.35px))
      scaleY(calc(1 + (var(--wl-velocity) * 0.01)));
  }

  .wl-chat-compose[data-intent="drop"] .wl-chat-text-input {
    border-color: rgb(var(--tool-status-success) / 0.38);
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-text-input {
    border-color: rgb(var(--chromatic-red) / 0.42);
  }

  .wl-chat-input-has-value .wl-chat-send-btn {
    opacity: 1;
  }

  :global(.whisper-mini-btn.wl-chat-send-btn) {
    flex: 0 0 auto;
    align-self: stretch;
    min-height: auto;
    padding: 0 0.8rem;
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.16) 0%,
      rgb(var(--chromatic-cyan) / 0.09) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.3);
    color: rgb(var(--chromatic-cyan));
    box-shadow:
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.02),
      0 12px 22px -24px rgb(var(--chromatic-cyan) / 0.42);
    opacity: 0.86;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      transform 120ms linear;
  }

  .wl-chat-compose[data-intent="typing"] .wl-chat-send-btn {
    transform: translateY(calc(var(--wl-activity) * -0.6px))
      scale(calc(1 + (var(--wl-velocity) * 0.018)));
  }

  .wl-chat-compose[data-intent="connecting"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-action-load) / 0.44);
    background: rgb(var(--tool-action-load) / 0.15);
    color: rgb(var(--tool-action-load));
  }

  .wl-chat-compose[data-intent="drop"] .wl-chat-send-btn {
    border-color: rgb(var(--tool-status-success) / 0.5);
    background: rgb(var(--tool-status-success) / 0.14);
    color: rgb(var(--tool-status-success));
  }

  .wl-chat-compose[data-intent="error"] .wl-chat-send-btn {
    border-color: rgb(var(--chromatic-red) / 0.5);
    background: rgb(var(--chromatic-red) / 0.12);
    color: rgb(var(--chromatic-red));
  }

  :global(.whisper-mini-btn.wl-chat-send-btn):hover {
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan) / 0.2) 0%,
      rgb(var(--chromatic-cyan) / 0.12) 100%
    );
    border-color: rgb(var(--chromatic-cyan) / 0.42);
  }

  :global(.whisper-mini-btn.wl-chat-send-btn):active:not(:disabled) {
    transform: scale(0.96);
    background: rgb(var(--chromatic-cyan) / 0.28);
    transition-duration: 40ms;
  }

  /* ── Media button + popover ───────────────────────────────── */
  .wl-media-wrap {
    position: relative;
    flex: 0 0 auto;
    align-self: stretch;
    display: flex;
  }

  .wl-chat-media-btn {
    position: relative;
    min-height: auto;
    height: 100%;
    padding: 0 0.42rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-color: rgb(var(--color-text-rgb) / 0.14);
    background: rgb(var(--color-text-rgb) / 0.02);
    transition:
      transform 120ms linear,
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out);
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .wl-chat-media-btn:hover:not(:disabled) {
    border-color: rgb(var(--color-text-rgb) / 0.3);
    background: rgb(var(--color-text-rgb) / 0.05);
  }

  .wl-chat-media-btn:active:not(:disabled) {
    transform: scale(0.94);
    transition-duration: 40ms;
  }

  :global(.wl-media-btn-icon) {
    width: 0.85rem;
    height: 0.85rem;
    display: block;
    fill: currentColor;
    stroke: none !important;
    transform: rotate(90deg);
  }

  :global(.wl-media-popover) {
    display: none;
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform-origin: bottom right;
    transform: translateX(-50%) scale(0.96);
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.3rem;
    border-radius: var(--whisper-radius-medium);
    background: rgb(10 10 10 / 0.94);
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 18px 30px -24px rgb(0 0 0 / 0.92),
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.02);
    z-index: 100;
    opacity: 0;
    /* no transition here: display:none removes the element from the render
       tree the instant --open drops, so closing is already instant */
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.wl-media-popover.--open) {
    display: flex;
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transition:
      opacity var(--duration-fast) var(--ease-spring),
      transform var(--duration-fast) var(--ease-spring);
  }

  /* stagger-in: each option rises in ~30ms after the last, capped at 6 */
  @keyframes wl-media-option-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.wl-media-popover.--open) :global(.wl-media-option) {
    animation: wl-media-option-in var(--duration-fast) var(--ease-out) both;
  }
  :global(.wl-media-popover.--open) :global(.wl-media-option:nth-child(2)) { animation-delay: 30ms; }
  :global(.wl-media-popover.--open) :global(.wl-media-option:nth-child(3)) { animation-delay: 60ms; }
  :global(.wl-media-popover.--open) :global(.wl-media-option:nth-child(4)) { animation-delay: 90ms; }
  :global(.wl-media-popover.--open) :global(.wl-media-option:nth-child(5)) { animation-delay: 120ms; }
  :global(.wl-media-popover.--open) :global(.wl-media-option:nth-child(6)) { animation-delay: 150ms; }

  @media (prefers-reduced-motion: reduce) {
    :global(.wl-media-popover.--open) {
      transition: opacity var(--duration-fast) linear;
      transform: translateX(-50%) scale(1) !important;
    }
    :global(.wl-media-popover.--open) :global(.wl-media-option) {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  :global(.wl-media-option) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--whisper-radius-tight);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.68);
    font-size: calc(var(--text-sm, 0.875rem) * 0.82);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-media-option) svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  :global(.wl-media-option:hover),
  :global(.wl-media-option.--hover) {
    background: rgb(var(--color-text-rgb) / 0.05);
    border-color: rgb(var(--color-text-rgb) / 0.12);
    color: rgb(var(--color-text-rgb) / 0.92);
  }

  :global(.wl-media-option:active) {
    background: rgb(var(--color-text-rgb) / 0.08);
  }

  /* ── Divider in popover ───────────────────────────────── */
  :global(.wl-media-divider) {
    height: 1px;
    margin: 0.1rem 0.5rem;
    background: rgb(var(--color-text-rgb) / 0.06);
  }

  /* ── "Coming soon" options — future call slots, dimmed and inert.
     opacity alone reads as merely quiet next to 0.68-opacity live rows,
     so these also desaturate and carry an explicit chip: unmistakably
     parked, not broken. ── */
  :global(.wl-media-option--soon) {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
    filter: saturate(0);
  }

  :global(.wl-media-option--soon)::after {
    content: "soon";
    margin-left: auto;
    font-family: var(--whisper-font-mono, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: rgb(var(--color-text-rgb) / 0.55);
    border: 1px solid rgb(var(--color-text-rgb) / 0.16);
    border-radius: 999px;
    padding: 0.08rem 0.42rem;
    line-height: 1.1;
  }

  /* ── Alpha menu button in popover ────────────────────── */
  :global(.wl-media-alpha) {
    color: rgb(var(--color-text-rgb) / 0.38);
    font-size: var(--whisper-text-fine, calc(var(--text-sm, 0.875rem) * 0.72));
    letter-spacing: 0.05em;
  }

  :global(.wl-alpha-iris) {
    width: 0.85rem;
    height: 0.85rem;
    opacity: 0.6;
    transition: opacity 120ms ease;
  }

  :global(.wl-media-alpha:hover) :global(.wl-alpha-iris),
  :global(.wl-media-alpha.--hover) :global(.wl-alpha-iris),
  :global(.wl-media-alpha.--active) :global(.wl-alpha-iris) {
    opacity: 1;
  }

  :global(.wl-alpha-iris) {
    transition: transform 350ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  :global(.wl-media-alpha.--active) :global(.wl-alpha-iris) {
    transform: rotate(var(--iris-jitter, 0deg));
  }

  :global(.wl-iris-blade) {
    transition:
      d 350ms cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 250ms ease;
    opacity: 0.8;
  }

  :global(.wl-media-alpha.--active) :global(.wl-iris-blade) {
    opacity: 1;
  }

  /* closed: curved swirl blades wrapping around center */
  :global(.wl-iris-1) { d: path("M7 3.2 Q11.5 4.5, 11.8 8"); }
  :global(.wl-iris-2) { d: path("M12 9.5 Q9 13, 5 12"); }
  :global(.wl-iris-3) { d: path("M4.2 10 Q3 6, 6.5 3.8"); }

  /* open: blades unfurl into radiating lines from center */
  :global(.wl-media-alpha.--active) :global(.wl-iris-1) { d: path("M8 8 Q9 4, 10.5 2.5"); }
  :global(.wl-media-alpha.--active) :global(.wl-iris-2) { d: path("M8 8 Q11 10, 12.5 12"); }
  :global(.wl-media-alpha.--active) :global(.wl-iris-3) { d: path("M8 8 Q5 10, 3 11.5"); }

  :global(.wl-media-alpha:hover),
  :global(.wl-media-alpha.--hover) {
    color: rgb(var(--color-text-rgb) / 0.7);
  }

  :global(.wl-media-alpha.--active) {
    color: rgb(var(--chromatic-cyan, 0 200 255) / 0.7);
    background: rgb(var(--chromatic-cyan, 0 200 255) / 0.06);
    border-color: rgb(var(--chromatic-cyan, 0 200 255) / 0.1);
  }

  /* ── Alpha panel (submenu) ───────────────────────────── */
  :global(.wl-alpha-panel) {
    display: none;
    position: absolute;
    bottom: 0;
    right: calc(100% + 0.3rem);
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem 0.6rem;
    min-width: 10rem;
    border-radius: var(--whisper-radius-medium, 0.325rem);
    background: rgb(8 8 8 / 0.96);
    border: 1px solid rgb(var(--color-text-rgb) / 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      0 12px 28px -8px rgb(0 0 0 / 0.7),
      0 2px 6px rgb(0 0 0 / 0.3),
      inset 0 1px 0 rgb(var(--color-text-rgb) / 0.03);
    z-index: 101;
    opacity: 0;
    transform: translateX(3px) scale(0.98);
    transform-origin: right bottom;
    transition:
      opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: none;
  }

  :global(.wl-alpha-panel.--open) {
    display: flex;
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  /* on narrow viewports, stack above the popover instead of beside it */
  @media (max-width: 360px) {
    :global(.wl-alpha-panel) {
      right: auto;
      left: 0;
      bottom: calc(100% + 0.3rem);
      transform-origin: left bottom;
      min-width: 8rem;
    }
  }

  :global(.wl-alpha-section) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    -webkit-user-select: none;
    user-select: none;
  }

  :global(.wl-alpha-label) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: rgb(var(--color-text-rgb) / 0.4);
    font-size: var(--whisper-text-fine, calc(var(--text-sm, 0.875rem) * 0.72));
    letter-spacing: 0.04em;
    user-select: none;
  }

  :global(.wl-alpha-reset) {
    all: unset;
    display: inline-flex;
    cursor: pointer;
    margin-left: 0.2em;
    vertical-align: -0.05em;
    border-radius: 2px;
    transition: opacity 120ms ease;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-alpha-reset:hover) {
    opacity: 1 !important;
  }

  :global(.wl-alpha-reset:active) {
    transform: scale(0.85);
  }

  :global(.wl-alpha-mic-icon) {
    width: 0.65em;
    height: 0.65em;
    display: block;
    opacity: 0.55;
    transition: opacity 120ms ease, filter 300ms ease;
  }

  :global(.wl-alpha-reset:hover) :global(.wl-alpha-mic-icon) {
    opacity: 0.9;
  }

  :global(.wl-alpha-reset.--modified) {
    position: relative;
    overflow: hidden;
  }

  :global(.wl-alpha-reset.--modified)::after {
    content: "";
    position: absolute;
    inset: -2px;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 40%,
      rgb(var(--chromatic-cyan, 0 200 255) / 0.35) 50%,
      transparent 60%,
      transparent 100%
    );
    background-size: 250% 100%;
    animation: wl-mic-shimmer 4s ease-in-out infinite;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  :global(.wl-alpha-reset.--modified) :global(.wl-alpha-mic-icon) {
    opacity: 0.7;
  }

  @keyframes wl-mic-shimmer {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: 0% 0; }
  }

  :global(.wl-alpha-q) {
    font-variant-numeric: tabular-nums;
    font-size: var(--whisper-text-fine, calc(var(--text-sm, 0.875rem) * 0.72));
    color: rgb(var(--color-text-rgb) / 0.6);
    min-width: 1.6em;
    text-align: right;
    transition: color var(--orbit-morph, 350ms) ease;
  }

  :global(.wl-alpha-q.--active) {
    color: rgb(var(--chromatic-cyan, 0 200 255) / 0.9);
  }

  /* ── Orbit visualizer ─────────────────────────────────── */
  :global(.wl-alpha-orbit-wrap) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.2rem;
    cursor: grab;
    animation: wl-orbit-breathe 5s ease-in-out infinite;
    -webkit-tap-highlight-color: transparent;
    touch-action: none;
  }

  :global(.wl-alpha-orbit-wrap:active) {
    cursor: grabbing;
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-orbit-wrap) {
    cursor: default;
  }

  :global(.wl-alpha-orbit) {
    width: 4.2rem;
    height: 4.2rem;
    will-change: transform;
  }

  @keyframes wl-orbit-breathe {
    0%, 100% { scale: 1; }
    50% { scale: 1.06; }
  }

  /* shared transition: --orbit-morph is set from JS based on network RTT.
     slow connection = gooey (up to 650ms). fast = snappy (250ms). */
  :global(.wl-orbit-line),
  :global(.wl-orbit-ghost),
  :global(.wl-orbit-glow) {
    transition:
      stroke var(--orbit-morph, 350ms) ease,
      stroke-width var(--orbit-morph, 350ms) ease,
      d var(--orbit-morph, 350ms) cubic-bezier(0.33, 1, 0.68, 1),
      opacity var(--orbit-morph, 350ms) ease;
  }

  /* main line: crisp, with a traveling gap (dashoffset driven by JS curvature map) */
  :global(.wl-orbit-line) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.7);
    stroke-width: 0.028;
    stroke-dasharray: 0.88 0.12;
    stroke-dashoffset: 0;
  }

  /* ghost: the inner simpler shape, always visible as a dim echo */
  :global(.wl-orbit-ghost) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.12);
    stroke-width: 0.02;
  }

  /* glow: soft halo behind the main line */
  :global(.wl-orbit-glow) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.3);
    stroke-width: 0.09;
    animation: wl-orbit-glow-pulse 3s ease-in-out infinite;
  }

  @keyframes wl-orbit-glow-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* dragging: intensify the orbit */
  :global(.wl-alpha-section.--dragging) :global(.wl-orbit-line) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.95);
    stroke-width: 0.036;
  }

  :global(.wl-alpha-section.--dragging) :global(.wl-orbit-glow) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.45);
    stroke-width: 0.11;
  }

  :global(.wl-alpha-section.--dragging) :global(.wl-orbit-ghost) {
    stroke: rgb(var(--chromatic-cyan, 0 200 255) / 0.18);
  }

  /* raw mode: flower → flat amber line (d-path interpolation) */

  :global(.wl-alpha-section.--raw) :global(.wl-orbit-line),
  :global(.wl-alpha-section.--raw.--dragging) :global(.wl-orbit-line) {
    stroke: rgb(255 180 90 / 0.9);
    stroke-dasharray: 1 0;
  }

  :global(.wl-alpha-section.--raw) :global(.wl-orbit-ghost),
  :global(.wl-alpha-section.--raw.--dragging) :global(.wl-orbit-ghost) {
    stroke: rgb(255 180 90 / 0.12);
  }

  :global(.wl-alpha-section.--raw) :global(.wl-orbit-glow),
  :global(.wl-alpha-section.--raw.--dragging) :global(.wl-orbit-glow) {
    stroke: rgb(255 180 90 / 0.35);
    animation: none;
    opacity: 1;
  }

  /* ── Status bar (shared, bottom of panel) ─────────── */
  :global(.wl-alpha-status) {
    color: rgb(var(--color-text-rgb) / 0.32);
    font-size: var(--whisper-text-hairline, calc(var(--text-sm, 0.875rem) * 0.62));
    letter-spacing: 0.02em;
    text-align: center;
    user-select: none;
    min-height: 1em;
    transition: color var(--orbit-morph, 350ms) ease;
  }

  :global(.wl-alpha-status:empty) {
    display: none;
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-status) {
    color: rgb(255 180 90 / 0.4);
  }

  /* ── Custom track slider ──────────────────────────────── */
  :global(.wl-alpha-track-wrap) {
    position: relative;
    height: 1.6rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-alpha-track) {
    position: relative;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: rgb(var(--color-text-rgb) / 0.08);
    overflow: hidden;
  }

  :global(.wl-alpha-fill) {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 1px;
    --fill-l: rgb(var(--chromatic-cyan, 0 200 255) / 0.35);
    --fill-r: rgb(var(--chromatic-cyan, 0 200 255) / 0.35);
    background: linear-gradient(90deg, var(--fill-l) 0%, var(--fill-r) 100%);
    transition:
      --fill-l var(--orbit-morph, 350ms) ease,
      --fill-r var(--orbit-morph, 350ms) ease;
    will-change: width;
  }


  :global(.wl-alpha-track-wrap.--resetting) :global(.wl-alpha-fill) {
    transition:
      --fill-l var(--orbit-morph, 350ms) ease,
      --fill-r var(--orbit-morph, 350ms) ease,
      width var(--orbit-morph, 350ms) cubic-bezier(0.33, 1, 0.68, 1);
  }

  :global(.wl-alpha-track-wrap.--dragging) :global(.wl-alpha-fill) {
    --fill-l: rgb(var(--chromatic-cyan, 0 200 255) / 0.55);
    --fill-r: rgb(var(--chromatic-cyan, 0 200 255) / 0.55);
  }

  :global(.wl-alpha-thumb) {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(var(--color-text-rgb) / 0.75);
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.5),
      0 0 0 0 rgb(var(--chromatic-cyan, 0 200 255) / 0);
    transform: translateX(-50%);
    transition:
      background var(--orbit-morph, 350ms) ease,
      box-shadow var(--orbit-morph, 350ms) ease,
      width 180ms cubic-bezier(0.16, 1, 0.3, 1),
      height 180ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: left;
    pointer-events: none;
  }

  :global(.wl-alpha-track-wrap.--resetting) :global(.wl-alpha-thumb) {
    transition:
      background var(--orbit-morph, 350ms) ease,
      box-shadow var(--orbit-morph, 350ms) ease,
      width 180ms cubic-bezier(0.16, 1, 0.3, 1),
      height 180ms cubic-bezier(0.16, 1, 0.3, 1),
      left var(--orbit-morph, 350ms) cubic-bezier(0.33, 1, 0.68, 1);
  }

  :global(.wl-alpha-track-wrap:hover) :global(.wl-alpha-thumb) {
    background: rgb(var(--color-text-rgb) / 0.9);
    box-shadow:
      0 1px 4px rgb(0 0 0 / 0.6),
      0 0 0 3px rgb(var(--chromatic-cyan, 0 200 255) / 0.08);
  }

  :global(.wl-alpha-track-wrap.--dragging) :global(.wl-alpha-thumb) {
    width: 13px;
    height: 13px;
    background: rgb(var(--chromatic-cyan, 0 200 255) / 0.9);
    box-shadow:
      0 1px 5px rgb(0 0 0 / 0.5),
      0 0 0 4px rgb(var(--chromatic-cyan, 0 200 255) / 0.12),
      0 0 12px rgb(var(--chromatic-cyan, 0 200 255) / 0.15);
  }

  :global(.wl-alpha-track-wrap.--fine) :global(.wl-alpha-thumb) {
    width: 15px;
    height: 15px;
  }

  /* ── Raw mode (q100) — regime shift visual ───────────── */
  :global(.wl-alpha-section.--raw) :global(.wl-alpha-q) {
    color: rgb(255 180 90 / 0.9);
    letter-spacing: 0.06em;
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-fill) {
    --fill-l: rgb(var(--chromatic-cyan, 0 200 255) / 0.3);
    --fill-r: rgb(255 180 90 / 0.45);
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-track-wrap.--dragging) :global(.wl-alpha-fill) {
    --fill-l: rgb(var(--chromatic-cyan, 0 200 255) / 0.45);
    --fill-r: rgb(255 180 90 / 0.65);
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-thumb) {
    background: rgb(255 180 90 / 0.85);
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-track-wrap.--dragging) :global(.wl-alpha-thumb) {
    background: rgb(255 180 90);
    box-shadow:
      0 1px 5px rgb(0 0 0 / 0.5),
      0 0 0 4px rgb(255 180 90 / 0.15),
      0 0 12px rgb(255 180 90 / 0.2);
  }

  :global(.wl-alpha-section.--raw) :global(.wl-alpha-track-wrap:hover) :global(.wl-alpha-thumb) {
    box-shadow:
      0 1px 4px rgb(0 0 0 / 0.6),
      0 0 0 3px rgb(255 180 90 / 0.12);
  }

  /* ── Clear option in popover — state feedback ─────────── */
  :global(.wl-media-clear:disabled) {
    opacity: 0.35;
    pointer-events: none;
  }

  :global(.wl-media-clear[data-clear-state="pending-out"]) {
    color: rgb(255 255 255 / 0.5);
  }

  :global(.wl-media-clear[data-clear-state="pending-out"]) svg {
    animation: wl-clear-spin 2.4s linear infinite;
  }

  @keyframes wl-clear-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  :global(.wl-media-clear[data-clear-state="pending-in"]) {
    color: rgb(var(--chromatic-cyan, 0 200 255));
    background: rgb(var(--chromatic-cyan, 0 200 255) / 0.12);
  }

  :global(.wl-media-clear[data-clear-state="pending-in"]) svg {
    animation: wl-clear-icon-shake 0.85s ease-in-out infinite;
  }

  @keyframes wl-clear-icon-shake {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-14deg);
    }
    75% {
      transform: rotate(14deg);
    }
  }

  /* Notification dot on media btn when clear request is pending-in */
  :global(.wl-chat-media-btn[data-notify])::after {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--chromatic-cyan, 0 200 255));
    box-shadow: 0 0 4px rgb(var(--chromatic-cyan, 0 200 255) / 0.6);
    pointer-events: none;
  }

  /* Chat clear animation — messages fade + drift down, container flashes */
  @keyframes wl-msg-clear {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
    30% {
      opacity: 0.7;
      transform: translateY(2px) scale(0.99);
      filter: blur(0px);
    }
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
      filter: blur(3px);
    }
  }
  @keyframes wl-chat-clear-flash {
    0% {
      background-color: transparent;
    }
    18% {
      background-color: rgb(var(--chromatic-cyan) / 0.05);
    }
    100% {
      background-color: transparent;
    }
  }
  :global(.wl-chat-messages)[data-clearing] {
    animation: wl-chat-clear-flash 320ms ease-out forwards;
    pointer-events: none;
  }
  :global(.wl-chat-messages)[data-clearing] :global(.wl-msg) {
    animation: wl-msg-clear 220ms ease-in forwards;
    /* stagger: first message leads, later ones follow (capped at index 10) */
    animation-delay: calc(var(--msg-idx, 0) * 16ms);
  }

  .wl-file-icon {
    width: 1rem;
    height: 1rem;
  }

  @keyframes wl-intent-error {
    0% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-1px);
    }
    50% {
      transform: translateX(1px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* message entrance: spring snap, offset+shrink, one overshoot, settle.
     peer slides from left, self from right, system centers in place.
     the first third carries a 1px chromatic split shadow that fades into
     the resting (shadow-less) bubble as the snap settles. */
  @keyframes wl-msg-in {
    0% {
      opacity: 0;
      transform: translateX(-6px) translateY(8px) scale(0.97);
      box-shadow:
        -1px 0 0 rgb(var(--chromatic-cyan) / 0.35),
        1px 0 0 rgb(var(--chromatic-red) / 0.35);
    }
    36% {
      opacity: 1;
      box-shadow: none;
    }
    65% {
      transform: translateX(0) translateY(0) scale(1.008);
    }
    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1);
      box-shadow: none;
    }
  }
  @keyframes wl-msg-in-right {
    0% {
      opacity: 0;
      transform: translateX(6px) translateY(8px) scale(0.97);
      box-shadow:
        -1px 0 0 rgb(var(--chromatic-cyan) / 0.35),
        1px 0 0 rgb(var(--chromatic-red) / 0.35);
    }
    36% {
      opacity: 1;
      box-shadow: none;
    }
    65% {
      transform: translateX(0) translateY(0) scale(1.008);
    }
    100% {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1);
      box-shadow: none;
    }
  }
  @keyframes wl-msg-in-center {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
      box-shadow:
        -1px 0 0 rgb(var(--chromatic-cyan) / 0.35),
        1px 0 0 rgb(var(--chromatic-red) / 0.35);
    }
    36% {
      opacity: 1;
      box-shadow: none;
    }
    65% {
      transform: translateY(0) scale(1.008);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      box-shadow: none;
    }
  }

  /* reduced-motion fallback: opacity only, no offset/scale/shadow */
  @keyframes wl-msg-in-reduced {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .wl-spinner {
      animation: none;
    }

    #wl-connecting-section .wl-spinner::after {
      animation: none;
    }

    /* keep the fade, drop the spring scale */
    :global(.wl-fingerprint-glyph) {
      transform: none !important;
      animation-delay: 0ms !important;
    }

    .wl-chat-compose,
    .wl-chat-text-input,
    .wl-chat-send-btn {
      animation: none !important;
      transition-duration: 0ms !important;
      transform: none !important;
      background-size:
        100% 100%,
        100% 100%,
        100% 100% !important;
      background-position:
        0 0,
        0 0,
        0 0 !important;
    }

    /* opacity-only fade in: no offset, scale, or chromatic shadow */
    :global(.wl-chat-messages) :global(.wl-msg) {
      animation: wl-msg-in-reduced var(--duration-normal, 180ms) ease both !important;
      transition-duration: 0ms !important;
      transform: none !important;
      box-shadow: none !important;
    }
    .wl-chat-compose::before,
    .wl-chat-compose::after {
      display: none !important;
    }
    :global(.wl-chat-messages) :global(.wl-msg-text) {
      transition: none !important;
      animation: none !important;
    }
    .wl-chat-mic-btn,
    .wl-chat-paste-btn {
      animation: none !important;
      transition: none !important;
    }
    .wl-paste-glyph,
    .wl-paste-board,
    .wl-paste-clip {
      transition: none !important;
      animation: none !important;
    }
    .wl-mic-wrap {
      animation: none !important;
    }
    .wl-mic-split {
      transition: none !important;
    }
    :global(.wl-chat-messages)[data-clearing] :global(.wl-msg) {
      animation: none !important;
      opacity: 0 !important;
    }
  }

  /* ── Silent mode ─────────────────────────────────────────── */
  .wl-silent-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .wl-secret-display {
    font-size: calc(var(--text-sm) * 0.75);
    color: rgb(var(--chromatic-cyan));
  }

  /* ── End/Error panels — shared with Campfire ─────────────── */
  :global(.whisper-panel.wl-end-panel),
  .wl-error-panel {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  /* the session is over: give the closing line room, no rush */
  :global(.whisper-panel.wl-end-panel) {
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
  }

  :global(.wl-end-text) {
    margin: 0;
    color: var(--whisper-muted);
    font-size: var(--text-sm);
    font-style: italic;
    letter-spacing: 0.08em;
    text-shadow:
      calc(-1 * var(--chromatic-offset)) 0 0 rgb(var(--chromatic-cyan) / 0.12),
      var(--chromatic-offset) 0 0 rgb(var(--chromatic-red) / 0.1);
    animation: wl-fade-in 600ms var(--ease-out) both;
  }

  /* "Start over": shrink out of the grid's full-width stretch into a quiet ghost */
  :global(.whisper-panel.wl-end-panel) :global(.whisper-mini-btn) {
    justify-self: center;
    width: auto;
    margin-top: var(--space-xs);
  }

  .wl-error-text {
    margin: 0;
    padding: calc(var(--space-xs) * 0.7) var(--space-sm);
    border: 1px solid rgb(var(--chromatic-red) / 0.3);
    border-radius: var(--whisper-radius-soft);
    background: rgb(var(--chromatic-red) / 0.08);
    color: rgb(var(--chromatic-red));
    font-size: var(--text-sm);
    animation: wl-fade-in var(--duration-slow) var(--ease-out) both;
  }

  @keyframes wl-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 520px) {
    .wl-code-display-wrap {
      flex-direction: column;
    }

    .wl-code-display-wrap :global(.whisper-mini-btn) {
      width: 100%;
    }

    :global(.wl-chat-tools) {
      width: 100%;
      justify-content: stretch;
    }

    :global(.wl-disconnect-btn) {
      width: 100%;
      justify-content: center;
    }

    :global(.wl-chat-compose) {
      gap: calc(var(--space-xs) * 0.45);
    }

    .wl-fingerprint {
      font-size: var(--text-2xl);
      letter-spacing: 0.2em;
    }

    :global(.wl-chat-messages) {
      min-height: 12rem;
    }

    :global(.wl-chat-messages) :global(.wl-msg) {
      max-width: 90%;
    }

    /* On phones the chat IS the screen — let media fill the bubble */
    :global(.wl-chat-messages) :global(.wl-msg-media) {
      max-width: 100%;
    }

    :global(.wl-lightbox-inner) {
      max-width: calc(100vw - 1rem);
    }

    :global(.wl-lightbox-img),
    :global(.wl-lightbox-video) {
      border-radius: 3px;
    }
  }

  @media (max-height: 760px) {
    :global(.wl-chat-messages) {
      min-height: 10rem;
      max-height: 36rem;
    }

    :global(.wl-code-display) {
      max-height: 4.5rem;
    }
  }

  /* ── Touch ─────────────────────────────────────────────── */
  @media (hover: none) {
    .wl-confirm-btn:hover {
      background: rgb(var(--tool-status-success) / 0.1);
      border-color: rgb(var(--tool-status-success) / 0.35);
    }

    .wl-reject-btn:hover {
      background: rgb(var(--chromatic-red) / 0.08);
      border-color: rgb(var(--chromatic-red) / 0.3);
    }

    :global(.whisper-mini-btn.wl-chat-send-btn):hover {
      background: rgb(var(--chromatic-cyan) / 0.08);
      border-color: rgb(var(--chromatic-cyan) / 0.3);
    }

    /* Disable sticky hover brightness on touch — it lingers after tap */
    :global(.wl-chat-messages) :global(.wl-media-thumb:hover) {
      filter: none;
    }

    :global(.wl-chat-messages)
      :global(.wl-media-thumb:hover .wl-media-play-overlay) {
      opacity: 1;
    }

    :global(.wl-chat-messages) :global(.wl-media-dl:hover) {
      color: rgb(var(--msg-accent) / 0.6);
      background: rgb(var(--msg-accent) / 0.08);
      border-color: rgb(var(--msg-accent) / 0.22);
    }

    :global(.wl-lightbox-close:hover) {
      background: rgb(255 255 255 / 0.06);
      color: rgb(255 255 255 / 0.6);
      border-color: rgb(255 255 255 / 0.1);
    }

    :global(.wl-lightbox-dl:hover) {
      color: rgb(255 255 255 / 0.5);
      background: none;
    }

    :global(.wl-draw-toolbar) button:hover:not(.wl-draw-color) {
      background: rgb(255 255 255 / 0.06);
    }

    :global(.wl-lightbox-annotate:hover) {
      color: rgb(255 255 255 / 0.5);
      background: none;
    }

    :global(.wl-media-option:hover) {
      background: transparent;
      color: rgb(255 255 255 / 0.7);
    }
  }

  /* ── PictoCanvas overlay ────────────────────────────────── */
  :global(.wl-draw) {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    /* true void: fully opaque, no page ghosting through, with an ambient
       vignette layered on top so the void reads as depth, not a flat slab */
    background-color: var(--color-bg);
    background-image: var(--ambient-vignette);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    padding: calc(0.6rem + env(safe-area-inset-top)) calc(0.6rem + env(safe-area-inset-right))
      calc(0.6rem + env(safe-area-inset-bottom)) calc(0.6rem + env(safe-area-inset-left));
    /* opacity only transitions on the way in (declared on .--open below) —
       closing drops the class and snaps instantly, no transition to reverse */
    opacity: 0;
  }

  :global(.wl-draw *) {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-draw.--open) {
    opacity: 1;
    transition: opacity var(--duration-normal) ease;
  }

  @keyframes wl-draw-canvas-in {
    from { scale: 0.985; }
    to { scale: 1; }
  }

  @keyframes wl-draw-toolbar-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* entrance choreography keyed to the overlay's mount: the overlay itself
     fades, the canvas settles in slightly after, the toolbar rises in last.
     scoped to .--open so closing (class removed) reverts instantly — no
     reverse-playing animation to wait out. canvas uses the standalone
     `scale` property (not `transform`) so it never fights the pinch-zoom
     pan/zoom transform the draw logic applies inline to this same element. */
  :global(.wl-draw.--open .wl-draw-canvas-wrapper) {
    animation: wl-draw-canvas-in var(--duration-normal) var(--ease-spring) 60ms both;
  }

  :global(.wl-draw.--open .wl-draw-toolbar) {
    animation: wl-draw-toolbar-in var(--duration-normal) var(--ease-spring) 120ms both;
  }

  /* stage fills the space above the toolbar and centers the canvas within
     it, so a small (letterboxed) canvas doesn't leave the toolbar floating
     mid-page. the toolbar instead sits pinned at the true bottom. */
  :global(.wl-draw-stage) {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  :global(.wl-draw-canvas-wrapper) {
    position: relative;
    border-radius: var(--whisper-radius-soft);
    /* hairline presence + top edge light + a deep soft drop so the canvas
       floats above the void instead of reading as an undefined flat slab */
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    box-shadow: var(--edge-highlight), 0 12px 48px rgb(0 0 0 / 0.5);
    overflow: hidden;
    /* Explicit baseline so toolbar/controls at z-index:1 always paint above */
    z-index: 0;
    /* safety net: the stage already bounds this via flex, this just caps
       desktop growth so a very tall viewport doesn't make the canvas loom. */
    max-width: 100%;
    max-height: min(86vh, 100%);
  }

  :global(.wl-draw-bg-canvas) {
    display: block;
  }

  :global(.wl-draw-canvas) {
    position: absolute;
    top: 0;
    left: 0;
    touch-action: none;
    cursor: crosshair;
    outline: none;
    -webkit-user-drag: none;
  }

  :global(.wl-draw-close) {
    position: absolute;
    top: 0.75rem;
    top: calc(0.75rem + env(safe-area-inset-top));
    right: 0.75rem;
    right: calc(0.75rem + env(safe-area-inset-right));
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    /* quiet hairline-ring pill language: transparent at rest, dim icon,
       brightens on hover — matches the site's ghost-button family */
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      transform 120ms ease;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-draw-close:hover) {
    background: rgb(var(--color-text-rgb) / 0.06);
    color: rgb(var(--color-text-rgb) / 0.9);
    border-color: rgb(var(--color-text-rgb) / 0.24);
    /* the standard chromatic hover split, as a ring instead of text-shadow
       since this is an icon-only control */
    box-shadow:
      -1px 0 0 rgb(var(--chromatic-cyan) / 0.3),
      1px 0 0 rgb(var(--chromatic-red) / 0.3);
  }

  :global(.wl-draw-close:active) {
    transform: scale(0.92);
  }

  :global(.wl-draw-touch-toggle) {
    position: absolute;
    top: calc(3.9rem + env(safe-area-inset-top));
    right: calc(0.75rem + env(safe-area-inset-right));
    z-index: 1;
    min-height: 1.7rem;
    padding: 0 0.55rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.74);
    font-size: calc(var(--text-sm, 0.875rem) * 0.68);
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 120ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-draw-touch-toggle:hover) {
    background: rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.9);
    border-color: rgb(255 255 255 / 0.24);
  }

  :global(.wl-draw-touch-toggle:active) {
    transform: scale(0.96);
  }

  :global(.wl-draw-touch-toggle.--off) {
    color: rgb(255 206 122 / 0.95);
    border-color: rgb(255 206 122 / 0.45);
    background: rgb(255 206 122 / 0.14);
  }

  :global(.wl-draw-close.--confirm) {
    background: rgb(255 60 60 / 0.25);
    border-color: rgb(255 60 60 / 0.5);
    color: rgb(255 100 100);
    animation: wl-draw-close-pulse 300ms ease;
  }

  @keyframes wl-draw-close-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  /* ── Draw toolbar (bottom pill bar) ─────────────────────── */
  :global(.wl-draw-toolbar) {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-shrink: 0;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    /* hairline-border pill language, matching the chat composer */
    background: rgb(var(--color-text-rgb) / 0.06);
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    /* Always above the canvas regardless of canvas CSS transform state */
    position: relative;
    z-index: 1;
  }

  /* one coherent row: [colors + custom] [eraser] | [undo redo] | [send].
     the tail group carries the eraser through send and grows to fill
     leftover row width so send can anchor to the right edge — whether it
     shares a line with the colors group (wide) or drops to its own
     second line (narrow, wrapped; see the responsive block below). */
  :global(.wl-draw-group) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.wl-draw-group-colors) {
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  :global(.wl-draw-tail) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
    row-gap: 0.5rem;
  }

  :global(.wl-draw-divider) {
    align-self: stretch;
    width: 1px;
    min-height: 1.2rem;
    margin: 0.1rem 0;
    background: rgb(var(--color-text-rgb) / 0.1);
    flex-shrink: 0;
  }

  :global(.wl-draw-hint) {
    display: none;
    align-self: center;
    min-height: 1.1rem;
    max-width: min(92vw, 32rem);
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    color: rgb(255 255 255 / 0.66);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: calc(var(--text-sm, 0.875rem) * 0.74);
    letter-spacing: 0.01em;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
    opacity: 0;
    position: relative;
    z-index: 1;
    transform: translateY(4px);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  :global(.wl-draw-hint.--show) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.wl-draw-color) {
    -webkit-appearance: none;
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / var(--swatch-ring-alpha, 0.1));
    padding: 0;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  :global(.wl-draw-color:hover),
  :global(.wl-draw-color:active),
  :global(.wl-draw-color.--dragging) {
    filter: none;
    /* Keep swatch color patch 1:1 during press/drag. */
    opacity: 1 !important;
    transform: none !important;
  }

  :global(.wl-draw-color.--has-color::before) {
    /* No sheen overlay: preserve raw swatch color fidelity. */
    content: none;
  }

  :global(.wl-draw-color.--has-color::after) {
    /* No shade overlay: preserve raw swatch color fidelity. */
    content: none;
  }

  :global(.wl-draw-color.--active) {
    border-color: rgb(255 255 255 / 0.8);
    /* a whisper of the chromatic split on the selected swatch ring */
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.15),
      -1px 0 0 rgb(var(--chromatic-cyan) / 0.22),
      1px 0 0 rgb(var(--chromatic-red) / 0.22);
    transform: none;
    opacity: 1;
  }

  :global(.wl-draw-color.--dragging) {
    border-color: rgb(255 255 255 / 0.95);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.24);
    opacity: 1;
    transform: none;
  }

  :global(.wl-draw-color:focus-visible),
  :global(.wl-draw-color-custom:focus-visible) {
    /* Override global button focus glow that tints perceived swatch color. */
    outline: 1px solid rgb(255 255 255 / 0.75);
    outline-offset: 1px;
    box-shadow: none;
    opacity: 1;
    transform: none;
  }

  /* eraser: quiet ghost circle, 44px hit at every width — hairline ring,
     dim icon brightening on hover/active, chromatic split ring when armed */
  :global(.wl-draw-tool) {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.9);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      transform 120ms ease;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-draw-tool:hover) {
    opacity: 1;
    background: rgb(var(--color-text-rgb) / 0.06);
    border-color: rgb(var(--color-text-rgb) / 0.2);
  }

  :global(.wl-draw-tool:active) {
    transform: scale(0.92);
  }

  :global(.wl-draw-tool.--active) {
    opacity: 1;
    border-color: rgb(var(--color-text-rgb) / 0.3);
    /* the chromatic split ring, matching the selected color swatch */
    box-shadow:
      0 0 0 1px rgb(var(--color-text-rgb) / 0.15),
      -1px 0 0 rgb(var(--chromatic-cyan) / 0.28),
      1px 0 0 rgb(var(--chromatic-red) / 0.28);
  }

  :global(.wl-draw-tool.--size-host) {
    flex-direction: column;
    gap: 1px;
  }

  :global(.wl-draw-tool.--dragging) {
    opacity: 1;
    background: rgb(var(--color-text-rgb) / 0.08);
    transform: none !important;
  }

  /* live brush-width indicator, dot dims/brightens with the parent icon */
  :global(.wl-draw-size-pip) {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
    pointer-events: none;
    flex-shrink: 0;
    transition:
      width var(--duration-fast) ease,
      height var(--duration-fast) ease;
  }

  /* Undo/Redo — quiet ghost pill: transparent, hairline ring, dim icons
     that brighten on hover/active instead of the old heavy gray fill */
  :global(.wl-draw-undoredo) {
    display: flex;
    align-items: center;
    background: transparent;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    border-radius: 9999px;
    flex-shrink: 0;
  }

  :global(.wl-draw-undo),
  :global(.wl-draw-redo) {
    width: 1.7rem;
    height: 1.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.9);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-draw-undo) {
    border-radius: 9999px 0 0 9999px;
  }
  :global(.wl-draw-redo) {
    border-radius: 0 9999px 9999px 0;
  }

  :global(.wl-draw-undo:hover),
  :global(.wl-draw-redo:hover) {
    opacity: 1;
    background: rgb(var(--color-text-rgb) / 0.06);
  }

  :global(.wl-draw-undo:active),
  :global(.wl-draw-redo:active) {
    opacity: 0.8;
  }

  :global(.wl-draw-undo:disabled),
  :global(.wl-draw-redo:disabled) {
    opacity: 0.25;
    pointer-events: none;
  }

  /* custom color "+": same 44px circular hit + hairline ring as the eraser;
     becomes a real swatch (bg set inline by JS) once a custom color is picked */
  :global(.wl-draw-color-custom) {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.12);
    background: transparent;
    color: rgb(var(--color-text-rgb) / 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  :global(.wl-draw-color-custom:hover) {
    color: rgb(var(--color-text-rgb) / 0.9);
    background: rgb(var(--color-text-rgb) / 0.06);
    border-color: rgb(var(--color-text-rgb) / 0.2);
  }

  :global(.wl-draw-color-custom:active),
  :global(.wl-draw-color-custom.--active) {
    color: rgb(var(--color-text-rgb) / 0.9);
    border-color: rgb(var(--color-text-rgb) / 0.3);
    box-shadow:
      0 0 0 1px rgb(var(--color-text-rgb) / 0.15),
      -1px 0 0 rgb(var(--chromatic-cyan) / 0.22),
      1px 0 0 rgb(var(--chromatic-red) / 0.22);
    transform: none !important;
    opacity: 1 !important;
  }

  :global(.wl-draw-send) {
    /* teal pill, but sized to the same touch-target/padding family as the
       chat composer's send button */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--chromatic-cyan, 0 200 255) / 0.42);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan, 0 200 255) / 0.2) 0%,
      rgb(var(--chromatic-cyan, 0 200 255) / 0.12) 100%
    );
    color: rgb(var(--chromatic-cyan, 0 200 255));
    font-family: var(--font-body);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      transform 120ms ease;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
    /* anchors to the tail group's right edge — see .wl-draw-tail above */
    margin-left: auto;
  }

  :global(.wl-draw-send:hover) {
    border-color: rgb(var(--chromatic-cyan, 0 200 255) / 0.5);
    background: linear-gradient(
      180deg,
      rgb(var(--chromatic-cyan, 0 200 255) / 0.24) 0%,
      rgb(var(--chromatic-cyan, 0 200 255) / 0.15) 100%
    );
  }

  :global(.wl-draw-send:active) {
    transform: scale(0.96);
  }

  :global(.wl-draw-send:disabled) {
    opacity: 0.3;
    pointer-events: none;
  }

  /* ── Lightbox annotate button ───────────────────────────── */
  :global(.wl-lightbox-annotate) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0.55rem;
    margin: -0.55rem 0;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition:
      color 200ms ease,
      background 200ms ease;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.wl-lightbox-annotate:hover) {
    color: rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.1);
  }

  :global(.wl-lightbox-annotate:active) {
    transform: scale(0.92);
  }

  /* ── Responsive draw ────────────────────────────────────── */
  @media (max-width: 520px) {
    :global(.wl-draw-toolbar) {
      /* full-width bottom row, pinned above the safe-area inset */
      align-self: stretch;
      width: 100%;
      flex-wrap: wrap;
      border-radius: 1rem;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.5rem;
      padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));
    }

    :global(.wl-draw-color) {
      width: 1.3rem;
      height: 1.3rem;
    }

    /* keep palette swatches compact; the eraser and custom color "+" are
       already a 44px circular hit at every width (see base rules above) */
    :global(.wl-draw-undo),
    :global(.wl-draw-redo) {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }

    :global(.wl-draw-hint) {
      max-width: calc(100vw - 1.2rem);
      font-size: calc(var(--text-sm, 0.875rem) * 0.72);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* opacity only: keep the overlay's own fade, strip the scale/rise
       entrance choreography and every hover/press micro-transition below */
    :global(.wl-draw.--open) {
      transition: opacity var(--duration-fast) linear !important;
    }

    :global(.wl-draw-canvas-wrapper) {
      animation: none !important;
      scale: 1 !important;
    }

    :global(.wl-draw-toolbar) {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    :global(.wl-draw-close),
    :global(.wl-draw-touch-toggle),
    :global(.wl-draw-color),
    :global(.wl-draw-color-custom),
    :global(.wl-draw-tool),
    :global(.wl-draw-undo),
    :global(.wl-draw-redo),
    :global(.wl-draw-send),
    :global(.wl-lightbox-annotate),
    :global(.wl-draw-hint),
    :global(.wl-draw-size-pip) {
      transition: none !important;
    }
  }
</style>

<style is:global>
  @property --fill-l { syntax: "<color>"; inherits: false; initial-value: transparent; }
  @property --fill-r { syntax: "<color>"; inherits: false; initial-value: transparent; }
</style>
