                  autocapitalize="off"
                  spellcheck="false"
                  data-lpignore="true"
                  data-1p-ignore="true"
                  data-form-type="other"
                />
                <button
                  id="cf-flare-join"
                  type="button"
                  class="whisper-mini-btn">Join flare</button
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Campfire: waiting -->
        <div class="wl-phase" id="cf-waiting-section" style="display:none">
