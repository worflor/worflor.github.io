                type="button"
                class="whisper-mini-btn wl-chat-send-btn">Send</button
              >
            </div>
          </div>
        </div>

        <!-- Campfire: DM overlay -->
        <div id="cf-dm-overlay" class="cf-dm-overlay" style="display:none">
