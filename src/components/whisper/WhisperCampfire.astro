                id="cf-dm-send"
                type="button"
                class="whisper-mini-btn wl-chat-send-btn">Send</button
              >
            </div>
          </div>
        </div>

        <!-- Campfire: ended -->
        <div class="wl-phase" id="cf-ended-section" style="display:none">
          <div class="whisper-panel wl-end-panel">
            <p id="cf-ended-message" class="wl-end-text">
