---
import { Image } from "astro:assets";
import fs from "node:fs";
import path from "node:path";
import type { Project } from "../types/config";
import { parseMarkdown } from "../utils/helpers";
import { STATUS_LABEL, STATUS_IS_ACTIVE } from "../utils/projects";

type Props = Project & { loading?: "eager" | "lazy"; variant?: "full" | "compact"; index?: number };

const { title, description, image, month, year, url, github, trackRelease = false, status, slug, loading = "lazy", variant = "full", index = 0 } = Astro.props;
const isCompact = variant === "compact";
const isExternal = /^https?:\/\//.test(url);
const isScryer = slug === "scryer";

let images: string[] | null = null;
let resolvedImage = image;
if (image) {
  const fsPath = path.join("public", image);
  try {
    if (fs.statSync(fsPath).isDirectory()) {
      const files = fs.readdirSync(fsPath)
        .filter(f => f.endsWith(".webp"))
        .sort();
      if (files.length > 1) {
        images = files.map(f => `${image}/${f}`);
      } else if (files.length === 1) {
        resolvedImage = `${image}/${files[0]}`;
      } else {
        throw new Error(`[ProjectCard] no .webp files in ${fsPath}`);
      }
    }
  } catch {}
}

// a folder whose pictures are named for the time of day (day, dusk, night) is shown by the
// visitor's local hour rather than at random: the same hours the lore doorstep keeps.
const byHour = images !== null && images.every((src) => /\/(day|dusk|night)\.webp$/.test(src));

// the behind-the-scenes tier stays dense: compact cards show only the opener
// (the first beat, before the first <br>) so they don't tower over the page.
const compactOpener = description.split(/<br\s*\/?>/i)[0].trim();
const htmlDescription = parseMarkdown(isCompact ? compactOpener : description);
---

<a
  href={url}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={`View project: ${title}`}
  style={`--stagger-i:${index}`}
  class:list={[
    "interactive stagger-in",
    { "project-scryer": isScryer },
    isCompact
      ? "project-compact flex items-start"
      : "py-[var(--space-md)] flex flex-wrap gap-[var(--space-md)] card-hover",
  ]}
>
  {resolvedImage && (
    <div
      class:list={[
        "bg-[var(--color-border)] rounded-[var(--radius-lg)]",
        isCompact
          ? "w-[4.5rem] shrink-0 self-start"
          : "w-[var(--size-thumbnail-md)] min-w-0 shrink-0 self-start",
      ]}
    >
      {images ? (<>
        <img
          width="1920"
          height="1080"
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          alt={title}
          loading={loading}
          decoding="async"
          class="w-full h-auto rounded-[var(--radius-lg)] project-rng"
          data-images={JSON.stringify(images)}
          data-by-hour={byHour ? "" : undefined}
        />
        <noscript><img width="1920" height="1080" src={images[0]} alt={title} class="w-full h-auto rounded-[var(--radius-lg)]" /></noscript>
      </>) : (
        <Image
          width={1920}
          height={1080}
          src={resolvedImage}
          alt={title}
          loading={loading}
          decoding="async"
          class="w-full h-auto rounded-[var(--radius-lg)]"
        />
      )}
    </div>
  )}
  <div class:list={["flex flex-col justify-start", isCompact ? "flex-1 min-w-0" : "flex-1 min-w-[14rem]"]}>
    <div class:list={["flex items-baseline gap-1 flex-wrap", isCompact ? "mb-1" : "mb-2"]}>
      <p class="font-medium min-w-0">{title}</p>
      {isScryer && <span class="scryer-card-scratch" aria-hidden="true">? → exact</span>}
      <span class="opacity-60 tabular-nums shrink-0 whitespace-nowrap">· {month ? `${month} ` : ""}{year}</span>
      {status && (
        <span class="project-status">
          {STATUS_IS_ACTIVE[status] && <span class="project-status-dot" aria-hidden="true"></span>}
          {STATUS_LABEL[status]}
        </span>
      )}
      {github && (
        <span
          class="github-stars opacity-60 tabular-nums shrink-0 whitespace-nowrap items-center gap-0.5 hidden"
          data-repo={github}
        >
          · <svg class="w-3.5 h-3.5 inline" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/></svg> <span class="star-count"></span>
        </span>
      )}
      {github && trackRelease && (
        <span class="github-release opacity-60 tabular-nums shrink-0 whitespace-nowrap hidden" data-repo={github}>
          · <span class="release-version"></span>
        </span>
      )}
    </div>
    <div class:list={["opacity-60 text-[length:var(--text-sm)]", { "[&>p]:line-clamp-2": isCompact }]}>
      <Fragment set:html={htmlDescription} />
    </div>
    {isScryer && (
      <div class="scryer-card-chain" aria-hidden="true">
        <span>?</span><i>···→</i><span>𝒳</span><i>···→</i><span>⊢</span><em>[or leave open]</em>
      </div>
    )}
  </div>
</a>

<style>
  /* compact variant: a bordered, denser card for the "behind the scenes" tier.
     mirrors the concept-card surface so the two secondary tiers read as kin. */
  .project-compact {
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid rgb(var(--color-text-rgb) / 0.08);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background-color var(--duration-normal) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .project-compact:hover {
    border-color: rgb(var(--color-text-rgb) / 0.18);
    background-color: rgb(var(--color-text-rgb) / 0.02);
  }

  .project-compact:active {
    transform: scale(var(--scale-active));
    transition-duration: var(--duration-fast);
  }

  .project-scryer {
    position: relative;
  }

  .scryer-card-scratch,
  .scryer-card-chain {
    color: rgb(var(--chromatic-cyan) / 0.36);
    font-family: var(--font-casual);
    font-weight: 400;
    pointer-events: none;
    user-select: none;
  }

  .scryer-card-scratch {
    margin-left: 0.2rem;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    transform: rotate(-4deg);
  }

  .scryer-card-chain {
    display: flex;
    align-items: baseline;
    gap: 0.42rem;
    width: min(100%, 16rem);
    margin-top: 0.8rem;
    padding-bottom: 0.12rem;
    border-bottom: 1px dashed rgb(var(--chromatic-cyan) / 0.1);
    font-size: 0.78rem;
    transform: rotate(-0.5deg);
  }

  .scryer-card-chain i {
    color: rgb(var(--chromatic-cyan) / 0.22);
    font-family: var(--font-mono);
    font-style: normal;
  }

  .scryer-card-chain em {
    margin-left: auto;
    color: rgb(var(--color-text-rgb) / 0.27);
    font-size: 0.86em;
    font-style: normal;
    white-space: nowrap;
  }
</style>

<script>
  var CACHE_TTL_MS = 1000 * 60 * 60;
  var STORE_KEY = 'github-stars-cache-v1';

  function readCache(): Record<string, { stars: number; ts: number }> {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (!raw) return {};
      var parsed = JSON.parse(raw) as Record<string, { stars: number; ts: number }>;
      return parsed && typeof parsed === 'object' ? parsed : {};
    } catch {
      return {};
    }
  }

  function writeCache(cache: Record<string, { stars: number; ts: number }>) {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(cache));
    } catch {}
  }

  function setStars(el: HTMLElement, stars: number) {
    var countEl = el.querySelector('.star-count');
    if (countEl) {
      countEl.textContent = String(stars);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }
  }

  // GitHub's /releases/latest omits prereleases, so Neuron uses the published
  // releases collection. Network failures are shown honestly, not silently hidden.
  type ReleaseRecord = { tag: string; prerelease: boolean; ts: number };
  var RELEASE_CACHE_KEY = 'github-release-cache-v1';
  function readReleaseCache(): Record<string, ReleaseRecord> {
    try {
      var value = JSON.parse(localStorage.getItem(RELEASE_CACHE_KEY) || '{}');
      return value && typeof value === 'object' ? value : {};
    } catch { return {}; }
  }
  function setRelease(el: HTMLElement, record: ReleaseRecord) {
    var label = el.querySelector('.release-version');
    if (!label || !record.tag) return;
    label.textContent = record.tag + (record.prerelease ? ' preview' : ' release');
    el.title = 'Latest published ' + (record.prerelease ? 'preview ' : '') + 'release: ' + record.tag;
    el.classList.remove('hidden');
  }
  function setReleaseStatus(el: HTMLElement, text: string, title: string) {
    var label = el.querySelector('.release-version');
    if (!label) return;
    label.textContent = text;
    el.title = title;
    el.classList.remove('hidden');
  }
  function bootProjectCards() {
    document.querySelectorAll<HTMLImageElement>('.project-rng').forEach(function (img) {
      var images: string[] = JSON.parse(img.getAttribute('data-images')!);
      if (img.hasAttribute('data-by-hour')) {
        // asleep from eleven to seven, daylight from eight to six, dusk either side
        var hour = new Date().getHours();
        var part = hour >= 23 || hour < 7 ? 'night' : hour >= 8 && hour < 18 ? 'day' : 'dusk';
        var chosen = images.find(function (src) { return src.endsWith('/' + part + '.webp'); });
        if (chosen) { img.src = chosen; return; }
      }
      img.src = images[Math.floor(Math.random() * images.length)];
    });

    var inflight = new Map<string, Promise<any>>();
    var cache = readCache();
    var now = Date.now();

    var releases = readReleaseCache();
    var releaseInflight = new Map<string, Promise<ReleaseRecord | null>>();
    document.querySelectorAll('.github-release').forEach(async function (el) {
      if (!(el instanceof HTMLElement)) return;
      var repo = el.getAttribute('data-repo');
      if (!repo) return;
      const repoName = repo;
      var cached = releases[repo];
      if (cached && typeof cached.tag === 'string' && typeof cached.ts === 'number' && now - cached.ts < CACHE_TTL_MS) {
        setRelease(el, cached);
        return;
      }
      try {
        var request = releaseInflight.get(repo);
        if (!request) {
          request = fetch(`https://api.github.com/repos/${repo}/releases?per_page=20`, {
            headers: { Accept: 'application/vnd.github+json' },
          }).then(async function (response): Promise<ReleaseRecord | null> {
            if (!response.ok) throw new Error('GitHub release fetch failed');
            var entries = await response.json();
            if (!Array.isArray(entries)) return null;
            var published = entries.filter(function (item) {
              return item && item.draft !== true && typeof item.tag_name === 'string'
                && item.tag_name.length > 0 && typeof item.published_at === 'string';
            });
            published.sort((a, b) => b.published_at.localeCompare(a.published_at));
            var latest = published[0];
            return latest ? { tag: latest.tag_name, prerelease: latest.prerelease === true, ts: Date.now() } : null;
          }).finally(function () { releaseInflight.delete(repoName); });
          releaseInflight.set(repo, request);
        }
        var result = await request;
        if (result) {
          releases[repo] = result;
          try { localStorage.setItem(RELEASE_CACHE_KEY, JSON.stringify(releases)); } catch {}
          setRelease(el, result);
        } else {
          setReleaseStatus(el, 'no release yet', 'No published GitHub releases');
        }
      } catch {
        setReleaseStatus(el, 'release unavailable', 'GitHub release metadata is temporarily unavailable');
      }
    });

    document.querySelectorAll('.github-stars').forEach(async function (el) {
      if (!(el instanceof HTMLElement)) return;
      var repo = el.getAttribute('data-repo');
      if (!repo) return;
      const repoName: string = repo;

      var cached = cache[repoName];
      if (cached && typeof cached.stars === 'number' && now - cached.ts < CACHE_TTL_MS) {
        setStars(el, cached.stars);
        return;
      }

      try {
        var promise = inflight.get(repoName);
        if (!promise) {
          promise = fetch(`https://api.github.com/repos/${repoName}`, {
            headers: { Accept: 'application/vnd.github+json' },
          })
            .then(function (res) {
              if (!res.ok) throw new Error('GitHub fetch failed');
              return res.json();
            })
            .finally(function () {
              inflight.delete(repoName);
            });
          inflight.set(repoName, promise);
        }

        var data = await promise;
        if (data && typeof data.stargazers_count === 'number') {
          cache[repoName] = { stars: data.stargazers_count, ts: Date.now() };
          writeCache(cache);
          setStars(el, data.stargazers_count);
        }
      } catch {}
    });
  }

  document.addEventListener("astro:page-load", bootProjectCards);
</script>
