---
import { Image } from "astro:assets";
import fs from "node:fs";
import path from "node:path";
import type { Project } from "../types/config";
import { parseMarkdown } from "../utils/helpers";

type Props = Project & { loading?: "eager" | "lazy" };

const { title, description, image, year, url, github, status, loading = "lazy" } = Astro.props;

let images: string[] | null = null;
let resolvedImage = image;
if (image) {
  const fsPath = path.join("public", image);
  try {
    if (fs.statSync(fsPath).isDirectory()) {
      const files = fs.readdirSync(fsPath)
        .filter(f => f.endsWith(".webp"))
        .sort();
      if (files.length > 1) {
        images = files.map(f => `${image}/${f}`);
      } else if (files.length === 1) {
        resolvedImage = `${image}/${files[0]}`;
      } else {
        throw new Error(`[ProjectCard] no .webp files in ${fsPath}`);
      }
    }
  } catch {}
}

const htmlDescription = parseMarkdown(description);
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`View project: ${title}`}
  class="interactive py-[var(--space-md)] flex flex-wrap gap-[var(--space-md)] card-hover stagger-in"
>
  {resolvedImage && (
    <div class="bg-[var(--color-border)] rounded-[var(--radius-lg)] w-[var(--size-thumbnail-md)] min-w-0 shrink-0 self-start">
      {images ? (<>
        <img
          width="1920"
          height="1080"
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          alt={title}
          loading={loading}
          decoding="async"
          class="w-full h-auto rounded-[var(--radius-lg)] project-rng"
          data-images={JSON.stringify(images)}
        />
        <noscript><img width="1920" height="1080" src={images[0]} alt={title} class="w-full h-auto rounded-[var(--radius-lg)]" /></noscript>
      </>) : (
        <Image
          width={1920}
          height={1080}
          src={resolvedImage}
          alt={title}
          loading={loading}
          decoding="async"
          class="w-full h-auto rounded-[var(--radius-lg)]"
        />
      )}
    </div>
  )}
  <div class="flex flex-col justify-start flex-1 min-w-[14rem]">
    <div class="flex items-baseline gap-1 mb-2 flex-wrap">
      <p class="font-medium min-w-0">{title}</p>
      <span class="opacity-60 tabular-nums shrink-0 whitespace-nowrap">· {year}</span>
      {status && (
        <span class="project-status">
          {(status === "private-beta" || status === "closed-dev-alpha") && <span class="project-status-dot" aria-hidden="true"></span>}
          {status === "private-beta" ? "private beta" : status === "closed-dev-alpha" ? "closed dev alpha" : "concept"}
        </span>
      )}
      {github && (
        <span
          class="github-stars opacity-60 tabular-nums shrink-0 whitespace-nowrap items-center gap-0.5 hidden"
          data-repo={github}
        >
          · <svg class="w-3.5 h-3.5 inline" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/></svg> <span class="star-count"></span>
        </span>
      )}
    </div>
    <div class="opacity-60 text-[length:var(--text-sm)]">
      <Fragment set:html={htmlDescription} />
    </div>
  </div>
</a>

<script>
  var CACHE_TTL_MS = 1000 * 60 * 60;
  var STORE_KEY = 'github-stars-cache-v1';

  function readCache(): Record<string, { stars: number; ts: number }> {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (!raw) return {};
      var parsed = JSON.parse(raw) as Record<string, { stars: number; ts: number }>;
      return parsed && typeof parsed === 'object' ? parsed : {};
    } catch {
      return {};
    }
  }

  function writeCache(cache: Record<string, { stars: number; ts: number }>) {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(cache));
    } catch {}
  }

  function setStars(el: HTMLElement, stars: number) {
    var countEl = el.querySelector('.star-count');
    if (countEl) {
      countEl.textContent = String(stars);
      el.style.display = 'flex';
    }
  }

  function bootProjectCards() {
    document.querySelectorAll<HTMLImageElement>('.project-rng').forEach(function (img) {
      var images = JSON.parse(img.getAttribute('data-images')!);
      img.src = images[Math.floor(Math.random() * images.length)];
    });

    var inflight = new Map<string, Promise<any>>();
    var cache = readCache();
    var now = Date.now();

    document.querySelectorAll('.github-stars').forEach(async function (el) {
      if (!(el instanceof HTMLElement)) return;
      var repo = el.getAttribute('data-repo');
      if (!repo) return;
      const repoName: string = repo;

      var cached = cache[repoName];
      if (cached && typeof cached.stars === 'number' && now - cached.ts < CACHE_TTL_MS) {
        setStars(el, cached.stars);
        return;
      }

      try {
        var promise = inflight.get(repoName);
        if (!promise) {
          promise = fetch(`https://api.github.com/repos/${repoName}`, {
            headers: { Accept: 'application/vnd.github+json' },
          })
            .then(function (res) {
              if (!res.ok) throw new Error('GitHub fetch failed');
              return res.json();
            })
            .finally(function () {
              inflight.delete(repoName);
            });
          inflight.set(repoName, promise);
        }

        var data = await promise;
        if (data && typeof data.stargazers_count === 'number') {
          cache[repoName] = { stars: data.stargazers_count, ts: Date.now() };
          writeCache(cache);
          setStars(el, data.stargazers_count);
        }
      } catch {}
    });
  }

  document.addEventListener("astro:page-load", bootProjectCards);
</script>

