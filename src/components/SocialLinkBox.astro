---
import Icon from "./Icon.astro";
import type { SocialLink } from "../types/config";

type Props = SocialLink;

const { title, url, icon, external } = Astro.props;
---

<a
  href={url}
  class="p-3 @xs:p-4 rounded-lg border border-[var(--color-border)] flex items-center gap-3 opacity-70 group-has-[a:hover]:opacity-40 hover:!opacity-100 min-h-[var(--touch-target)]"
  target={external ? "_blank" : "_self"}
  rel={external ? `noopener noreferrer${url.includes("github.com") ? " me" : ""}` : url.includes("github.com") ? "me" : undefined}
  aria-label={title}
>
  <Icon name={icon} width={24} height={24} class="shrink-0" aria-hidden="true" />
  <div class="flex items-center justify-between w-full min-w-0 gap-2">
    <p class="truncate">{title}</p>
    <Icon name="mdi:arrow-up" class="rotate-45 shrink-0" width={16} height={16} aria-hidden="true" />
  </div>
</a>
