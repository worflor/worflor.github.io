---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatPostDate } from "../utils/posts";

interface Props {
  post: CollectionEntry<"posts">;
  loading?: "eager" | "lazy";
  showReadingTime?: boolean;
}

const { post, loading = "lazy", showReadingTime = false } = Astro.props;
---

<a
  href={`/blog/${post.id}`}
  aria-label={`Read post: ${post.data.title}`}
  class="blog-card post py-2 min-h-[var(--touch-target)]"
>
  <Image
    src={post.data.images[0].url}
    alt={post.data.images[0].alt}
    width={100}
    height={100}
    loading={loading}
    decoding="async"
    class="blog-card__image rounded-[var(--radius-lg)] object-cover"
    transition:name={`blog-image-${post.id}`}
  />
  <div class="blog-card__content">
    <p class="opacity-60 mb-2 tabular-nums text-[length:var(--text-sm)]">
      {formatPostDate(post.data.pubDate)}{showReadingTime && post.data.readingTime && <> · {post.data.readingTime}</>}
    </p>
    <p class="font-medium hover-underline">{post.data.title}</p>
    <p class="text-[length:var(--text-sm)] opacity-60 mt-2 mb-3">{post.data.description}</p>
  </div>
</a>

<style>
  .blog-card {
    --img-size: clamp(4.5rem, 28cqi, 6rem);
    --gap: clamp(0.75rem, 4cqi, 1.5rem);

    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .blog-card__image {
    width: var(--img-size);
    height: var(--img-size);
    flex-shrink: 0;
  }

  .blog-card__content {
    min-width: 0;
  }

  /* Horizontal layout when there's room */
  @container (min-width: 22rem) {
    .blog-card {
      --img-size: clamp(5rem, 16cqi, 6.5rem);
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
    }

    .blog-card__content {
      flex: 1;
    }
  }
</style>
